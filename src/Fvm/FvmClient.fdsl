#L ==============================================================================
#L TheFlux Fast Virtual Machine (FVM): Cliente e Conector IPC
#L Arquivo: src/Fvm/FvmClient.fdsl
#L Versao: 1.0.5
#L ==============================================================================

use RuntimeStdLib
use IoStdLib
use FvmContract.fdsl

agent (FvmClient) impl FvmContract {
      op fvmInjectBytecode (as string: bytecode_json, as string: stdin_text) as map ==> {
            mut as string: vm_bin = "bin\\fluxvm.exe"
            route {
                  stdIoFileExists(".\\bin\\fluxvm.exe") ==> { vm_bin = ".\\bin\\fluxvm.exe" }
                  stdIoFileExists("bin\\fluxvm.exe")   ==> { vm_bin = "bin\\fluxvm.exe" }
                  _                                    ==> { vm_bin = "fluxvm.exe" }
            }

            #L Grava o bytecode em arquivo temporario seguro em temp/
            mut as int64: now_ts = stdDatetimeNow()
            mut as string: tmp_path = "temp\\fvm_inject_" + now_ts + ".fvmbc"
            route {
                  not stdIoDirExists("temp") ==> {
                        stdIoCreateDir("temp")
                  }
                  _ ==> {}
            }
            stdIoWriteFile(tmp_path, bytecode_json)

            mut as string: cmd = vm_bin + " --inject \"" + tmp_path + "\""
            route {
                  stdin_text != "" ==> {
                        cmd = cmd + " --stdin \"" + stdin_text + "\""
                  }
                  _ ==> {}
            }
            mut as string: out = stdOsExecOutput(cmd)
            route {
                  stdIoFileExists(tmp_path) ==> {
                        stdIoDeleteFile(tmp_path)
                  }
                  _ ==> {}
            }

            mut as map: res = map{}
            res["success"] = true
            res["stdout"] = out
            emit(nice, res, "ok")
      }

      op fvmExecuteFile (as string: fvmbc_path, as string: stdin_text) as map ==> {
            mut as string: vm_bin = "bin\\fluxvm.exe"
            route {
                  stdIoFileExists(".\\bin\\fluxvm.exe") ==> { vm_bin = ".\\bin\\fluxvm.exe" }
                  stdIoFileExists("bin\\fluxvm.exe")   ==> { vm_bin = "bin\\fluxvm.exe" }
                  _                                    ==> { vm_bin = "fluxvm.exe" }
            }
            mut as string: cmd = vm_bin + " \"" + fvmbc_path + "\""
            route {
                  stdin_text != "" ==> {
                        cmd = cmd + " --stdin \"" + stdin_text + "\""
                  }
                  _ ==> {}
            }
            mut as string: out = stdOsExecOutput(cmd)

            mut as map: res = map{}
            res["success"] = true
            res["stdout"] = out
            emit(nice, res, "ok")
      }

      op fvmIsServiceActive () as bool ==> {
            mut as string: vm_bin = "bin\\fluxvm.exe"
            route {
                  stdIoFileExists(".\\bin\\fluxvm.exe") ==> { vm_bin = ".\\bin\\fluxvm.exe" }
                  stdIoFileExists("bin\\fluxvm.exe")   ==> { vm_bin = "bin\\fluxvm.exe" }
                  _                                    ==> { vm_bin = "fluxvm.exe" }
            }
            mut as string: out = stdOsExecOutput(vm_bin + " --status")
            mut as int64: olen = stdCollectionLength(out)
            route {
                  olen >= 6 and out[1..6] == "active" ==> {
                        emit(nice, true, "active")
                  }
                  _ ==> {
                        emit(nice, false, "inactive")
                  }
            }
      }
}
