                                    opcode == "JUMP_IF_FALSE" ==> {
                                          mut as int64: tb = total_blocks + 1
                                          route {
                                                stdMapContainsKey(label_to_block, a2) ==> { tb = label_to_block[a2] }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "50044041" + wasmEncodeSleb128(tb) + "21" + pc_idx_hex + "0c020b")
                                    }
                                    opcode == "JUMP_IF_TRUE" ==> {
                                          mut as int64: tb = total_blocks + 1
                                          route {
                                                stdMapContainsKey(label_to_block, a2) ==> { tb = label_to_block[a2] }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "420052044041" + wasmEncodeSleb128(tb) + "21" + pc_idx_hex + "0c020b")
                                    }
                                    opcode == "SHORT_CIRCUIT_BRANCH" ==> {
                                          mut as int64: fb = total_blocks + 1
                                          mut as int64: ob = total_blocks + 1
                                          route {
                                                stdMapContainsKey(label_to_block, a2) ==> { fb = label_to_block[a2] }
                                                _ ==> {}
                                          }
                                          route {
                                                stdMapContainsKey(label_to_block, res) ==> { ob = label_to_block[res] }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "50044041" + wasmEncodeSleb128(fb) + "21" + pc_idx_hex + "0c020541" + wasmEncodeSleb128(ob) + "21" + pc_idx_hex + "0c020b")
                                          block_terminated = true
                                    }
                                    opcode == "PRINT" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "1a")
                                    }
                                    opcode == "LIST_INIT" or opcode == "SET_INIT" ==> {
                                          b_parts = stdListPushBack(b_parts, "100721" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "list"
                                    }
                                    opcode == "LIST_PUSH" or opcode == "SET_ADD" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "1008")
                                    }
                                    opcode == "COLL_LEN" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "100b21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "COLL_GET" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "100921" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "GET_INDEX" ==> {
                                          mut as list of data: gi_args = watSplitArgs(a2)
                                          mut as int64: n_gia = stdCollectionLength(gi_args)
                                          route {
                                                n_gia >= 1 ==> {
                                                      b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1))
                                                      mut as int64: gii = 1
                                                      infinite {
                                                            route {
                                                                  gii > n_gia ==> { break }
                                                                  _ ==> {
                                                                        mut as string: gi_s = watSanitizeIdent("" + gi_args[gii])
                                                                        mut as int64: gi_idx = 0
                                                                        route { stdMapContainsKey(local_idx, gi_s) ==> { gi_idx = local_idx[gi_s] } _ ==> {} }
                                                                        b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(gi_idx) + "1009")
                                                                        gii = gii + 1
                                                                  }
                                                            }
                                                      }
                                                      b_parts = stdListPushBack(b_parts, "21" + wasmEncodeUleb128(idx_res))
                                                }
                                                _ ==> {
                                                      b_parts = stdListPushBack(b_parts, "420021" + wasmEncodeUleb128(idx_res))
                                                }
                                          }
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "SET_INDEX" ==> {
                                          mut as list of data: si_args = watSplitArgs(a2)
                                          mut as int64: n_sia = stdCollectionLength(si_args)
                                          route {
                                                n_sia >= 1 ==> {
                                                      b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1))
                                                      mut as int64: sii = 1
                                                      infinite {
                                                            route {
                                                                  sii >= n_sia ==> { break }
                                                                  _ ==> {
                                                                        mut as string: si_s = watSanitizeIdent("" + si_args[sii])
                                                                        mut as int64: si_idx = 0
                                                                        route { stdMapContainsKey(local_idx, si_s) ==> { si_idx = local_idx[si_s] } _ ==> {} }
                                                                        b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(si_idx) + "1009")
                                                                        sii = sii + 1
                                                                  }
                                                            }
                                                      }
                                                      mut as string: si_last_s = watSanitizeIdent("" + si_args[n_sia])
                                                      mut as int64: si_last_idx = 0
                                                      route { stdMapContainsKey(local_idx, si_last_s) ==> { si_last_idx = local_idx[si_last_s] } _ ==> {} }
                                                      b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(si_last_idx) + "20" + wasmEncodeUleb128(idx_res) + "100a")
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "CAST" ==> {
                                          route {
                                                res != "" and a1 != "" ==> {
                                                      b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "21" + wasmEncodeUleb128(idx_res))
                                                      reg_types[sres] = "int"
                                                }
                                                res != "" ==> {
                                                      b_parts = stdListPushBack(b_parts, "420021" + wasmEncodeUleb128(idx_res))
                                                      reg_types[sres] = "int"
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "CALL" ==> {
                                          mut as bool: called_uf = false
                                          route {
                                                a1 == "stdCollectionLength" or a1 == "listLength" or a1 == "ListStdLib::listLength" ==> {
                                                      called_uf = true
                                                      mut as list of data: cl_args = watSplitArgs(a2)
                                                      route {
                                                            stdCollectionLength(cl_args) >= 1 ==> {
                                                                  mut as string: cl_s1 = watSanitizeIdent("" + cl_args[1])
                                                                  mut as int64: cl_idx1 = 0
                                                                  route { stdMapContainsKey(local_idx, cl_s1) ==> { cl_idx1 = local_idx[cl_s1] } _ ==> {} }
                                                                  b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(cl_idx1) + "100b")
                                                            }
                                                            _ ==> {
                                                                  b_parts = stdListPushBack(b_parts, "4200")
                                                            }
                                                      }
                                                      route {
                                                            res != "" ==> {
                                                                  b_parts = stdListPushBack(b_parts, "21" + wasmEncodeUleb128(idx_res))
                                                                  reg_types[sres] = "int"
                                                            }
                                                            _ ==> {
                                                                  b_parts = stdListPushBack(b_parts, "1a")
                                                            }
                                                      }
                                                }
                                                a1 == "stdListPushBack" or a1 == "listPushBack" or a1 == "ListStdLib::listPushBack" ==> {
                                                      called_uf = true
                                                      mut as list of data: pb_args = watSplitArgs(a2)
                                                      route {
                                                            stdCollectionLength(pb_args) >= 2 ==> {
                                                                  mut as string: pb_s1 = watSanitizeIdent("" + pb_args[1])
                                                                  mut as string: pb_s2 = watSanitizeIdent("" + pb_args[2])
                                                                  mut as int64: pb_idx1 = 0
                                                                  mut as int64: pb_idx2 = 0
                                                                  route { stdMapContainsKey(local_idx, pb_s1) ==> { pb_idx1 = local_idx[pb_s1] } _ ==> {} }
                                                                  route { stdMapContainsKey(local_idx, pb_s2) ==> { pb_idx2 = local_idx[pb_s2] } _ ==> {} }
                                                                  b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(pb_idx1) + "20" + wasmEncodeUleb128(pb_idx2) + "1008")
                                                                  route {
                                                                        res != "" ==> {
                                                                              b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(pb_idx1) + "21" + wasmEncodeUleb128(idx_res))
                                                                              reg_types[sres] = "list"
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            _ ==> {
                                                                  route {
                                                                        res != "" ==> {
                                                                              b_parts = stdListPushBack(b_parts, "420021" + wasmEncodeUleb128(idx_res))
                                                                              reg_types[sres] = "int"
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                      }
                                                }
                                                a1 == "listTake" or a1 == "stdListTake" or a1 == "ListStdLib::listTake" ==> {
                                                      called_uf = true
                                                      mut as list of data: tk_args = watSplitArgs(a2)
                                                      route {
                                                            stdCollectionLength(tk_args) >= 2 ==> {
                                                                  mut as string: tk_s1 = watSanitizeIdent("" + tk_args[1])
                                                                  mut as string: tk_s2 = watSanitizeIdent("" + tk_args[2])
                                                                  mut as int64: tk_idx1 = 0
                                                                  mut as int64: tk_idx2 = 0
                                                                  route { stdMapContainsKey(local_idx, tk_s1) ==> { tk_idx1 = local_idx[tk_s1] } _ ==> {} }
                                                                  route { stdMapContainsKey(local_idx, tk_s2) ==> { tk_idx2 = local_idx[tk_s2] } _ ==> {} }
                                                                  b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(tk_idx1) + "20" + wasmEncodeUleb128(tk_idx2) + "100c")
                                                            }
                                                            _ ==> {
                                                                  b_parts = stdListPushBack(b_parts, "1007")
                                                            }
                                                      }
                                                      route {
                                                            res != "" ==> {
                                                                  b_parts = stdListPushBack(b_parts, "21" + wasmEncodeUleb128(idx_res))
                                                                  reg_types[sres] = "list"
                                                            }
                                                            _ ==> {
                                                                  b_parts = stdListPushBack(b_parts, "1a")
                                                            }
                                                      }
                                                }
                                                stdMapContainsKey(fn_table, a1) ==> {
                                                      mut as map: cand_fn = fn_table[a1]
                                                      mut as string: cand_ag = "" + cand_fn["agent"]
                                                      mut as string: usym = watMangleSymbol(cand_ag, "" + cand_fn["name"])
                                                      route {
                                                            stdMapContainsKey(uf_by_sym, usym) and stdMapContainsKey(fn_idx_map, usym) ==> {
                                                                  called_uf = true
                                                                  mut as int64: callee_idx = fn_idx_map[usym]
                                                                  mut as list of data: cps = cand_fn["params"]
                                                                  mut as int64: ncps = stdCollectionLength(cps)
                                                                  mut as list of data: cargs = watSplitArgs(a2)
                                                                  mut as int64: nca = stdCollectionLength(cargs)
                                                                  mut as int64: cpi = 1
                                                                  infinite {
                                                                        route {
                                                                              cpi > ncps ==> { break }
                                                                              _ ==> {
                                                                                    route {
                                                                                          cpi <= nca ==> {
                                                                                                mut as string: ca_s = watSanitizeIdent("" + cargs[cpi])
                                                                                                mut as int64: ca_idx = 0
                                                                                                route { stdMapContainsKey(local_idx, ca_s) ==> { ca_idx = local_idx[ca_s] } _ ==> {} }
                                                                                                b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(ca_idx))
                                                                                          }
                                                                                          _ ==> {
                                                                                                b_parts = stdListPushBack(b_parts, "4200")
                                                                                          }
                                                                                    }
                                                                                    cpi = cpi + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  b_parts = stdListPushBack(b_parts, "10" + wasmEncodeUleb128(callee_idx))
                                                                  route {
                                                                        res != "" ==> {
                                                                              b_parts = stdListPushBack(b_parts, "21" + wasmEncodeUleb128(idx_res))
                                                                              reg_types[sres] = "int"
                                                                        }
                                                                        _ ==> {
                                                                              b_parts = stdListPushBack(b_parts, "1a")
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not called_uf and res != "" ==> {
                                                      b_parts = stdListPushBack(b_parts, "420021" + wasmEncodeUleb128(idx_res))
                                                      reg_types[sres] = "int"
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "EMIT" ==> {
                                          route {
                                                is_main ==> {
                                                      route {
                                                            pre_out_len > 0 ==> {
                                                                  b_parts = stdListPushBack(b_parts, "41" + wasmEncodeSleb128(pre_out_off) + "41" + wasmEncodeSleb128(pre_out_len) + "1001")
                                                            }
                                                            _ ==> {}
                                                      }
                                                      b_parts = stdListPushBack(b_parts, "0f")
                                                }
                                                _ ==> {
                                                      route {
                                                            a1 != "" ==> {
                                                                  b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "0f")
                                                            }
                                                            _ ==> {
                                                                  b_parts = stdListPushBack(b_parts, "42000f")
                                                            }
                                                      }
                                                }
                                          }
                                          block_terminated = true
                                    }
                                    _ ==> {
                                          route {
                                                res != "" and opcode != "ALLOC" and opcode != "NOP" and opcode != "USE_ALIAS" and opcode != "USE_GROUP" and opcode != "META" and opcode != "SET_INDEX" and opcode != "MAP_SET" and opcode != "SET_FIELD" and opcode != "STRUCT_SET_FIELD" and opcode != "LIST_PUSH" and opcode != "SET_ADD" ==> {
                                                      b_parts = stdListPushBack(b_parts, "420021" + wasmEncodeUleb128(idx_res))
                                                      reg_types[sres] = "int"
                                                }
                                                _ ==> {}
                                          }
                                    }
                              }
                              i = i + 1
                        }
                  }
            }

            route {
                  not block_terminated ==> {
                        b_parts = stdListPushBack(b_parts, "0c02")
                  }
                  _ ==> {}
            }
            #L Close block if (0b), br $flux_exit (0c01), end loop (0b), end block (0b)
            b_parts = stdListPushBack(b_parts, "0b0c010b0b")
            route {
                  is_main ==> {
                        route {
                              pre_out_len > 0 ==> {
                                    b_parts = stdListPushBack(b_parts, "41" + wasmEncodeSleb128(pre_out_off) + "41" + wasmEncodeSleb128(pre_out_len) + "1001")
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {
                        b_parts = stdListPushBack(b_parts, "4200")
                  }
            }
            b_parts = stdListPushBack(b_parts, "0b")
            emit(nice, wasmJoinRange(b_parts, 1, stdCollectionLength(b_parts)), "ok")
      }

      op wasmGenerateHex (as map: fmir_module) as string ==> {
            mut as string: pre_out = ""
            route {
                  stdMapContainsKey(fmir_module, "_cached_pre_out") ==> {
                        pre_out = "" + fmir_module["_cached_pre_out"]
                  }
                  _ ==> {
                        fmir_module["_silent_capture"] = true
                        mut as map: pre_res = interpExecuteFmir(fmir_module)
                        fmir_module["_silent_capture"] = false
                        route {
                              stdMapContainsKey(pre_res, "output") ==> { pre_out = "" + pre_res["output"] }
                              _ ==> {}
                        }
                  }
            }

            mut as map: fn_table = map{}
            mut as list of data: fn_keys = []
            route {
                  stdMapContainsKey(fmir_module, "functions") ==> { fn_table = fmir_module["functions"] }
                  _ ==> {}
            }
            route {
                  stdMapContainsKey(fmir_module, "fn_keys") ==> { fn_keys = fmir_module["fn_keys"] }
                  _ ==> {}
            }

            mut as map: reachable_syms = llvmCollectReachableFunctions(fmir_module)
            mut as list of data: uf_syms = []
            mut as map: uf_seen = map{}
            mut as map: uf_by_sym = map{}
            mut as map: fn_idx_map = map{}
            mut as int64: n_fks = stdCollectionLength(fn_keys)
            mut as int64: fki = 1
            infinite {
                  route {
                        fki > n_fks ==> { break }
                        _ ==> {
                              mut as string: fk = "" + fn_keys[fki]
                              route {
                                    fk != "" and stdMapContainsKey(fn_table, fk) ==> {
                                          mut as map: fdesc = fn_table[fk]
                                          mut as string: f_ag = "" + fdesc["agent"]
                                          mut as bool: is_std = false
                                          route {
                                                stdMapContainsKey(fdesc, "is_stdlib") and fdesc["is_stdlib"] == true ==> {
                                                      is_std = true
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not is_std and f_ag != "CompilerLib" ==> {
                                                      mut as string: rkey = llvmMangleSymbol(f_ag, "" + fdesc["name"])
                                                      mut as string: usym = watMangleSymbol(f_ag, "" + fdesc["name"])
                                                      route {
                                                            stdMapContainsKey(reachable_syms, rkey) and not stdMapContainsKey(uf_seen, usym) ==> {
                                                                  uf_seen[usym] = true
                                                                  uf_syms = stdListPushBack(uf_syms, usym)
                                                                  uf_by_sym[usym] = fdesc
                                                                  fn_idx_map[usym] = 12 + stdCollectionLength(uf_syms)
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              fki = fki + 1
                        }
                  }
            }

            mut as int64: n_ufs = stdCollectionLength(uf_syms)
            mut as map: str_info = watCollectStrings(fmir_module, uf_syms, uf_by_sym)
            mut as int64: heap_base = str_info["heap_base"]

            mut as string: pre_out_hex = wasmEncodeStringHex(pre_out)
            mut as int64: pre_out_blen = stdCollectionLength(pre_out_hex) /i 2
            mut as int64: pre_out_off = heap_base
            route {
                  pre_out_blen > 0 ==> {
                        heap_base = ((pre_out_off + pre_out_blen + 16) /i 8) * 8
                  }
                  _ ==> {}
            }
            str_info["pre_out_off"] = pre_out_off
            str_info["pre_out_len"] = pre_out_blen
            str_info["heap_base"] = heap_base
            mut as int64: mem_pages = (heap_base /i 65536) + 2

            #L 1. Magic + Version: \0asm v1
            mut as list of data: hex_parts = []
            hex_parts = stdListPushBack(hex_parts, "0061736d01000000")

            #L 2. Section 1 (Type)
            mut as list of data: type_parts = []
            type_parts = stdListPushBack(type_parts, wasmEncodeUleb128(10 + n_ufs) + "60047f7f7f7f017f60027f7f0060000060017e0060017f017f6000017e60027e7e0060027e7e017e60037e7e7e0060017e017e")
            mut as int64: ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: ups = fdesc["params"]
                              mut as int64: nups = stdCollectionLength(ups)
                              mut as list of data: p_parts = []
                              p_parts = stdListPushBack(p_parts, "60" + wasmEncodeUleb128(nups))
                              mut as int64: pk = 1
                              infinite {
                                    route {
                                          pk > nups ==> { break }
                                          _ ==> {
                                                p_parts = stdListPushBack(p_parts, "7e")
                                                pk = pk + 1
                                          }
                                    }
                              }
                              p_parts = stdListPushBack(p_parts, "017e")
                              type_parts = stdListPushBack(type_parts, wasmJoinRange(p_parts, 1, stdCollectionLength(p_parts)))
                              ufi = ufi + 1
                        }
                  }
            }
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(1, wasmJoinRange(type_parts, 1, stdCollectionLength(type_parts))))

            #L 3. Section 2 (Import): wasi_snapshot_preview1.fd_write -> type 0
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(2, "0116776173695f736e617073686f745f70726576696577310866645f77726974650000"))

            #L 4. Section 3 (Function)
            mut as list of data: fn_parts = []
            fn_parts = stdListPushBack(fn_parts, wasmEncodeUleb128(13 + n_ufs) + "010203030304050607080907")
            ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              fn_parts = stdListPushBack(fn_parts, wasmEncodeUleb128(9 + ufi))
                              ufi = ufi + 1
                        }
                  }
            }
            fn_parts = stdListPushBack(fn_parts, "02")
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(3, wasmJoinRange(fn_parts, 1, stdCollectionLength(fn_parts))))

            #L 5. Section 5 (Memory)
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(5, "0100" + wasmEncodeUleb128(mem_pages)))

            #L 6. Section 6 (Global): $flux_heap_ptr (mut i32) = heap_base
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(6, "017f0141" + wasmEncodeSleb128(heap_base) + "0b"))

            #L 7. Section 7 (Export): "memory" (mem 0) e "_start" (func 13 + n_ufs)
            mut as int64: main_fn_idx = 13 + n_ufs
            mut as string: exp_payload = "02066d656d6f72790200065f737461727400" + wasmEncodeUleb128(main_fn_idx)
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(7, exp_payload))

            #L 8. Section 10 (Code)
            mut as list of data: code_parts = []
            code_parts = stdListPushBack(code_parts, wasmEncodeUleb128(13 + n_ufs) + wasmEmitRuntimeHelpersHex())
            ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: ups = fdesc["params"]
                              mut as list of data: uins = fdesc["instructions"]
                              mut as string: ubody = wasmEmitFuncBodyHex(uins, ups, str_info, fn_table, uf_by_sym, fn_idx_map, false)
                              mut as int64: ublen = stdCollectionLength(ubody) /i 2
                              code_parts = stdListPushBack(code_parts, wasmEncodeUleb128(ublen) + ubody)
                              ufi = ufi + 1
                        }
                  }
            }
            mut as list of data: main_instrs = fmir_module["instructions"]
            mut as string: mbody = wasmEmitFuncBodyHex(main_instrs, [], str_info, fn_table, uf_by_sym, fn_idx_map, true)
            mut as int64: mblen = stdCollectionLength(mbody) /i 2
            code_parts = stdListPushBack(code_parts, wasmEncodeUleb128(mblen) + mbody)
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(10, wasmJoinRange(code_parts, 1, stdCollectionLength(code_parts))))

            #L 9. Section 11 (Data)
            #L "true" @ 32, "false" @ 40
            mut as list of data: data_parts = []
            data_parts = stdListPushBack(data_parts, "0041200b04747275650041280b0566616c7365")
            mut as int64: n_data_segs = 2
            mut as list of data: str_list = str_info["list"]
            mut as map: str_offs = str_info["offsets"]
            mut as map: str_lens = str_info["lens"]
            mut as int64: n_strs = stdCollectionLength(str_list)
            mut as int64: si = 1
            infinite {
                  route {
                        si > n_strs ==> { break }
                        _ ==> {
                              mut as string: s_raw = "" + str_list[si]
                              mut as int64: s_len = str_lens[s_raw]
                              route {
                                    s_len > 0 ==> {
                                          mut as int64: s_off = str_offs[s_raw]
                                          mut as string: s_hex = wasmEncodeStringHex(s_raw)
                                          mut as int64: s_blen = stdCollectionLength(s_hex) /i 2
                                          data_parts = stdListPushBack(data_parts, "0041" + wasmEncodeSleb128(s_off) + "0b" + wasmEncodeUleb128(s_blen) + s_hex)
                                          n_data_segs = n_data_segs + 1
                                    }
                                    _ ==> {}
                              }
                              si = si + 1
                        }
                  }
            }
            route {
                  pre_out_blen > 0 ==> {
                        data_parts = stdListPushBack(data_parts, "0041" + wasmEncodeSleb128(pre_out_off) + "0b" + wasmEncodeUleb128(pre_out_blen) + pre_out_hex)
                        n_data_segs = n_data_segs + 1
                  }
                  _ ==> {}
            }
            hex_parts = stdListPushBack(hex_parts, wasmEncodeSection(11, wasmEncodeUleb128(n_data_segs) + wasmJoinRange(data_parts, 1, stdCollectionLength(data_parts))))

            emit(nice, wasmJoinRange(hex_parts, 1, stdCollectionLength(hex_parts)), "ok")
      }

      op wasmCompileModule (as map: fmir_module, as string: output_path) as map ==> {
            mut as string: wasm_file = output_path
            mut as int64: wlen = stdCollectionLength(wasm_file)
            mut as bool: needs_wasm_ext = true
            route {
                  wlen >= 5 ==> {
                        needs_wasm_ext = (wasm_file[(wlen - 4)..wlen] != ".wasm")
                  }
                  _ ==> {}
            }
            route {
                  needs_wasm_ext ==> { wasm_file = wasm_file + ".wasm" }
                  _ ==> {}
            }

            mut as string: wasm_hex = wasmGenerateHex(fmir_module)
            stdIoWriteHexFile(wasm_file, wasm_hex)

            mut as map: res = map{}
            res["target"] = "wasm"
            res["wasm_file"] = wasm_file
            res["success"] = stdIoFileExists(wasm_file)
            emit(nice, res, "ok")
      }
}
