#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: WasmBackend (Target: 'wasm' / 'was')
#L Codificador Binario WebAssembly (.wasm) 100% Self-Hosted em FDSL
#L ==============================================================================

contract (WasmBackendContract) {
      op wasmJoinRange (as list of data: parts, as int64: lo, as int64: hi) as string
      op wasmByteToHex (as int64: b) as string
      op wasmEncodeUleb128 (as int64: val) as string
      op wasmEncodeSleb128 (as int64: val) as string
      op wasmAsciiCharToHex (as string: ch) as string
      op wasmEncodeStringHex (as string: s) as string
      op wasmEncodeName (as string: s) as string
      op wasmEncodeSection (as int64: sec_id, as string: payload_hex) as string
      op wasmEncodeVec (as list of data: items) as string
      op wasmEmitRuntimeHelpersHex () as string
      op wasmEmitFuncBodyHex (as list of data: instrs, as list of data: fn_params, as map: str_info, as map: fn_table, as map: uf_by_sym, as map: fn_idx_map, as bool: is_main) as string
      op wasmGenerateHex (as map: fmir_module) as string
      op wasmCompileModule (as map: fmir_module, as string: output_path) as map
}

agent (CompilerLib) impl WasmBackendContract {
      op wasmJoinRange (as list of data: parts, as int64: lo, as int64: hi) as string ==> {
            route {
                  lo > hi ==> { emit(nice, "", "ok") }
                  lo == hi ==> { emit(nice, "" + parts[lo], "ok") }
                  _ ==> {
                        mut as int64: mid = (lo + hi) /i 2
                        emit(nice, wasmJoinRange(parts, lo, mid) + wasmJoinRange(parts, mid + 1, hi), "ok")
                  }
            }
      }

      op wasmByteToHex (as int64: b) as string ==> {
            mut as string: hex_digits = "0123456789abcdef"
            mut as int64: v = b & 255
            mut as int64: hi = (v >>> 4) & 15
            mut as int64: lo = v & 15
            mut as string: h1 = hex_digits[hi + 1]
            mut as string: h2 = hex_digits[lo + 1]
            emit(nice, h1 + h2, "ok")
      }

      op wasmEncodeUleb128 (as int64: val) as string ==> {
            mut as string: hex = ""
            mut as int64: v = val
            infinite {
                  mut as int64: byte_val = v & 127
                  v = v >>> 7
                  route {
                        v != 0 ==> {
                              byte_val = byte_val | 128
                              hex = hex + wasmByteToHex(byte_val)
                        }
                        _ ==> {
                              hex = hex + wasmByteToHex(byte_val)
                              break
                        }
                  }
            }
            emit(nice, hex, "ok")
      }

      op wasmEncodeSleb128 (as int64: val) as string ==> {
            mut as string: hex = ""
            mut as int64: v = val
            mut as bool: more = true
            infinite {
                  route {
                        not more ==> { break }
                        _ ==> {
                              mut as int64: byte_val = v & 127
                              v = v >> 7
                              mut as int64: sign_bit = byte_val & 64
                              route {
                                    (v == 0 and sign_bit == 0) or (v == -1 and sign_bit != 0) ==> {
                                          more = false
                                    }
                                    _ ==> {
                                          byte_val = byte_val | 128
                                    }
                              }
                              hex = hex + wasmByteToHex(byte_val)
                        }
                  }
            }
            emit(nice, hex, "ok")
      }

      op wasmAsciiCharToHex (as string: ch) as string ==> {
            mut as string: table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            mut as int64: code = 63
            mut as int64: lo = 1
            mut as int64: hi = 95
            infinite {
                  route {
                        lo > hi ==> { break }
                        _ ==> {
                              mut as int64: mid = (lo + hi) /i 2
                              mut as string: mc = table[mid]
                              route {
                                    mc == ch ==> {
                                          code = 31 + mid
                                          break
                                    }
                                    ch < mc ==> { hi = mid - 1 }
                                    _ ==> { lo = mid + 1 }
                              }
                        }
                  }
            }
            mut as string: res = wasmByteToHex(code)
            emit(nice, res, "ok")
      }

      op wasmEncodeStringHex (as string: s) as string ==> {
            mut as string: esc = stdStringLlvmEscape(s)
            mut as int64: elen = stdCollectionLength(esc)
            mut as list of data: hex_parts = []
            mut as int64: i = 1
            infinite {
                  route {
                        i > elen ==> { break }
                        _ ==> {
                              mut as string: ch = esc[i]
                              route {
                                    ch == "\\" and (i + 2) <= elen ==> {
                                          hex_parts = stdListPushBack(hex_parts, esc[(i + 1)..(i + 2)])
                                          i = i + 3
                                    }
                                    _ ==> {
                                          hex_parts = stdListPushBack(hex_parts, wasmAsciiCharToHex(ch))
                                          i = i + 1
                                    }
                              }
                        }
                  }
            }
            emit(nice, wasmJoinRange(hex_parts, 1, stdCollectionLength(hex_parts)), "ok")
      }

      op wasmEncodeName (as string: s) as string ==> {
            mut as string: raw_hex = wasmEncodeStringHex(s)
            mut as int64: blen = stdCollectionLength(raw_hex) /i 2
            mut as string: res = wasmEncodeUleb128(blen) + raw_hex
            emit(nice, res, "ok")
      }

      op wasmEncodeSection (as int64: sec_id, as string: payload_hex) as string ==> {
            mut as int64: blen = stdCollectionLength(payload_hex) /i 2
            mut as string: res = wasmByteToHex(sec_id) + wasmEncodeUleb128(blen) + payload_hex
            emit(nice, res, "ok")
      }

      op wasmEncodeVec (as list of data: items) as string ==> {
            mut as int64: n = stdCollectionLength(items)
            mut as list of data: parts = []
            parts = stdListPushBack(parts, wasmEncodeUleb128(n))
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              parts = stdListPushBack(parts, "" + items[i])
                              i = i + 1
                        }
                  }
            }
            emit(nice, wasmJoinRange(parts, 1, stdCollectionLength(parts)), "ok")
      }

      op wasmEmitRuntimeHelpersHex () as string ==> {
            mut as string: hex = ""
            #L 1. $flux_print_bytes (func idx 1, type 1: (i32, i32) -> ())
            mut as string: h1 = "004100200036020041042001360200410141004101411010001a0b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h1) /i 2) + h1
            #L 2. $flux_print_newline (func idx 2, type 2: () -> ())
            mut as string: h2 = "004118410a3a00004118410110010b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h2) /i 2) + h2
            #L 3. $flux_print_str (func idx 3, type 3: (i64) -> ())
            mut as string: h3 = "01027f2000422088a72101200042ffffffff0f83a7210220012002100110020b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h3) /i 2) + h3
            #L 4. $flux_print_bool (func idx 4, type 3: (i64) -> ())
            mut as string: h4 = "0020004200520440412041041001054128410510010b10020b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h4) /i 2) + h4
            #L 5. $flux_print_i64 (func idx 5, type 3: (i64) -> ())
            mut as string: h5 = "02017e037f41bf0221032000500440200341303a000020034101100110020f0b2000420053044041012102420020007d210105200021010b024003402001500d012001420a82a741306a2104200320043a0000200341016b21032001420a8021010c000b0b200204402003412d3a0000200341016b21030b200341016a41bf0220036b100110020b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h5) /i 2) + h5
            #L 6. $flux_alloc (func idx 6, type 4: (i32) -> (i32))
            mut as string: h6 = "01037f200041004c0440410821000b200041076a417871210023002101200120006a21023f004110742103200220034b0440200220036b41ffff036a41107640001a0b2002240020010b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h6) /i 2) + h6
            #L 7. $flux_list_new (func idx 7, type 5: () -> (i64))
            mut as string: h7 = "01027f41101006210041c00010062101200041003602002000410836020420002001360208200041d4a6b1b20436020c2000ad0b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h7) /i 2) + h7
            #L 8. $flux_list_push (func idx 8, type 6: (i64, i64) -> ())
            mut as string: h8 = ""
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h8) /i 2) + h8
            #L 9. $flux_list_get (func idx 9, type 7: (i64, i64) -> (i64))
            mut as string: h9 = "01027f2000420057044042000f0b2000230041106bad56044042000f0b2000a72102200228020c41d4a6b1b20447044042000f0b200228020021032001420153044042000f0b20012003ad55044042000f0b20022802082001a741016b4103746a2903000b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h9) /i 2) + h9
            #L 10. $flux_list_set (func idx 10, type 8: (i64, i64, i64) -> ())
            mut as string: h10 = ""
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h10) /i 2) + h10
            #L 11. $flux_list_len (func idx 11, type 9: (i64) -> (i64))
            mut as string: h11 = "01017f2000420057044042000f0b2000230041106bad56044042000f0b2000a72101200128020c41d4a6b1b20447044042000f0b2001280200ad0b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h11) /i 2) + h11
            #L 12. $flux_list_take (func idx 12, type 7: (i64, i64) -> (i64))
            mut as string: h12 = "01047e100721022000100b2103200120035304402001210405200321040b420121050240034020052004550d0120022000200510091008200542017c21050c000b0b20020b"
            hex = hex + wasmEncodeUleb128(stdCollectionLength(h12) /i 2) + h12
            emit(nice, hex, "ok")
      }

      op wasmEmitFuncBodyHex (as list of data: instrs, as list of data: fn_params, as map: str_info, as map: fn_table, as map: uf_by_sym, as map: fn_idx_map, as bool: is_main) as string ==> {
            mut as map: str_fats = str_info["fats"]
            mut as int64: pre_out_off = 0
            mut as int64: pre_out_len = 0
            route {
                  stdMapContainsKey(str_info, "pre_out_off") ==> { pre_out_off = str_info["pre_out_off"] }
                  _ ==> {}
            }
            route {
                  stdMapContainsKey(str_info, "pre_out_len") ==> { pre_out_len = str_info["pre_out_len"] }
                  _ ==> {}
            }
            mut as map: local_idx = map{}
            mut as int64: np = stdCollectionLength(fn_params)
            mut as int64: pi = 1
            infinite {
                  route {
                        pi > np ==> { break }
                        _ ==> {
                              mut as string: sp = watSanitizeIdent("" + fn_params[pi])
                              local_idx[sp] = pi - 1
                              pi = pi + 1
                        }
                  }
            }

            mut as int64: pc_idx = np
            mut as string: pc_idx_hex = wasmEncodeUleb128(pc_idx)

            mut as list of data: locals = watCollectLocals(instrs, fn_params)
            mut as int64: n_locals = stdCollectionLength(locals)
            mut as int64: li = 1
            infinite {
                  route {
                        li > n_locals ==> { break }
                        _ ==> {
                              mut as string: lname = "" + locals[li]
                              local_idx[lname] = np + li
                              li = li + 1
                        }
                  }
            }

            mut as string: decl_hex = "01017f"
            route {
                  n_locals > 0 ==> {
                        decl_hex = "02017f" + wasmEncodeUleb128(n_locals) + "7e"
                  }
                  _ ==> {}
            }

            mut as int64: n = stdCollectionLength(instrs)
            mut as map: label_to_block = map{}
            mut as int64: total_blocks = 1
            mut as int64: bi = 1
            infinite {
                  route {
                        bi > n ==> { break }
                        _ ==> {
                              mut as map: binst = instrs[bi]
                              mut as string: bop = "" + binst["op"]
                              mut as string: ba1 = "" + binst["arg1"]
                              route {
                                    bop == "LABEL" and ba1 != "" ==> {
                                          total_blocks = total_blocks + 1
                                          label_to_block[ba1] = total_blocks
                                    }
                                    _ ==> {}
                              }
                              bi = bi + 1
                        }
                  }
            }

            #L Init $flux_pc = 1, open (block $flux_exit (loop $flux_dispatch
            mut as list of data: b_parts = []
            b_parts = stdListPushBack(b_parts, decl_hex + "410121" + pc_idx_hex + "02400340")

            #L Open block 1: local.get $flux_pc, i32.const 1, i32.eq, if (void)
            mut as int64: cur_block = 1
            mut as bool: block_terminated = false
            b_parts = stdListPushBack(b_parts, "20" + pc_idx_hex + "41" + wasmEncodeSleb128(1) + "460440")

            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]
                              mut as string: sa1 = watSanitizeIdent(a1)
                              mut as string: sa2 = watSanitizeIdent(a2)
                              mut as string: sres = watSanitizeIdent(res)

                              mut as int64: idx_a1 = 0
                              mut as int64: idx_a2 = 0
                              mut as int64: idx_res = 0
                              route { stdMapContainsKey(local_idx, sa1) ==> { idx_a1 = local_idx[sa1] } _ ==> {} }
                              route { stdMapContainsKey(local_idx, sa2) ==> { idx_a2 = local_idx[sa2] } _ ==> {} }
                              route { stdMapContainsKey(local_idx, sres) ==> { idx_res = local_idx[sres] } _ ==> {} }

                              route {
                                    opcode == "LABEL" and a1 != "" ==> {
                                          route {
                                                not block_terminated ==> {
                                                      mut as int64: next_b = cur_block + 1
                                                      b_parts = stdListPushBack(b_parts, "41" + wasmEncodeSleb128(next_b) + "21" + pc_idx_hex + "0c01")
                                                }
                                                _ ==> {}
                                          }
                                          cur_block = cur_block + 1
                                          block_terminated = false
                                          b_parts = stdListPushBack(b_parts, "0b20" + pc_idx_hex + "41" + wasmEncodeSleb128(cur_block) + "460440")
                                    }
                                    block_terminated ==> {
                                          #L Ignora codigo morto ate o proximo LABEL
                                    }
                                    opcode == "CONST_INT" ==> {
                                          mut as int64: iv = watParseIntSafe(a1)
                                          b_parts = stdListPushBack(b_parts, "42" + wasmEncodeSleb128(iv) + "21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          mut as int64: fv = watParseIntSafe(a1)
                                          b_parts = stdListPushBack(b_parts, "42" + wasmEncodeSleb128(fv) + "21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "float"
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as int64: bv = 0
                                          route {
                                                a1 == "true" ==> { bv = 1 }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "42" + wasmEncodeSleb128(bv) + "21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "CONST_STR" or opcode == "CONST_COMPLEX" ==> {
                                          mut as int64: fat = 0
                                          route {
                                                stdMapContainsKey(str_fats, a1) ==> { fat = str_fats[a1] }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "42" + wasmEncodeSleb128(fat) + "21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "string"
                                    }
                                    opcode == "LOAD" or opcode == "STORE" or opcode == "COPY_REG" ==> {
                                          route {
                                                a1 != "" and res != "" ==> {
                                                      b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "21" + wasmEncodeUleb128(idx_res))
                                                      route {
                                                            stdMapContainsKey(reg_types, sa1) ==> {
                                                                  reg_types[sres] = reg_types[sa1]
                                                                  var_types[sres] = reg_types[sa1]
                                                            }
                                                            stdMapContainsKey(var_types, sa1) ==> {
                                                                  reg_types[sres] = var_types[sa1]
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "BINOP_+" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "7c21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_-" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "7d21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_*" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "7e21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_/i" or opcode == "BINOP_/f" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a2) + "50047e42000520" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "7f0b21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_%" or opcode == "BINOP_/r" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a2) + "50047e42000520" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "810b21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_&" or opcode == "BINOP_band" or opcode == "BINOP_and" or opcode == "BINOP_&&" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8321" + wasmEncodeUleb128(idx_res))
                                          route {
                                                opcode == "BINOP_and" or opcode == "BINOP_&&" ==> { reg_types[sres] = "bool" }
                                                _ ==> { reg_types[sres] = "int" }
                                          }
                                    }
                                    opcode == "BINOP_|" or opcode == "BINOP_bor" or opcode == "BINOP_or" or opcode == "BINOP_||" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8421" + wasmEncodeUleb128(idx_res))
                                          route {
                                                opcode == "BINOP_or" or opcode == "BINOP_||" ==> { reg_types[sres] = "bool" }
                                                _ ==> { reg_types[sres] = "int" }
                                          }
                                    }
                                    opcode == "BINOP_^" or opcode == "BINOP_bxor" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8521" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_<<" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8621" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_>>" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8721" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_>>>" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "8821" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_==" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "51ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "BINOP_!=" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "52ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "BINOP_<" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "53ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "BINOP_<=" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "57ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "BINOP_>" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "55ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "BINOP_>=" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "20" + wasmEncodeUleb128(idx_a2) + "59ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "UNARY_-" ==> {
                                          b_parts = stdListPushBack(b_parts, "420020" + wasmEncodeUleb128(idx_a1) + "7d21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "UNARY_not" or opcode == "UNARY_!" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "50ad21" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "UNARY_~" ==> {
                                          b_parts = stdListPushBack(b_parts, "20" + wasmEncodeUleb128(idx_a1) + "427f8521" + wasmEncodeUleb128(idx_res))
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "JUMP" ==> {
                                          mut as int64: tb = total_blocks + 1
                                          route {
                                                stdMapContainsKey(label_to_block, a1) ==> { tb = label_to_block[a1] }
                                                _ ==> {}
                                          }
                                          b_parts = stdListPushBack(b_parts, "41" + wasmEncodeSleb128(tb) + "21" + pc_idx_hex + "0c01")
                                          block_terminated = true
