                                                                  mut as int64: ncps = stdCollectionLength(cps)
                                                                  mut as list of data: cargs = watSplitArgs(a2)
                                                                  mut as int64: nca = stdCollectionLength(cargs)
                                                                  mut as int64: cpi = 1
                                                                  infinite {
                                                                        route {
                                                                              cpi > ncps ==> { break }
                                                                              _ ==> {
                                                                                    route {
                                                                                          cpi <= nca ==> {
                                                                                                mut as string: ca_s = watSanitizeIdent("" + cargs[cpi])
                                                                                                w_parts = stdListPushBack(w_parts, "            local.get $" + ca_s + nl)
                                                                                          }
                                                                                          _ ==> {
                                                                                                w_parts = stdListPushBack(w_parts, "            i64.const 0" + nl)
                                                                                          }
                                                                                    }
                                                                                    cpi = cpi + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  w_parts = stdListPushBack(w_parts, "            call $" + usym + nl)
