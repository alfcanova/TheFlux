                                                                  mut as string: tk_s2 = watSanitizeIdent("" + tk_args[2])
                                                                  w_parts = stdListPushBack(w_parts, "            local.get $" + tk_s1 + nl + "            local.get $" + tk_s2 + nl + "            call $flux_list_take" + nl)
