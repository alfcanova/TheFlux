                                                                  _ ==> {
                                                                        mut as string: gi_s = watSanitizeIdent("" + gi_args[gii])
                                                                        w_parts = stdListPushBack(w_parts, "            local.get $" + gi_s + nl + "            call $flux_list_get" + nl)
