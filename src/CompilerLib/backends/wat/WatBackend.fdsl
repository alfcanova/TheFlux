                                                      reg_types[sres] = "int"
                                                }
                                                _ ==> {}
                                          }
                                    }
                              }
                              i = i + 1
                        }
                  }
            }

            route {
                  not block_terminated ==> {
                        w_parts = stdListPushBack(w_parts, "            br $flux_exit" + nl)
                  }
                  _ ==> {}
            }
            w_parts = stdListPushBack(w_parts, "          )" + nl +
                  "        )" + nl +
                  "        br $flux_exit" + nl +
                  "      )" + nl +
                  "    )" + nl)
            route {
                  is_main ==> {
                        route {
                              pre_out_len > 0 ==> {
                                    w_parts = stdListPushBack(w_parts, "    i32.const " + pre_out_off + nl + "    i32.const " + pre_out_len + nl + "    call $flux_print_bytes" + nl)
                              }
                              _ ==> {}
                        }
