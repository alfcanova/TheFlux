#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: WatBackend (Target: 'wat')
#L ==============================================================================

contract (WatBackendContract) {
      op watGenerateModule (as map: fmir_module) as string
      op watCompileModule (as map: fmir_module, as string: output_path) as map
}

agent (CompilerLib) impl WatBackendContract {
      op watGenerateModule (as map: fmir_module) as string ==> {
            mut as string: wat = "(module\n"
            wat = wat + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n"
            wat = wat + "  (memory (export \"memory\") 2)\n"

            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: n = stdCollectionLength(instrs)

            wat = wat + "  (func $main (export \"_start\")\n"

            #L Declara locais para as variaveis e temporarios (com deduplicacao)
            mut as map: declared_locals = map{}
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: res = "" + inst["res"]
                              route {
                                    (opcode == "ALLOC" or res != "") and not stdMapContainsKey(declared_locals, res) ==> {
                                          declared_locals[res] = true
                                          wat = wat + "    (local $" + res + " i64)\n"
                                    }
                                    _ ==> {}
                              }
                              i = i + 1
                        }
                  }
            }

            #L Corpo da funcao
            i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              route {
                                    opcode == "CONST_INT" ==> {
                                          wat = wat + "    i64.const " + a1 + "\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as string: bv = "0"
                                          route {
                                                a1 == "true" ==> { bv = "1" }
                                                _ ==> {}
                                          }
                                          wat = wat + "    i64.const " + bv + "\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "LOAD" or opcode == "STORE" or opcode == "COPY_REG" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_+" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.add\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_-" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.sub\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_*" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.mul\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_/" or opcode == "BINOP_/i" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.div_s\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_%" or opcode == "BINOP_/r" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.rem_s\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_&" or opcode == "BINOP_band" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.and\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_|" or opcode == "BINOP_bor" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.or\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_^" or opcode == "BINOP_bxor" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.xor\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_<<" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.shl\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_>>" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.shr_s\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_>>>" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.shr_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_==" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.eq\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_!=" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.ne\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_<" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.lt_s\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_<=" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.le_s\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_>" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.gt_s\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "BINOP_>=" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    local.get $" + a2 + "\n"
                                          wat = wat + "    i64.ge_s\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "UNARY_-" ==> {
                                          wat = wat + "    i64.const 0\n"
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    i64.sub\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "UNARY_not" ==> {
                                          wat = wat + "    local.get $" + a1 + "\n"
                                          wat = wat + "    i64.eqz\n"
                                          wat = wat + "    i64.extend_i32_u\n"
                                          wat = wat + "    local.set $" + res + "\n"
                                    }
                                    opcode == "PRINT" ==> {
                                          #L Para imprimir, emite nop por enquanto na maquina wasi
                                    }
                                    _ ==> {}
                              }
                              i = i + 1
                        }
                  }
            }

            wat = wat + "  )\n"
            wat = wat + ")\n"

            emit(nice, wat, "ok")
      }

      op watCompileModule (as map: fmir_module, as string: output_path) as map ==> {
            mut as string: wat_text = watGenerateModule(fmir_module)
            mut as string: wat_file = output_path + ".wat"
            stdIoWriteFile(wat_file, wat_text)

            mut as map: res = map{}
            res["target"] = "wat"
            res["wat_file"] = wat_file
            res["success"] = true
            emit(nice, res, "ok")
      }
}
