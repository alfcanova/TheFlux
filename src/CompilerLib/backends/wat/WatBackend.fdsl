                                    opcode == "PRINT" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            drop" + nl)
                                    }
                                    opcode == "LIST_INIT" or opcode == "SET_INIT" ==> {
                                          w_parts = stdListPushBack(w_parts, "            call $flux_list_new" + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "list"
                                    }
                                    opcode == "LIST_PUSH" or opcode == "SET_ADD" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            local.get $" + sa2 + nl + "            call $flux_list_push" + nl)
                                    }
                                    opcode == "COLL_LEN" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            call $flux_list_len" + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "COLL_GET" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            local.get $" + sa2 + nl + "            call $flux_list_get" + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "GET_INDEX" ==> {
                                          mut as list of data: gi_args = watSplitArgs(a2)
                                          mut as int64: n_gia = stdCollectionLength(gi_args)
                                          route {
                                                n_gia >= 1 ==> {
                                                      w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl)
                                                      mut as int64: gii = 1
                                                      infinite {
