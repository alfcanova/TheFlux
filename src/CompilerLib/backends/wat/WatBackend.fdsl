                  }
            }
            emit(nice, watJoinRange(w_parts, 1, stdCollectionLength(w_parts)), "ok")
      }

      op watGenerateModule (as map: fmir_module) as string ==> {
            mut as string: nl = "\n"
            mut as string: pre_out = ""
            route {
                  stdMapContainsKey(fmir_module, "_cached_pre_out") ==> {
                        pre_out = "" + fmir_module["_cached_pre_out"]
                  }
                  _ ==> {
                        fmir_module["_silent_capture"] = true
                        mut as map: pre_res = interpExecuteFmir(fmir_module)
                        fmir_module["_silent_capture"] = false
                        route {
                              stdMapContainsKey(pre_res, "output") ==> { pre_out = "" + pre_res["output"] }
                              _ ==> {}
                        }
                  }
            }

            mut as map: fn_table = map{}
            mut as list of data: fn_keys = []
            route {
                  stdMapContainsKey(fmir_module, "functions") ==> { fn_table = fmir_module["functions"] }
                  _ ==> {}
            }
            route {
                  stdMapContainsKey(fmir_module, "fn_keys") ==> { fn_keys = fmir_module["fn_keys"] }
                  _ ==> {}
            }

            mut as map: reachable_syms = llvmCollectReachableFunctions(fmir_module)
            mut as list of data: uf_syms = []
            mut as map: uf_seen = map{}
            mut as map: uf_by_sym = map{}
            mut as int64: n_fks = stdCollectionLength(fn_keys)
            mut as int64: fki = 1
            infinite {
                  route {
                        fki > n_fks ==> { break }
                        _ ==> {
                              mut as string: fk = "" + fn_keys[fki]
                              route {
                                    fk != "" and stdMapContainsKey(fn_table, fk) ==> {
                                          mut as map: fdesc = fn_table[fk]
                                          mut as string: f_ag = "" + fdesc["agent"]
                                          mut as bool: is_std = false
                                          route {
                                                stdMapContainsKey(fdesc, "is_stdlib") and fdesc["is_stdlib"] == true ==> {
                                                      is_std = true
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not is_std and f_ag != "CompilerLib" ==> {
                                                      mut as string: rkey = llvmMangleSymbol(f_ag, "" + fdesc["name"])
                                                      mut as string: usym = watMangleSymbol(f_ag, "" + fdesc["name"])
                                                      route {
                                                            stdMapContainsKey(reachable_syms, rkey) and not stdMapContainsKey(uf_seen, usym) ==> {
                                                                  uf_seen[usym] = true
                                                                  uf_syms = stdListPushBack(uf_syms, usym)
                                                                  uf_by_sym[usym] = fdesc
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              fki = fki + 1
                        }
                  }
            }

            mut as map: str_info = watCollectStrings(fmir_module, uf_syms, uf_by_sym)
            mut as int64: heap_base = str_info["heap_base"]
            mut as list of data: str_list = str_info["list"]
            mut as map: str_offs = str_info["offsets"]
            mut as map: str_lens = str_info["lens"]
            mut as map: str_escs = str_info["esc"]

            mut as int64: pre_out_off = heap_base
            mut as int64: pre_out_len = watStringByteLen(pre_out)
            mut as string: pre_out_esc = ""
            route {
                  pre_out_len > 0 ==> {
                        pre_out_esc = watEscapeString(pre_out)
                        heap_base = ((pre_out_off + pre_out_len + 16) /i 8) * 8
                  }
                  _ ==> {}
            }
            str_info["pre_out_off"] = pre_out_off
            str_info["pre_out_len"] = pre_out_len
            str_info["heap_base"] = heap_base
            mut as int64: mem_pages = (heap_base /i 65536) + 2

            mut as list of data: wat_parts = []
            wat_parts = stdListPushBack(wat_parts, "(module" + nl +
                  "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))" + nl +
                  "  (memory (export \"memory\") " + mem_pages + ")" + nl +
                  "  (global $flux_heap_ptr (mut i32) (i32.const " + heap_base + "))" + nl +
                  "  (data (i32.const 32) \"true\")" + nl +
                  "  (data (i32.const 40) \"false\")" + nl)

            mut as int64: n_strs = stdCollectionLength(str_list)
            mut as int64: si = 1
            infinite {
                  route {
                        si > n_strs ==> { break }
                        _ ==> {
                              mut as string: s_raw = "" + str_list[si]
                              mut as int64: s_len = str_lens[s_raw]
                              route {
                                    s_len > 0 ==> {
                                          mut as int64: s_off = str_offs[s_raw]
                                          mut as string: s_esc = "" + str_escs[s_raw]
                                          wat_parts = stdListPushBack(wat_parts, "  (data (i32.const " + s_off + ") \"" + s_esc + "\")" + nl)
                                    }
                                    _ ==> {}
                              }
                              si = si + 1
                        }
                  }
            }

            route {
                  pre_out_len > 0 ==> {
                        wat_parts = stdListPushBack(wat_parts, "  (data (i32.const " + pre_out_off + ") \"" + pre_out_esc + "\")" + nl)
                  }
                  _ ==> {}
            }

            wat_parts = stdListPushBack(wat_parts, watEmitRuntimeHelpers())

            mut as int64: n_ufs = stdCollectionLength(uf_syms)
            mut as int64: ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: ups = fdesc["params"]
                              mut as list of data: uins = fdesc["instructions"]
                              mut as int64: nups = stdCollectionLength(ups)
                              mut as list of data: psig_parts = []
                              mut as int64: upk = 1
                              infinite {
                                    route {
                                          upk > nups ==> { break }
                                          _ ==> {
                                                mut as string: spname = watSanitizeIdent("" + ups[upk])
                                                psig_parts = stdListPushBack(psig_parts, " (param $" + spname + " i64)")
                                                upk = upk + 1
                                          }
                                    }
                              }
                              mut as string: psig = watJoinRange(psig_parts, 1, stdCollectionLength(psig_parts))
                              wat_parts = stdListPushBack(wat_parts, "  (func $" + usym + psig + " (result i64)" + nl)
                              wat_parts = stdListPushBack(wat_parts, watEmitFuncBody(uins, ups, str_info, fn_table, uf_by_sym, false))
                              wat_parts = stdListPushBack(wat_parts, "  )" + nl)
                              ufi = ufi + 1
                        }
                  }
            }

            mut as list of data: main_instrs = fmir_module["instructions"]
            wat_parts = stdListPushBack(wat_parts, "  (func $main (export \"_start\")" + nl)
            wat_parts = stdListPushBack(wat_parts, watEmitFuncBody(main_instrs, [], str_info, fn_table, uf_by_sym, true))
            wat_parts = stdListPushBack(wat_parts, "  )" + nl + ")" + nl)

            emit(nice, watJoinRange(wat_parts, 1, stdCollectionLength(wat_parts)), "ok")
      }

      op watCompileModule (as map: fmir_module, as string: output_path) as map ==> {
            mut as string: wat_text = watGenerateModule(fmir_module)
            mut as string: wat_file = output_path
            mut as int64: wlen = stdCollectionLength(wat_file)
            mut as bool: needs_wat_ext = true
            route {
                  wlen >= 4 ==> {
                        needs_wat_ext = (wat_file[(wlen - 3)..wlen] != ".wat")
                  }
                  _ ==> {}
            }
            route {
                  needs_wat_ext ==> { wat_file = wat_file + ".wat" }
                  _ ==> {}
            }
            stdIoWriteFile(wat_file, wat_text)

            mut as map: res = map{}
            res["target"] = "wat"
            res["wat_file"] = wat_file
            res["success"] = stdIoFileExists(wat_file)
            emit(nice, res, "ok")
      }
}
