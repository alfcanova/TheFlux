#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: WatBackend (Target: 'wat')
#L Compilador 100% Self-Hosted FDSL para WebAssembly Text Format (.wat)
#L ==============================================================================

contract (WatBackendContract) {
      op watJoinRange (as list of data: parts, as int64: lo, as int64: hi) as string
      op watSanitizeIdent (as string: raw) as string
      op watMangleSymbol (as string: agent_name, as string: op_name) as string
      op watEscapeString (as string: s) as string
      op watStringByteLen (as string: s) as int64
      op watParseIntSafe (as string: s) as int64
      op watSplitArgs (as string: csv) as list of data
      op watCollectLocals (as list of data: instrs, as list of data: fn_params) as list of data
      op watCollectStrings (as map: fmir_module, as list of data: uf_syms, as map: uf_by_sym) as map
      op watEmitRuntimeHelpers () as string
      op watEmitFuncBody (as list of data: instrs, as list of data: fn_params, as map: str_info, as map: fn_table, as map: uf_by_sym, as bool: is_main) as string
      op watGenerateModule (as map: fmir_module) as string
      op watCompileModule (as map: fmir_module, as string: output_path) as map
}

agent (CompilerLib) impl WatBackendContract {
      op watJoinRange (as list of data: parts, as int64: lo, as int64: hi) as string ==> {
            route {
                  lo > hi ==> { emit(nice, "", "ok") }
                  lo == hi ==> { emit(nice, "" + parts[lo], "ok") }
                  _ ==> {
                        mut as int64: mid = (lo + hi) /i 2
                        emit(nice, watJoinRange(parts, lo, mid) + watJoinRange(parts, mid + 1, hi), "ok")
                  }
            }
      }

      op watSanitizeIdent (as string: raw) as string ==> {
            mut as int64: n = stdCollectionLength(raw)
            route {
                  n == 0 ==> {
                        emit(nice, "v_empty", "ok")
                  }
                  _ ==> {}
            }
            mut as string: out = "v_"
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as string: ch = raw[i]
                              route {
                                    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_" ==> {
                                          out = out + ch
                                    }
                                    ch == "%" ==> {
                                          out = out + "r_"
                                    }
                                    _ ==> {
                                          out = out + "_"
                                    }
                              }
                              i = i + 1
                        }
                  }
            }
            emit(nice, out, "ok")
      }

      op watMangleSymbol (as string: agent_name, as string: op_name) as string ==> {
            mut as string: raw = op_name
            route {
                  agent_name != "" ==> {
                        raw = agent_name + "__" + op_name
                  }
                  _ ==> {}
            }
            mut as string: san = watSanitizeIdent(raw)
            emit(nice, "uf_" + san, "ok")
      }

      op watEscapeString (as string: s) as string ==> {
            mut as string: res = stdStringLlvmEscape(s)
            emit(nice, res, "ok")
      }

      op watStringByteLen (as string: s) as int64 ==> {
            mut as int64: blen = stdStringByteLength(s)
            emit(nice, blen, "ok")
      }

      op watParseIntSafe (as string: s) as int64 ==> {
            mut as int64: slen = stdCollectionLength(s)
            mut as int64: i = 1
            infinite {
                  route {
                        i > slen ==> { break }
                        s[i] == " " or s[i] == "\t" ==> { i = i + 1 }
                        _ ==> { break }
                  }
            }
            mut as int64: sign = 1
            route {
                  i <= slen ==> {
                        route {
                              s[i] == "-" ==> {
                                    sign = -1
                                    i = i + 1
                              }
                              s[i] == "+" ==> {
                                    i = i + 1
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            mut as int64: base = 10
            route {
                  i + 1 <= slen and s[i] == "0" ==> {
                        mut as string: pfx = s[i + 1]
                        route {
                              pfx == "x" or pfx == "X" ==> {
                                    base = 16
                                    i = i + 2
                              }
                              pfx == "b" or pfx == "B" ==> {
                                    base = 2
                                    i = i + 2
                              }
                              pfx == "o" or pfx == "O" ==> {
                                    base = 8
                                    i = i + 2
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            mut as int64: res = 0
            infinite {
                  route {
                        i > slen ==> { break }
                        _ ==> {
                              mut as string: ch = s[i]
                              route {
                                    ch == "_" ==> {
                                          i = i + 1
                                    }
                                    ch >= "0" and ch <= "9" ==> {
                                          mut as int64: d = 0
                                          route {
                                                ch == "1" ==> { d = 1 }
                                                ch == "2" ==> { d = 2 }
                                                ch == "3" ==> { d = 3 }
                                                ch == "4" ==> { d = 4 }
                                                ch == "5" ==> { d = 5 }
                                                ch == "6" ==> { d = 6 }
                                                ch == "7" ==> { d = 7 }
                                                ch == "8" ==> { d = 8 }
                                                ch == "9" ==> { d = 9 }
                                                _ ==> { d = 0 }
                                          }
                                          res = res * base + d
                                          i = i + 1
                                    }
                                    base == 16 and ((ch >= "a" and ch <= "f") or (ch >= "A" and ch <= "F")) ==> {
                                          mut as int64: hd = 10
                                          route {
                                                ch == "a" or ch == "A" ==> { hd = 10 }
                                                ch == "b" or ch == "B" ==> { hd = 11 }
                                                ch == "c" or ch == "C" ==> { hd = 12 }
                                                ch == "d" or ch == "D" ==> { hd = 13 }
                                                ch == "e" or ch == "E" ==> { hd = 14 }
                                                ch == "f" or ch == "F" ==> { hd = 15 }
                                                _ ==> {}
                                          }
                                          res = res * 16 + hd
                                          i = i + 1
                                    }
                                    _ ==> { break }
                              }
                        }
                  }
            }
            res = res * sign
            emit(nice, res, "ok")
      }

      op watSplitArgs (as string: csv) as list of data ==> {
            mut as list of data: out = []
            mut as int64: n = stdCollectionLength(csv)
            route {
                  n == 0 ==> {
                        emit(nice, out, "ok")
                  }
                  _ ==> {}
            }
            mut as string: cur = ""
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as string: ch = csv[i]
                              route {
                                    ch == "," ==> {
                                          route {
                                                cur != "" ==> {
                                                      out = stdListPushBack(out, cur)
                                                      cur = ""
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    ch == " " or ch == "\t" ==> {
                                          route {
                                                cur != "" ==> { cur = cur + ch }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {
                                          cur = cur + ch
                                    }
                              }
                              i = i + 1
                        }
                  }
            }
            route {
                  cur != "" ==> {
                        out = stdListPushBack(out, cur)
                  }
                  _ ==> {}
            }
            emit(nice, out, "ok")
      }

      op watCollectLocals (as list of data: instrs, as list of data: fn_params) as list of data ==> {
            mut as list of data: locals = []
            mut as map: seen = map{}
            mut as int64: np = stdCollectionLength(fn_params)
            mut as int64: pi = 1
            infinite {
                  route {
                        pi > np ==> { break }
                        _ ==> {
                              mut as string: pname = "" + fn_params[pi]
                              mut as string: sp = watSanitizeIdent(pname)
                              seen[sp] = true
                              pi = pi + 1
                        }
                  }
            }
            mut as int64: n = stdCollectionLength(instrs)
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]
                              mut as int64: oplen = stdCollectionLength(opcode)
                              mut as bool: is_binop = (oplen >= 6 and opcode[1..6] == "BINOP_")
                              mut as bool: is_unary = (oplen >= 6 and opcode[1..6] == "UNARY_")

                              route {
                                    res != "" and opcode != "LABEL" and opcode != "JUMP" and opcode != "JUMP_IF_FALSE" and opcode != "JUMP_IF_TRUE" and opcode != "SHORT_CIRCUIT_BRANCH" and opcode != "PRINT" and opcode != "EMIT" and opcode != "NOP" and opcode != "USE_ALIAS" and opcode != "USE_GROUP" and opcode != "META" and opcode != "MAP_SET" and opcode != "SET_FIELD" and opcode != "STRUCT_SET_FIELD" and opcode != "LIST_PUSH" and opcode != "SET_ADD" ==> {
                                          mut as string: sres = watSanitizeIdent(res)
                                          route {
                                                not stdMapContainsKey(seen, sres) ==> {
                                                      seen[sres] = true
                                                      locals = stdListPushBack(locals, sres)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              route {
                                    a1 != "" and (is_binop or is_unary or opcode == "LOAD" or opcode == "STORE" or opcode == "COPY_REG" or opcode == "JUMP_IF_FALSE" or opcode == "JUMP_IF_TRUE" or opcode == "SHORT_CIRCUIT_BRANCH" or opcode == "PRINT" or opcode == "EMIT" or opcode == "CAST" or opcode == "COLL_LEN" or opcode == "COLL_GET" or opcode == "LIST_PUSH" or opcode == "SET_ADD" or opcode == "GET_INDEX" or opcode == "SET_INDEX") ==> {
                                          mut as string: sa1 = watSanitizeIdent(a1)
                                          route {
                                                not stdMapContainsKey(seen, sa1) ==> {
                                                      seen[sa1] = true
                                                      locals = stdListPushBack(locals, sa1)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              route {
                                    a2 != "" and (is_binop or opcode == "LIST_PUSH" or opcode == "SET_ADD" or opcode == "COLL_GET") ==> {
                                          mut as string: sa2 = watSanitizeIdent(a2)
                                          route {
                                                not stdMapContainsKey(seen, sa2) ==> {
                                                      seen[sa2] = true
                                                      locals = stdListPushBack(locals, sa2)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              route {
                                    (opcode == "CALL" or opcode == "GET_INDEX" or opcode == "SET_INDEX") and a2 != "" ==> {
                                          mut as list of data: cargs = watSplitArgs(a2)
                                          mut as int64: nca = stdCollectionLength(cargs)
                                          mut as int64: cai = 1
                                          infinite {
                                                route {
                                                      cai > nca ==> { break }
                                                      _ ==> {
                                                            mut as string: ca = "" + cargs[cai]
                                                            mut as string: sca = watSanitizeIdent(ca)
                                                            route {
                                                                  not stdMapContainsKey(seen, sca) ==> {
                                                                        seen[sca] = true
                                                                        locals = stdListPushBack(locals, sca)
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            cai = cai + 1
                                                      }
                                                }
                                          }
                                    }
                                    _ ==> {}
                              }
                              i = i + 1
                        }
                  }
            }
            emit(nice, locals, "ok")
      }

      op watCollectStrings (as map: fmir_module, as list of data: uf_syms, as map: uf_by_sym) as map ==> {
            mut as list of data: str_list = []
            mut as map: offsets = map{}
            mut as map: lens = map{}
            mut as map: fats = map{}
            mut as map: esc = map{}
            mut as int64: cur_offset = 1024

            mut as list of data: base_strs = ["", "nice", "fail", "ok"]
            mut as int64: nb = stdCollectionLength(base_strs)
            mut as int64: bi = 1
            infinite {
                  route {
                        bi > nb ==> { break }
                        _ ==> {
                              mut as string: bs = "" + base_strs[bi]
                              route {
                                    not stdMapContainsKey(offsets, bs) ==> {
                                          mut as int64: blen = watStringByteLen(bs)
                                          mut as int64: off = cur_offset
                                          offsets[bs] = off
                                          lens[bs] = blen
                                          fats[bs] = (off << 32) | blen
                                          esc[bs] = watEscapeString(bs)
                                          str_list = stdListPushBack(str_list, bs)
                                          cur_offset = cur_offset + blen + 1
                                    }
                                    _ ==> {}
                              }
                              bi = bi + 1
                        }
                  }
            }

            mut as int64: n_ufs = stdCollectionLength(uf_syms)
            mut as int64: ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: uins = fdesc["instructions"]
                              mut as int64: nu = stdCollectionLength(uins)
                              mut as int64: ui = 1
                              infinite {
                                    route {
                                          ui > nu ==> { break }
                                          _ ==> {
                                                mut as map: uinst = uins[ui]
                                                mut as string: uop = "" + uinst["op"]
                                                mut as string: ua1 = "" + uinst["arg1"]
                                                route {
                                                      (uop == "CONST_STR" or uop == "CONST_COMPLEX") and not stdMapContainsKey(offsets, ua1) ==> {
                                                            mut as int64: blen = watStringByteLen(ua1)
                                                            mut as int64: off = cur_offset
                                                            offsets[ua1] = off
                                                            lens[ua1] = blen
                                                            fats[ua1] = (off << 32) | blen
                                                            esc[ua1] = watEscapeString(ua1)
                                                            str_list = stdListPushBack(str_list, ua1)
                                                            cur_offset = cur_offset + blen + 1
                                                      }
                                                      _ ==> {}
                                                }
                                                ui = ui + 1
                                          }
                                    }
                              }
                              ufi = ufi + 1
                        }
                  }
            }

            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: n = stdCollectionLength(instrs)
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              route {
                                    (opcode == "CONST_STR" or opcode == "CONST_COMPLEX") and not stdMapContainsKey(offsets, a1) ==> {
                                          mut as int64: blen = watStringByteLen(a1)
                                          mut as int64: off = cur_offset
                                          offsets[a1] = off
                                          lens[a1] = blen
                                          fats[a1] = (off << 32) | blen
                                          esc[a1] = watEscapeString(a1)
                                          str_list = stdListPushBack(str_list, a1)
                                          cur_offset = cur_offset + blen + 1
                                    }
                                    _ ==> {}
                              }
                              i = i + 1
                        }
                  }
            }

            mut as int64: heap_base = ((cur_offset + 15) /i 8) * 8
            route {
                  heap_base < 4096 ==> { heap_base = 4096 }
                  _ ==> {}
            }

            mut as map: info = map{}
            info["list"] = str_list
            info["offsets"] = offsets
            info["lens"] = lens
            info["fats"] = fats
            info["esc"] = esc
            info["heap_base"] = heap_base
            emit(nice, info, "ok")
      }

      op watEmitRuntimeHelpers () as string ==> {
            mut as string: nl = "\n"
            mut as list of data: w_parts = []
            w_parts = stdListPushBack(w_parts, "  (func $flux_print_bytes (param $ptr i32) (param $len i32)" + nl +
                  "    i32.const 0" + nl +
                  "    local.get $ptr" + nl +
                  "    i32.store" + nl +
                  "    i32.const 4" + nl +
                  "    local.get $len" + nl +
                  "    i32.store" + nl +
                  "    i32.const 1" + nl +
                  "    i32.const 0" + nl +
                  "    i32.const 1" + nl +
                  "    i32.const 16" + nl +
                  "    call $fd_write" + nl +
                  "    drop" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_print_newline" + nl +
                  "    i32.const 24" + nl +
                  "    i32.const 10" + nl +
                  "    i32.store8" + nl +
                  "    i32.const 24" + nl +
                  "    i32.const 1" + nl +
                  "    call $flux_print_bytes" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_print_str (param $fat i64)" + nl +
                  "    (local $ptr i32)" + nl +
                  "    (local $len i32)" + nl +
                  "    local.get $fat" + nl +
                  "    i64.const 32" + nl +
                  "    i64.shr_u" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $ptr" + nl +
                  "    local.get $fat" + nl +
                  "    i64.const 4294967295" + nl +
                  "    i64.and" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $len" + nl +
                  "    local.get $ptr" + nl +
                  "    local.get $len" + nl +
                  "    call $flux_print_bytes" + nl +
                  "    call $flux_print_newline" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_print_bool (param $val i64)" + nl +
                  "    local.get $val" + nl +
                  "    i64.const 0" + nl +
                  "    i64.ne" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        i32.const 32" + nl +
                  "        i32.const 4" + nl +
                  "        call $flux_print_bytes" + nl +
                  "      )" + nl +
                  "      (else" + nl +
                  "        i32.const 40" + nl +
                  "        i32.const 5" + nl +
                  "        call $flux_print_bytes" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    call $flux_print_newline" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_print_i64 (param $val i64)" + nl +
                  "    (local $v i64)" + nl +
                  "    (local $neg i32)" + nl +
                  "    (local $pos i32)" + nl +
                  "    (local $digit i32)" + nl +
                  "    i32.const 319" + nl +
                  "    local.set $pos" + nl +
                  "    local.get $val" + nl +
                  "    i64.eqz" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        local.get $pos" + nl +
                  "        i32.const 48" + nl +
                  "        i32.store8" + nl +
                  "        local.get $pos" + nl +
                  "        i32.const 1" + nl +
                  "        call $flux_print_bytes" + nl +
                  "        call $flux_print_newline" + nl +
                  "        return" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $val" + nl +
                  "    i64.const 0" + nl +
                  "    i64.lt_s" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        i32.const 1" + nl +
                  "        local.set $neg" + nl +
                  "        i64.const 0" + nl +
                  "        local.get $val" + nl +
                  "        i64.sub" + nl +
                  "        local.set $v" + nl +
                  "      )" + nl +
                  "      (else" + nl +
                  "        local.get $val" + nl +
                  "        local.set $v" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    (block $fmt_done" + nl +
                  "      (loop $fmt_loop" + nl +
                  "        local.get $v" + nl +
                  "        i64.eqz" + nl +
                  "        br_if $fmt_done" + nl +
                  "        local.get $v" + nl +
                  "        i64.const 10" + nl +
                  "        i64.rem_u" + nl +
                  "        i32.wrap_i64" + nl +
                  "        i32.const 48" + nl +
                  "        i32.add" + nl +
                  "        local.set $digit" + nl +
                  "        local.get $pos" + nl +
                  "        local.get $digit" + nl +
                  "        i32.store8" + nl +
                  "        local.get $pos" + nl +
                  "        i32.const 1" + nl +
                  "        i32.sub" + nl +
                  "        local.set $pos" + nl +
                  "        local.get $v" + nl +
                  "        i64.const 10" + nl +
                  "        i64.div_u" + nl +
                  "        local.set $v" + nl +
                  "        br $fmt_loop" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $neg" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        local.get $pos" + nl +
                  "        i32.const 45" + nl +
                  "        i32.store8" + nl +
                  "        local.get $pos" + nl +
                  "        i32.const 1" + nl +
                  "        i32.sub" + nl +
                  "        local.set $pos" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $pos" + nl +
                  "    i32.const 1" + nl +
                  "    i32.add" + nl +
                  "    i32.const 319" + nl +
                  "    local.get $pos" + nl +
                  "    i32.sub" + nl +
                  "    call $flux_print_bytes" + nl +
                  "    call $flux_print_newline" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_alloc (param $size i32) (result i32)" + nl +
                  "    (local $ptr i32)" + nl +
                  "    (local $end i32)" + nl +
                  "    (local $cur_bytes i32)" + nl +
                  "    local.get $size" + nl +
                  "    i32.const 0" + nl +
                  "    i32.le_s" + nl +
                  "    (if (then i32.const 8 local.set $size))" + nl +
                  "    local.get $size" + nl +
                  "    i32.const 7" + nl +
                  "    i32.add" + nl +
                  "    i32.const -8" + nl +
                  "    i32.and" + nl +
                  "    local.set $size" + nl +
                  "    global.get $flux_heap_ptr" + nl +
                  "    local.set $ptr" + nl +
                  "    local.get $ptr" + nl +
                  "    local.get $size" + nl +
                  "    i32.add" + nl +
                  "    local.set $end" + nl +
                  "    memory.size" + nl +
                  "    i32.const 16" + nl +
                  "    i32.shl" + nl +
                  "    local.set $cur_bytes" + nl +
                  "    local.get $end" + nl +
                  "    local.get $cur_bytes" + nl +
                  "    i32.gt_u" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        local.get $end" + nl +
                  "        local.get $cur_bytes" + nl +
                  "        i32.sub" + nl +
                  "        i32.const 65535" + nl +
                  "        i32.add" + nl +
                  "        i32.const 16" + nl +
                  "        i32.shr_u" + nl +
                  "        memory.grow" + nl +
                  "        drop" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $end" + nl +
                  "    global.set $flux_heap_ptr" + nl +
                  "    local.get $ptr" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_new (result i64)" + nl +
                  "    (local $hdr i32)" + nl +
                  "    (local $data i32)" + nl +
                  "    i32.const 16" + nl +
                  "    call $flux_alloc" + nl +
                  "    local.set $hdr" + nl +
                  "    i32.const 64" + nl +
                  "    call $flux_alloc" + nl +
                  "    local.set $data" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.const 0" + nl +
                  "    i32.store offset=0" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.const 8" + nl +
                  "    i32.store offset=4" + nl +
                  "    local.get $hdr" + nl +
                  "    local.get $data" + nl +
                  "    i32.store offset=8" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.const 1179407188" + nl +
                  "    i32.store offset=12" + nl +
                  "    local.get $hdr" + nl +
                  "    i64.extend_i32_u" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_push (param $h i64) (param $val i64)" + nl +
                  "    (local $hdr i32)" + nl +
                  "    (local $len i32)" + nl +
                  "    (local $cap i32)" + nl +
                  "    (local $data i32)" + nl +
                  "    (local $new_data i32)" + nl +
                  "    (local $i i32)" + nl +
                  "    local.get $h" + nl +
                  "    i64.const 0" + nl +
                  "    i64.le_s" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $h" + nl +
                  "    global.get $flux_heap_ptr" + nl +
                  "    i32.const 16" + nl +
                  "    i32.sub" + nl +
                  "    i64.extend_i32_u" + nl +
                  "    i64.gt_u" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $h" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $hdr" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=12" + nl +
                  "    i32.const 1179407188" + nl +
                  "    i32.ne" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=0" + nl +
                  "    local.set $len" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=4" + nl +
                  "    local.set $cap" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=8" + nl +
                  "    local.set $data" + nl +
                  "    local.get $len" + nl +
                  "    local.get $cap" + nl +
                  "    i32.ge_s" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        local.get $cap" + nl +
                  "        i32.const 2" + nl +
                  "        i32.mul" + nl +
                  "        local.set $cap" + nl +
                  "        local.get $cap" + nl +
                  "        i32.const 8" + nl +
                  "        i32.lt_s" + nl +
                  "        (if (then i32.const 8 local.set $cap))" + nl +
                  "        local.get $cap" + nl +
                  "        i32.const 3" + nl +
                  "        i32.shl" + nl +
                  "        call $flux_alloc" + nl +
                  "        local.set $new_data" + nl +
                  "        i32.const 0" + nl +
                  "        local.set $i" + nl +
                  "        (block $cp_done" + nl +
                  "          (loop $cp_loop" + nl +
                  "            local.get $i" + nl +
                  "            local.get $len" + nl +
                  "            i32.ge_s" + nl +
                  "            br_if $cp_done" + nl +
                  "            local.get $new_data" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 3" + nl +
                  "            i32.shl" + nl +
                  "            i32.add" + nl +
                  "            local.get $data" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 3" + nl +
                  "            i32.shl" + nl +
                  "            i32.add" + nl +
                  "            i64.load" + nl +
                  "            i64.store" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 1" + nl +
                  "            i32.add" + nl +
                  "            local.set $i" + nl +
                  "            br $cp_loop" + nl +
                  "          )" + nl +
                  "        )" + nl +
                  "        local.get $hdr" + nl +
                  "        local.get $cap" + nl +
                  "        i32.store offset=4" + nl +
                  "        local.get $hdr" + nl +
                  "        local.get $new_data" + nl +
                  "        i32.store offset=8" + nl +
                  "        local.get $new_data" + nl +
                  "        local.set $data" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $data" + nl +
                  "    local.get $len" + nl +
                  "    i32.const 3" + nl +
                  "    i32.shl" + nl +
                  "    i32.add" + nl +
                  "    local.get $val" + nl +
                  "    i64.store" + nl +
                  "    local.get $hdr" + nl +
                  "    local.get $len" + nl +
                  "    i32.const 1" + nl +
                  "    i32.add" + nl +
                  "    i32.store offset=0" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_get (param $h i64) (param $idx i64) (result i64)" + nl +
                  "    (local $hdr i32)" + nl +
                  "    (local $len i32)" + nl +
                  "    local.get $h" + nl +
                  "    i64.const 0" + nl +
                  "    i64.le_s" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $h" + nl +
                  "    global.get $flux_heap_ptr" + nl +
                  "    i32.const 16" + nl +
                  "    i32.sub" + nl +
                  "    i64.extend_i32_u" + nl +
                  "    i64.gt_u" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $h" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $hdr" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=12" + nl +
                  "    i32.const 1179407188" + nl +
                  "    i32.ne" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=0" + nl +
                  "    local.set $len" + nl +
                  "    local.get $idx" + nl +
                  "    i64.const 1" + nl +
                  "    i64.lt_s" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $idx" + nl +
                  "    local.get $len" + nl +
                  "    i64.extend_i32_u" + nl +
                  "    i64.gt_s" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=8" + nl +
                  "    local.get $idx" + nl +
                  "    i32.wrap_i64" + nl +
                  "    i32.const 1" + nl +
                  "    i32.sub" + nl +
                  "    i32.const 3" + nl +
                  "    i32.shl" + nl +
                  "    i32.add" + nl +
                  "    i64.load" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_set (param $h i64) (param $idx i64) (param $val i64)" + nl +
                  "    (local $hdr i32)" + nl +
                  "    (local $len i32)" + nl +
                  "    (local $cap i32)" + nl +
                  "    (local $data i32)" + nl +
                  "    (local $new_data i32)" + nl +
                  "    (local $i i32)" + nl +
                  "    (local $idx32 i32)" + nl +
                  "    local.get $h" + nl +
                  "    i64.const 0" + nl +
                  "    i64.le_s" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $h" + nl +
                  "    global.get $flux_heap_ptr" + nl +
                  "    i32.const 16" + nl +
                  "    i32.sub" + nl +
                  "    i64.extend_i32_u" + nl +
                  "    i64.gt_u" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $h" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $hdr" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=12" + nl +
                  "    i32.const 1179407188" + nl +
                  "    i32.ne" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $idx" + nl +
                  "    i64.const 1" + nl +
                  "    i64.lt_s" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $idx" + nl +
                  "    i64.const 1048576" + nl +
                  "    i64.gt_s" + nl +
                  "    (if (then return))" + nl +
                  "    local.get $idx" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $idx32" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=0" + nl +
                  "    local.set $len" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=4" + nl +
                  "    local.set $cap" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=8" + nl +
                  "    local.set $data" + nl +
                  "    local.get $idx32" + nl +
                  "    local.get $cap" + nl +
                  "    i32.gt_s" + nl +
                  "    (if" + nl +
                  "      (then" + nl +
                  "        local.get $cap" + nl +
                  "        i32.const 2" + nl +
                  "        i32.mul" + nl +
                  "        local.set $cap" + nl +
                  "        local.get $cap" + nl +
                  "        local.get $idx32" + nl +
                  "        i32.lt_s" + nl +
                  "        (if (then local.get $idx32 local.set $cap))" + nl +
                  "        local.get $cap" + nl +
                  "        i32.const 3" + nl +
                  "        i32.shl" + nl +
                  "        call $flux_alloc" + nl +
                  "        local.set $new_data" + nl +
                  "        i32.const 0" + nl +
                  "        local.set $i" + nl +
                  "        (block $scp_done" + nl +
                  "          (loop $scp_loop" + nl +
                  "            local.get $i" + nl +
                  "            local.get $len" + nl +
                  "            i32.ge_s" + nl +
                  "            br_if $scp_done" + nl +
                  "            local.get $new_data" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 3" + nl +
                  "            i32.shl" + nl +
                  "            i32.add" + nl +
                  "            local.get $data" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 3" + nl +
                  "            i32.shl" + nl +
                  "            i32.add" + nl +
                  "            i64.load" + nl +
                  "            i64.store" + nl +
                  "            local.get $i" + nl +
                  "            i32.const 1" + nl +
                  "            i32.add" + nl +
                  "            local.set $i" + nl +
                  "            br $scp_loop" + nl +
                  "          )" + nl +
                  "        )" + nl +
                  "        local.get $hdr" + nl +
                  "        local.get $cap" + nl +
                  "        i32.store offset=4" + nl +
                  "        local.get $hdr" + nl +
                  "        local.get $new_data" + nl +
                  "        i32.store offset=8" + nl +
                  "        local.get $new_data" + nl +
                  "        local.set $data" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $data" + nl +
                  "    local.get $idx32" + nl +
                  "    i32.const 1" + nl +
                  "    i32.sub" + nl +
                  "    i32.const 3" + nl +
                  "    i32.shl" + nl +
                  "    i32.add" + nl +
                  "    local.get $val" + nl +
                  "    i64.store" + nl +
                  "    local.get $idx32" + nl +
                  "    local.get $len" + nl +
                  "    i32.gt_s" + nl +
                  "    (if (then local.get $hdr local.get $idx32 i32.store offset=0))" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_len (param $h i64) (result i64)" + nl +
                  "    (local $hdr i32)" + nl +
                  "    local.get $h" + nl +
                  "    i64.const 0" + nl +
                  "    i64.le_s" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $h" + nl +
                  "    global.get $flux_heap_ptr" + nl +
                  "    i32.const 16" + nl +
                  "    i32.sub" + nl +
                  "    i64.extend_i32_u" + nl +
                  "    i64.gt_u" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $h" + nl +
                  "    i32.wrap_i64" + nl +
                  "    local.set $hdr" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=12" + nl +
                  "    i32.const 1179407188" + nl +
                  "    i32.ne" + nl +
                  "    (if (then i64.const 0 return))" + nl +
                  "    local.get $hdr" + nl +
                  "    i32.load offset=0" + nl +
                  "    i64.extend_i32_u" + nl +
                  "  )" + nl)
            w_parts = stdListPushBack(w_parts, "  (func $flux_list_take (param $h i64) (param $cnt i64) (result i64)" + nl +
                  "    (local $res i64)" + nl +
                  "    (local $n i64)" + nl +
                  "    (local $lim i64)" + nl +
                  "    (local $i i64)" + nl +
                  "    call $flux_list_new" + nl +
                  "    local.set $res" + nl +
                  "    local.get $h" + nl +
                  "    call $flux_list_len" + nl +
                  "    local.set $n" + nl +
                  "    local.get $cnt" + nl +
                  "    local.get $n" + nl +
                  "    i64.lt_s" + nl +
                  "    (if (then local.get $cnt local.set $lim) (else local.get $n local.set $lim))" + nl +
                  "    i64.const 1" + nl +
                  "    local.set $i" + nl +
                  "    (block $tk_done" + nl +
                  "      (loop $tk_loop" + nl +
                  "        local.get $i" + nl +
                  "        local.get $lim" + nl +
                  "        i64.gt_s" + nl +
                  "        br_if $tk_done" + nl +
                  "        local.get $res" + nl +
                  "        local.get $h" + nl +
                  "        local.get $i" + nl +
                  "        call $flux_list_get" + nl +
                  "        call $flux_list_push" + nl +
                  "        local.get $i" + nl +
                  "        i64.const 1" + nl +
                  "        i64.add" + nl +
                  "        local.set $i" + nl +
                  "        br $tk_loop" + nl +
                  "      )" + nl +
                  "    )" + nl +
                  "    local.get $res" + nl +
                  "  )" + nl)
            emit(nice, watJoinRange(w_parts, 1, stdCollectionLength(w_parts)), "ok")
      }

      op watEmitFuncBody (as list of data: instrs, as list of data: fn_params, as map: str_info, as map: fn_table, as map: uf_by_sym, as bool: is_main) as string ==> {
            mut as string: nl = "\n"
            mut as list of data: w_parts = []
            mut as map: str_fats = str_info["fats"]
            mut as int64: pre_out_off = 0
            mut as int64: pre_out_len = 0
            route {
                  stdMapContainsKey(str_info, "pre_out_off") ==> { pre_out_off = str_info["pre_out_off"] }
                  _ ==> {}
            }
            route {
                  stdMapContainsKey(str_info, "pre_out_len") ==> { pre_out_len = str_info["pre_out_len"] }
                  _ ==> {}
            }

            #L 1. Declaracao de locais
            w_parts = stdListPushBack(w_parts, "    (local $flux_pc i32)" + nl)
            mut as list of data: locals = watCollectLocals(instrs, fn_params)
            mut as int64: n_locals = stdCollectionLength(locals)
            mut as int64: li = 1
            infinite {
                  route {
                        li > n_locals ==> { break }
                        _ ==> {
                              mut as string: lname = "" + locals[li]
                              w_parts = stdListPushBack(w_parts, "    (local $" + lname + " i64)" + nl)
                              li = li + 1
                        }
                  }
            }

            #L 2. Mapeia labels para indices de blocos (1..total_blocks)
            mut as int64: n = stdCollectionLength(instrs)
            mut as map: label_to_block = map{}
            mut as int64: total_blocks = 1
            mut as int64: bi = 1
            infinite {
                  route {
                        bi > n ==> { break }
                        _ ==> {
                              mut as map: binst = instrs[bi]
                              mut as string: bop = "" + binst["op"]
                              mut as string: ba1 = "" + binst["arg1"]
                              route {
                                    bop == "LABEL" and ba1 != "" ==> {
                                          total_blocks = total_blocks + 1
                                          label_to_block[ba1] = total_blocks
                                    }
                                    _ ==> {}
                              }
                              bi = bi + 1
                        }
                  }
            }

            #L 3. Inicializa $flux_pc e abre loop de despacho estruturado
            w_parts = stdListPushBack(w_parts, "    i32.const 1" + nl +
                  "    local.set $flux_pc" + nl +
                  "    (block $flux_exit" + nl +
                  "      (loop $flux_dispatch" + nl +
                  "        local.get $flux_pc" + nl +
                  "        i32.const 1" + nl +
                  "        i32.eq" + nl +
                  "        (if" + nl +
                  "          (then" + nl)

            #L Abre bloco 1
            mut as int64: cur_block = 1
            mut as bool: block_terminated = false

            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]
                              mut as string: sa1 = watSanitizeIdent(a1)
                              mut as string: sa2 = watSanitizeIdent(a2)
                              mut as string: sres = watSanitizeIdent(res)

                              route {
                                    opcode == "LABEL" and a1 != "" ==> {
                                          route {
                                                not block_terminated ==> {
                                                      mut as int64: next_b = cur_block + 1
                                                      w_parts = stdListPushBack(w_parts, "            i32.const " + next_b + nl + "            local.set $flux_pc" + nl + "            br $flux_dispatch" + nl)
                                                }
                                                _ ==> {}
                                          }
                                          cur_block = cur_block + 1
                                          block_terminated = false
                                          w_parts = stdListPushBack(w_parts, "          )" + nl +
                                                "        )" + nl +
                                                "        local.get $flux_pc" + nl +
                                                "        i32.const " + cur_block + nl +
                                                "        i32.eq" + nl +
                                                "        (if" + nl +
                                                "          (then" + nl)
                                    }
                                    block_terminated ==> {
                                          #L Ignora codigo morto ate o proximo LABEL
                                    }
                                    opcode == "CONST_INT" ==> {
                                          mut as int64: iv = watParseIntSafe(a1)
                                          w_parts = stdListPushBack(w_parts, "            i64.const " + iv + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          mut as int64: fv = watParseIntSafe(a1)
                                          w_parts = stdListPushBack(w_parts, "            i64.const " + fv + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "float"
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as int64: bv = 0
                                          route {
                                                a1 == "true" ==> { bv = 1 }
                                                _ ==> {}
                                          }
                                          w_parts = stdListPushBack(w_parts, "            i64.const " + bv + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "bool"
                                    }
                                    opcode == "CONST_STR" or opcode == "CONST_COMPLEX" ==> {
                                          mut as int64: fat = 0
                                          route {
                                                stdMapContainsKey(str_fats, a1) ==> { fat = str_fats[a1] }
                                                _ ==> {}
                                          }
                                          w_parts = stdListPushBack(w_parts, "            i64.const " + fat + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "string"
                                    }
                                    opcode == "LOAD" or opcode == "STORE" or opcode == "COPY_REG" ==> {
                                          route {
                                                a1 != "" and res != "" ==> {
                                                      w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            local.set $" + sres + nl)
                                                      route {
                                                            stdMapContainsKey(reg_types, sa1) ==> {
                                                                  reg_types[sres] = reg_types[sa1]
                                                                  var_types[sres] = reg_types[sa1]
                                                            }
                                                            stdMapContainsKey(var_types, sa1) ==> {
                                                                  reg_types[sres] = var_types[sa1]
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "BINOP_+" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            local.get $" + sa2 + nl + "            i64.add" + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "int"
                                    }
                                    opcode == "BINOP_-" ==> {
                                          w_parts = stdListPushBack(w_parts, "            local.get $" + sa1 + nl + "            local.get $" + sa2 + nl + "            i64.sub" + nl + "            local.set $" + sres + nl)
                                          reg_types[sres] = "int"
                                    }
