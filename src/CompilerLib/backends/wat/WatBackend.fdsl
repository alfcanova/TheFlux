                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not called_uf and res != "" ==> {
                                                      w_parts = stdListPushBack(w_parts, "            i64.const 0" + nl + "            local.set $" + sres + nl)
                                                      reg_types[sres] = "int"
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "EMIT" ==> {
                                          route {
                                                is_main ==> {
                                                      route {
                                                            pre_out_len > 0 ==> {
                                                                  w_parts = stdListPushBack(w_parts, "            i32.const " + pre_out_off + nl + "            i32.const " + pre_out_len + nl + "            call $flux_print_bytes" + nl)
                                                            }
                                                            _ ==> {}
                                                      }
