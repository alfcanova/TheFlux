                                          name == "stdDbKvOpen" ==> { emit(nice, "int|i64|flux_std_db_kv_open|pp", "ok") }
                                          name == "stdDbKvPut" ==> { emit(nice, "bool|i64|flux_std_db_kv_put|ipp", "ok") }
                                          name == "stdDbSanitizeIdentifier" ==> { emit(nice, "string|i8*|flux_std_db_sanitize_identifier|p", "ok") }
                                          name == "stdDbSqlBegin" ==> { emit(nice, "bool|i64|flux_std_db_sql_begin|i", "ok") }
                                          name == "stdDbSqlChanges" ==> { emit(nice, "int|i64|flux_std_db_sql_changes|i", "ok") }
                                          name == "stdDbSqlClose" ==> { emit(nice, "bool|i64|flux_std_db_sql_close|i", "ok") }
                                          name == "stdDbSqlCommit" ==> { emit(nice, "bool|i64|flux_std_db_sql_commit|i", "ok") }
