      op llvmCollectReachableFunctions (as map: fmir_module) as map ==> {
            mut as map: seen_syms = map{}
            mut as map: fn_table = map{}
            route {
                  stdMapContainsKey(fmir_module, "functions") ==> { fn_table = fmir_module["functions"] }
                  _ ==> {}
            }
            mut as list of data: work_ins = []
            mut as list of data: main_ins = []
            route {
                  stdMapContainsKey(fmir_module, "instructions") ==> { main_ins = fmir_module["instructions"] }
                  _ ==> {}
            }
            work_ins = stdListPushBack(work_ins, main_ins)

            mut as int64: wi = 1
            infinite {
                  route {
                        wi > stdCollectionLength(work_ins) ==> { break }
                        _ ==> {
                              mut as list of data: ins_list = work_ins[wi]
                              mut as int64: n_in = stdCollectionLength(ins_list)
                              mut as int64: ii = 1
                              infinite {
                                    route {
                                          ii > n_in ==> { break }
                                          _ ==> {
                                                mut as map: inst = ins_list[ii]
                                                mut as string: iop = "" + inst["op"]
                                                route {
                                                      iop == "CALL" ==> {
                                                            mut as string: callee = "" + inst["arg1"]
                                                            route {
                                                                  callee != "" and stdMapContainsKey(fn_table, callee) ==> {
                                                                        mut as map: cf = fn_table[callee]
                                                                        mut as string: cag = "" + cf["agent"]
                                                                        mut as string: csym = llvmMangleSymbol(cag, "" + cf["name"])
                                                                        route {
                                                                              not stdMapContainsKey(seen_syms, csym) ==> {
                                                                                    seen_syms[csym] = true
                                                                                    work_ins = stdListPushBack(work_ins, cf["instructions"])
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      _ ==> {}
                                                }
                                                ii = ii + 1
                                          }
                                    }
                              }
                              wi = wi + 1
                        }
                  }
            }
            emit(nice, seen_syms, "ok")
      }

      op llvmEscapeString (as string: s) as string ==> {
            mut as string: res = stdStringLlvmEscape(s)
            emit(nice, res, "ok")
      }

      op llvmStringByteLength (as string: s) as int64 ==> {
            mut as int64: blen = stdStringByteLength(s)
            emit(nice, blen + 1, "ok")
      }

      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf, as map: global_vars, as list of data: global_var_list) as string ==> {
            mut as string: nl = "\n"
            mut as list of string: ir_parts = []
            ir_parts = stdListPushBack(ir_parts, "fn_entry:" + nl)
            ir_parts = stdListPushBack(ir_parts, "  %_fmt_s1 = alloca [32 x i8], align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "  %_fmt_p1 = getelementptr inbounds [32 x i8], [32 x i8]* %_fmt_s1, i32 0, i32 0" + nl)
            ir_parts = stdListPushBack(ir_parts, "  %_fmt_s2 = alloca [32 x i8], align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "  %_fmt_p2 = getelementptr inbounds [32 x i8], [32 x i8]* %_fmt_s2, i32 0, i32 0" + nl)
            route {
                  is_main ==> {
                        ir_parts = stdListPushBack(ir_parts, "  call void @flux_runtime_init_args(i32 %_sys_argc, i8** %_sys_argv)" + nl)
                        route {
                              has_uf ==> {
                                    mut as int64: n_gvl = stdCollectionLength(global_var_list)
                                    mut as int64: gvli = 1
                                    infinite {
                                          route {
                                                gvli > n_gvl ==> { break }
                                                _ ==> {
                                                      mut as string: gvn = "" + global_var_list[gvli]
                                                      mut as string: g_sl_n = str_map["nice"]
                                                      mut as int64: g_ln_n = str_lens["nice"]
                                                      mut as string: g_sl_o = str_map["ok"]
                                                      mut as int64: g_ln_o = str_lens["ok"]
                                                      route { g_sl_n == "" or g_sl_n == "1" ==> { g_sl_n = "@.str.3"  g_ln_n = 5 } _ ==> {} }
                                                      route { g_sl_o == "" or g_sl_o == "1" ==> { g_sl_o = "@.str.4"  g_ln_o = 3 } _ ==> {} }
                                                      ir_parts = stdListPushBack(ir_parts, "  store i8* getelementptr inbounds ([" + g_ln_n + " x i8], [" + g_ln_n + " x i8]* " + g_sl_n + ", i32 0, i32 0), i8** @" + gvn + "__sta, align 8" + nl)
                                                      ir_parts = stdListPushBack(ir_parts, "  store i8* getelementptr inbounds ([" + g_ln_o + " x i8], [" + g_ln_o + " x i8]* " + g_sl_o + ", i32 0, i32 0), i8** @" + gvn + "__msg, align 8" + nl)
                                                      gvli = gvli + 1
                                                }
                                          }
                                    }
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            mut as int64: n = stdCollectionLength(instrs)
            mut as map: alloc_map = map{}
            mut as list of data: alloc_list = []
            mut as map: list_elem_types = map{}
            mut as map: list_inner_elem_types = map{}
            mut as map: decl_var_types = map{}
            mut as map: reg_slice_bounds = map{}
            mut as int64: spy_counter = 0
            mut as int64: n_fparams = stdCollectionLength(fn_params)
            mut as int64: fpi = 1
            infinite {
                  route {
                        fpi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: fp_name = "" + fn_params[fpi]
                              route {
                                    fp_name != "" and not stdMapContainsKey(alloc_map, fp_name) ==> {
                                          alloc_map[fp_name] = true
                                          alloc_list = stdListPushBack(alloc_list, fp_name)
                                    }
                                    _ ==> {}
                              }
                              fpi = fpi + 1
                        }
                  }
            }
            mut as int64: api = 1
            infinite {
                  route {
                        api > n ==> { break }
                        _ ==> {
                              mut as map: ainst = instrs[api]
                              mut as string: aop = "" + ainst["op"]
                              mut as string: ares = "" + ainst["res"]
                              mut as string: aarg1 = "" + ainst["arg1"]
                              route {
                                    aop == "ALLOC" and ares != "" ==> {
                                          route {
                                                not stdMapContainsKey(alloc_map, ares) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                          mut as string: aarg2 = "" + ainst["arg2"]
                                          mut as int64: aarg2_l = stdCollectionLength(aarg2)
                                          route {
                                                aarg2 != "" ==> {
                                                      decl_var_types[ares] = aarg2
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                (aarg2_l >= 6 and aarg2[1..6] == "tensor") or (aarg2_l >= 4 and aarg2[1..4] == "list") or (aarg2_l >= 3 and aarg2[1..3] == "set") ==> {
                                                      mut as int64: of_idx = 1
                                                      infinite {
                                                            route {
                                                                  of_idx + 5 > aarg2_l ==> { break }
                                                                  of_idx + 6 <= aarg2_l and aarg2[of_idx..(of_idx + 6)] == "of list" ==> {
                                                                        list_elem_types[ares] = "list"
                                                                        mut as int64: of_in_idx = of_idx + 7
                                                                        infinite {
                                                                              route {
                                                                                    of_in_idx + 5 > aarg2_l ==> { break }
                                                                                    of_in_idx + 6 <= aarg2_l and aarg2[of_in_idx..(of_in_idx + 6)] == "of list" ==> {
                                                                                          list_inner_elem_types[ares] = "list"
                                                                                          break
                                                                                    }
                                                                                    of_in_idx + 6 <= aarg2_l and aarg2[of_in_idx..(of_in_idx + 6)] == "of data" ==> {
                                                                                          list_inner_elem_types[ares] = "data"
                                                                                          break
                                                                                    }
                                                                                    of_in_idx + 8 <= aarg2_l and aarg2[of_in_idx..(of_in_idx + 8)] == "of string" ==> {
                                                                                          list_inner_elem_types[ares] = "string"
                                                                                          break
                                                                                    }
                                                                                    of_in_idx + 6 <= aarg2_l and aarg2[of_in_idx..(of_in_idx + 6)] == "of bool" ==> {
                                                                                          list_inner_elem_types[ares] = "bool"
                                                                                          break
                                                                                    }
                                                                                    aarg2[of_in_idx..(of_in_idx + 5)] == "of int" ==> {
                                                                                          list_inner_elem_types[ares] = "int"
                                                                                          break
                                                                                    }
                                                                                    of_in_idx + 7 <= aarg2_l and aarg2[of_in_idx..(of_in_idx + 7)] == "of float" ==> {
                                                                                          list_inner_elem_types[ares] = "float"
                                                                                          break
                                                                                    }
                                                                                    _ ==> { of_in_idx = of_in_idx + 1 }
                                                                              }
                                                                        }
                                                                        break
                                                                  }
                                                                  of_idx + 6 <= aarg2_l and aarg2[of_idx..(of_idx + 6)] == "of data" ==> {
                                                                        list_elem_types[ares] = "data"
                                                                        break
                                                                  }
                                                                  of_idx + 8 <= aarg2_l and aarg2[of_idx..(of_idx + 8)] == "of string" ==> {
                                                                        list_elem_types[ares] = "string"
                                                                        break
                                                                  }
                                                                  of_idx + 6 <= aarg2_l and aarg2[of_idx..(of_idx + 6)] == "of bool" ==> {
                                                                        list_elem_types[ares] = "bool"
                                                                        break
                                                                  }
                                                                  aarg2[of_idx..(of_idx + 5)] == "of int" ==> {
                                                                        list_elem_types[ares] = "int"
                                                                        break
                                                                  }
                                                                  of_idx + 7 <= aarg2_l and aarg2[of_idx..(of_idx + 7)] == "of float" ==> {
                                                                        list_elem_types[ares] = "float"
                                                                        break
                                                                  }
                                                                  _ ==> { of_idx = of_idx + 1 }
                                                            }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "STORE" and ares != "" and not stdMapContainsKey(alloc_map, ares) ==> {
                                          mut as int64: ares_l = stdCollectionLength(ares)
                                          route {
                                                ares_l > 0 and ares[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, ares)) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "LOAD" and aarg1 != "" and not stdMapContainsKey(alloc_map, aarg1) ==> {
                                          mut as int64: aarg1_l = stdCollectionLength(aarg1)
                                          route {
                                                aarg1_l > 0 and aarg1[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, aarg1)) ==> {
                                                      alloc_map[aarg1] = true
                                                      alloc_list = stdListPushBack(alloc_list, aarg1)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "COLL_GET" and ares != "" and not stdMapContainsKey(alloc_map, ares) ==> {
                                          mut as int64: ares_l = stdCollectionLength(ares)
                                          route {
                                                ares_l > 0 and ares[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, ares)) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              api = api + 1
                        }
                  }
            }

            #L Alocacoes de variaveis locais
            mut as int64: n_allocs = stdCollectionLength(alloc_list)
            mut as int64: ai = 1
            infinite {
                  route {
                        ai > n_allocs ==> { break }
                        _ ==> {
                              mut as string: vname = "" + alloc_list[ai]
                              route {
                                    is_main and stdMapContainsKey(global_vars, vname) ==> {}
                                    _ ==> {
                                          ir_parts = stdListPushBack(ir_parts, "  %_v_" + vname + " = alloca i64, align 8" + nl)
                                          route {
                                                has_uf ==> {
                                                      mut as string: sl_n = str_map["nice"]
                                                      mut as int64: ln_n = str_lens["nice"]
                                                      mut as string: sl_o = str_map["ok"]
                                                      mut as int64: ln_o = str_lens["ok"]
                                                      route { sl_n == "" or sl_n == "1" ==> { sl_n = "@.str.3"  ln_n = 5 } _ ==> {} }
                                                      route { sl_o == "" or sl_o == "1" ==> { sl_o = "@.str.4"  ln_o = 3 } _ ==> {} }
                                                      ir_parts = stdListPushBack(ir_parts, "  %_v_" + vname + "__sta = alloca i8*, align 8" + nl)
                                                      ir_parts = stdListPushBack(ir_parts, "  %_v_" + vname + "__msg = alloca i8*, align 8" + nl)
                                                      ir_parts = stdListPushBack(ir_parts, "  store i8* getelementptr inbounds ([" + ln_n + " x i8], [" + ln_n + " x i8]* " + sl_n + ", i32 0, i32 0), i8** %_v_" + vname + "__sta, align 8" + nl)
                                                      ir_parts = stdListPushBack(ir_parts, "  store i8* getelementptr inbounds ([" + ln_o + " x i8], [" + ln_o + " x i8]* " + sl_o + ", i32 0, i32 0), i8** %_v_" + vname + "__msg, align 8" + nl)
                                                }
                                                _ ==> {}
                                          }
                                    }
                              }
                              ai = ai + 1
                        }
                  }
            }

            #L 4. Segunda Passagem: Emissao de Instrucoes
            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as int64: n_gvl_seed = stdCollectionLength(global_var_list)
            mut as int64: gvsi = 1
            infinite {
                  route {
                        gvsi > n_gvl_seed ==> { break }
                        _ ==> {
                              mut as string: gvk = "" + global_var_list[gvsi]
                              mut as string: gvt = "" + global_vars[gvk]
                              route {
                                    gvt != "" and gvt != "true" and gvt != "1" ==> {
                                          var_types[gvk] = gvt
                                    }
                                    _ ==> {}
                              }
                              gvsi = gvsi + 1
                        }
                  }
            }
            mut as map: reg_str_vals = map{}
            mut as map: reg_sta_regs = map{}
            mut as map: reg_msg_regs = map{}
            mut as map: reg_src_var = map{}
            mut as int64: n_fptypes = stdCollectionLength(fn_ptypes)
            mut as int64: spi = 1
            infinite {
                  route {
                        spi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: sp_name = "" + fn_params[spi]
                              mut as string: sp_type = "int"
                              route {
                                    spi <= n_fptypes ==> {
                                          mut as string: decl_spt = "" + fn_ptypes[spi]
                                          mut as int64: dspt_len = stdCollectionLength(decl_spt)
                                          route {
                                                dspt_len >= 4 and decl_spt[1..4] == "list" ==> {
                                                      sp_type = "list"
                                                      route {
                                                            dspt_len >= 12 and decl_spt[6..12] == "of list" ==> {
                                                                  list_elem_types[sp_name] = "list"
                                                                  mut as int64: sp_in_idx = 13
                                                                  infinite {
                                                                        route {
                                                                              sp_in_idx + 5 > dspt_len ==> { break }
                                                                              sp_in_idx + 6 <= dspt_len and decl_spt[sp_in_idx..(sp_in_idx + 6)] == "of list" ==> {
                                                                                    list_inner_elem_types[sp_name] = "list"
                                                                                    break
                                                                              }
                                                                              sp_in_idx + 6 <= dspt_len and decl_spt[sp_in_idx..(sp_in_idx + 6)] == "of data" ==> {
                                                                                    list_inner_elem_types[sp_name] = "data"
                                                                                    break
                                                                              }
                                                                              sp_in_idx + 8 <= dspt_len and decl_spt[sp_in_idx..(sp_in_idx + 8)] == "of string" ==> {
                                                                                    list_inner_elem_types[sp_name] = "string"
                                                                                    break
                                                                              }
                                                                              sp_in_idx + 6 <= dspt_len and decl_spt[sp_in_idx..(sp_in_idx + 6)] == "of bool" ==> {
                                                                                    list_inner_elem_types[sp_name] = "bool"
                                                                                    break
                                                                              }
                                                                              decl_spt[sp_in_idx..(sp_in_idx + 5)] == "of int" ==> {
                                                                                    list_inner_elem_types[sp_name] = "int"
                                                                                    break
                                                                              }
                                                                              sp_in_idx + 7 <= dspt_len and decl_spt[sp_in_idx..(sp_in_idx + 7)] == "of float" ==> {
                                                                                    list_inner_elem_types[sp_name] = "float"
                                                                                    break
                                                                              }
                                                                              _ ==> { sp_in_idx = sp_in_idx + 1 }
                                                                        }
                                                                  }
                                                            }
                                                            dspt_len >= 12 and decl_spt[6..12] == "of bool" ==> { list_elem_types[sp_name] = "bool" }
                                                            dspt_len >= 11 and decl_spt[6..11] == "of int" ==> { list_elem_types[sp_name] = "int" }
                                                            dspt_len >= 14 and decl_spt[6..14] == "of string" ==> { list_elem_types[sp_name] = "string" }
                                                            dspt_len >= 12 and decl_spt[6..12] == "of data" ==> { list_elem_types[sp_name] = "data" }
                                                            dspt_len >= 13 and decl_spt[6..13] == "of float" ==> { list_elem_types[sp_name] = "float" }
                                                            _ ==> { list_elem_types[sp_name] = "data" }
                                                      }
                                                }
                                                dspt_len >= 3 and decl_spt[1..3] == "set" ==> {
                                                      sp_type = "set"
                                                      route {
                                                            dspt_len >= 11 and decl_spt[5..11] == "of bool" ==> { list_elem_types[sp_name] = "bool" }
                                                            dspt_len >= 10 and decl_spt[5..10] == "of int" ==> { list_elem_types[sp_name] = "int" }
                                                            dspt_len >= 13 and decl_spt[5..13] == "of string" ==> { list_elem_types[sp_name] = "string" }
                                                            dspt_len >= 11 and decl_spt[5..11] == "of data" ==> { list_elem_types[sp_name] = "data" }
                                                            dspt_len >= 12 and decl_spt[5..12] == "of float" ==> { list_elem_types[sp_name] = "float" }
                                                            _ ==> { list_elem_types[sp_name] = "data" }
                                                      }
                                                }
                                                decl_spt == "float64" or decl_spt == "float32" or decl_spt == "float" or decl_spt == "float16" or decl_spt == "fp8_e4m3" or decl_spt == "fp8_e5m2" or decl_spt == "bf16_e8m7" or decl_spt == "tf32_e8m10" ==> { sp_type = "float" }
                                                decl_spt == "int64" or decl_spt == "int32" or decl_spt == "int" or decl_spt == "byte" or decl_spt == "nat" or decl_spt == "datetime" or decl_spt == "DateTime" or decl_spt == "date" or decl_spt == "Date" or decl_spt == "time" or decl_spt == "Time" or decl_spt == "timestamp" or decl_spt == "Timestamp" or decl_spt == "uint64" or decl_spt == "uint32" or decl_spt == "int16" or decl_spt == "uint16" or decl_spt == "int8" or decl_spt == "uint8" ==> { sp_type = "int" }
                                                decl_spt == "complex" or decl_spt == "complex32" or decl_spt == "complex64" or decl_spt == "complex128" ==> { sp_type = "complex" }
                                                decl_spt == "data" ==> { sp_type = "data" }
                                                decl_spt != "" and decl_spt != "data" ==> { sp_type = decl_spt }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              var_types[sp_name] = sp_type
                              ir_parts = stdListPushBack(ir_parts, "  store i64 %in_" + spi + ", i64* %_v_" + sp_name + ", align 8" + nl)
                              spi = spi + 1
                        }
                  }
            }
            mut as int64: n_alloc_seed = stdCollectionLength(alloc_list)
            mut as int64: asi = 1
            infinite {
                  route {
                        asi > n_alloc_seed ==> { break }
                        _ ==> {
                              mut as string: aname = "" + alloc_list[asi]
                              route {
                                    stdMapContainsKey(decl_var_types, aname) ==> {
                                          mut as string: adt = "" + decl_var_types[aname]
                                          mut as int64: adt_len = stdCollectionLength(adt)
                                          route {
                                                adt_len >= 4 and adt[1..4] == "list" ==> { var_types[aname] = "list" }
                                                adt_len >= 3 and adt[1..3] == "map" ==> { var_types[aname] = "map" }
                                                adt_len >= 3 and adt[1..3] == "set" ==> { var_types[aname] = "set" }
                                                adt == "string" ==> { var_types[aname] = "string" }
                                                adt == "float" or adt == "float64" ==> { var_types[aname] = "float" }
                                                adt == "bool" ==> { var_types[aname] = "bool" }
                                                adt == "int" or adt == "int64" ==> { var_types[aname] = "int" }
                                                adt == "complex" ==> { var_types[aname] = "complex" }
                                                adt == "data" ==> { var_types[aname] = "data" }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              asi = asi + 1
                        }
                  }
            }
            mut as int64: ft_count = 0
            mut as int64: cv_count = 0
            mut as int64: lp_count = 0
            mut as int64: ms_count = 0
            mut as int64: gf_count = 0
            mut as int64: st_count = 0
            mut as int64: pr_count = 0
            mut as int64: em_count = 0
            mut as int64: cg_count = 0
            mut as bool: block_terminated = false

            #L Pre-pass O(N) de definicoes e usos para achatar cadeias de concatenacao de strings
            mut as map: reg_def_cnt = map{}
            mut as map: reg_use_cnt = map{}
            mut as map: deferred_concat = map{}
            mut as int64: ui = 1
            infinite {
                  route {
                        ui > n ==> { break }
                        _ ==> {
                              mut as map: uinst = instrs[ui]
                              mut as string: uop = "" + uinst["op"]
                              mut as string: ua1 = "" + uinst["arg1"]
                              mut as string: ua2 = "" + uinst["arg2"]
                              mut as string: ures = "" + uinst["res"]

                              route {
                                    ures != "" and uop != "LABEL" and uop != "JUMP" and uop != "JUMP_IF_FALSE" and uop != "JUMP_IF_TRUE" and uop != "SHORT_CIRCUIT_BRANCH" and uop != "STORE" and uop != "SET_FIELD" and uop != "STRUCT_SET_FIELD" and uop != "SET_INDEX" and uop != "MAP_SET" and uop != "PRINT" and uop != "EMIT" ==> {
                                          mut as int64: cur_dc = 0
                                          route { stdMapContainsKey(reg_def_cnt, ures) ==> { cur_dc = reg_def_cnt[ures] } _ ==> {} }
                                          reg_def_cnt[ures] = cur_dc + 1
                                    }
                                    _ ==> {}
                              }

                              mut as list of data: scan_inputs = []
                              route { ua1 != "" ==> { scan_inputs = stdListPushBack(scan_inputs, ua1) } _ ==> {} }
                              route { ua2 != "" ==> { scan_inputs = stdListPushBack(scan_inputs, ua2) } _ ==> {} }
                              route {
                                    ures != "" and (uop == "STORE" or uop == "SET_FIELD" or uop == "STRUCT_SET_FIELD" or uop == "SET_INDEX" or uop == "MAP_SET" or uop == "SHORT_CIRCUIT_BRANCH" or uop == "PRINT") ==> {
                                          scan_inputs = stdListPushBack(scan_inputs, ures)
                                    }
                                    _ ==> {}
                              }
                              mut as int64: nsi = stdCollectionLength(scan_inputs)
                              mut as int64: sii = 1
                              infinite {
                                    route {
                                          sii > nsi ==> { break }
                                          _ ==> {
                                                mut as string: s_in = "" + scan_inputs[sii]
                                                mut as int64: sl_in = stdCollectionLength(s_in)
                                                mut as int64: p_in = 1
                                                infinite {
                                                      route {
                                                            p_in > sl_in ==> { break }
                                                            _ ==> {
                                                                  route {
                                                                        s_in[p_in] == "%" ==> {
                                                                              mut as int64: p_end = p_in + 1
                                                                              infinite {
                                                                                    route {
                                                                                          p_end > sl_in or s_in[p_end] == "," or s_in[p_end] == " " ==> { break }
                                                                                          _ ==> { p_end = p_end + 1 }
                                                                                    }
                                                                              }
                                                                              mut as string: utok = s_in[p_in..(p_end - 1)]
                                                                              mut as int64: cur_uc = 0
                                                                              route { stdMapContainsKey(reg_use_cnt, utok) ==> { cur_uc = reg_use_cnt[utok] } _ ==> {} }
                                                                              reg_use_cnt[utok] = cur_uc + 1
                                                                              p_in = p_end
                                                                        }
                                                                        _ ==> { p_in = p_in + 1 }
                                                                  }
                                                            }
                                                      }
                                                }
                                                sii = sii + 1
                                          }
                                    }
                              }
                              ui = ui + 1
                        }
                  }
            }

            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              #L Remove prefixo % de forma 100% segura sem slicing invalido
                              mut as string: cr = res
                              mut as int64: cr_len = stdCollectionLength(cr)
                              route {
