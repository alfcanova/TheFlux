                                                a1 == "stdDateTimeAddMilliseconds" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_add_milliseconds(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeAddMicroseconds" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_add_microseconds(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeAddNanoseconds" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_add_nanoseconds(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeAddMonths" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_add_months(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeAddYears" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_add_years(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeIsBefore" ==> {
                                                      ir = ir + "  %" + cr + "_c64 = call i64 @flux_std_datetime_is_before(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      ir = ir + "  " + res + " = icmp ne i64 %" + cr + "_c64, 0" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                a1 == "stdDateTimeIsAfter" ==> {
                                                      ir = ir + "  %" + cr + "_c64 = call i64 @flux_std_datetime_is_after(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      ir = ir + "  " + res + " = icmp ne i64 %" + cr + "_c64, 0" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                a1 == "stdDateTimeCompare" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_compare(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeDaysBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_days_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeMonthsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_months_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeYearsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_years_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeHoursBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_hours_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeMinutesBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_minutes_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeSecondsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_seconds_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeMillisecondsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_milliseconds_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeMicrosecondsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_microseconds_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeNanosecondsBetween" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_nanoseconds_between(i64 " + call_arg1 + ", i64 " + call_arg2 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeToTimeZone" ==> {
                                                      ir = ir + "  " + res + " = call i8* @flux_std_datetime_to_timezone(i64 " + call_arg1 + ", i8* " + call_arg2 + ")" + nl
                                                      reg_types[res] = "string"
                                                }
                                                a1 == "stdDateTimeToLocal" ==> {
                                                      ir = ir + "  " + res + " = call i8* @flux_std_datetime_to_local(i64 " + call_arg1 + ")" + nl
                                                      reg_types[res] = "string"
                                                }
                                                a1 == "stdDateTimeToUtc" ==> {
                                                      ir = ir + "  " + res + " = call i64 @flux_std_datetime_to_utc(i64 " + call_arg1 + ")" + nl
                                                      reg_types[res] = "int"
                                                }
                                                a1 == "stdDateTimeUtcOffset" ==> {
                                                      ir = ir + "  " + res + " = call double @flux_std_datetime_utc_offset(i64 " + call_arg1 + ", i8* " + call_arg2 + ")" + nl
                                                      reg_types[res] = "float"
                                                }
                                                a1 == "stdDateTimeLocalTimeZone" ==> {
                                                      ir = ir + "  " + res + " = call i8* @flux_std_datetime_local_timezone()" + nl
                                                      reg_types[res] = "string"
                                                }
                                                a1 == "stdDateTimeIsDaylightSavingTime" ==> {
                                                      ir = ir + "  %" + cr + "_c64 = call i64 @flux_std_datetime_is_daylight_saving_time(i64 " + call_arg1 + ", i8* " + call_arg2 + ")" + nl
                                                      ir = ir + "  " + res + " = icmp ne i64 %" + cr + "_c64, 0" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                a1 == "stdDateTimeDstOffset" ==> {
                                                      ir = ir + "  " + res + " = call double @flux_std_datetime_dst_offset(i64 " + call_arg1 + ", i8* " + call_arg2 + ")" + nl
                                                      reg_types[res] = "float"
                                                }
                                                stdMapContainsKey(fn_table, a1) ==> {
                                                      mut as map: cand_fn = fn_table[a1]
                                                      mut as string: cand_ag = "" + cand_fn["agent"]
                                                      route {
                                                            cand_ag != "CompilerLib" ==> {
                                                                  mut as string: uf_sym = llvmMangleSymbol(cand_ag, "" + cand_fn["name"])
                                                                  mut as list of data: callee_ps = cand_fn["params"]
                                                                  mut as int64: n_cps = stdCollectionLength(callee_ps)
                                                                  mut as string: arg_sig = ""
                                                                  mut as int64: cpi = 1
                                                                  infinite {
                                                                        route {
                                                                              cpi > n_cps ==> { break }
                                                                              _ ==> {
                                                                                    mut as string: raw_ca = ""
                                                                                    route { cpi <= ncargs ==> { raw_ca = "" + cargs[cpi] } _ ==> {} }
                                                                                    infinite {
                                                                                          route {
                                                                                                stdCollectionLength(raw_ca) > 0 and raw_ca[1] == " " ==> {
                                                                                                      raw_ca = raw_ca[2..stdCollectionLength(raw_ca)]
                                                                                                }
                                                                                                _ ==> { break }
                                                                                          }
                                                                                    }
                                                                                    mut as string: ca_i64 = "0"
                                                                                    route {
                                                                                          raw_ca != "" ==> {
                                                                                                mut as string: ca_ty = "int"
                                                                                                route { stdMapContainsKey(reg_types, raw_ca) ==> { ca_ty = reg_types[raw_ca] } _ ==> {} }
                                                                                                route {
                                                                                                      ca_ty == "string" or ca_ty == "list" or ca_ty == "map" or ca_ty == "struct" or ca_ty == "set" or ca_ty == "complex" or ca_ty == "data" ==> {
                                                                                                            cv_count = cv_count + 1
                                                                                                            ir = ir + "  %uf_ca_" + cv_count + " = ptrtoint i8* " + raw_ca + " to i64" + nl
                                                                                                            ca_i64 = "%uf_ca_" + cv_count
                                                                                                      }
                                                                                                      ca_ty == "float" ==> {
                                                                                                            cv_count = cv_count + 1
                                                                                                            ir = ir + "  %uf_ca_" + cv_count + " = bitcast double " + raw_ca + " to i64" + nl
                                                                                                            ca_i64 = "%uf_ca_" + cv_count
                                                                                                      }
                                                                                                      ca_ty == "bool" ==> {
                                                                                                            cv_count = cv_count + 1
                                                                                                            ir = ir + "  %uf_ca_" + cv_count + " = zext i1 " + raw_ca + " to i64" + nl
                                                                                                            ca_i64 = "%uf_ca_" + cv_count
                                                                                                      }
                                                                                                      _ ==> {
                                                                                                            ca_i64 = raw_ca
                                                                                                      }
                                                                                                }
                                                                                          }
                                                                                          _ ==> {}
                                                                                    }
                                                                                    route {
                                                                                          arg_sig == "" ==> { arg_sig = "i64 " + ca_i64 }
                                                                                          _ ==> { arg_sig = arg_sig + ", i64 " + ca_i64 }
                                                                                    }
                                                                                    cpi = cpi + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  ir = ir + "  %" + cr + "_ufr = call %flux.result @" + uf_sym + "(" + arg_sig + ")" + nl
                                                                  ir = ir + "  %" + cr + "_usta = extractvalue %flux.result %" + cr + "_ufr, 0" + nl
                                                                  ir = ir + "  %" + cr + "_uvi = extractvalue %flux.result %" + cr + "_ufr, 1" + nl
                                                                  ir = ir + "  %" + cr + "_uvf = extractvalue %flux.result %" + cr + "_ufr, 2" + nl
                                                                  ir = ir + "  %" + cr + "_umsg = extractvalue %flux.result %" + cr + "_ufr, 3" + nl
                                                                  mut as string: crt = "int"
                                                                  route {
                                                                        stdMapContainsKey(cand_fn, "ret_type") ==> {
                                                                              mut as string: drt = "" + cand_fn["ret_type"]
                                                                              mut as int64: drt_len = stdCollectionLength(drt)
                                                                              route {
                                                                                    drt_len >= 4 and drt[1..4] == "list" ==> { crt = "list" }
                                                                                    drt_len >= 3 and drt[1..3] == "set" ==> { crt = "set" }
                                                                                    drt == "float64" or drt == "float32" or drt == "float" or drt == "float16" ==> { crt = "float" }
                                                                                    drt == "int64" or drt == "int32" or drt == "int" or drt == "datetime" ==> { crt = "int" }
                                                                                    drt == "complex" or drt == "complex32" or drt == "complex64" or drt == "complex128" ==> { crt = "complex" }
                                                                                    drt == "data" ==> { crt = "data" }
                                                                                    drt != "" ==> { crt = drt }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  route {
                                                                        crt == "float" ==> {
                                                                              ir = ir + "  " + res + " = fadd double 0.0, %" + cr + "_uvf" + nl
                                                                              reg_types[res] = "float"
                                                                        }
                                                                        crt == "bool" ==> {
                                                                              ir = ir + "  " + res + " = trunc i64 %" + cr + "_uvi to i1" + nl
                                                                              reg_types[res] = "bool"
                                                                        }
                                                                        crt == "int" ==> {
                                                                              ir = ir + "  " + res + " = add i64 0, %" + cr + "_uvi" + nl
                                                                              reg_types[res] = "int"
                                                                        }
                                                                        _ ==> {
                                                                              ir = ir + "  " + res + " = inttoptr i64 %" + cr + "_uvi to i8*" + nl
                                                                              reg_types[res] = crt
                                                                        }
                                                                  }
                                                                  reg_sta_regs[res] = "%" + cr + "_usta"
                                                                  reg_msg_regs[res] = "%" + cr + "_umsg"
                                                            }
                                                            _ ==> {
                                                                  ir = ir + "  " + res + " = add i64 0, 0" + nl
                                                                  reg_types[res] = "int"
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = add i64 0, 0" + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "EMIT" ==> {
                                          em_count = em_count + 1
                                          route {
                                                not block_terminated ==> {
                                                      route {
                                                            is_main ==> {
                                                                  ir = ir + "  ret i32 0" + nl
                                                            }
                                                            _ ==> {
                                                                  mut as string: esta_key = a2
                                                                  route { esta_key == "" or not stdMapContainsKey(str_map, esta_key) ==> { esta_key = "nice" } _ ==> {} }
                                                                  mut as string: sl_es = str_map[esta_key]
                                                                  mut as int64: ln_es = str_lens[esta_key]
                                                                  ir = ir + "  %em_sta_" + em_count + " = getelementptr inbounds [" + ln_es + " x i8], [" + ln_es + " x i8]* " + sl_es + ", i32 0, i32 0" + nl

                                                                  mut as string: emsg_ptr = ""
                                                                  mut as int64: r_ml = stdCollectionLength(res)
                                                                  route {
                                                                        r_ml > 0 and res[1] == "%" and stdMapContainsKey(reg_types, res) and reg_types[res] == "string" ==> {
                                                                              emsg_ptr = res
                                                                        }
                                                                        stdMapContainsKey(str_map, res) ==> {
                                                                              mut as string: sl_em = str_map[res]
                                                                              mut as int64: ln_em = str_lens[res]
                                                                              ir = ir + "  %em_msg_" + em_count + " = getelementptr inbounds [" + ln_em + " x i8], [" + ln_em + " x i8]* " + sl_em + ", i32 0, i32 0" + nl
                                                                              emsg_ptr = "%em_msg_" + em_count
                                                                        }
                                                                        _ ==> {
                                                                              mut as string: sl_eo = str_map["ok"]
                                                                              mut as int64: ln_eo = str_lens["ok"]
                                                                              ir = ir + "  %em_msg_" + em_count + " = getelementptr inbounds [" + ln_eo + " x i8], [" + ln_eo + " x i8]* " + sl_eo + ", i32 0, i32 0" + nl
                                                                              emsg_ptr = "%em_msg_" + em_count
                                                                        }
                                                                  }

                                                                  mut as string: ev_ty = "int"
                                                                  route { stdMapContainsKey(reg_types, a1) ==> { ev_ty = reg_types[a1] } _ ==> {} }
                                                                  mut as string: ev_i64 = "0"
                                                                  mut as string: ev_f64 = "0.0"
                                                                  route {
                                                                        ev_ty == "string" or ev_ty == "list" or ev_ty == "map" or ev_ty == "struct" or ev_ty == "set" or ev_ty == "complex" or ev_ty == "data" ==> {
                                                                              ir = ir + "  %em_vi_" + em_count + " = ptrtoint i8* " + a1 + " to i64" + nl
                                                                              ev_i64 = "%em_vi_" + em_count
                                                                        }
                                                                        ev_ty == "float" ==> {
                                                                              ir = ir + "  %em_vi_" + em_count + " = bitcast double " + a1 + " to i64" + nl
                                                                              ev_i64 = "%em_vi_" + em_count
                                                                              ev_f64 = a1
                                                                        }
                                                                        ev_ty == "bool" ==> {
                                                                              ir = ir + "  %em_vi_" + em_count + " = zext i1 " + a1 + " to i64" + nl
                                                                              ev_i64 = "%em_vi_" + em_count
                                                                        }
                                                                        _ ==> {
                                                                              ev_i64 = a1
                                                                        }
                                                                  }

                                                                  ir = ir + "  %em_r0_" + em_count + " = insertvalue %flux.result undef, i8* %em_sta_" + em_count + ", 0" + nl
                                                                  ir = ir + "  %em_r1_" + em_count + " = insertvalue %flux.result %em_r0_" + em_count + ", i64 " + ev_i64 + ", 1" + nl
                                                                  ir = ir + "  %em_r2_" + em_count + " = insertvalue %flux.result %em_r1_" + em_count + ", double " + ev_f64 + ", 2" + nl
                                                                  ir = ir + "  %em_r3_" + em_count + " = insertvalue %flux.result %em_r2_" + em_count + ", i8* " + emsg_ptr + ", 3" + nl
                                                                  ir = ir + "  ret %flux.result %em_r3_" + em_count + nl
                                                            }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          block_terminated = true
                                    }
                                    opcode == "NOP" ==> {
                                          block_terminated = false
                                    }
                                    _ ==> {}
                              }
                              i = i + 1
                        }
                  }
            }

            route {
                  not block_terminated ==> {
                        route {
                              is_main ==> {
                                    ir = ir + "  ret i32 0" + nl
                              }
                              _ ==> {
                                    mut as string: sl_dn = str_map["nice"]
                                    mut as int64: ln_dn = str_lens["nice"]
                                    mut as string: sl_do = str_map["ok"]
                                    mut as int64: ln_do = str_lens["ok"]
                                    ir = ir + "  %def_sta = getelementptr inbounds [" + ln_dn + " x i8], [" + ln_dn + " x i8]* " + sl_dn + ", i32 0, i32 0" + nl
                                    ir = ir + "  %def_msg = getelementptr inbounds [" + ln_do + " x i8], [" + ln_do + " x i8]* " + sl_do + ", i32 0, i32 0" + nl
                                    ir = ir + "  %def_r0 = insertvalue %flux.result undef, i8* %def_sta, 0" + nl
                                    ir = ir + "  %def_r1 = insertvalue %flux.result %def_r0, i64 0, 1" + nl
                                    ir = ir + "  %def_r2 = insertvalue %flux.result %def_r1, double 0.0, 2" + nl
                                    ir = ir + "  %def_r3 = insertvalue %flux.result %def_r2, i8* %def_msg, 3" + nl
                                    ir = ir + "  ret %flux.result %def_r3" + nl
                              }
                        }
                  }
                  _ ==> {}
            }
            ir = ir + "}" + nl

            emit(nice, ir, "ok")
      }

      op llvmGenerateIr (as map: fmir_module) as string ==> {
            mut as string: nl = "\n"
            mut as string: mod_name = "" + fmir_module["name"]
            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: n = stdCollectionLength(instrs)

            mut as map: fn_table = map{}
            mut as list of data: fn_keys = []
            route {
                  stdMapContainsKey(fmir_module, "functions") ==> { fn_table = fmir_module["functions"] }
                  _ ==> {}
            }
            route {
                  stdMapContainsKey(fmir_module, "fn_keys") ==> { fn_keys = fmir_module["fn_keys"] }
                  _ ==> {}
            }

            mut as list of data: uf_syms = []
            mut as map: uf_seen = map{}
            mut as map: uf_by_sym = map{}
            mut as int64: n_fks = stdCollectionLength(fn_keys)
            mut as int64: fki = 1
            infinite {
                  route {
                        fki > n_fks ==> { break }
                        _ ==> {
                              mut as string: fk = "" + fn_keys[fki]
                              mut as map: fdesc = fn_table[fk]
                              mut as string: f_ag = "" + fdesc["agent"]
                              route {
                                    f_ag != "CompilerLib" ==> {
                                          mut as string: usym = llvmMangleSymbol(f_ag, "" + fdesc["name"])
                                          route {
                                                not stdMapContainsKey(uf_seen, usym) ==> {
                                                      uf_seen[usym] = true
                                                      uf_syms = stdListPushBack(uf_syms, usym)
                                                      uf_by_sym[usym] = fdesc
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              fki = fki + 1
                        }
                  }
            }

            mut as int64: n_ufs = stdCollectionLength(uf_syms)
            mut as bool: has_uf = (n_ufs > 0)

            #L Coleta de variaveis globais acessadas em funcoes de usuario
            mut as map: main_allocs = map{}
            mut as int64: mii = 1
            mut as int64: n_instrs = stdCollectionLength(instrs)
            infinite {
                  route {
                        mii > n_instrs ==> { break }
                        _ ==> {
                              mut as map: minst = instrs[mii]
                              mut as string: mop = "" + minst["op"]
                              mut as string: mres = "" + minst["res"]
                              route {
                                    mop == "ALLOC" and mres != "" ==> {
                                          main_allocs[mres] = true
                                    }
                                    mop == "STORE" and mres != "" ==> {
                                          mut as int64: mr_l = stdCollectionLength(mres)
                                          route {
                                                mr_l > 0 and mres[1] != "%" ==> {
                                                      main_allocs[mres] = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mii = mii + 1
                        }
                  }
            }

            mut as map: global_vars = map{}
            mut as list of data: global_var_list = []
            route {
                  has_uf ==> {
                        mut as int64: gufi = 1
                        infinite {
                              route {
                                    gufi > n_ufs ==> { break }
                                    _ ==> {
                                          mut as string: gusym = "" + uf_syms[gufi]
                                          mut as map: gfd = uf_by_sym[gusym]
                                          mut as list of data: gu_ins = gfd["instructions"]
                                          mut as int64: ngu = stdCollectionLength(gu_ins)
                                          mut as map: gu_allocs = map{}
                                          mut as list of data: gu_params = gfd["params"]
                                          mut as int64: ngp = stdCollectionLength(gu_params)
                                          mut as int64: gpi = 1
                                          infinite {
                                                route {
                                                      gpi > ngp ==> { break }
                                                      _ ==> {
                                                            gu_allocs["" + gu_params[gpi]] = true
                                                            gpi = gpi + 1
                                                      }
                                                }
                                          }
                                          mut as int64: gui_pre = 1
                                          infinite {
                                                route {
                                                      gui_pre > ngu ==> { break }
                                                      _ ==> {
                                                            mut as map: pinst = gu_ins[gui_pre]
                                                            mut as string: pop = "" + pinst["op"]
                                                            mut as string: pres = "" + pinst["res"]
                                                            route {
                                                                  pop == "ALLOC" and pres != "" ==> {
                                                                        gu_allocs[pres] = true
                                                                  }
                                                                  pop == "STORE" and pres != "" ==> {
                                                                        mut as int64: pr_l = stdCollectionLength(pres)
                                                                        route {
                                                                              pr_l > 0 and pres[1] != "%" ==> {
                                                                                    gu_allocs[pres] = true
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            gui_pre = gui_pre + 1
                                                      }
                                                }
                                          }
                                          mut as int64: gui = 1
                                          infinite {
                                                route {
                                                      gui > ngu ==> { break }
                                                      _ ==> {
                                                            mut as map: guinst = gu_ins[gui]
                                                            mut as string: guop = "" + guinst["op"]
                                                            mut as string: gua1 = "" + guinst["arg1"]
                                                            mut as string: gures = "" + guinst["res"]
                                                            route {
                                                                  guop == "LOAD" and stdMapContainsKey(main_allocs, gua1) and not stdMapContainsKey(gu_allocs, gua1) and not stdMapContainsKey(global_vars, gua1) ==> {
                                                                        global_vars[gua1] = true
                                                                        global_var_list = stdListPushBack(global_var_list, gua1)
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            route {
                                                                  guop == "STORE" and stdMapContainsKey(main_allocs, gures) and not stdMapContainsKey(gu_allocs, gures) and not stdMapContainsKey(global_vars, gures) ==> {
                                                                        global_vars[gures] = true
                                                                        global_var_list = stdListPushBack(global_var_list, gures)
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            gui = gui + 1
                                                      }
                                                }
                                          }
                                          gufi = gufi + 1
                                    }
                              }
                        }
                  }
                  _ ==> {}
            }

            #L 1. Primeira Passagem: Coleta de strings literais
            mut as map: str_map = map{}
            mut as map: str_lens = map{}
            mut as map: str_escaped = map{}
            mut as list of data: str_list = []
            mut as int64: str_count = 0
            mut as list of data: common_strs = ["sta", "val", "msg", "nice", "ok", "int64", "float64", "bool", "string", "list", "set", "map", "data", "_struct_name"]
            route {
                  has_uf ==> { common_strs = stdListPushBack(common_strs, "fail") }
                  _ ==> {}
            }
            mut as int64: n_cs = stdCollectionLength(common_strs)
            mut as int64: csi = 1
            infinite {
                  route {
                        csi > n_cs ==> { break }
                        _ ==> {
                              mut as string: cs_val = "" + common_strs[csi]
                              route {
                                    not stdMapContainsKey(str_map, cs_val) ==> {
                                          mut as string: lbl = "@.str." + str_count
                                          str_map[cs_val] = lbl
                                          str_lens[cs_val] = llvmStringByteLength(cs_val)
                                          str_escaped[cs_val] = llvmEscapeString(cs_val) + "\\00"
                                          str_list = stdListPushBack(str_list, cs_val)
                                          str_count = str_count + 1
                                    }
                                    _ ==> {}
                              }
                              csi = csi + 1
                        }
                  }
            }

            mut as int64: ufi_s = 1
            infinite {
                  route {
                        ufi_s > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym_s = "" + uf_syms[ufi_s]
                              mut as map: fd_s = uf_by_sym[usym_s]
                              mut as list of data: u_ins = fd_s["instructions"]
                              mut as int64: n_uins = stdCollectionLength(u_ins)
                              mut as int64: uii = 1
                              infinite {
                                    route {
                                          uii > n_uins ==> { break }
                                          _ ==> {
                                                mut as map: uinst = u_ins[uii]
                                                mut as string: uop = "" + uinst["op"]
                                                mut as string: ua1 = "" + uinst["arg1"]
                                                mut as string: ua2 = "" + uinst["arg2"]
                                                mut as string: ures = "" + uinst["res"]
                                                route {
                                                      uop == "CONST_STR" or uop == "CONST_COMPLEX" or uop == "STRUCT_INIT" ==> {
                                                            route {
                                                                  not stdMapContainsKey(str_map, ua1) ==> {
                                                                        mut as string: lbl = "@.str." + str_count
                                                                        str_map[ua1] = lbl
                                                                        str_lens[ua1] = llvmStringByteLength(ua1)
                                                                        str_escaped[ua1] = llvmEscapeString(ua1) + "\\00"
                                                                        str_list = stdListPushBack(str_list, ua1)
                                                                        str_count = str_count + 1
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      uop == "STRUCT_SET_FIELD" or uop == "GET_FIELD" or uop == "SET_FIELD" or uop == "MAP_SET" or uop == "SET_INDEX" or uop == "GET_INDEX" ==> {
                                                            mut as int64: ua2_l = stdCollectionLength(ua2)
                                                            route {
                                                                  ua2_l > 0 and ua2[1] != "%" and not stdMapContainsKey(str_map, ua2) ==> {
                                                                        mut as string: lbl = "@.str." + str_count
                                                                        str_map[ua2] = lbl
                                                                        str_lens[ua2] = llvmStringByteLength(ua2)
                                                                        str_escaped[ua2] = llvmEscapeString(ua2) + "\\00"
                                                                        str_list = stdListPushBack(str_list, ua2)
                                                                        str_count = str_count + 1
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      uop == "EMIT" ==> {
                                                            route {
                                                                  ua2 != "" and not stdMapContainsKey(str_map, ua2) ==> {
                                                                        mut as string: lbl = "@.str." + str_count
                                                                        str_map[ua2] = lbl
                                                                        str_lens[ua2] = llvmStringByteLength(ua2)
                                                                        str_escaped[ua2] = llvmEscapeString(ua2) + "\\00"
                                                                        str_list = stdListPushBack(str_list, ua2)
                                                                        str_count = str_count + 1
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            mut as int64: ur_l = stdCollectionLength(ures)
                                                            route {
                                                                  ur_l > 0 and ures[1] != "%" and not stdMapContainsKey(str_map, ures) ==> {
                                                                        mut as string: lbl = "@.str." + str_count
                                                                        str_map[ures] = lbl
                                                                        str_lens[ures] = llvmStringByteLength(ures)
                                                                        str_escaped[ures] = llvmEscapeString(ures) + "\\00"
                                                                        str_list = stdListPushBack(str_list, ures)
                                                                        str_count = str_count + 1
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      _ ==> {}
                                                }
                                                uii = uii + 1
                                          }
                                    }
                              }
                              ufi_s = ufi_s + 1
                        }
                  }
            }

            mut as int64: pi = 1
            infinite {
                  route {
                        pi > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[pi]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]

                              route {
                                    opcode == "CONST_STR" or opcode == "CONST_COMPLEX" or opcode == "STRUCT_INIT" ==> {
                                          route {
                                                not stdMapContainsKey(str_map, a1) ==> {
                                                      mut as string: lbl = "@.str." + str_count
                                                      str_map[a1] = lbl
                                                      str_lens[a1] = llvmStringByteLength(a1)
                                                      str_escaped[a1] = llvmEscapeString(a1) + "\\00"
                                                      str_list = stdListPushBack(str_list, a1)
                                                      str_count = str_count + 1
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "STRUCT_SET_FIELD" or opcode == "GET_FIELD" or opcode == "SET_FIELD" or opcode == "MAP_SET" or opcode == "SET_INDEX" or opcode == "GET_INDEX" ==> {
                                          mut as int64: a2_l = stdCollectionLength(a2)
                                          route {
                                                a2_l > 0 and a2[1] != "%" and not stdMapContainsKey(str_map, a2) ==> {
                                                      mut as string: lbl = "@.str." + str_count
                                                      str_map[a2] = lbl
                                                      str_lens[a2] = llvmStringByteLength(a2)
                                                      str_escaped[a2] = llvmEscapeString(a2) + "\\00"
                                                      str_list = stdListPushBack(str_list, a2)
                                                      str_count = str_count + 1
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              pi = pi + 1
                        }
                  }
            }

            #L 2. Emissao de Cabecalho do Modulo e Declaracoes Externas
            mut as string: ir = "; ModuleID = '" + mod_name + "'" + nl
            ir = ir + "target triple = \"x86_64-pc-windows-msvc\"" + nl + nl

            ir = ir + "%flux.result = type { i8*, i64, double, i8* }" + nl + nl
            ir = ir + "declare %flux.result @f_diagnosticExplain(i8*)" + nl
            ir = ir + "declare %flux.result @f_diagnosticGetHeader(i8*, i8*)" + nl
            ir = ir + "declare %flux.result @f_diagnosticGetHint(i8*)" + nl
            ir = ir + "declare %flux.result @f_parseFile(i8*)" + nl
            ir = ir + "declare %flux.result @f_parseDumpAst(i8*)" + nl
            ir = ir + "declare %flux.result @f_semanticAnalyze(i8*, i64)" + nl
            ir = ir + "declare %flux.result @f_fmirBuildFromAst(i8*, i64)" + nl
            ir = ir + "declare %flux.result @f_fmirDumpText(i8*)" + nl
            ir = ir + "declare %flux.result @f_backendCompile(i8*, i8*, i8*)" + nl
            ir = ir + "declare %flux.result @f_vmrExecuteFile(i8*)" + nl + nl

            ir = ir + "declare void @flux_runtime_init_args(i32, i8**)" + nl
            ir = ir + "declare i32 @printf(i8*, ...)" + nl
            ir = ir + "declare i32 @fflush(i8*)" + nl
            ir = ir + "declare void @exit(i32)" + nl
            ir = ir + "declare i8* @malloc(i64)" + nl
            ir = ir + "declare void @free(i8*)" + nl
            ir = ir + "declare i64 @strlen(i8*)" + nl
            ir = ir + "declare i32 @strcmp(i8*, i8*)" + nl
            ir = ir + "declare i32 @snprintf(i8*, i64, i8*, ...)" + nl
            ir = ir + "declare double @pow(double, double)" + nl
            ir = ir + "declare double @llvm.sqrt.f64(double)" + nl
            ir = ir + "declare i64 @atoll(i8*)" + nl
            ir = ir + "declare double @atof(i8*)" + nl
            ir = ir + "declare i8* @flux_str_concat(i8*, i8*)" + nl
            ir = ir + "declare i32 @flux_str_compare(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_str_slice(i8*, i64, i64)" + nl
            ir = ir + "declare i8* @flux_list_slice(i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_str_len(i8*)" + nl
            ir = ir + "declare i8* @flux_list_create(i64)" + nl
            ir = ir + "declare void @flux_list_push_val(i8*, i64)" + nl
            ir = ir + "declare i64 @flux_list_get_val(i8*, i64)" + nl
            ir = ir + "declare i64 @flux_list_get(i8*, i64)" + nl
            ir = ir + "declare void @flux_list_set(i8*, i64, i64)" + nl
            ir = ir + "declare void @flux_list_set_tagged(i8*, i64, i64, i64)" + nl
            ir = ir + "declare void @flux_list_push_tagged(i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_list_contains(i8*, i64)" + nl
            ir = ir + "declare void @flux_set_add_tagged(i8*, i64, i64)" + nl
            ir = ir + "declare i8* @flux_dataflow_join(i64, i64, i64, i64)" + nl
            ir = ir + "declare i8* @flux_complex_neg(i8*)" + nl
            ir = ir + "declare i64 @flux_list_len(i8*)" + nl
            ir = ir + "declare i1 @flux_is_list(i8*)" + nl
            ir = ir + "declare i8* @flux_map_build(i64)" + nl
            ir = ir + "declare void @flux_list_print(i8*)" + nl
            ir = ir + "declare void @flux_map_print(i8*)" + nl
            ir = ir + "declare i8* @flux_map_set(i8*, i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_map_get(i8*, i8*)" + nl
            ir = ir + "declare i64 @flux_map_get_tag(i8*, i8*)" + nl
            ir = ir + "declare i1 @flux_map_contains_key(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_map_key_at(i8*, i64)" + nl
            ir = ir + "declare i64 @flux_map_len(i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_read_file(i8*)" + nl
            ir = ir + "declare i8* @flux_runtime_input_string(i8*, i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_write_file(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_read_hex_file(i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_write_hex_file(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_std_string_llvm_escape(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_file_exists(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_dir_exists(i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_list_dir(i8*, i8* (i64, i64)*, i8* (i8*, i64, i64, i8*)*)" + nl
            ir = ir + "declare i8* @flux_std_io_path_join(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_path_base_name(i8*)" + nl
            ir = ir + "declare i8* @flux_std_io_path_dir_name(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_delete_file(i8*)" + nl
            ir = ir + "declare i64 @flux_std_os_exec(i8*)" + nl
            ir = ir + "declare i8* @flux_std_os_exec_output(i8*)" + nl
            ir = ir + "declare i64 @flux_std_os_exit(i64)" + nl
            ir = ir + "declare i8* @flux_list_build(i64, i64)" + nl
            ir = ir + "declare i8* @flux_list_push(i8*, i64, i64, i8*)" + nl
            ir = ir + "declare i8* @flux_std_runtime_get_args(i8* (i64, i64)*, i8* (i8*, i64, i64, i8*)*)" + nl
            ir = ir + "declare i8* @flux_std_runtime_backend()" + nl
            ir = ir + "declare i8* @flux_std_runtime_compiler_version()" + nl
            ir = ir + "declare i8* @flux_std_runtime_executable_path()" + nl
            ir = ir + "declare i64 @flux_std_runtime_allocated_memory()" + nl
            ir = ir + "declare i64 @flux_std_runtime_heap_size()" + nl
            ir = ir + "declare i64 @flux_std_runtime_pointer_of(i8*)" + nl
            ir = ir + "declare i8* @flux_std_runtime_stack_trace(i8* (i64, i64)*, i8* (i8*, i64, i64, i8*)*)" + nl
            ir = ir + "declare i64 @flux_std_runtime_panic(i8*)" + nl
            ir = ir + "declare i64 @flux_std_runtime_trap()" + nl
            ir = ir + "declare i64 @flux_std_datetime_now()" + nl
            ir = ir + "declare i64 @flux_std_datetime_monotonic_now()" + nl
            ir = ir + "declare i64 @flux_std_datetime_monotonic_elapsed(i64)" + nl + nl
            ir = ir + "declare i64 @flux_std_datetime_today()" + nl
            ir = ir + "declare i64 @flux_std_datetime_time()" + nl
            ir = ir + "declare i64 @flux_std_datetime_create_date(i64, i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_create_time(i64, i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_create_time_full(i64, i64, i64, i64, i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_parse_iso(i8*)" + nl
            ir = ir + "declare i8* @flux_std_datetime_to_iso(i64)" + nl
            ir = ir + "declare i8* @flux_std_datetime_format(i64, i8*)" + nl
            ir = ir + "declare i64 @flux_std_datetime_year(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_month(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_day(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_hour(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_minute(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_second(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_millisecond(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_microsecond(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_nanosecond(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_weekday(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_day_of_year(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_days_in_month(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_quarter(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_is_leap_year(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_is_weekend(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_days(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_hours(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_minutes(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_seconds(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_milliseconds(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_microseconds(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_nanoseconds(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_months(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_add_years(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_is_before(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_is_after(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_compare(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_days_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_months_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_years_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_hours_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_minutes_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_seconds_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_milliseconds_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_microseconds_between(i64, i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_nanoseconds_between(i64, i64)" + nl
            ir = ir + "declare i8* @flux_std_datetime_to_timezone(i64, i8*)" + nl
            ir = ir + "declare i8* @flux_std_datetime_to_local(i64)" + nl
            ir = ir + "declare i64 @flux_std_datetime_to_utc(i64)" + nl
            ir = ir + "declare double @flux_std_datetime_utc_offset(i64, i8*)" + nl
            ir = ir + "declare i8* @flux_std_datetime_local_timezone()" + nl
            ir = ir + "declare i64 @flux_std_datetime_is_daylight_saving_time(i64, i8*)" + nl
            ir = ir + "declare double @flux_std_datetime_dst_offset(i64, i8*)" + nl
            ir = ir + "declare i8* @flux_float_to_str(double)" + nl
            ir = ir + "declare i8* @flux_val_to_str(i64)" + nl
            ir = ir + "declare void @flux_val_print(i64)" + nl
            ir = ir + "declare i8* @flux_set_to_str(i8*)" + nl
            ir = ir + "declare void @flux_set_print(i8*)" + nl
            ir = ir + "declare i8* @flux_list_to_str(i8*)" + nl
            ir = ir + "declare i8* @flux_map_to_str(i8*)" + nl
            ir = ir + "declare i8* @flux_list_to_set(i8*)" + nl
            ir = ir + "declare double @flux_cast_special_float(double, i64)" + nl
            ir = ir + "declare i8* @flux_complex_create(double, double)" + nl
            ir = ir + "declare i8* @flux_complex_from_str(i8*)" + nl
            ir = ir + "declare i8* @flux_complex_add(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_complex_sub(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_complex_mul(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_complex_mul_real(i8*, double)" + nl
            ir = ir + "declare i8* @flux_complex_real_mul(double, i8*)" + nl
            ir = ir + "declare i8* @flux_complex_add_real(double, i8*)" + nl
            ir = ir + "declare i8* @flux_complex_real_add(i8*, double)" + nl
            ir = ir + "declare i8* @flux_complex_to_str(i8*)" + nl
            ir = ir + "declare void @flux_complex_print(i8*)" + nl

            #L Format strings globais
            ir = ir + "@.fmt_int = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_int_val = private unnamed_addr constant [5 x i8] c\"%lld\\00\", align 1" + nl
            ir = ir + "@.fmt_str = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_str_val = private unnamed_addr constant [3 x i8] c\"%s\\00\", align 1" + nl
            ir = ir + "@.fmt_float = private unnamed_addr constant [7 x i8] c\"%.17g\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_float_val = private unnamed_addr constant [6 x i8] c\"%.17g\\00\", align 1" + nl
            ir = ir + "@.str_true = private unnamed_addr constant [5 x i8] c\"true\\00\", align 1" + nl
            ir = ir + "@.str_false = private unnamed_addr constant [6 x i8] c\"false\\00\", align 1" + nl
            ir = ir + "@.str_empty = private unnamed_addr constant [1 x i8] c\"\\00\", align 1" + nl + nl

            #L Tabela de strings constantes
            mut as int64: n_strs = stdCollectionLength(str_list)
            mut as int64: si = 1
            infinite {
                  route {
                        si > n_strs ==> { break }
                        _ ==> {
                              mut as string: s_raw = "" + str_list[si]
                              mut as string: s_lbl = str_map[s_raw]
                              mut as int64: s_len = str_lens[s_raw]
                              mut as string: s_esc = str_escaped[s_raw]
                              ir = ir + s_lbl + " = private unnamed_addr constant [" + s_len + " x i8] c\"" + s_esc + "\", align 1" + nl
                              si = si + 1
                        }
                  }
            }
            ir = ir + nl

            #L Variaveis Globais Compartilhadas com Funcoes de Usuario
            mut as int64: n_gvars = stdCollectionLength(global_var_list)
            mut as int64: gvi = 1
            infinite {
                  route {
                        gvi > n_gvars ==> { break }
                        _ ==> {
                              mut as string: gv_name = "" + global_var_list[gvi]
                              ir = ir + "@" + gv_name + " = internal global i64 0, align 8" + nl
                              route {
                                    has_uf ==> {
                                          ir = ir + "@" + gv_name + "__sta = internal global i8* null, align 8" + nl
                                          ir = ir + "@" + gv_name + "__msg = internal global i8* null, align 8" + nl
                                    }
                                    _ ==> {}
                              }
                              gvi = gvi + 1
                        }
                  }
            }
            ir = ir + nl

            #L 2.5. Funcoes e Operacoes Definidas pelo Usuario
            mut as int64: ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: ups = fdesc["params"]
                              mut as list of data: upts = []
                              route { stdMapContainsKey(fdesc, "param_types") ==> { upts = fdesc["param_types"] } _ ==> {} }
                              mut as string: urt = "int"
                              route { stdMapContainsKey(fdesc, "ret_type") ==> { urt = "" + fdesc["ret_type"] } _ ==> {} }
                              mut as list of data: uins = fdesc["instructions"]
                              mut as int64: nups = stdCollectionLength(ups)
                              mut as string: psig = ""
                              mut as int64: upk = 1
                              infinite {
                                    route {
                                          upk > nups ==> { break }
                                          _ ==> {
                                                route {
                                                      psig == "" ==> { psig = "i64 %in_" + upk }
                                                      _ ==> { psig = psig + ", i64 %in_" + upk }
                                                }
                                                upk = upk + 1
                                          }
                                    }
                              }
                              ir = ir + "define %flux.result @" + usym + "(" + psig + ") {" + nl
                              ir = ir + llvmEmitInstrs(uins, false, ups, upts, urt, str_map, str_lens, fn_table, true, global_vars, global_var_list) + nl
                              ufi = ufi + 1
                        }
                  }
            }

            #L 3. Funcao Principal @main
            ir = ir + "define i32 @main(i32 %_sys_argc, i8** %_sys_argv) {" + nl
            ir = ir + llvmEmitInstrs(instrs, true, [], [], "int", str_map, str_lens, fn_table, has_uf, global_vars, global_var_list)

            emit(nice, ir, "ok")
      }

      op llvmCompileModule (as map: fmir_module, as string: output_path) as map ==> {
            mut as string: ir_text = llvmGenerateIr(fmir_module)
            mut as string: ll_file = output_path + ".ll"
            stdIoWriteFile(ll_file, ir_text)

            mut as map: res = map{}
            res["target"] = "llvm"
            res["ir_file"] = ll_file
            res["success"] = true
            emit(nice, res, "ok")
      }
}
