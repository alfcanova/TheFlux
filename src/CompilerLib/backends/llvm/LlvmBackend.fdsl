                                          name == "stdDbGraphOpen" ==> { emit(nice, "int|i64|flux_std_db_graph_open|p", "ok") }
                                          name == "stdDbGraphQuery" ==> { emit(nice, "list|i8*|flux_std_db_graph_query|ip", "ok") }
                                          name == "stdDbGraphRelCount" ==> { emit(nice, "int|i64|flux_std_db_graph_rel_count|ip", "ok") }
                                          name == "stdDbIsValidRecord" ==> { emit(nice, "bool|i64|flux_std_db_is_valid_record|pp", "ok") }
                                          name == "stdDbKvClose" ==> { emit(nice, "bool|i64|flux_std_db_kv_close|i", "ok") }
                                          name == "stdDbKvDelete" ==> { emit(nice, "bool|i64|flux_std_db_kv_delete|ip", "ok") }
