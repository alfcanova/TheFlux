            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_month(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_day(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_hour(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_minute(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_second(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_millisecond(i64)" + nl)
