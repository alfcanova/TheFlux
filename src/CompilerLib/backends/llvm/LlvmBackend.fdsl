#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: LlvmBackend (Target: 'llvm')
#L Backend 100% Nativo FDSL para Geracao de Codigo LLVM IR
#L ==============================================================================

contract (LlvmBackendContract) {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string
      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf, as map: global_vars, as list of data: global_var_list) as string
      op llvmGenerateIr (as map: fmir_module) as string
      op llvmCompileModule (as map: fmir_module, as string: output_path) as map
      op llvmEscapeString (as string: s) as string
      op llvmStringByteLength (as string: s) as int64
}

agent (CompilerLib) impl LlvmBackendContract {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string ==> {
            mut as string: sym = "uf_" + op_name
            route {
                  agent_name != "" ==> {
                        sym = "uf_" + agent_name + "__" + op_name
                  }
                  _ ==> {}
            }
            emit(nice, sym, "ok")
      }

      op llvmEscapeString (as string: s) as string ==> {
            mut as string: res = stdStringLlvmEscape(s)
            emit(nice, res, "ok")
      }

      op llvmStringByteLength (as string: s) as int64 ==> {
            mut as int64: blen = stdStringByteLength(s)
            emit(nice, blen + 1, "ok")
      }

      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf, as map: global_vars, as list of data: global_var_list) as string ==> {
            mut as string: nl = "\n"
            mut as string: ir = "fn_entry:" + nl
            route {
                  is_main ==> {
                        ir = ir + "  call void @flux_runtime_init_args(i32 %_sys_argc, i8** %_sys_argv)" + nl
                        route {
                              has_uf ==> {
                                    mut as int64: n_gvl = stdCollectionLength(global_var_list)
                                    mut as int64: gvli = 1
                                    infinite {
                                          route {
                                                gvli > n_gvl ==> { break }
                                                _ ==> {
                                                      mut as string: gvn = "" + global_var_list[gvli]
                                                      mut as string: g_sl_n = str_map["nice"]
                                                      mut as int64: g_ln_n = str_lens["nice"]
                                                      mut as string: g_sl_o = str_map["ok"]
                                                      mut as int64: g_ln_o = str_lens["ok"]
                                                      ir = ir + "  store i8* getelementptr inbounds ([" + g_ln_n + " x i8], [" + g_ln_n + " x i8]* " + g_sl_n + ", i32 0, i32 0), i8** @" + gvn + "__sta, align 8" + nl
                                                      ir = ir + "  store i8* getelementptr inbounds ([" + g_ln_o + " x i8], [" + g_ln_o + " x i8]* " + g_sl_o + ", i32 0, i32 0), i8** @" + gvn + "__msg, align 8" + nl
                                                      gvli = gvli + 1
                                                }
                                          }
                                    }
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            mut as int64: n = stdCollectionLength(instrs)
            mut as map: alloc_map = map{}
            mut as list of data: alloc_list = []
            mut as map: list_elem_types = map{}
            mut as int64: n_fparams = stdCollectionLength(fn_params)
            mut as int64: fpi = 1
            infinite {
                  route {
                        fpi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: fp_name = "" + fn_params[fpi]
                              route {
                                    fp_name != "" and not stdMapContainsKey(alloc_map, fp_name) ==> {
                                          alloc_map[fp_name] = true
                                          alloc_list = stdListPushBack(alloc_list, fp_name)
                                    }
                                    _ ==> {}
                              }
                              fpi = fpi + 1
                        }
                  }
            }
            mut as int64: api = 1
            infinite {
                  route {
                        api > n ==> { break }
                        _ ==> {
                              mut as map: ainst = instrs[api]
                              mut as string: aop = "" + ainst["op"]
                              mut as string: ares = "" + ainst["res"]
                              mut as string: aarg1 = "" + ainst["arg1"]
                              route {
                                    aop == "ALLOC" and ares != "" ==> {
                                          route {
                                                not stdMapContainsKey(alloc_map, ares) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                          mut as string: aarg2 = "" + ainst["arg2"]
                                          mut as int64: aarg2_l = stdCollectionLength(aarg2)
                                          route {
                                                aarg2_l >= 6 and aarg2[1..6] == "tensor" ==> {
                                                      mut as int64: of_idx = 1
                                                      infinite {
                                                            route {
                                                                  of_idx + 6 > aarg2_l ==> { break }
                                                                  aarg2[of_idx..(of_idx + 6)] == "of int" ==> {
                                                                        list_elem_types[ares] = "int"
                                                                        break
                                                                  }
                                                                  aarg2[of_idx..(of_idx + 8)] == "of float" ==> {
                                                                        list_elem_types[ares] = "float"
                                                                        break
                                                                  }
                                                                  _ ==> { of_idx = of_idx + 1 }
                                                            }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "STORE" and ares != "" and not stdMapContainsKey(alloc_map, ares) ==> {
                                          mut as int64: ares_l = stdCollectionLength(ares)
                                          route {
                                                ares_l > 0 and ares[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, ares)) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "LOAD" and aarg1 != "" and not stdMapContainsKey(alloc_map, aarg1) ==> {
                                          mut as int64: aarg1_l = stdCollectionLength(aarg1)
                                          route {
                                                aarg1_l > 0 and aarg1[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, aarg1)) ==> {
                                                      alloc_map[aarg1] = true
                                                      alloc_list = stdListPushBack(alloc_list, aarg1)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    aop == "COLL_GET" and ares != "" and not stdMapContainsKey(alloc_map, ares) ==> {
                                          mut as int64: ares_l = stdCollectionLength(ares)
                                          route {
                                                ares_l > 0 and ares[1] != "%" and not (not is_main and stdMapContainsKey(global_vars, ares)) ==> {
                                                      alloc_map[ares] = true
                                                      alloc_list = stdListPushBack(alloc_list, ares)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              api = api + 1
                        }
                  }
            }

            #L Alocacoes de variaveis locais
            mut as int64: n_allocs = stdCollectionLength(alloc_list)
            mut as int64: ai = 1
            infinite {
                  route {
                        ai > n_allocs ==> { break }
                        _ ==> {
                              mut as string: vname = "" + alloc_list[ai]
                              route {
                                    is_main and stdMapContainsKey(global_vars, vname) ==> {}
                                    _ ==> {
                                          ir = ir + "  %_v_" + vname + " = alloca i64, align 8" + nl
                                          route {
                                                has_uf ==> {
                                                      mut as string: sl_n = str_map["nice"]
                                                      mut as int64: ln_n = str_lens["nice"]
                                                      mut as string: sl_o = str_map["ok"]
                                                      mut as int64: ln_o = str_lens["ok"]
                                                      ir = ir + "  %_v_" + vname + "__sta = alloca i8*, align 8" + nl
                                                      ir = ir + "  %_v_" + vname + "__msg = alloca i8*, align 8" + nl
                                                      ir = ir + "  store i8* getelementptr inbounds ([" + ln_n + " x i8], [" + ln_n + " x i8]* " + sl_n + ", i32 0, i32 0), i8** %_v_" + vname + "__sta, align 8" + nl
                                                      ir = ir + "  store i8* getelementptr inbounds ([" + ln_o + " x i8], [" + ln_o + " x i8]* " + sl_o + ", i32 0, i32 0), i8** %_v_" + vname + "__msg, align 8" + nl
                                                }
                                                _ ==> {}
                                          }
                                    }
                              }
                              ai = ai + 1
                        }
                  }
            }

            #L 4. Segunda Passagem: Emissao de Instrucoes
            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as map: reg_str_vals = map{}
            mut as map: reg_sta_regs = map{}
            mut as map: reg_msg_regs = map{}
            mut as int64: n_fptypes = stdCollectionLength(fn_ptypes)
            mut as int64: spi = 1
            infinite {
                  route {
                        spi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: sp_name = "" + fn_params[spi]
                              mut as string: sp_type = "int"
                              route {
                                    spi <= n_fptypes ==> {
                                          mut as string: decl_spt = "" + fn_ptypes[spi]
                                          mut as int64: dspt_len = stdCollectionLength(decl_spt)
                                          route {
                                                dspt_len >= 4 and decl_spt[1..4] == "list" ==> {
                                                      sp_type = "list"
                                                      route {
                                                            dspt_len >= 11 and decl_spt[6..11] == "of int" ==> { list_elem_types[sp_name] = "int" }
                                                            dspt_len >= 14 and decl_spt[6..14] == "of string" ==> { list_elem_types[sp_name] = "string" }
                                                            dspt_len >= 12 and decl_spt[6..12] == "of data" ==> { list_elem_types[sp_name] = "data" }
                                                            dspt_len >= 13 and decl_spt[6..13] == "of float" ==> { list_elem_types[sp_name] = "float" }
                                                            _ ==> { list_elem_types[sp_name] = "data" }
                                                      }
                                                }
                                                dspt_len >= 3 and decl_spt[1..3] == "set" ==> {
                                                      sp_type = "set"
                                                      route {
                                                            dspt_len >= 10 and decl_spt[5..10] == "of int" ==> { list_elem_types[sp_name] = "int" }
                                                            dspt_len >= 13 and decl_spt[5..13] == "of string" ==> { list_elem_types[sp_name] = "string" }
                                                            dspt_len >= 11 and decl_spt[5..11] == "of data" ==> { list_elem_types[sp_name] = "data" }
                                                            dspt_len >= 12 and decl_spt[5..12] == "of float" ==> { list_elem_types[sp_name] = "float" }
                                                            _ ==> { list_elem_types[sp_name] = "data" }
                                                      }
                                                }
                                                decl_spt == "float64" or decl_spt == "float32" or decl_spt == "float" or decl_spt == "float16" or decl_spt == "fp8_e4m3" or decl_spt == "fp8_e5m2" or decl_spt == "bf16_e8m7" or decl_spt == "tf32_e8m10" ==> { sp_type = "float" }
                                                decl_spt == "int64" or decl_spt == "int32" or decl_spt == "int" or decl_spt == "byte" or decl_spt == "nat" or decl_spt == "datetime" or decl_spt == "DateTime" or decl_spt == "date" or decl_spt == "Date" or decl_spt == "time" or decl_spt == "Time" or decl_spt == "timestamp" or decl_spt == "Timestamp" or decl_spt == "uint64" or decl_spt == "uint32" or decl_spt == "int16" or decl_spt == "uint16" or decl_spt == "int8" or decl_spt == "uint8" ==> { sp_type = "int" }
                                                decl_spt == "complex" or decl_spt == "complex32" or decl_spt == "complex64" or decl_spt == "complex128" ==> { sp_type = "complex" }
                                                decl_spt == "data" ==> { sp_type = "data" }
                                                decl_spt != "" and decl_spt != "data" ==> { sp_type = decl_spt }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              var_types[sp_name] = sp_type
                              ir = ir + "  store i64 %in_" + spi + ", i64* %_v_" + sp_name + ", align 8" + nl
                              spi = spi + 1
                        }
                  }
            }
            mut as int64: ft_count = 0
            mut as int64: cv_count = 0
            mut as int64: lp_count = 0
            mut as int64: ms_count = 0
            mut as int64: gf_count = 0
            mut as int64: st_count = 0
            mut as int64: pr_count = 0
            mut as int64: em_count = 0
            mut as int64: cg_count = 0
            mut as bool: block_terminated = false

            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              #L Remove prefixo % de forma 100% segura sem slicing invalido
                              mut as string: cr = res
                              mut as int64: cr_len = stdCollectionLength(cr)
                              route {
                                    cr_len > 1 ==> {
                                          route {
                                                cr[1] == "%" ==> {
                                                      cr = cr[2..cr_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca1 = a1
                              mut as int64: ca1_len = stdCollectionLength(ca1)
                              route {
                                    ca1_len > 1 ==> {
                                          route {
                                                ca1[1] == "%" ==> {
                                                      ca1 = ca1[2..ca1_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca2 = a2
                              mut as int64: ca2_len = stdCollectionLength(ca2)
                              route {
                                    ca2_len > 1 ==> {
                                          route {
                                                ca2[1] == "%" ==> {
                                                      ca2 = ca2[2..ca2_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }

                              route {
                                    opcode == "CONST_INT" ==> {
                                          ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                          reg_types[res] = "int"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          mut as string: flt_lit = a1
                                          mut as int64: fl_len = stdCollectionLength(a1)
                                          route {
                                                fl_len >= 1 and a1[1] == "." ==> {
                                                      flt_lit = "0" + a1
                                                }
                                                fl_len >= 2 and a1[1..2] == "-." ==> {
                                                      flt_lit = "-0." + a1[3..fl_len]
                                                }
                                                _ ==> {}
                                          }
                                          ir = ir + "  " + res + " = fadd double 0.0, " + flt_lit + nl
                                          reg_types[res] = "float"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_STR" ==> {
                                          mut as string: slbl = str_map[a1]
                                          mut as int64: slen = str_lens[a1]
                                          ir = ir + "  " + res + " = getelementptr inbounds [" + slen + " x i8], [" + slen + " x i8]* " + slbl + ", i32 0, i32 0" + nl
                                          reg_types[res] = "string"
                                          reg_str_vals[res] = a1
                                          block_terminated = false
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as int64: bval = 0
                                          route { a1 == "true" ==> { bval = 1 } _ ==> {} }
                                          ir = ir + "  " + res + " = add i1 0, " + bval + nl
                                          reg_types[res] = "bool"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_COMPLEX" ==> {
                                          mut as string: slbl = str_map[a1]
                                          mut as int64: slen = str_lens[a1]
                                          cv_count = cv_count + 1
                                          ir = ir + "  %c_str_" + cv_count + " = getelementptr inbounds [" + slen + " x i8], [" + slen + " x i8]* " + slbl + ", i32 0, i32 0" + nl
                                          ir = ir + "  " + res + " = call i8* @flux_complex_from_str(i8* %c_str_" + cv_count + ")" + nl
                                          reg_types[res] = "complex"
                                          block_terminated = false
                                    }
                                    opcode == "LOAD" ==> {
                                          mut as string: vt = "int"
                                          route {
                                                stdMapContainsKey(var_types, a1) ==> { vt = var_types[a1] }
                                                _ ==> {}
                                          }
                                          mut as string: a1_ptr = "%_v_" + a1
                                          mut as string: a1_sta = "%_v_" + a1 + "__sta"
                                          mut as string: a1_msg = "%_v_" + a1 + "__msg"
                                          route {
                                                (is_main and stdMapContainsKey(global_vars, a1)) or (not is_main and stdMapContainsKey(global_vars, a1) and not stdMapContainsKey(alloc_map, a1)) ==> {
                                                      a1_ptr = "@" + a1
                                                      a1_sta = "@" + a1 + "__sta"
                                                      a1_msg = "@" + a1 + "__msg"
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                vt == "float" ==> {
                                                      ir = ir + "  %" + cr + "_ptr = bitcast i64* " + a1_ptr + " to double*" + nl
                                                      ir = ir + "  " + res + " = load double, double* %" + cr + "_ptr, align 8" + nl
                                                      reg_types[res] = "float"
                                                }
                                                vt == "bool" ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* " + a1_ptr + ", align 8" + nl
                                                      ir = ir + "  " + res + " = trunc i64 %" + cr + "_i64 to i1" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                vt == "int" ==> {
                                                      ir = ir + "  " + res + " = load i64, i64* " + a1_ptr + ", align 8" + nl
                                                      reg_types[res] = "int"
                                                }
                                                _ ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* " + a1_ptr + ", align 8" + nl
                                                      ir = ir + "  " + res + " = inttoptr i64 %" + cr + "_i64 to i8*" + nl
                                                      reg_types[res] = vt
                                                }
                                          }
                                          route {
                                                has_uf ==> {
                                                      ir = ir + "  %" + cr + "_vsta = load i8*, i8** " + a1_sta + ", align 8" + nl
                                                      ir = ir + "  %" + cr + "_vmsg = load i8*, i8** " + a1_msg + ", align 8" + nl
                                                      reg_sta_regs[res] = "%" + cr + "_vsta"
                                                      reg_msg_regs[res] = "%" + cr + "_vmsg"
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                stdMapContainsKey(list_elem_types, a1) ==> {
                                                      list_elem_types[res] = list_elem_types[a1]
                                                }
                                                _ ==> {}
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "STORE" ==> {
                                          st_count = st_count + 1
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                not stdMapContainsKey(var_types, res) or var_types[res] == "data" ==> {
                                                      var_types[res] = rt
                                                }
                                                _ ==> {}
                                          }
                                          mut as string: res_ptr = "%_v_" + res
                                          mut as string: res_sta = "%_v_" + res + "__sta"
                                          mut as string: res_msg = "%_v_" + res + "__msg"
                                          route {
                                                (is_main and stdMapContainsKey(global_vars, res)) or (not is_main and stdMapContainsKey(global_vars, res) and not stdMapContainsKey(alloc_map, res)) ==> {
                                                      res_ptr = "@" + res
                                                      res_sta = "@" + res + "__sta"
                                                      res_msg = "@" + res + "__msg"
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                rt == "float" ==> {
                                                      ir = ir + "  %st_dbl_" + st_count + " = bitcast i64* " + res_ptr + " to double*" + nl
                                                      ir = ir + "  store double " + a1 + ", double* %st_dbl_" + st_count + ", align 8" + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  %st_b_" + st_count + " = zext i1 " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_b_" + st_count + ", i64* " + res_ptr + ", align 8" + nl
                                                }
                                                rt == "int" ==> {
                                                      ir = ir + "  store i64 " + a1 + ", i64* " + res_ptr + ", align 8" + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  %st_" + st_count + " = ptrtoint i8* " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_" + st_count + ", i64* " + res_ptr + ", align 8" + nl
                                                }
                                          }
                                          route {
                                                has_uf ==> {
                                                      route {
                                                            stdMapContainsKey(reg_sta_regs, a1) ==> {
                                                                  ir = ir + "  store i8* " + reg_sta_regs[a1] + ", i8** " + res_sta + ", align 8" + nl
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            stdMapContainsKey(reg_msg_regs, a1) ==> {
                                                                  ir = ir + "  store i8* " + reg_msg_regs[a1] + ", i8** " + res_msg + ", align 8" + nl
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                stdMapContainsKey(list_elem_types, a1) ==> {
                                                      list_elem_types[res] = list_elem_types[a1]
                                                }
                                                _ ==> {}
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "COPY_REG" ==> {
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          reg_types[res] = rt
                                          route {
                                                stdMapContainsKey(reg_sta_regs, a1) ==> { reg_sta_regs[res] = reg_sta_regs[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                stdMapContainsKey(reg_msg_regs, a1) ==> { reg_msg_regs[res] = reg_msg_regs[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                rt == "float" ==> {
                                                      ir = ir + "  " + res + " = fadd double 0.0, " + a1 + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  " + res + " = add i1 0, " + a1 + nl
                                                }
                                                rt == "int" ==> {
                                                      ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = bitcast i8* " + a1 + " to i8*" + nl
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_+" ==> {
                                          mut as string: t1 = "int"
                                          mut as string: t2 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route { stdMapContainsKey(reg_types, a2) ==> { t2 = reg_types[a2] } _ ==> {} }
                                          route {
                                                t1 == "string" or t2 == "string" ==> {
                                                      mut as string: op1 = a1
