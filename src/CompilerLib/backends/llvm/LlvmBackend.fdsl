#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: LlvmBackend (Target: 'llvm')
#L Backend 100% Nativo FDSL para Geracao de Codigo LLVM IR
#L ==============================================================================

contract (LlvmBackendContract) {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string
      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf) as string
      op llvmGenerateIr (as map: fmir_module) as string
      op llvmCompileModule (as map: fmir_module, as string: output_path) as map
      op llvmEscapeString (as string: s) as string
      op llvmStringByteLength (as string: s) as int64
}

agent (CompilerLib) impl LlvmBackendContract {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string ==> {
            mut as string: sym = "uf_" + op_name
            route {
                  agent_name != "" ==> {
                        sym = "uf_" + agent_name + "__" + op_name
                  }
                  _ ==> {}
            }
            emit(nice, sym, "ok")
      }

      op llvmEscapeString (as string: s) as string ==> {
            mut as string: res = stdStringLlvmEscape(s)
            emit(nice, res, "ok")
      }

      op llvmStringByteLength (as string: s) as int64 ==> {
            mut as int64: blen = stdStringByteLength(s)
            emit(nice, blen + 1, "ok")
      }

      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf) as string ==> {
            mut as string: nl = "\n"
            mut as string: ir = "entry:" + nl
            route {
                  is_main ==> {
                        ir = ir + "  call void @flux_runtime_init_args(i32 %argc, i8** %argv)" + nl
                  }
                  _ ==> {}
            }
            mut as int64: n = stdCollectionLength(instrs)
            mut as map: alloc_map = map{}
            mut as list of data: alloc_list = []
            mut as int64: n_fparams = stdCollectionLength(fn_params)
            mut as int64: fpi = 1
            infinite {
                  route {
                        fpi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: fp_name = "" + fn_params[fpi]
                              route {
                                    fp_name != "" and not stdMapContainsKey(alloc_map, fp_name) ==> {
                                          alloc_map[fp_name] = true
                                          alloc_list = stdListPushBack(alloc_list, fp_name)
                                    }
                                    _ ==> {}
                              }
                              fpi = fpi + 1
                        }
                  }
            }
            mut as int64: api = 1
            infinite {
                  route {
                        api > n ==> { break }
                        _ ==> {
                              mut as map: ainst = instrs[api]
                              mut as string: aop = "" + ainst["op"]
                              mut as string: ares = "" + ainst["res"]
                              route {
                                    aop == "ALLOC" and ares != "" and not stdMapContainsKey(alloc_map, ares) ==> {
                                          alloc_map[ares] = true
                                          alloc_list = stdListPushBack(alloc_list, ares)
                                    }
                                    _ ==> {}
                              }
                              api = api + 1
                        }
                  }
            }

            #L Alocacoes de variaveis locais
            mut as int64: n_allocs = stdCollectionLength(alloc_list)
            mut as int64: ai = 1
            infinite {
                  route {
                        ai > n_allocs ==> { break }
                        _ ==> {
                              mut as string: vname = "" + alloc_list[ai]
                              ir = ir + "  %" + vname + " = alloca i64, align 8" + nl
                              route {
                                    has_uf ==> {
                                          mut as string: sl_n = str_map["nice"]
                                          mut as int64: ln_n = str_lens["nice"]
                                          mut as string: sl_o = str_map["ok"]
                                          mut as int64: ln_o = str_lens["ok"]
                                          ir = ir + "  %" + vname + "__sta = alloca i8*, align 8" + nl
                                          ir = ir + "  %" + vname + "__msg = alloca i8*, align 8" + nl
                                          ir = ir + "  store i8* getelementptr inbounds ([" + ln_n + " x i8], [" + ln_n + " x i8]* " + sl_n + ", i32 0, i32 0), i8** %" + vname + "__sta, align 8" + nl
                                          ir = ir + "  store i8* getelementptr inbounds ([" + ln_o + " x i8], [" + ln_o + " x i8]* " + sl_o + ", i32 0, i32 0), i8** %" + vname + "__msg, align 8" + nl
                                    }
                                    _ ==> {}
                              }
                              ai = ai + 1
                        }
                  }
            }

            #L 4. Segunda Passagem: Emissao de Instrucoes
            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as map: reg_str_vals = map{}
            mut as map: reg_sta_regs = map{}
            mut as map: reg_msg_regs = map{}
            mut as int64: n_fptypes = stdCollectionLength(fn_ptypes)
            mut as int64: spi = 1
            infinite {
                  route {
                        spi > n_fparams ==> { break }
                        _ ==> {
                              mut as string: sp_name = "" + fn_params[spi]
                              mut as string: sp_type = "int"
                              route {
                                    spi <= n_fptypes ==> {
                                          mut as string: decl_spt = "" + fn_ptypes[spi]
                                          mut as int64: dspt_len = stdCollectionLength(decl_spt)
                                          route {
                                                dspt_len >= 4 and decl_spt[1..4] == "list" ==> { sp_type = "list" }
                                                decl_spt == "float64" or decl_spt == "float32" or decl_spt == "float" ==> { sp_type = "float" }
                                                decl_spt == "int64" or decl_spt == "int32" or decl_spt == "int" ==> { sp_type = "int" }
                                                decl_spt != "" and decl_spt != "data" ==> { sp_type = decl_spt }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              var_types[sp_name] = sp_type
                              ir = ir + "  store i64 %in_" + spi + ", i64* %" + sp_name + ", align 8" + nl
                              spi = spi + 1
                        }
                  }
            }
            mut as int64: ft_count = 0
            mut as int64: cv_count = 0
            mut as int64: lp_count = 0
            mut as int64: ms_count = 0
            mut as int64: gf_count = 0
            mut as int64: st_count = 0
            mut as int64: pr_count = 0
            mut as int64: em_count = 0
            mut as bool: block_terminated = false

            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              #L Remove prefixo % de forma 100% segura sem slicing invalido
                              mut as string: cr = res
                              mut as int64: cr_len = stdCollectionLength(cr)
                              route {
                                    cr_len > 1 ==> {
                                          route {
                                                cr[1] == "%" ==> {
                                                      cr = cr[2..cr_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca1 = a1
                              mut as int64: ca1_len = stdCollectionLength(ca1)
                              route {
                                    ca1_len > 1 ==> {
                                          route {
                                                ca1[1] == "%" ==> {
                                                      ca1 = ca1[2..ca1_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca2 = a2
                              mut as int64: ca2_len = stdCollectionLength(ca2)
                              route {
                                    ca2_len > 1 ==> {
                                          route {
                                                ca2[1] == "%" ==> {
                                                      ca2 = ca2[2..ca2_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }

                              route {
                                    opcode == "CONST_INT" ==> {
                                          ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                          reg_types[res] = "int"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          ir = ir + "  " + res + " = fadd double 0.0, " + a1 + nl
                                          reg_types[res] = "float"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_STR" ==> {
                                          mut as string: slbl = str_map[a1]
                                          mut as int64: slen = str_lens[a1]
                                          ir = ir + "  " + res + " = getelementptr inbounds [" + slen + " x i8], [" + slen + " x i8]* " + slbl + ", i32 0, i32 0" + nl
                                          reg_types[res] = "string"
                                          reg_str_vals[res] = a1
                                          block_terminated = false
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as int64: bval = 0
                                          route { a1 == "true" ==> { bval = 1 } _ ==> {} }
                                          ir = ir + "  " + res + " = add i1 0, " + bval + nl
                                          reg_types[res] = "bool"
                                          block_terminated = false
                                    }
                                    opcode == "LOAD" ==> {
                                          mut as string: vt = "int"
                                          route {
                                                stdMapContainsKey(var_types, a1) ==> { vt = var_types[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                vt == "string" or vt == "list" or vt == "map" or vt == "struct" ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* %" + a1 + ", align 8" + nl
                                                      ir = ir + "  " + res + " = inttoptr i64 %" + cr + "_i64 to i8*" + nl
                                                      reg_types[res] = vt
                                                }
                                                vt == "float" ==> {
                                                      ir = ir + "  %" + cr + "_ptr = bitcast i64* %" + a1 + " to double*" + nl
                                                      ir = ir + "  " + res + " = load double, double* %" + cr + "_ptr, align 8" + nl
                                                      reg_types[res] = "float"
                                                }
                                                vt == "bool" ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* %" + a1 + ", align 8" + nl
                                                      ir = ir + "  " + res + " = trunc i64 %" + cr + "_i64 to i1" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = load i64, i64* %" + a1 + ", align 8" + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          route {
                                                has_uf ==> {
                                                      ir = ir + "  %" + cr + "_vsta = load i8*, i8** %" + a1 + "__sta, align 8" + nl
                                                      ir = ir + "  %" + cr + "_vmsg = load i8*, i8** %" + a1 + "__msg, align 8" + nl
                                                      reg_sta_regs[res] = "%" + cr + "_vsta"
                                                      reg_msg_regs[res] = "%" + cr + "_vmsg"
                                                }
                                                _ ==> {}
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "STORE" ==> {
                                          st_count = st_count + 1
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          var_types[res] = rt
                                          route {
                                                rt == "string" or rt == "list" or rt == "map" or rt == "struct" ==> {
                                                      ir = ir + "  %st_" + st_count + " = ptrtoint i8* " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_" + st_count + ", i64* %" + res + ", align 8" + nl
                                                }
                                                rt == "float" ==> {
                                                      ir = ir + "  %st_dbl_" + st_count + " = bitcast i64* %" + res + " to double*" + nl
                                                      ir = ir + "  store double " + a1 + ", double* %st_dbl_" + st_count + ", align 8" + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  %st_b_" + st_count + " = zext i1 " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_b_" + st_count + ", i64* %" + res + ", align 8" + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  store i64 " + a1 + ", i64* %" + res + ", align 8" + nl
                                                }
                                          }
                                          route {
                                                has_uf ==> {
                                                      route {
                                                            stdMapContainsKey(reg_sta_regs, a1) ==> {
                                                                  ir = ir + "  store i8* " + reg_sta_regs[a1] + ", i8** %" + res + "__sta, align 8" + nl
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            stdMapContainsKey(reg_msg_regs, a1) ==> {
                                                                  ir = ir + "  store i8* " + reg_msg_regs[a1] + ", i8** %" + res + "__msg, align 8" + nl
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "COPY_REG" ==> {
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          reg_types[res] = rt
                                          route {
                                                stdMapContainsKey(reg_sta_regs, a1) ==> { reg_sta_regs[res] = reg_sta_regs[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                stdMapContainsKey(reg_msg_regs, a1) ==> { reg_msg_regs[res] = reg_msg_regs[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                rt == "string" or rt == "list" or rt == "map" or rt == "struct" ==> {
                                                      ir = ir + "  " + res + " = bitcast i8* " + a1 + " to i8*" + nl
                                                }
                                                rt == "float" ==> {
                                                      ir = ir + "  " + res + " = fadd double 0.0, " + a1 + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  " + res + " = add i1 0, " + a1 + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_+" ==> {
                                          mut as string: t1 = "int"
                                          mut as string: t2 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route { stdMapContainsKey(reg_types, a2) ==> { t2 = reg_types[a2] } _ ==> {} }
                                          route {
                                                t1 == "string" or t2 == "string" ==> {
                                                      mut as string: op1 = a1
                                                      mut as string: op2 = a2
                                                      route {
                                                            t1 != "string" and t1 != "map" and t1 != "list" and t1 != "struct" ==> {
                                                                  route {
                                                                        t1 == "float" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_float_val, i32 0, i32 0), double " + a1 + ")" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                        t1 == "bool" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = select i1 " + a1 + ", i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.str_true, i32 0, i32 0), i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.str_false, i32 0, i32 0)" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                        _ ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([4 x i8], [4 x i8]* @.fmt_int_val, i32 0, i32 0), i64 " + a1 + ")" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            t2 != "string" and t2 != "map" and t2 != "list" and t2 != "struct" ==> {
                                                                  route {
                                                                        t2 == "float" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_float_val, i32 0, i32 0), double " + a2 + ")" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                        t2 == "bool" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = select i1 " + a2 + ", i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.str_true, i32 0, i32 0), i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.str_false, i32 0, i32 0)" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                        _ ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([4 x i8], [4 x i8]* @.fmt_int_val, i32 0, i32 0), i64 " + a2 + ")" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      ir = ir + "  " + res + " = call i8* @flux_str_concat(i8* " + op1 + ", i8* " + op2 + ")" + nl
                                                      reg_types[res] = "string"
                                                }
                                                t1 == "float" or t2 == "float" ==> {
                                                      ir = ir + "  " + res + " = fadd double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = add i64 " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_-" ==> {
                                          mut as string: t1 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route {
                                                t1 == "float" ==> {
                                                      ir = ir + "  " + res + " = fsub double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = sub i64 " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_*" ==> {
                                          mut as string: t1 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route {
                                                t1 == "float" ==> {
                                                      ir = ir + "  " + res + " = fmul double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = mul i64 " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_/i" ==> {
                                          mut as string: t1 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route {
                                                t1 == "float" ==> {
                                                      ir = ir + "  " + res + " = fdiv double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                has_uf ==> {
                                                      mut as string: sl_f = str_map["fail"]
                                                      mut as int64: ln_f = str_lens["fail"]
                                                      mut as string: sl_n = str_map["nice"]
                                                      mut as int64: ln_n = str_lens["nice"]
                                                      ir = ir + "  %" + cr + "_dz = icmp eq i64 " + a2 + ", 0" + nl
                                                      ir = ir + "  %" + cr + "_sd = select i1 %" + cr + "_dz, i64 1, i64 " + a2 + nl
                                                      ir = ir + "  %" + cr + "_qt = sdiv i64 " + a1 + ", %" + cr + "_sd" + nl
                                                      ir = ir + "  " + res + " = select i1 %" + cr + "_dz, i64 0, i64 %" + cr + "_qt" + nl
                                                      ir = ir + "  %" + cr + "_dsta = select i1 %" + cr + "_dz, i8* getelementptr inbounds ([" + ln_f + " x i8], [" + ln_f + " x i8]* " + sl_f + ", i32 0, i32 0), i8* getelementptr inbounds ([" + ln_n + " x i8], [" + ln_n + " x i8]* " + sl_n + ", i32 0, i32 0)" + nl
                                                      reg_sta_regs[res] = "%" + cr + "_dsta"
                                                      reg_types[res] = "int"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = sdiv i64 " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_/f" ==> {
                                          mut as string: op1 = a1
                                          mut as string: op2 = a2
                                          mut as string: t1 = "int"
                                          mut as string: t2 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route { stdMapContainsKey(reg_types, a2) ==> { t2 = reg_types[a2] } _ ==> {} }
                                          route {
                                                t1 != "float" ==> {
                                                      ir = ir + "  %" + cr + "_d1 = sitofp i64 " + a1 + " to double" + nl
                                                      op1 = "%" + cr + "_d1"
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                t2 != "float" ==> {
                                                      ir = ir + "  %" + cr + "_d2 = sitofp i64 " + a2 + " to double" + nl
                                                      op2 = "%" + cr + "_d2"
                                                }
                                                _ ==> {}
                                          }
                                          ir = ir + "  " + res + " = fdiv double " + op1 + ", " + op2 + nl
                                          reg_types[res] = "float"
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_%" or opcode == "BINOP_/r" ==> {
                                          ir = ir + "  " + res + " = srem i64 " + a1 + ", " + a2 + nl
                                          reg_types[res] = "int"
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_^e" ==> {
