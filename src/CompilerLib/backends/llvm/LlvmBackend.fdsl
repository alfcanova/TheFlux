            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_is_weekend(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_days(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_hours(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_minutes(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_seconds(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_milliseconds(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_microseconds(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_nanoseconds(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_months(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_add_years(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_is_before(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_is_after(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_compare(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_days_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_months_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_years_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_hours_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_minutes_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_seconds_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_milliseconds_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_microseconds_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_nanoseconds_between(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_std_datetime_to_timezone(i64, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_std_datetime_to_local(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_to_utc(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare double @flux_std_datetime_utc_offset(i64, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_std_datetime_local_timezone()" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_std_datetime_is_daylight_saving_time(i64, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare double @flux_std_datetime_dst_offset(i64, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_float_to_str(double)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_val_to_str(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare void @flux_val_print(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_set_to_str(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare void @flux_set_print(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_list_to_str(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_map_to_str(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_list_to_set(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare double @flux_cast_special_float(double, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_create(double, double)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_from_str(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_add(i8*, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_sub(i8*, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_mul(i8*, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_mul_real(i8*, double)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_real_mul(double, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_add_real(double, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_real_add(i8*, double)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_complex_to_str(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare void @flux_complex_print(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare double @flux_val_to_float(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_val_to_int(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_val_to_list(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i1 @flux_val_equals(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare double @flux_map_get_float(i8*, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_set_to_list(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_std_datetime_normalize(i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_std_runtime_get_type_name_val(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare void @flux_set_last_tag(i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_list_concat(i8*, i8*)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_slice(i8*, i64, i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i8* @flux_set_new(i64)" + nl)
            ir_parts = stdListPushBack(ir_parts, "declare i64 @flux_val_compare(i64, i64)" + nl)
            mut as int64: n_dyn_decls = stdCollectionLength(dyn_decl_lines)
            mut as int64: ddi = 1
            infinite {
                  route {
                        ddi > n_dyn_decls ==> { break }
                        _ ==> {
                              ir_parts = stdListPushBack(ir_parts, "" + dyn_decl_lines[ddi] + nl)
                              ddi = ddi + 1
                        }
                  }
            }

            #L Format strings globais
            ir_parts = stdListPushBack(ir_parts, "@.fmt_int = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.fmt_int_val = private unnamed_addr constant [5 x i8] c\"%lld\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.fmt_str = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.fmt_str_val = private unnamed_addr constant [3 x i8] c\"%s\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.fmt_float = private unnamed_addr constant [7 x i8] c\"%.17g\\0A\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.fmt_float_val = private unnamed_addr constant [6 x i8] c\"%.17g\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.str_true = private unnamed_addr constant [5 x i8] c\"true\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.str_false = private unnamed_addr constant [6 x i8] c\"false\\00\", align 1" + nl)
            ir_parts = stdListPushBack(ir_parts, "@.str_empty = private unnamed_addr constant [1 x i8] c\"\\00\", align 1" + nl + nl)

            #L Tabela de strings constantes
            mut as int64: n_strs = stdCollectionLength(str_list)
            mut as int64: si = 1
            infinite {
                  route {
                        si > n_strs ==> { break }
                        _ ==> {
                              mut as string: s_raw = "" + str_list[si]
                              mut as string: s_lbl = str_map[s_raw]
                              mut as int64: s_len = str_lens[s_raw]
                              mut as string: s_esc = str_escaped[s_raw]
                              ir_parts = stdListPushBack(ir_parts, s_lbl + " = private unnamed_addr constant [" + s_len + " x i8] c\"" + s_esc + "\", align 1" + nl)
                              si = si + 1
                        }
                  }
            }
            ir_parts = stdListPushBack(ir_parts, nl)

            #L Variaveis Globais Compartilhadas com Funcoes de Usuario
            mut as int64: n_gvars = stdCollectionLength(global_var_list)
            mut as int64: gvi = 1
            infinite {
                  route {
                        gvi > n_gvars ==> { break }
                        _ ==> {
                              mut as string: gv_name = "" + global_var_list[gvi]
                              ir_parts = stdListPushBack(ir_parts, "@" + gv_name + " = internal global i64 0, align 8" + nl)
                              route {
                                    has_uf ==> {
                                          ir_parts = stdListPushBack(ir_parts, "@" + gv_name + "__sta = internal global i8* null, align 8" + nl)
                                          ir_parts = stdListPushBack(ir_parts, "@" + gv_name + "__msg = internal global i8* null, align 8" + nl)
                                    }
                                    _ ==> {}
                              }
                              gvi = gvi + 1
                        }
                  }
            }
            ir_parts = stdListPushBack(ir_parts, nl)

            #L 2.5. Funcoes e Operacoes Definidas pelo Usuario
            mut as int64: ufi = 1
            infinite {
                  route {
                        ufi > n_ufs ==> { break }
                        _ ==> {
                              mut as string: usym = "" + uf_syms[ufi]
                              mut as map: fdesc = uf_by_sym[usym]
                              mut as list of data: ups = fdesc["params"]
                              mut as list of data: upts = []
                              route { stdMapContainsKey(fdesc, "param_types") ==> { upts = fdesc["param_types"] } _ ==> {} }
                              mut as string: urt = "int"
                              route { stdMapContainsKey(fdesc, "ret_type") ==> { urt = "" + fdesc["ret_type"] } _ ==> {} }
                              mut as list of data: uins = fdesc["instructions"]
                              mut as int64: nups = stdCollectionLength(ups)
                              mut as string: psig = ""
                              mut as int64: upk = 1
                              infinite {
                                    route {
                                          upk > nups ==> { break }
                                          _ ==> {
                                                route {
                                                      psig == "" ==> { psig = "i64 %in_" + upk }
                                                      _ ==> { psig = psig + ", i64 %in_" + upk }
                                                }
                                                upk = upk + 1
                                          }
                                    }
                              }
                              ir_parts = stdListPushBack(ir_parts, "define %flux.result @" + usym + "(" + psig + ") {" + nl)
                              mut as string: u_ir_body = llvmEmitInstrs(uins, false, ups, upts, urt, str_map, str_lens, fn_table, true, global_vars, global_var_list)
                              ir_parts = stdListPushBack(ir_parts, u_ir_body)
                              ir_parts = stdListPushBack(ir_parts, nl)
                              ufi = ufi + 1
                        }
                  }
            }

            #L 3. Funcao Principal @main
            ir_parts = stdListPushBack(ir_parts, "define i32 @main(i32 %_sys_argc, i8** %_sys_argv) {" + nl)
            mut as string: main_ir_body = llvmEmitInstrs(instrs, true, [], [], "int", str_map, str_lens, fn_table, has_uf, global_vars, global_var_list)
            ir_parts = stdListPushBack(ir_parts, main_ir_body)

            emit(nice, llvmJoinRange(ir_parts, 1, stdCollectionLength(ir_parts)), "ok")
      }

      op llvmCompileModule (as map: fmir_module, as string: output_path) as map ==> {
            mut as string: ir_text = llvmGenerateIr(fmir_module)
            mut as string: ll_file = output_path + ".ll"
            stdIoWriteFile(ll_file, ir_text)

            mut as map: res = map{}
            res["target"] = "llvm"
            res["ir_file"] = ll_file
            res["success"] = true
            emit(nice, res, "ok")
      }
}
