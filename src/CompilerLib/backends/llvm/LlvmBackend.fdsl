#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: LlvmBackend (Target: 'llvm')
#L Backend 100% Nativo FDSL para Geracao de Codigo LLVM IR
#L ==============================================================================

contract (LlvmBackendContract) {
      op llvmGenerateIr (as map: fmir_module) as string
      op llvmCompileModule (as map: fmir_module, as string: output_path) as map
      op llvmEscapeString (as string: s) as string
      op llvmStringByteLength (as string: s) as int64
}

agent (CompilerLib) impl LlvmBackendContract {
      op llvmEscapeString (as string: s) as string ==> {
            mut as string: res = stdStringLlvmEscape(s)
            emit(nice, res, "ok")
      }

      op llvmStringByteLength (as string: s) as int64 ==> {
            mut as int64: blen = stdStringByteLength(s)
            emit(nice, blen + 1, "ok")
      }

      op llvmGenerateIr (as map: fmir_module) as string ==> {
            mut as string: nl = "\n"
            mut as string: mod_name = "" + fmir_module["name"]
            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: n = stdCollectionLength(instrs)

            #L 1. Primeira Passagem: Coleta de strings literais e identificacao de registradores
            mut as map: str_map = map{}
            mut as map: str_lens = map{}
            mut as map: str_escaped = map{}
            mut as list of data: str_list = []
            mut as int64: str_count = 0
            mut as list of data: common_strs = ["sta", "val", "msg", "nice", "ok"]
            mut as int64: csi = 1
            infinite {
                  route {
                        csi > 5 ==> { break }
                        _ ==> {
                              mut as string: cs_val = "" + common_strs[csi]
                              route {
                                    not stdMapContainsKey(str_map, cs_val) ==> {
                                          mut as string: lbl = "@.str." + str_count
                                          str_map[cs_val] = lbl
                                          str_lens[cs_val] = llvmStringByteLength(cs_val)
                                          str_escaped[cs_val] = llvmEscapeString(cs_val) + "\\00"
                                          str_list = stdListPushBack(str_list, cs_val)
                                          str_count = str_count + 1
                                    }
                                    _ ==> {}
                              }
                              csi = csi + 1
                        }
                  }
            }

            mut as map: alloc_map = map{}
            mut as list of data: alloc_list = []

            mut as map: reg_def_counts = map{}

            mut as int64: pi = 1
            infinite {
                  route {
                        pi > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[pi]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              route {
                                    opcode == "CONST_STR" ==> {
                                          route {
                                                not stdMapContainsKey(str_map, a1) ==> {
                                                      mut as string: lbl = "@.str." + str_count
                                                      str_map[a1] = lbl
                                                      str_lens[a1] = llvmStringByteLength(a1)
                                                      str_escaped[a1] = llvmEscapeString(a1) + "\\00"
                                                      str_list = stdListPushBack(str_list, a1)
                                                      str_count = str_count + 1
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "STRUCT_SET_FIELD" or opcode == "GET_FIELD" or opcode == "SET_FIELD" or opcode == "MAP_SET" or opcode == "SET_INDEX" or opcode == "GET_INDEX" ==> {
                                          mut as int64: a2_l = stdCollectionLength(a2)
                                          route {
                                                a2_l > 0 and a2[1] != "%" and not stdMapContainsKey(str_map, a2) ==> {
                                                      mut as string: lbl = "@.str." + str_count
                                                      str_map[a2] = lbl
                                                      str_lens[a2] = llvmStringByteLength(a2)
                                                      str_escaped[a2] = llvmEscapeString(a2) + "\\00"
                                                      str_list = stdListPushBack(str_list, a2)
                                                      str_count = str_count + 1
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "ALLOC" ==> {
                                          route {
                                                res != "" and not stdMapContainsKey(alloc_map, res) ==> {
                                                      alloc_map[res] = true
                                                      alloc_list = stdListPushBack(alloc_list, res)
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }

                              mut as int64: res_l = stdCollectionLength(res)
                              route {
                                    res_l > 1 ==> {
                                          route {
                                                res[1] == "%" ==> {
                                                      mut as int64: cur_c = 0
                                                      route {
                                                            stdMapContainsKey(reg_def_counts, res) ==> {
                                                                  cur_c = reg_def_counts[res]
                                                            }
                                                            _ ==> {}
                                                      }
                                                      reg_def_counts[res] = cur_c + 1
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              pi = pi + 1
                        }
                  }
            }

            #L 2. Emissao de Cabecalho do Modulo e Declaracoes Externas
            mut as string: ir = "; ModuleID = '" + mod_name + "'" + nl
            ir = ir + "target triple = \"x86_64-pc-windows-msvc\"" + nl + nl

            ir = ir + "%flux.result = type { i8*, i64, double, i8* }" + nl + nl
            ir = ir + "declare %flux.result @f_diagnosticExplain(i8*)" + nl
            ir = ir + "declare %flux.result @f_diagnosticGetHeader(i8*, i8*)" + nl
            ir = ir + "declare %flux.result @f_diagnosticGetHint(i8*)" + nl
            ir = ir + "declare %flux.result @f_parseFile(i8*)" + nl
            ir = ir + "declare %flux.result @f_parseDumpAst(i8*)" + nl
            ir = ir + "declare %flux.result @f_semanticAnalyze(i8*, i64)" + nl
            ir = ir + "declare %flux.result @f_fmirBuildFromAst(i8*, i64)" + nl
            ir = ir + "declare %flux.result @f_fmirDumpText(i8*)" + nl
            ir = ir + "declare %flux.result @f_backendCompile(i8*, i8*, i8*)" + nl + nl

            ir = ir + "declare void @flux_runtime_init_args(i32, i8**)" + nl
            ir = ir + "declare i32 @printf(i8*, ...)" + nl
            ir = ir + "declare i32 @fflush(i8*)" + nl
            ir = ir + "declare void @exit(i32)" + nl
            ir = ir + "declare i8* @malloc(i64)" + nl
            ir = ir + "declare void @free(i8*)" + nl
            ir = ir + "declare i64 @strlen(i8*)" + nl
            ir = ir + "declare i32 @strcmp(i8*, i8*)" + nl
            ir = ir + "declare i32 @snprintf(i8*, i64, i8*, ...)" + nl
            ir = ir + "declare double @pow(double, double)" + nl
            ir = ir + "declare double @llvm.sqrt.f64(double)" + nl
            ir = ir + "declare i8* @flux_str_concat(i8*, i8*)" + nl
            ir = ir + "declare i32 @flux_str_compare(i8*, i8*)" + nl
            ir = ir + "declare i8* @flux_str_slice(i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_str_len(i8*)" + nl
            ir = ir + "declare i8* @flux_list_create(i64)" + nl
            ir = ir + "declare void @flux_list_push_val(i8*, i64)" + nl
            ir = ir + "declare i64 @flux_list_get_val(i8*, i64)" + nl
            ir = ir + "declare i64 @flux_list_get(i8*, i64)" + nl
            ir = ir + "declare void @flux_list_set(i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_list_len(i8*)" + nl
            ir = ir + "declare i8* @flux_map_build(i64)" + nl
            ir = ir + "declare void @flux_list_print(i8*)" + nl
            ir = ir + "declare void @flux_map_print(i8*)" + nl
            ir = ir + "declare i8* @flux_map_set(i8*, i8*, i64, i64)" + nl
            ir = ir + "declare i64 @flux_map_get(i8*, i8*)" + nl
            ir = ir + "declare i64 @flux_map_get_tag(i8*, i8*)" + nl
            ir = ir + "declare i1 @flux_map_contains_key(i8*, i8*)" + nl
            ir = ir + "declare i64 @flux_map_len(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_read_file(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_write_file(i8*, i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_file_exists(i8*)" + nl
            ir = ir + "declare i64 @flux_std_io_delete_file(i8*)" + nl
            ir = ir + "declare i64 @flux_std_os_exec(i8*)" + nl
            ir = ir + "declare i64 @flux_std_os_exit(i64)" + nl
            ir = ir + "declare i8* @flux_list_build(i64, i64)" + nl
            ir = ir + "declare i8* @flux_list_push(i8*, i64, i64, i8*)" + nl
            ir = ir + "declare i8* @flux_std_runtime_get_args(i8* (i64, i64)*, i8* (i8*, i64, i64, i8*)*)" + nl
            ir = ir + "declare i64 @flux_std_datetime_now()" + nl
            ir = ir + "declare i64 @flux_std_datetime_monotonic_now()" + nl
            ir = ir + "declare i64 @flux_std_datetime_monotonic_elapsed(i64)" + nl + nl

            #L Format strings globais
            ir = ir + "@.fmt_int = private unnamed_addr constant [5 x i8] c\"%ld\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_int_val = private unnamed_addr constant [4 x i8] c\"%ld\\00\", align 1" + nl
            ir = ir + "@.fmt_str = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_str_val = private unnamed_addr constant [3 x i8] c\"%s\\00\", align 1" + nl
            ir = ir + "@.fmt_float = private unnamed_addr constant [7 x i8] c\"%.17g\\0A\\00\", align 1" + nl
            ir = ir + "@.fmt_float_val = private unnamed_addr constant [6 x i8] c\"%.17g\\00\", align 1" + nl
            ir = ir + "@.str_true = private unnamed_addr constant [5 x i8] c\"true\\00\", align 1" + nl
            ir = ir + "@.str_false = private unnamed_addr constant [6 x i8] c\"false\\00\", align 1" + nl
            ir = ir + "@.str_empty = private unnamed_addr constant [1 x i8] c\"\\00\", align 1" + nl + nl

            #L Tabela de strings constantes
            mut as int64: n_strs = stdCollectionLength(str_list)
            mut as int64: si = 1
            infinite {
                  route {
                        si > n_strs ==> { break }
                        _ ==> {
                              mut as string: s_raw = "" + str_list[si]
                              mut as string: s_lbl = str_map[s_raw]
                              mut as int64: s_len = str_lens[s_raw]
                              mut as string: s_esc = str_escaped[s_raw]
                              ir = ir + s_lbl + " = private unnamed_addr constant [" + s_len + " x i8] c\"" + s_esc + "\", align 1" + nl
                              si = si + 1
                        }
                  }
            }
            ir = ir + nl

            #L 3. Funcao Principal @main
            ir = ir + "define i32 @main(i32 %argc, i8** %argv) {" + nl
            ir = ir + "entry:" + nl
            ir = ir + "  call void @flux_runtime_init_args(i32 %argc, i8** %argv)" + nl

            #L Alocacoes de variaveis locais
            mut as int64: n_allocs = stdCollectionLength(alloc_list)
            mut as int64: ai = 1
            infinite {
                  route {
                        ai > n_allocs ==> { break }
                        _ ==> {
                              mut as string: vname = "" + alloc_list[ai]
                              ir = ir + "  %" + vname + " = alloca i64, align 8" + nl
                              ai = ai + 1
                        }
                  }
            }

            #L 4. Segunda Passagem: Emissao de Instrucoes
            mut as map: reg_types = map{}
            mut as map: var_types = map{}
            mut as map: reg_str_vals = map{}
            mut as int64: ft_count = 0
            mut as int64: cv_count = 0
            mut as int64: lp_count = 0
            mut as int64: ms_count = 0
            mut as int64: gf_count = 0
            mut as int64: st_count = 0
            mut as int64: pr_count = 0
            mut as bool: block_terminated = false

            mut as int64: i = 1
            infinite {
                  route {
                        i > n ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[i]
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              #L Remove prefixo % de forma 100% segura sem slicing invalido
                              mut as string: cr = res
                              mut as int64: cr_len = stdCollectionLength(cr)
                              route {
                                    cr_len > 1 ==> {
                                          route {
                                                cr[1] == "%" ==> {
                                                      cr = cr[2..cr_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca1 = a1
                              mut as int64: ca1_len = stdCollectionLength(ca1)
                              route {
                                    ca1_len > 1 ==> {
                                          route {
                                                ca1[1] == "%" ==> {
                                                      ca1 = ca1[2..ca1_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }
                              mut as string: ca2 = a2
                              mut as int64: ca2_len = stdCollectionLength(ca2)
                              route {
                                    ca2_len > 1 ==> {
                                          route {
                                                ca2[1] == "%" ==> {
                                                      ca2 = ca2[2..ca2_len]
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    _ ==> {}
                              }

                              route {
                                    opcode == "CONST_INT" ==> {
                                          ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                          reg_types[res] = "int"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          ir = ir + "  " + res + " = fadd double 0.0, " + a1 + nl
                                          reg_types[res] = "float"
                                          block_terminated = false
                                    }
                                    opcode == "CONST_STR" ==> {
                                          mut as string: slbl = str_map[a1]
                                          mut as int64: slen = str_lens[a1]
                                          ir = ir + "  " + res + " = getelementptr inbounds [" + slen + " x i8], [" + slen + " x i8]* " + slbl + ", i32 0, i32 0" + nl
                                          reg_types[res] = "string"
                                          reg_str_vals[res] = a1
                                          block_terminated = false
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          mut as int64: bval = 0
                                          route { a1 == "true" ==> { bval = 1 } _ ==> {} }
                                          ir = ir + "  " + res + " = add i1 0, " + bval + nl
                                          reg_types[res] = "bool"
                                          block_terminated = false
                                    }
                                    opcode == "LOAD" ==> {
                                          mut as string: vt = "int"
                                          route {
                                                stdMapContainsKey(var_types, a1) ==> { vt = var_types[a1] }
                                                _ ==> {}
                                          }
                                          route {
                                                vt == "string" or vt == "list" or vt == "map" or vt == "struct" ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* %" + a1 + ", align 8" + nl
                                                      ir = ir + "  " + res + " = inttoptr i64 %" + cr + "_i64 to i8*" + nl
                                                      reg_types[res] = vt
                                                }
                                                vt == "float" ==> {
                                                      ir = ir + "  %" + cr + "_ptr = bitcast i64* %" + a1 + " to double*" + nl
                                                      ir = ir + "  " + res + " = load double, double* %" + cr + "_ptr, align 8" + nl
                                                      reg_types[res] = "float"
                                                }
                                                vt == "bool" ==> {
                                                      ir = ir + "  %" + cr + "_i64 = load i64, i64* %" + a1 + ", align 8" + nl
                                                      ir = ir + "  " + res + " = trunc i64 %" + cr + "_i64 to i1" + nl
                                                      reg_types[res] = "bool"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = load i64, i64* %" + a1 + ", align 8" + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "STORE" ==> {
                                          st_count = st_count + 1
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          var_types[res] = rt
                                          route {
                                                rt == "string" or rt == "list" or rt == "map" or rt == "struct" ==> {
                                                      ir = ir + "  %st_" + st_count + " = ptrtoint i8* " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_" + st_count + ", i64* %" + res + ", align 8" + nl
                                                }
                                                rt == "float" ==> {
                                                      ir = ir + "  %st_dbl_" + st_count + " = bitcast i64* %" + res + " to double*" + nl
                                                      ir = ir + "  store double " + a1 + ", double* %st_dbl_" + st_count + ", align 8" + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  %st_b_" + st_count + " = zext i1 " + a1 + " to i64" + nl
                                                      ir = ir + "  store i64 %st_b_" + st_count + ", i64* %" + res + ", align 8" + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  store i64 " + a1 + ", i64* %" + res + ", align 8" + nl
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "COPY_REG" ==> {
                                          mut as string: rt = "int"
                                          route {
                                                stdMapContainsKey(reg_types, a1) ==> { rt = reg_types[a1] }
                                                _ ==> {}
                                          }
                                          reg_types[res] = rt
                                          route {
                                                rt == "string" or rt == "list" or rt == "map" or rt == "struct" ==> {
                                                      ir = ir + "  " + res + " = bitcast i8* " + a1 + " to i8*" + nl
                                                }
                                                rt == "float" ==> {
                                                      ir = ir + "  " + res + " = fadd double 0.0, " + a1 + nl
                                                }
                                                rt == "bool" ==> {
                                                      ir = ir + "  " + res + " = add i1 0, " + a1 + nl
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = add i64 0, " + a1 + nl
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_+" ==> {
                                          mut as string: t1 = "int"
                                          mut as string: t2 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route { stdMapContainsKey(reg_types, a2) ==> { t2 = reg_types[a2] } _ ==> {} }
                                          route {
                                                t1 == "string" or t2 == "string" ==> {
                                                      mut as string: op1 = a1
                                                      mut as string: op2 = a2
                                                      route {
                                                            t1 != "string" and t1 != "map" and t1 != "list" and t1 != "struct" ==> {
                                                                  route {
                                                                        t1 == "float" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_float_val, i32 0, i32 0), double " + a1 + ")" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                        t1 == "bool" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = select i1 " + a1 + ", i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.str_true, i32 0, i32 0), i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.str_false, i32 0, i32 0)" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                        _ ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([4 x i8], [4 x i8]* @.fmt_int_val, i32 0, i32 0), i64 " + a1 + ")" + nl
                                                                              op1 = "%cv_buf_" + cv_count
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            t2 != "string" and t2 != "map" and t2 != "list" and t2 != "struct" ==> {
                                                                  route {
                                                                        t2 == "float" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_float_val, i32 0, i32 0), double " + a2 + ")" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                        t2 == "bool" ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = select i1 " + a2 + ", i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.str_true, i32 0, i32 0), i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.str_false, i32 0, i32 0)" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                        _ ==> {
                                                                              cv_count = cv_count + 1
                                                                              ir = ir + "  %cv_buf_" + cv_count + " = call i8* @malloc(i64 32)" + nl
                                                                              ir = ir + "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %cv_buf_" + cv_count + ", i64 32, i8* getelementptr inbounds ([4 x i8], [4 x i8]* @.fmt_int_val, i32 0, i32 0), i64 " + a2 + ")" + nl
                                                                              op2 = "%cv_buf_" + cv_count
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      ir = ir + "  " + res + " = call i8* @flux_str_concat(i8* " + op1 + ", i8* " + op2 + ")" + nl
                                                      reg_types[res] = "string"
                                                }
                                                t1 == "float" or t2 == "float" ==> {
                                                      ir = ir + "  " + res + " = fadd double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                _ ==> {
                                                      ir = ir + "  " + res + " = add i64 " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "int"
                                                }
                                          }
                                          block_terminated = false
                                    }
                                    opcode == "BINOP_-" ==> {
                                          mut as string: t1 = "int"
                                          route { stdMapContainsKey(reg_types, a1) ==> { t1 = reg_types[a1] } _ ==> {} }
                                          route {
                                                t1 == "float" ==> {
                                                      ir = ir + "  " + res + " = fsub double " + a1 + ", " + a2 + nl
                                                      reg_types[res] = "float"
                                                }
                                                _ ==> {
