#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: LlvmBackend (Target: 'llvm')
#L Backend 100% Nativo FDSL para Geracao de Codigo LLVM IR
#L ==============================================================================

contract (LlvmBackendContract) {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string
      op llvmJoinRange (as list of string: parts, as int64: lo, as int64: hi) as string
      op llvmSpecField (as string: spec, as int64: field_idx) as string
      op llvmFormatStdDeclare (as string: spec) as string
      op llvmLookupStdIntrinsic (as string: name) as string
      op llvmCollectReachableFunctions (as map: fmir_module) as map
      op llvmEmitInstrs (as list of data: instrs, as bool: is_main, as list of data: fn_params, as list of data: fn_ptypes, as string: fn_ret_type, as map: str_map, as map: str_lens, as map: fn_table, as bool: has_uf, as map: global_vars, as list of data: global_var_list) as string
      op llvmGenerateIr (as map: fmir_module) as string
      op llvmCompileModule (as map: fmir_module, as string: output_path) as map
      op llvmEscapeString (as string: s) as string
      op llvmStringByteLength (as string: s) as int64
}

agent (CompilerLib) impl LlvmBackendContract {
      op llvmMangleSymbol (as string: agent_name, as string: op_name) as string ==> {
            mut as string: sym = "uf_" + op_name
            route {
                  agent_name != "" ==> {
                        sym = "uf_" + agent_name + "__" + op_name
                  }
                  _ ==> {}
            }
            emit(nice, sym, "ok")
      }

      op llvmJoinRange (as list of string: parts, as int64: lo, as int64: hi) as string ==> {
            route {
                  lo > hi ==> { emit(nice, "", "ok") }
                  lo == hi ==> { emit(nice, "" + parts[lo], "ok") }
                  _ ==> {
                        mut as int64: mid = (lo + hi) /i 2
                        mut as string: left_s = llvmJoinRange(parts, lo, mid)
                        mut as string: right_s = llvmJoinRange(parts, mid + 1, hi)
                        emit(nice, left_s + right_s, "ok")
                  }
            }
      }

      op llvmSpecField (as string: spec, as int64: field_idx) as string ==> {
            mut as int64: slen = stdCollectionLength(spec)
            mut as int64: cur = 1
            mut as int64: start = 1
            mut as int64: si = 1
            infinite {
                  route {
                        si > slen ==> {
                              route {
                                    cur == field_idx and start <= slen ==> {
                                          emit(nice, spec[start..slen], "ok")
                                    }
                                    _ ==> { emit(nice, "", "ok") }
                              }
                        }
                        spec[si] == "|" ==> {
                              route {
                                    cur == field_idx ==> {
                                          route {
                                                si > start ==> { emit(nice, spec[start..(si - 1)], "ok") }
                                                _ ==> { emit(nice, "", "ok") }
                                          }
                                    }
                                    _ ==> {
                                          cur = cur + 1
                                          start = si + 1
                                          si = si + 1
                                    }
                              }
                        }
                        _ ==> { si = si + 1 }
                  }
            }
            emit(nice, "", "ok")
      }

      op llvmFormatStdDeclare (as string: spec) as string ==> {
            mut as string: d_cret = llvmSpecField(spec, 2)
            mut as string: d_cfunc = llvmSpecField(spec, 3)
            mut as string: d_args = llvmSpecField(spec, 4)
            mut as int64: d_alen = stdCollectionLength(d_args)
            mut as string: d_plist = ""
            mut as int64: d_ai = 1
            infinite {
                  route {
                        d_ai > d_alen ==> { break }
                        _ ==> {
                              mut as string: d_ch = d_args[d_ai]
                              mut as string: d_ty = "i64"
                              route {
                                    d_ch == "p" ==> { d_ty = "i8*" }
                                    d_ch == "d" ==> { d_ty = "double" }
                                    _ ==> { d_ty = "i64" }
                              }
                              route {
                                    d_plist == "" ==> { d_plist = d_ty }
                                    _ ==> { d_plist = d_plist + ", " + d_ty }
                              }
                              d_ai = d_ai + 1
                        }
                  }
            }
            emit(nice, "declare " + d_cret + " @" + d_cfunc + "(" + d_plist + ")", "ok")
      }

      op llvmLookupStdIntrinsic (as string: name) as string ==> {
            mut as int64: nlen = stdCollectionLength(name)
            route {
                  nlen < 6 or name[1..3] != "std" ==> { emit(nice, "", "ok") }
                  _ ==> {
                        mut as string: pfx = name[4..5]
                        route {
                              pfx == "Ar" ==> {
                                    route {
                                          name == "stdArchiveCreate7z" ==> { emit(nice, "bool|i64|flux_std_archive_create_7z|pp", "ok") }
                                          name == "stdArchiveDetectFormat" ==> { emit(nice, "string|i8*|flux_std_archive_detect_format|p", "ok") }
                                          name == "stdArchiveExtract7z" ==> { emit(nice, "bool|i64|flux_std_archive_extract_7z|pp", "ok") }
                                          name == "stdArchiveExtractFile" ==> { emit(nice, "bool|i64|flux_std_archive_extract_file|ppp", "ok") }
                                          name == "stdArchiveExtractRar" ==> { emit(nice, "bool|i64|flux_std_archive_extract_rar|pp", "ok") }
                                          name == "stdArchiveExtractTar" ==> { emit(nice, "bool|i64|flux_std_archive_extract_tar|pp", "ok") }
                                          name == "stdArchiveExtractTarBz2" ==> { emit(nice, "bool|i64|flux_std_archive_extract_tar_bz2|pp", "ok") }
                                          name == "stdArchiveExtractTarGz" ==> { emit(nice, "bool|i64|flux_std_archive_extract_tar_gz|pp", "ok") }
                                          name == "stdArchiveExtractTarXz" ==> { emit(nice, "bool|i64|flux_std_archive_extract_tar_xz|pp", "ok") }
                                          name == "stdArchiveExtractTarZst" ==> { emit(nice, "bool|i64|flux_std_archive_extract_tar_zst|pp", "ok") }
                                          name == "stdArchiveIsArchive" ==> { emit(nice, "bool|i64|flux_std_archive_is_archive|p", "ok") }
                                          name == "stdArchiveListFiles" ==> { emit(nice, "list|i8*|flux_std_archive_list_files_simple|p", "ok") }
                                          name == "stdArchiveTar" ==> { emit(nice, "bool|i64|flux_std_archive_tar|pp", "ok") }
                                          name == "stdArchiveTarBz2" ==> { emit(nice, "bool|i64|flux_std_archive_tar_bz2|pp", "ok") }
                                          name == "stdArchiveTarGz" ==> { emit(nice, "bool|i64|flux_std_archive_tar_gz|pp", "ok") }
                                          name == "stdArchiveTarXz" ==> { emit(nice, "bool|i64|flux_std_archive_tar_xz|pp", "ok") }
                                          name == "stdArchiveTarZst" ==> { emit(nice, "bool|i64|flux_std_archive_tar_zst|pp", "ok") }
                                          name == "stdArchiveUnzip" ==> { emit(nice, "bool|i64|flux_std_archive_unzip|pp", "ok") }
                                          name == "stdArchiveZip" ==> { emit(nice, "bool|i64|flux_std_archive_zip|pp", "ok") }
                                          _ ==> { emit(nice, "", "ok") }
                                    }
                              }
                              pfx == "Ch" ==> {
                                    route {
                                          name == "stdChannelCapacity" ==> { emit(nice, "int|i64|flux_std_channel_capacity|i", "ok") }
                                          name == "stdChannelClose" ==> { emit(nice, "bool|i64|flux_std_channel_close|i", "ok") }
                                          name == "stdChannelCreate" ==> { emit(nice, "map|i8*|flux_std_channel_create|0", "ok") }
                                          name == "stdChannelCreateWithCapacity" ==> { emit(nice, "map|i8*|flux_std_channel_create|i", "ok") }
                                          name == "stdChannelIsClosed" ==> { emit(nice, "bool|i64|flux_std_channel_is_closed|i", "ok") }
                                          name == "stdChannelIsEmpty" ==> { emit(nice, "bool|i64|flux_std_channel_is_empty|i", "ok") }
                                          name == "stdChannelLength" ==> { emit(nice, "int|i64|flux_std_channel_length|i", "ok") }
                                          name == "stdChannelRecv" ==> { emit(nice, "data|i8*|flux_std_channel_recv|i", "ok") }
                                          name == "stdChannelSend" ==> { emit(nice, "bool|i64|flux_std_channel_send|ip", "ok") }
                                          name == "stdChannelTryRecv" ==> { emit(nice, "map|i8*|flux_std_channel_try_recv|i", "ok") }
                                          name == "stdChannelTrySend" ==> { emit(nice, "bool|i64|flux_std_channel_try_send|ip", "ok") }
                                          _ ==> { emit(nice, "", "ok") }
                                    }
                              }
                              pfx == "Co" ==> {
                                    route {
                                          name == "stdCollectionClearAll" ==> { emit(nice, "set|i8*|flux_collection_clear_all|p", "ok") }
                                          name == "stdCollectionContains" ==> { emit(nice, "bool|i64|flux_collection_contains|pv", "ok") }
                                          name == "stdCollectionIsEmpty" ==> { emit(nice, "bool|i64|flux_collection_is_empty|p", "ok") }
                                          name == "stdCollectionToSet" ==> { emit(nice, "set|i8*|flux_list_to_set|p", "ok") }
                                          name == "stdCompressBzip2" ==> { emit(nice, "string|i8*|flux_std_compress_bzip2|p", "ok") }
                                          name == "stdCompressBzip2Level" ==> { emit(nice, "string|i8*|flux_std_compress_bzip2_level|pi", "ok") }
                                          name == "stdCompressDeflate" ==> { emit(nice, "string|i8*|flux_std_compress_deflate|p", "ok") }
                                          name == "stdCompressDeflateLevel" ==> { emit(nice, "string|i8*|flux_std_compress_deflate_level|pi", "ok") }
                                          name == "stdCompressDetectFormat" ==> { emit(nice, "string|i8*|flux_std_compress_detect_format|p", "ok") }
                                          name == "stdCompressEstimateDecompressedSize" ==> { emit(nice, "int|i64|flux_std_compress_estimate_decompressed_size|p", "ok") }
                                          name == "stdCompressGzip" ==> { emit(nice, "string|i8*|flux_std_compress_gzip|p", "ok") }
                                          name == "stdCompressGzipCrc32" ==> { emit(nice, "int|i64|flux_std_compress_gzip_crc32|p", "ok") }
                                          name == "stdCompressGzipLevel" ==> { emit(nice, "string|i8*|flux_std_compress_gzip_level|pi", "ok") }
                                          name == "stdCompressGzipTimestamp" ==> { emit(nice, "int|i64|flux_std_compress_gzip_timestamp|p", "ok") }
                                          name == "stdCompressIsBzip2" ==> { emit(nice, "bool|i64|flux_std_compress_is_bzip2|p", "ok") }
                                          name == "stdCompressIsDeflate" ==> { emit(nice, "bool|i64|flux_std_compress_is_deflate|p", "ok") }
                                          name == "stdCompressIsEffective" ==> { emit(nice, "bool|i64|flux_std_compress_is_effective|pp", "ok") }
                                          name == "stdCompressIsFormatSupported" ==> { emit(nice, "bool|i64|flux_std_compress_is_format_supported|p", "ok") }
                                          name == "stdCompressIsGzip" ==> { emit(nice, "bool|i64|flux_std_compress_is_gzip|p", "ok") }
                                          name == "stdCompressIsLzma" ==> { emit(nice, "bool|i64|flux_std_compress_is_lzma|p", "ok") }
                                          name == "stdCompressIsXz" ==> { emit(nice, "bool|i64|flux_std_compress_is_xz|p", "ok") }
                                          name == "stdCompressIsZlib" ==> { emit(nice, "bool|i64|flux_std_compress_is_zlib|p", "ok") }
                                          name == "stdCompressIsZstd" ==> { emit(nice, "bool|i64|flux_std_compress_is_zstd|p", "ok") }
                                          name == "stdCompressLzma" ==> { emit(nice, "string|i8*|flux_std_compress_lzma|p", "ok") }
                                          name == "stdCompressLzma2" ==> { emit(nice, "string|i8*|flux_std_compress_lzma2|p", "ok") }
                                          name == "stdCompressLzma2Level" ==> { emit(nice, "string|i8*|flux_std_compress_lzma2_level|pi", "ok") }
                                          name == "stdCompressLzmaLevel" ==> { emit(nice, "string|i8*|flux_std_compress_lzma_level|pi", "ok") }
                                          name == "stdCompressStats" ==> { emit(nice, "map|i8*|flux_std_compress_stats|pp", "ok") }
                                          name == "stdCompressXz" ==> { emit(nice, "string|i8*|flux_std_compress_xz|p", "ok") }
                                          name == "stdCompressXzLevel" ==> { emit(nice, "string|i8*|flux_std_compress_xz_level|pi", "ok") }
                                          name == "stdCompressZlib" ==> { emit(nice, "string|i8*|flux_std_compress_zlib|p", "ok") }
                                          name == "stdCompressZlibAdler32" ==> { emit(nice, "int|i64|flux_std_compress_zlib_adler32|p", "ok") }
                                          name == "stdCompressZlibLevel" ==> { emit(nice, "string|i8*|flux_std_compress_zlib_level|pi", "ok") }
                                          name == "stdCompressZstd" ==> { emit(nice, "string|i8*|flux_std_compress_zstd|p", "ok") }
                                          name == "stdCompressZstdFrameSize" ==> { emit(nice, "int|i64|flux_std_compress_zstd_frame_size|p", "ok") }
                                          name == "stdCompressZstdLevel" ==> { emit(nice, "string|i8*|flux_std_compress_zstd_level|pi", "ok") }
                                          _ ==> { emit(nice, "", "ok") }
                                    }
                              }
                              pfx == "Da" ==> {
                                    route {
                                          name == "stdDatetimeNow" ==> { emit(nice, "int|i64|flux_std_datetime_now|", "ok") }
                                          _ ==> { emit(nice, "", "ok") }
                                    }
                              }
                              pfx == "Db" ==> {
                                    route {
                                          name == "stdDbColumnClose" ==> { emit(nice, "bool|i64|flux_std_db_column_close|i", "ok") }
                                          name == "stdDbColumnExecute" ==> { emit(nice, "bool|i64|flux_std_db_column_execute|ip", "ok") }
                                          name == "stdDbColumnOpen" ==> { emit(nice, "int|i64|flux_std_db_column_open|p", "ok") }
                                          name == "stdDbColumnQuery" ==> { emit(nice, "list|i8*|flux_std_db_column_query|ip", "ok") }
                                          name == "stdDbColumnRowCount" ==> { emit(nice, "int|i64|flux_std_db_column_row_count|ip", "ok") }
                                          name == "stdDbColumnScalar" ==> { emit(nice, "int|i64|flux_std_db_column_scalar|ip", "ok") }
                                          name == "stdDbDocClose" ==> { emit(nice, "bool|i64|flux_std_db_doc_close|i", "ok") }
                                          name == "stdDbDocCount" ==> { emit(nice, "int|i64|flux_std_db_doc_count|ip", "ok") }
                                          name == "stdDbDocDelete" ==> { emit(nice, "bool|i64|flux_std_db_doc_delete|ipp", "ok") }
                                          name == "stdDbDocFetch" ==> { emit(nice, "map|i8*|flux_std_db_doc_fetch|ipp", "ok") }
                                          name == "stdDbDocOpen" ==> { emit(nice, "int|i64|flux_std_db_doc_open|p", "ok") }
                                          name == "stdDbDocQuery" ==> { emit(nice, "list|i8*|flux_std_db_doc_query|ippp", "ok") }
                                          name == "stdDbDocStore" ==> { emit(nice, "string|i8*|flux_std_db_doc_store|ipp", "ok") }
                                          name == "stdDbEscapeString" ==> { emit(nice, "string|i8*|flux_std_db_escape_string|p", "ok") }
                                          name == "stdDbGraphClose" ==> { emit(nice, "bool|i64|flux_std_db_graph_close|i", "ok") }
