#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: InterpBackend (Target: 'in')
#L ==============================================================================

contract (InterpBackendContract) {
      op interpParseInt (as string: s) as int64
      op interpParseFloat (as string: s) as float64
      op interpPad2 (as int64: v) as string
      op interpPad4 (as int64: v) as string
      op interpNormalizeDatetime (as string: s) as string
      op interpExecuteFmir (as map: fmir_module) as map
}

agent (CompilerLib) impl InterpBackendContract {
      op interpParseInt (as string: s) as int64 ==> {
            mut as int64: slen = stdCollectionLength(s)
            mut as int64: res = 0
            mut as int64: sign = 1
            mut as int64: i = 1
            route {
                  slen > 0 ==> {
                        route {
                              s[1] == "-" ==> {
                                    sign = -1
                                    i = 2
                              }
                              s[1] == "+" ==> {
                                    i = 2
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            infinite {
                  route {
                        i > slen ==> { break }
                        _ ==> {
                              mut as string: ch = s[i]
                              mut as int64: d = 0
                              route {
                                    ch == "0" ==> { d = 0 }
                                    ch == "1" ==> { d = 1 }
                                    ch == "2" ==> { d = 2 }
                                    ch == "3" ==> { d = 3 }
                                    ch == "4" ==> { d = 4 }
                                    ch == "5" ==> { d = 5 }
                                    ch == "6" ==> { d = 6 }
                                    ch == "7" ==> { d = 7 }
                                    ch == "8" ==> { d = 8 }
                                    ch == "9" ==> { d = 9 }
                                    _ ==> { break }
                              }
                              res = res * 10 + d
                              i = i + 1
                        }
                  }
            }
            res = res * sign
            emit(nice, res, "ok")
      }

      op interpParseFloat (as string: s) as float64 ==> {
            mut as int64: slen = stdCollectionLength(s)
            mut as float64: sign = 1.0
            mut as int64: i = 1
            route {
                  slen > 0 ==> {
                        route {
                              s[1] == "-" ==> {
                                    sign = -1.0
                                    i = 2
                              }
                              s[1] == "+" ==> {
                                    i = 2
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            mut as float64: int_part = 0.0
            infinite {
                  route {
                        i > slen ==> { break }
                        _ ==> {
                              mut as string: ch = s[i]
                              route {
                                    ch == "." ==> {
                                          i = i + 1
                                          break
                                    }
                                    ch == "0" ==> { int_part = int_part * 10.0 + 0.0 }
                                    ch == "1" ==> { int_part = int_part * 10.0 + 1.0 }
                                    ch == "2" ==> { int_part = int_part * 10.0 + 2.0 }
                                    ch == "3" ==> { int_part = int_part * 10.0 + 3.0 }
                                    ch == "4" ==> { int_part = int_part * 10.0 + 4.0 }
                                    ch == "5" ==> { int_part = int_part * 10.0 + 5.0 }
                                    ch == "6" ==> { int_part = int_part * 10.0 + 6.0 }
                                    ch == "7" ==> { int_part = int_part * 10.0 + 7.0 }
                                    ch == "8" ==> { int_part = int_part * 10.0 + 8.0 }
                                    ch == "9" ==> { int_part = int_part * 10.0 + 9.0 }
                                    _ ==> { break }
                              }
                              i = i + 1
                        }
                  }
            }
            mut as float64: frac_num = 0.0
            mut as float64: frac_den = 1.0
            infinite {
                  route {
                        i > slen ==> { break }
                        _ ==> {
                              mut as string: ch = s[i]
                              mut as float64: d = -1.0
                              route {
                                    ch == "0" ==> { d = 0.0 }
                                    ch == "1" ==> { d = 1.0 }
                                    ch == "2" ==> { d = 2.0 }
                                    ch == "3" ==> { d = 3.0 }
                                    ch == "4" ==> { d = 4.0 }
                                    ch == "5" ==> { d = 5.0 }
                                    ch == "6" ==> { d = 6.0 }
                                    ch == "7" ==> { d = 7.0 }
                                    ch == "8" ==> { d = 8.0 }
                                    ch == "9" ==> { d = 9.0 }
                                    _ ==> { break }
                              }
                              route {
                                    d >= 0.0 ==> {
                                          frac_num = frac_num * 10.0 + d
                                          frac_den = frac_den * 10.0
                                    }
                                    _ ==> { break }
                              }
                              i = i + 1
                        }
                  }
            }
            mut as float64: total = int_part + (frac_num /f frac_den)
            route {
                  i <= slen ==> {
                        route {
                              s[i] == "e" or s[i] == "E" ==> {
                                    i = i + 1
                                    mut as bool: exp_neg = false
                                    route {
                                          i <= slen ==> {
                                                route {
                                                      s[i] == "-" ==> {
                                                            exp_neg = true
                                                            i = i + 1
                                                      }
                                                      s[i] == "+" ==> {
                                                            i = i + 1
                                                      }
                                                      _ ==> {}
                                                }
                                          }
                                          _ ==> {}
                                    }
                                    mut as int64: exp_val = 0
                                    infinite {
                                          route {
                                                i > slen ==> { break }
                                                _ ==> {
                                                      mut as string: ech = s[i]
                                                      mut as int64: ed = -1
                                                      route {
                                                            ech == "0" ==> { ed = 0 }
                                                            ech == "1" ==> { ed = 1 }
                                                            ech == "2" ==> { ed = 2 }
                                                            ech == "3" ==> { ed = 3 }
                                                            ech == "4" ==> { ed = 4 }
                                                            ech == "5" ==> { ed = 5 }
                                                            ech == "6" ==> { ed = 6 }
                                                            ech == "7" ==> { ed = 7 }
                                                            ech == "8" ==> { ed = 8 }
                                                            ech == "9" ==> { ed = 9 }
                                                            _ ==> { break }
                                                      }
                                                      route {
                                                            ed >= 0 ==> { exp_val = exp_val * 10 + ed }
                                                            _ ==> { break }
                                                      }
                                                      i = i + 1
                                                }
                                          }
                                    }
                                    mut as float64: mult = 1.0
                                    mut as int64: ei = 0
                                    infinite {
                                          route {
                                                ei >= exp_val ==> { break }
                                                _ ==> {
                                                      mult = mult * 10.0
                                                      ei = ei + 1
                                                }
                                          }
                                    }
                                    route {
                                          exp_neg ==> { total = total /f mult }
                                          _ ==> { total = total * mult }
                                    }
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            total = total * sign
            emit(nice, total, "ok")
      }

      op interpPad2 (as int64: v) as string ==> {
            route {
                  v < 0 ==> { emit(nice, "00", "ok") }
                  v < 10 ==> { emit(nice, "0" + v, "ok") }
                  _ ==> { emit(nice, "" + v, "ok") }
            }
      }

      op interpPad4 (as int64: v) as string ==> {
            route {
                  v < 10 ==> { emit(nice, "000" + v, "ok") }
                  v < 100 ==> { emit(nice, "00" + v, "ok") }
                  v < 1000 ==> { emit(nice, "0" + v, "ok") }
                  _ ==> { emit(nice, "" + v, "ok") }
            }
      }

      op interpNormalizeDatetime (as string: s) as string ==> {
            mut as int64: slen = stdCollectionLength(s)
            route {
                  slen < 19 ==> { emit(nice, s, "ok") }
                  s[5] != "-" or s[8] != "-" or s[11] != "T" or s[14] != ":" or s[17] != ":" ==> { emit(nice, s, "ok") }
                  _ ==> {
                        mut as int64: y = interpParseInt(s[1..4])
                        mut as int64: mo = interpParseInt(s[6..7])
                        mut as int64: d = interpParseInt(s[9..10])
                        mut as int64: h = interpParseInt(s[12..13])
                        mut as int64: mi = interpParseInt(s[15..16])
                        mut as int64: sec = interpParseInt(s[18..19])

                        mut as int64: p = 20
                        mut as string: nanos_str = "000000000"
                        route {
                              p <= slen ==> {
                                    route {
                                          s[p] == "." ==> {
                                                p = p + 1
                                                mut as string: frac = ""
                                                infinite {
                                                      route {
                                                            p > slen ==> { break }
                                                            s[p] == "+" or s[p] == "-" or s[p] == "Z" ==> { break }
                                                            _ ==> {
                                                                  frac = frac + s[p]
                                                                  p = p + 1
                                                            }
                                                      }
                                                }
                                                mut as string: frac_pad = frac + "000000000"
                                                nanos_str = frac_pad[1..9]
                                          }
                                          _ ==> {}
                                    }
                              }
                              _ ==> {}
                        }

                        route {
                              p <= slen ==> {
                                    route {
                                          s[p] == "+" or s[p] == "-" ==> {
                                                mut as string: sign = s[p]
                                                p = p + 1
                                                mut as string: off_body = s[p..slen]
                                                mut as int64: oh = 0
                                                mut as int64: om = 0
                                                mut as int64: ob_len = stdCollectionLength(off_body)
                                                route {
                                                      ob_len >= 5 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            route {
                                                                  off_body[3] == ":" ==> {
                                                                        om = interpParseInt(off_body[4..5])
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      ob_len == 4 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            om = interpParseInt(off_body[3..4])
                                                      }
                                                      ob_len >= 2 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            om = 0
                                                      }
                                                      _ ==> {}
                                                }
                                                route {
                                                      sign == "+" ==> {
                                                            h = h - oh
                                                            mi = mi - om
                                                      }
                                                      _ ==> {
                                                            h = h + oh
                                                            mi = mi + om
                                                      }
                                                }
                                                route {
                                                      mi < 0 ==> {
                                                            mi = mi + 60
                                                            h = h - 1
                                                      }
                                                      mi >= 60 ==> {
                                                            mi = mi - 60
                                                            h = h + 1
                                                      }
                                                      _ ==> {}
                                                }
                                                route {
                                                      h < 0 ==> {
                                                            h = h + 24
                                                            d = d - 1
                                                      }
                                                      h >= 24 ==> {
                                                            h = h - 24
                                                            d = d + 1
                                                      }
                                                      _ ==> {}
                                                }
                                          }
                                          _ ==> {}
                                    }
                              }
                              _ ==> {}
                        }

                        mut as string: res = interpPad4(y) + "-" + interpPad2(mo) + "-" + interpPad2(d) + "T" + interpPad2(h) + ":" + interpPad2(mi) + ":" + interpPad2(sec) + "." + nanos_str + "Z"
                        emit(nice, res, "ok")
                  }
            }
      }

      op interpExecuteFmir (as map: fmir_module) as map ==> {
            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: total_instrs_count = stdCollectionLength(instrs)
            mut as string: mod_name = "" + fmir_module["name"]

            mut as map: env = map{}
            mut as map: regs = map{}
            mut as map: reg_types = map{}
            mut as map: env_types = map{}
            mut as string: stdout_acc = ""
            mut as string: pending_prefix = ""
            mut as int64: spy_counter = 0

            mut as map: labels = map{}
            mut as int64: lscan = 1
            infinite {
                  route {
                        lscan > total_instrs_count ==> { break }
                        _ ==> {
                              mut as map: linstr = instrs[lscan]
                              route {
                                    linstr["op"] == "LABEL" ==> {
                                          labels["" + linstr["arg1"]] = lscan
                                    }
                                    _ ==> {}
                              }
                              lscan = lscan + 1
                        }
                  }
            }

            mut as int64: pc = 1
            infinite {
                  route {
                        pc > total_instrs_count ==> { break }
                        _ ==> {
                              mut as map: inst = instrs[pc]
                              mut as bool: jumped = false
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              route {
                                    opcode == "LABEL" ==> {}
                                    opcode == "JUMP" ==> {
                                          route {
                                                stdMapContainsKey(labels, a1) ==> {
                                                      pc = labels[a1] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "JUMP_IF_FALSE" ==> {
                                          mut as bool: cval = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> { cval = regs[a1] as bool }
                                                _ ==> {}
                                          }
                                          route {
                                                not cval and stdMapContainsKey(labels, a2) ==> {
                                                      pc = labels[a2] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "JUMP_IF_TRUE" ==> {
                                          mut as bool: cval = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> { cval = regs[a1] as bool }
                                                _ ==> {}
                                          }
                                          route {
                                                cval and stdMapContainsKey(labels, a2) ==> {
                                                      pc = labels[a2] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "COPY_REG" ==> {
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      regs[res] = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { reg_types[res] = reg_types[a1] }
                                                            _ ==> { reg_types[res] = "int" }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "COLL_LEN" ==> {
                                          mut as int64: clen = 0
                                          mut as string: c_ty = ""
                                          mut as data: c_obj = 0
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      c_obj = env[a1]
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { c_ty = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(regs, a1) ==> {
                                                      c_obj = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { c_ty = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                c_ty == "string" ==> {
                                                      mut as string: s = "" + c_obj
                                                      clen = stdCollectionLength(s)
                                                }
                                                c_ty == "map" ==> {
                                                      mut as map: m = c_obj
                                                      clen = stdCollectionLength(m)
                                                }
                                                c_ty == "list" or c_ty == "set" ==> {
                                                      mut as list of data: l = c_obj
                                                      clen = stdCollectionLength(l)
                                                }
                                                c_ty == "range" ==> {
                                                      mut as string: rng_str = "" + c_obj
                                                      mut as int64: rlen = stdCollectionLength(rng_str)
                                                      mut as int64: ddot = 0
                                                      mut as int64: ri = 1
                                                      infinite {
                                                            route {
                                                                  ri >= rlen ==> { break }
                                                                  rng_str[ri] == "." and rng_str[ri + 1] == "." ==> {
                                                                        ddot = ri
                                                                        break
                                                                  }
                                                                  _ ==> { ri = ri + 1 }
                                                            }
                                                      }
                                                      route {
                                                            ddot > 0 ==> {
                                                                  mut as string: s_str = rng_str[1..(ddot - 1)]
                                                                  mut as string: e_str = rng_str[(ddot + 2)..rlen]
                                                                  mut as int64: s_val = interpParseInt(s_str)
                                                                  mut as int64: e_val = interpParseInt(e_str)
                                                                  route {
                                                                        s_val <= e_val ==> { clen = e_val - s_val + 1 }
                                                                        _ ==> { clen = s_val - e_val + 1 }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          regs[res] = clen
                                          reg_types[res] = "int"
                                    }
                                    opcode == "COLL_GET" ==> {
                                          mut as int64: cidx = 1
                                          route {
                                                stdMapContainsKey(regs, a2) ==> { cidx = regs[a2] as int64 }
                                                _ ==> { cidx = interpParseInt(a2) }
                                          }
                                          mut as string: ctype = ""
                                          mut as data: cobj = 0
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      cobj = env[a1]
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { ctype = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(regs, a1) ==> {
                                                      cobj = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { ctype = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          mut as data: res_val = 0
                                          mut as string: res_type = "int"
                                          route {
                                                ctype == "map" ==> {
                                                      mut as map: cm = cobj
                                                      mut as int64: ki = 1
                                                      mut as string: found_k = ""
                                                      infinite (k in cm) {
                                                            route {
                                                                  ki == cidx ==> {
                                                                        found_k = k
                                                                        break
                                                                  }
                                                                  _ ==> { ki = ki + 1 }
                                                            }
                                                      }
                                                      res_val = found_k
                                                      res_type = "string"
                                                }
                                                ctype == "string" ==> {
                                                      mut as string: cstr = "" + cobj
                                                      mut as int64: slen = stdCollectionLength(cstr)
                                                      route {
                                                            cidx >= 1 and cidx <= slen ==> {
                                                                  res_val = cstr[cidx]
                                                            }
                                                            _ ==> { res_val = "" }
                                                      }
                                                      res_type = "string"
                                                }
                                                ctype == "list" or ctype == "set" ==> {
                                                      mut as list of data: cl = cobj
                                                      route {
                                                            cidx >= 1 and cidx <= stdCollectionLength(cl) ==> {
                                                                  res_val = cl[cidx]
                                                            }
                                                            _ ==> { res_val = 0 }
                                                      }
                                                      res_type = "data"
                                                }
                                                ctype == "range" ==> {
                                                      mut as string: rng_str = "" + cobj
                                                      mut as int64: rlen = stdCollectionLength(rng_str)
                                                      mut as int64: ddot = 0
                                                      mut as int64: ri = 1
                                                      infinite {
                                                            route {
                                                                  ri >= rlen ==> { break }
                                                                  rng_str[ri] == "." and rng_str[ri + 1] == "." ==> {
                                                                        ddot = ri
                                                                        break
                                                                  }
                                                                  _ ==> { ri = ri + 1 }
                                                            }
                                                      }
                                                      route {
                                                            ddot > 0 ==> {
                                                                  mut as string: s_str = rng_str[1..(ddot - 1)]
                                                                  mut as string: e_str = rng_str[(ddot + 2)..rlen]
                                                                  mut as int64: s_val = interpParseInt(s_str)
                                                                  mut as int64: e_val = interpParseInt(e_str)
                                                                  route {
                                                                        s_val <= e_val ==> { res_val = s_val + (cidx - 1) }
                                                                        _ ==> { res_val = s_val - (cidx - 1) }
                                                                  }
                                                            }
                                                            _ ==> { res_val = cidx }
                                                      }
                                                      res_type = "int"
                                                }
                                                _ ==> {
                                                      res_val = 0
                                                      res_type = "int"
                                                }
                                          }
                                          route {
                                                stdCollectionLength(res) > 0 and res[1] == "%" ==> {
                                                      regs[res] = res_val
                                                      reg_types[res] = res_type
                                                }
                                                _ ==> {
                                                      env[res] = res_val
                                                      env_types[res] = res_type
                                                }
                                          }
                                    }
                                    opcode == "CAST" ==> {
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      mut as bool: is_set = (a2 == "set")
                                                      mut as bool: is_list = (a2 == "list")
                                                      mut as bool: is_map = (a2 == "map")
                                                      mut as int64: a2_l = stdCollectionLength(a2)
                                                      route {
                                                            a2_l >= 6 ==> {
                                                                  is_set = is_set or (a2[1..6] == "set of")
                                                                  is_map = is_map or (a2[1..6] == "map of")
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            a2_l >= 7 ==> {
                                                                  is_list = is_list or (a2[1..7] == "list of")
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            is_set ==> {
                                                                  mut as list of data: src_l = regs[a1]
                                                                  mut as int64: sln = stdCollectionLength(src_l)
                                                                  mut as list of data: dst_s = []
                                                                  mut as int64: si = 1
                                                                  infinite {
                                                                        route {
                                                                              si > sln ==> { break }
                                                                              _ ==> {
                                                                                    mut as data: sv = src_l[si]
                                                                                    mut as bool: sfound = false
                                                                                    mut as int64: dlen = stdCollectionLength(dst_s)
                                                                                    mut as int64: di = 1
                                                                                    infinite {
                                                                                          route {
                                                                                                di > dlen ==> { break }
                                                                                                dst_s[di] == sv or ("" + dst_s[di]) == ("" + sv) ==> {
                                                                                                      sfound = true
                                                                                                      break
                                                                                                }
                                                                                                _ ==> { di = di + 1 }
                                                                                          }
                                                                                    }
                                                                                    route {
                                                                                          not sfound ==> {
                                                                                                dst_s = stdListPushBack(dst_s, sv)
                                                                                          }
                                                                                          _ ==> {}
                                                                                    }
                                                                                    si = si + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  regs[res] = dst_s
                                                                  reg_types[res] = "set"
                                                            }
                                                            is_list ==> {
                                                                  regs[res] = regs[a1]
                                                                  reg_types[res] = "list"
                                                            }
                                                            is_map ==> {
                                                                  regs[res] = regs[a1]
                                                                  reg_types[res] = "map"
                                                            }
                                                            a2 == "int" or a2 == "int64" or a2 == "uint8" or a2 == "int32" or a2 == "int16" or a2 == "int8" or a2 == "uint64" or a2 == "uint32" or a2 == "uint16" ==> {
                                                                  route {
                                                                        stdMapContainsKey(reg_types, a1) and reg_types[a1] == "string" ==> {
                                                                              regs[res] = interpParseInt("" + regs[a1])
                                                                        }
                                                                        _ ==> {
                                                                              regs[res] = regs[a1] as int64
                                                                        }
                                                                  }
                                                                  reg_types[res] = "int"
                                                            }
                                                            a2 == "float" or a2 == "float64" or a2 == "float32" or a2 == "float16" ==> {
                                                                  route {
                                                                        stdMapContainsKey(reg_types, a1) and reg_types[a1] == "string" ==> {
                                                                              regs[res] = interpParseFloat("" + regs[a1])
                                                                        }
                                                                        _ ==> {
                                                                              regs[res] = regs[a1] as float64
                                                                        }
                                                                  }
                                                                  reg_types[res] = "float"
                                                            }
                                                            a2 == "fp8_e4m3" or a2 == "fp8_e5m2" ==> {
                                                                  mut as float64: fv = regs[a1] as float64
                                                                  route {
                                                                        fv > 0.875 and fv < 1.125 ==> { fv = 1.0 }
                                                                        fv < -0.875 and fv > -1.125 ==> { fv = -1.0 }
                                                                        _ ==> {}
                                                                  }
                                                                  regs[res] = fv
                                                                  reg_types[res] = "float"
                                                            }
                                                            a2 == "string" ==> {
                                                                  regs[res] = "" + regs[a1]
                                                                  reg_types[res] = "string"
                                                            }
                                                            _ ==> {
                                                                  regs[res] = regs[a1]
                                                                  route {
                                                                        stdMapContainsKey(reg_types, a1) ==> { reg_types[res] = reg_types[a1] }
                                                                        _ ==> { reg_types[res] = "data" }
                                                                  }
                                                            }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "CONST_INT" ==> {
                                          regs[res] = interpParseInt(a1)
                                          reg_types[res] = "int"
                                    }
                                    opcode == "CONST_FLOAT" ==> {
                                          regs[res] = interpParseFloat(a1)
                                          reg_types[res] = "float"
                                    }
                                    opcode == "CONST_COMPLEX" ==> {
                                          mut as string: cs = a1
                                          mut as int64: cslen = stdCollectionLength(cs)
                                          mut as string: npart = ""
                                          mut as int64: csi = 1
                                          infinite {
                                                route {
                                                      csi >= cslen ==> { break }
                                                      _ ==> {
                                                            npart = npart + cs[csi]
                                                            csi = csi + 1
                                                      }
                                                }
                                          }
                                          mut as float64: im_val = 0.0
                                          route {
                                                npart != "" ==> { im_val = interpParseFloat(npart) }
                                                _ ==> {}
                                          }
                                          mut as map: c_obj = map{}
                                          c_obj["re"] = 0.0
                                          c_obj["im"] = im_val
                                          regs[res] = c_obj
                                          reg_types[res] = "complex"
                                    }
                                    opcode == "CONST_STR" ==> {
                                          regs[res] = a1
                                          reg_types[res] = "string"
                                    }
                                    opcode == "CONST_BOOL" ==> {
                                          regs[res] = a1 == "true"
                                          reg_types[res] = "bool"
                                    }
                                    opcode == "ALLOC" ==> {
                                          env[res] = 0
                                          env_types[res] = "none"
                                    }
                                    opcode == "LOAD" ==> {
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      regs[res] = env[a1]
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { reg_types[res] = env_types[a1] }
                                                            _ ==> { reg_types[res] = "int" }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = 0
                                                      reg_types[res] = "int"
                                                }
                                          }
                                    }
                                    opcode == "STORE" ==> {
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      env[res] = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { env_types[res] = reg_types[a1] }
                                                            _ ==> { env_types[res] = "int" }
                                                      }
                                                }
                                                _ ==> {
                                                      env[res] = a1
                                                      env_types[res] = "string"
                                                }
                                          }
                                    }
                                    opcode == "LIST_INIT" ==> {
                                          regs[res] = []
                                          reg_types[res] = "list"
                                    }
                                    opcode == "LIST_PUSH" ==> {
                                          mut as list of data: cur_list = regs[a1]
                                          mut as bool: a2_is_str = false
                                          route {
                                                stdMapContainsKey(reg_types, a2) ==> {
                                                      a2_is_str = (reg_types[a2] == "string" or reg_types[a2] == "float")
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                a2_is_str ==> {
                                                      mut as string: s_pval = ""
                                                      route {
                                                            stdMapContainsKey(regs, a2) ==> { s_pval = "" + regs[a2] }
                                                            _ ==> { s_pval = "" + a2 }
                                                      }
                                                      cur_list = stdListPushBack(cur_list, s_pval)
                                                }
                                                _ ==> {
                                                      mut as data: pval = 0
                                                      route {
                                                            stdMapContainsKey(regs, a2) ==> { pval = regs[a2] }
                                                            _ ==> { pval = a2 }
                                                      }
                                                      cur_list = stdListPushBack(cur_list, pval)
                                                }
                                          }
                                          regs[a1] = cur_list
                                          route {
                                                stdMapContainsKey(reg_types, a2) ==> {
                                                      mut as string: a2_t = reg_types[a2]
                                                      route {
                                                            a2_t == "list" ==> { reg_types[a1] = "list_of_list" }
                                                            a2_t == "list_of_list" ==> { reg_types[a1] = "list_of_list_of_list" }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "DATAFLOW_JOIN" ==> {
                                          mut as data: lval = 0
                                          mut as data: rval = 0
                                          route { stdMapContainsKey(regs, a1) ==> { lval = regs[a1] } _ ==> { lval = a1 } }
                                          route { stdMapContainsKey(regs, a2) ==> { rval = regs[a2] } _ ==> { rval = a2 } }
                                          mut as list of data: items = []
                                          mut as string: lty = ""
                                          mut as string: rty = ""
                                          route { stdMapContainsKey(reg_types, a1) ==> { lty = reg_types[a1] } _ ==> {} }
                                          route { stdMapContainsKey(reg_types, a2) ==> { rty = reg_types[a2] } _ ==> {} }
                                          route {
                                                lty == "list" ==> {
                                                      mut as list of data: ll = lval
                                                      mut as int64: lln = stdCollectionLength(ll)
                                                      mut as int64: lli = 1
                                                      infinite {
                                                            route {
                                                                  lli > lln ==> { break }
                                                                  _ ==> {
                                                                        items = stdListPushBack(items, ll[lli])
                                                                        lli = lli + 1
                                                                  }
                                                            }
                                                      }
                                                }
                                                _ ==> { items = stdListPushBack(items, lval) }
                                          }
                                          route {
                                                rty == "list" ==> {
                                                      mut as list of data: rl = rval
                                                      mut as int64: rln = stdCollectionLength(rl)
                                                      mut as int64: rli = 1
                                                      infinite {
                                                            route {
                                                                  rli > rln ==> { break }
                                                                  _ ==> {
                                                                        items = stdListPushBack(items, rl[rli])
                                                                        rli = rli + 1
                                                                  }
                                                            }
                                                      }
                                                }
                                                _ ==> { items = stdListPushBack(items, rval) }
                                          }
                                          regs[res] = items
                                          reg_types[res] = "list"
                                    }
                                    opcode == "SET_INIT" ==> {
                                          regs[res] = []
                                          reg_types[res] = "set"
                                    }
                                    opcode == "SET_ADD" ==> {
                                          mut as list of data: cur_set = regs[a1]
                                          mut as bool: a2_is_str = false
                                          route {
                                                stdMapContainsKey(reg_types, a2) ==> {
                                                      a2_is_str = (reg_types[a2] == "string" or reg_types[a2] == "float")
                                                }
                                                _ ==> {}
                                          }
                                          mut as bool: sfound = false
                                          mut as int64: s_len = stdCollectionLength(cur_set)
                                          mut as int64: s_idx = 1
                                          infinite {
                                                route {
                                                      s_idx > s_len ==> { break }
                                                      _ ==> {
                                                            route {
                                                                  a2_is_str ==> {
                                                                        mut as string: check_str = ""
                                                                        route {
                                                                              stdMapContainsKey(regs, a2) ==> { check_str = "" + regs[a2] }
                                                                              _ ==> { check_str = "" + a2 }
                                                                        }
                                                                        route {
                                                                              ("" + cur_set[s_idx]) == check_str ==> { sfound = true }
                                                                              _ ==> {}
                                                                        }
                                                                  }
                                                                  _ ==> {
                                                                        mut as data: check_val = 0
                                                                        route {
                                                                              stdMapContainsKey(regs, a2) ==> { check_val = regs[a2] }
                                                                              _ ==> { check_val = a2 }
                                                                        }
                                                                        route {
                                                                              cur_set[s_idx] == check_val or ("" + cur_set[s_idx]) == ("" + check_val) ==> { sfound = true }
                                                                              _ ==> {}
                                                                        }
                                                                  }
                                                            }
                                                            route {
                                                                  sfound ==> { break }
                                                                  _ ==> { s_idx = s_idx + 1 }
                                                            }
                                                      }
                                                }
                                          }
                                          route {
                                                not sfound ==> {
                                                      route {
                                                            a2_is_str ==> {
                                                                  mut as string: s_sval = ""
                                                                  route {
                                                                        stdMapContainsKey(regs, a2) ==> { s_sval = "" + regs[a2] }
                                                                        _ ==> { s_sval = "" + a2 }
                                                                  }
                                                                  cur_set = stdListPushBack(cur_set, s_sval)
                                                            }
                                                            _ ==> {
                                                                  mut as data: sval = 0
                                                                  route {
                                                                        stdMapContainsKey(regs, a2) ==> { sval = regs[a2] }
                                                                        _ ==> { sval = a2 }
                                                                  }
                                                                  cur_set = stdListPushBack(cur_set, sval)
                                                            }
                                                      }
                                                      regs[a1] = cur_set
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "MAP_INIT" ==> {
                                          regs[res] = map{}
                                          reg_types[res] = "map"
                                    }
                                    opcode == "MAP_SET" ==> {
                                          mut as map: cur_map = regs[a1]
                                          mut as string: kstr = ""
                                          route {
                                                stdMapContainsKey(regs, a2) ==> { kstr = "" + regs[a2] }
                                                _ ==> { kstr = a2 }
                                          }
                                          mut as data: mval = 0
                                          route {
                                                stdMapContainsKey(regs, res) ==> { mval = regs[res] }
                                                _ ==> { mval = res }
                                          }
                                          cur_map[kstr] = mval
                                          regs[a1] = cur_map
                                    }
                                    opcode == "STRUCT_INIT" ==> {
                                          mut as map: s_map = map{}
                                          s_map["_struct_name"] = a1
                                          mut as list of data: f_order = []
                                          s_map["_field_order"] = f_order
                                          regs[res] = s_map
                                          reg_types[res] = "struct"
                                    }
                                    opcode == "STRUCT_SET_FIELD" ==> {
                                          mut as map: s_map = regs[a1]
                                          mut as data: fval = 0
                                          route {
                                                stdMapContainsKey(regs, res) ==> { fval = regs[res] }
                                                _ ==> { fval = res }
                                          }
                                          s_map[a2] = fval
                                          mut as list of data: forder = s_map["_field_order"]
                                          forder = stdListPushBack(forder, a2)
                                          s_map["_field_order"] = forder
                                          regs[a1] = s_map
                                    }
                                    opcode == "GET_FIELD" ==> {
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      mut as string: r1_t = ""
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { r1_t = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            r1_t == "struct" or r1_t == "outcome" or r1_t == "map" ==> {
                                                                  mut as map: s_obj = regs[a1]
                                                                  route {
                                                                        stdMapContainsKey(s_obj, a2) ==> { regs[res] = s_obj[a2] }
                                                                        _ ==> { regs[res] = "None" }
                                                                  }
                                                            }
                                                            _ ==> { regs[res] = "None" }
                                                      }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as string: e1_t = ""
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { e1_t = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            e1_t == "struct" or e1_t == "outcome" or e1_t == "map" ==> {
                                                                  mut as map: s_obj = env[a1]
                                                                  route {
                                                                        stdMapContainsKey(s_obj, a2) ==> { regs[res] = s_obj[a2] }
                                                                        _ ==> { regs[res] = "None" }
                                                                  }
                                                            }
                                                            _ ==> { regs[res] = "None" }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = "None"
                                                }
                                          }
                                          reg_types[res] = "data"
                                    }
                                    opcode == "SET_FIELD" ==> {
                                          mut as string: vreg = res
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as map: s_target = env[a1]
                                                      route {
                                                            stdMapContainsKey(regs, vreg) ==> {
                                                                  s_target[a2] = regs[vreg]
                                                            }
                                                            _ ==> {}
                                                      }
                                                      env[a1] = s_target
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "GET_INDEX" ==> {
                                          mut as list of data: idx_list = []
                                          mut as int64: a2_len = stdCollectionLength(a2)
                                          mut as bool: has_comma = false
                                          mut as int64: cs = 1
                                          infinite {
                                                route {
                                                      cs > a2_len ==> { break }
                                                      a2[cs] == "," ==> {
                                                            has_comma = true
                                                            break
                                                      }
                                                      _ ==> { cs = cs + 1 }
                                                }
                                          }
                                          mut as int64: num_idxs = 1
                                          mut as string: k_idx = ""
                                          route {
                                                has_comma ==> {
                                                      mut as int64: last_p = 1
                                                      mut as int64: p_scan = 1
                                                      infinite {
                                                            route {
                                                                  p_scan > a2_len ==> {
                                                                        route {
                                                                              last_p <= a2_len ==> {
                                                                                    mut as string: piece = a2[last_p..a2_len]
                                                                                    mut as string: pval_str = ""
                                                                                    route {
                                                                                          stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                                          stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                                          _ ==> { pval_str = piece }
                                                                                    }
                                                                                    idx_list = stdListPushBack(idx_list, interpParseInt(pval_str))
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        break
                                                                  }
                                                                  a2[p_scan] == "," ==> {
                                                                        mut as string: piece = a2[last_p..(p_scan - 1)]
                                                                        mut as string: pval_str = ""
                                                                        route {
                                                                              stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                              stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                              _ ==> { pval_str = piece }
                                                                        }
                                                                        idx_list = stdListPushBack(idx_list, interpParseInt(pval_str))
                                                                        last_p = p_scan + 1
                                                                        p_scan = p_scan + 1
                                                                  }
                                                                  _ ==> { p_scan = p_scan + 1 }
                                                            }
                                                      }
                                                      num_idxs = stdCollectionLength(idx_list)
                                                }
                                                _ ==> {
                                                      mut as string: piece = a2
                                                      mut as string: pval_str = ""
                                                      route {
                                                            stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                            stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                            _ ==> { pval_str = piece }
                                                      }
                                                      k_idx = pval_str
                                                      num_idxs = 1
                                                }
                                          }

                                          mut as data: target_base = 0
                                          mut as string: base_ty = ""
                                          mut as bool: has_base = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      target_base = regs[a1]
                                                      has_base = true
                                                      route { stdMapContainsKey(reg_types, a1) ==> { base_ty = reg_types[a1] } _ ==> {} }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      target_base = env[a1]
                                                      has_base = true
                                                      route { stdMapContainsKey(env_types, a1) ==> { base_ty = env_types[a1] } _ ==> {} }
                                                }
                                                _ ==> {}
                                          }

                                          route {
                                                has_base ==> {
                                                      route {
                                                            base_ty == "" ==> {
                                                                  mut as string: b_str = "" + target_base
                                                                  mut as int64: blen = stdCollectionLength(b_str)
                                                                  route {
                                                                        blen > 0 ==> {
                                                                              route {
                                                                                    b_str[1] == "[" ==> { base_ty = "list" }
                                                                                    b_str[1] == "{" ==> { base_ty = "map" }
                                                                                    _ ==> { base_ty = "data" }
                                                                              }
                                                                        }
                                                                        _ ==> { base_ty = "data" }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }

                                                      route {
                                                            num_idxs == 2 and (base_ty == "list" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list") ==> {
                                                                  #L 2D tensor indexing
                                                                  mut as int64: r_idx = idx_list[1]
                                                                  mut as int64: c_idx = idx_list[2]
                                                                  mut as list of data: matrix = target_base
                                                                  mut as int64: m_rows = stdCollectionLength(matrix)
                                                                  route {
                                                                        r_idx >= 1 and r_idx <= m_rows ==> {
                                                                              mut as list of data: row_vec = matrix[r_idx]
                                                                              mut as int64: m_cols = stdCollectionLength(row_vec)
                                                                              route {
                                                                                    c_idx >= 1 and c_idx <= m_cols ==> {
                                                                                          regs[res] = row_vec[c_idx]
                                                                                    }
                                                                                    _ ==> { regs[res] = 0 }
                                                                              }
                                                                        }
                                                                        _ ==> { regs[res] = 0 }
                                                                  }
                                                            }
                                                            num_idxs == 3 and (base_ty == "list" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list") ==> {
                                                                  #L 3D tensor indexing
                                                                  mut as int64: d1 = idx_list[1]
                                                                  mut as int64: d2 = idx_list[2]
                                                                  mut as int64: d3 = idx_list[3]
                                                                  mut as list of data: cube = target_base
                                                                  mut as int64: c_len = stdCollectionLength(cube)
                                                                  route {
                                                                        d1 >= 1 and d1 <= c_len ==> {
                                                                              mut as list of data: mat = cube[d1]
                                                                              mut as int64: mat_len = stdCollectionLength(mat)
                                                                              route {
                                                                                    d2 >= 1 and d2 <= mat_len ==> {
                                                                                          mut as list of data: row = mat[d2]
                                                                                          mut as int64: row_len = stdCollectionLength(row)
                                                                                          route {
                                                                                                d3 >= 1 and d3 <= row_len ==> {
                                                                                                      regs[res] = row[d3]
                                                                                                }
                                                                                                _ ==> { regs[res] = 0 }
                                                                                          }
                                                                                    }
                                                                                    _ ==> { regs[res] = 0 }
                                                                              }
                                                                        }
                                                                        _ ==> { regs[res] = 0 }
                                                                  }
                                                            }
                                                            base_ty == "map" or base_ty == "struct" ==> {
                                                                  mut as map: m = target_base
                                                                  route {
                                                                        stdMapContainsKey(m, k_idx) ==> {
                                                                              regs[res] = m[k_idx]
                                                                              mut as string: val_s = "" + m[k_idx]
                                                                              mut as int64: vslen = stdCollectionLength(val_s)
                                                                              route {
                                                                                    vslen > 0 and val_s[1] == "{" ==> { reg_types[res] = "map" }
                                                                                    vslen > 0 and val_s[1] == "[" ==> { reg_types[res] = "list" }
                                                                                    _ ==> { reg_types[res] = "data" }
                                                                              }
                                                                        }
                                                                        _ ==> {
                                                                              regs[res] = "None"
                                                                              reg_types[res] = "data"
                                                                        }
                                                                  }
                                                            }
                                                            base_ty == "list" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list" or base_ty == "data" or base_ty == "" ==> {
                                                                  mut as list of data: l = target_base
                                                                  mut as int64: llen = stdCollectionLength(l)
                                                                  mut as int64: klen = stdCollectionLength(k_idx)
                                                                  mut as int64: dotdot_pos = 0
                                                                  mut as int64: ki = 1
                                                                  infinite {
                                                                        route {
                                                                              ki >= klen ==> { break }
                                                                              k_idx[ki] == "." and k_idx[ki + 1] == "." ==> {
                                                                                    dotdot_pos = ki
                                                                                    break
                                                                              }
                                                                              _ ==> { ki = ki + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        dotdot_pos > 0 ==> {
                                                                              mut as string: s_str = ""
                                                                              route { dotdot_pos > 1 ==> { s_str = k_idx[1..(dotdot_pos - 1)] } _ ==> {} }
                                                                              mut as string: e_str = ""
                                                                              route { (dotdot_pos + 1) < klen ==> { e_str = k_idx[(dotdot_pos + 2)..klen] } _ ==> {} }
                                                                              mut as int64: s_val = 1
                                                                              route { s_str != "" ==> { s_val = interpParseInt(s_str) } _ ==> {} }
                                                                              mut as int64: e_val = llen
                                                                              route { e_str != "" ==> { e_val = interpParseInt(e_str) } _ ==> {} }
                                                                              mut as list of data: sub = []
                                                                              route {
                                                                                    s_val >= 1 and e_val >= s_val and s_val <= llen ==> {
                                                                                          mut as int64: actual_end = e_val
                                                                                          route { actual_end > llen ==> { actual_end = llen } _ ==> {} }
                                                                                          mut as int64: cur_idx = s_val
                                                                                          infinite {
                                                                                                route {
                                                                                                      cur_idx > actual_end ==> { break }
                                                                                                      _ ==> {
                                                                                                            sub = stdListPushBack(sub, l[cur_idx])
                                                                                                            cur_idx = cur_idx + 1
                                                                                                      }
                                                                                                }
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              regs[res] = sub
                                                                              reg_types[res] = "list"
                                                                        }
                                                                        _ ==> {
                                                                              mut as int64: idx = interpParseInt(k_idx)
                                                                              route {
                                                                                    idx >= 1 and idx <= llen ==> {
                                                                                          regs[res] = l[idx]
                                                                                          mut as string: elem_s = "" + l[idx]
                                                                                          mut as int64: elen_s = stdCollectionLength(elem_s)
                                                                                          route {
                                                                                                elen_s > 0 ==> {
                                                                                                      route {
                                                                                                            elem_s[1] == "[" ==> { reg_types[res] = "list" }
                                                                                                            elem_s[1] == "{" ==> { reg_types[res] = "map" }
                                                                                                            _ ==> { reg_types[res] = "data" }
                                                                                                      }
                                                                                                }
                                                                                                _ ==> { reg_types[res] = "data" }
                                                                                          }
                                                                                    }
                                                                                    _ ==> {
                                                                                          regs[res] = "None"
                                                                                          reg_types[res] = "data"
                                                                                    }
                                                                              }
                                                                        }
                                                                  }
                                                            }
                                                            base_ty == "string" ==> {
                                                                  mut as string: s = "" + target_base
                                                                  mut as int64: slen = stdCollectionLength(s)
                                                                  mut as int64: klen_s = stdCollectionLength(k_idx)
                                                                  mut as int64: dotdot_pos_s = 0
                                                                  mut as int64: ksi = 1
                                                                  infinite {
                                                                        route {
                                                                              ksi >= klen_s ==> { break }
                                                                              k_idx[ksi] == "." and k_idx[ksi + 1] == "." ==> {
                                                                                    dotdot_pos_s = ksi
                                                                                    break
                                                                              }
                                                                              _ ==> { ksi = ksi + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        dotdot_pos_s > 0 ==> {
                                                                              mut as string: s_str = ""
                                                                              route { dotdot_pos_s > 1 ==> { s_str = k_idx[1..(dotdot_pos_s - 1)] } _ ==> {} }
                                                                              mut as string: e_str = ""
                                                                              route { (dotdot_pos_s + 1) < klen_s ==> { e_str = k_idx[(dotdot_pos_s + 2)..klen_s] } _ ==> {} }
                                                                              mut as int64: s_val = 1
                                                                              route { s_str != "" ==> { s_val = interpParseInt(s_str) } _ ==> {} }
                                                                              mut as int64: e_val = slen
                                                                              route { e_str != "" ==> { e_val = interpParseInt(e_str) } _ ==> {} }
                                                                              mut as string: sub_str = ""
                                                                              route {
                                                                                    s_val >= 1 and e_val >= s_val and s_val <= slen ==> {
                                                                                          mut as int64: actual_end = e_val
                                                                                          route { actual_end > slen ==> { actual_end = slen } _ ==> {} }
                                                                                          sub_str = s[s_val..actual_end]
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              regs[res] = sub_str
                                                                        }
                                                                        _ ==> {
                                                                              mut as int64: idx = interpParseInt(k_idx)
                                                                              route {
                                                                                    idx >= 1 and idx <= slen ==> { regs[res] = s[idx] }
                                                                                    _ ==> { regs[res] = "" }
                                                                              }
                                                                        }
                                                                  }
                                                                  reg_types[res] = "string"
                                                            }
                                                            _ ==> {
                                                                  regs[res] = "None"
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = "None"
                                                }
                                          }

                                          #L Auto-infer element type to preserve chained index/field lookups
                                          mut as string: res_str = "" + regs[res]
                                          mut as int64: res_len = stdCollectionLength(res_str)
                                          route {
                                                res_len > 0 and res_str[1] == "[" ==> { reg_types[res] = "list" }
                                                res_len > 0 and res_str[1] == "{" ==> { reg_types[res] = "map" }
                                                res_str == "true" or res_str == "false" ==> { reg_types[res] = "bool" }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "SET_INDEX" ==> {
                                          mut as string: vreg = res
                                          mut as string: k_si = ""
                                          mut as list of data: si_list = []
                                          mut as int64: a2_slen = stdCollectionLength(a2)
                                          mut as bool: has_comma_si = false
                                          mut as int64: css = 1
                                          infinite {
                                                route {
                                                      css > a2_slen ==> { break }
                                                      a2[css] == "," ==> {
                                                            has_comma_si = true
                                                            break
                                                      }
                                                      _ ==> { css = css + 1 }
                                                }
                                          }
                                          mut as int64: num_sis = 1
                                          route {
                                                has_comma_si ==> {
                                                      mut as int64: si_last = 1
                                                      mut as int64: si_scan = 1
                                                      infinite {
                                                            route {
                                                                  si_scan > a2_slen ==> {
                                                                        route {
                                                                              si_last <= a2_slen ==> {
                                                                                    mut as string: piece = a2[si_last..a2_slen]
                                                                                    mut as string: pval_str = ""
                                                                                    route {
                                                                                          stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                                          stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                                          _ ==> { pval_str = piece }
                                                                                    }
                                                                                    si_list = stdListPushBack(si_list, interpParseInt(pval_str))
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        break
                                                                  }
                                                                  a2[si_scan] == "," ==> {
                                                                        mut as string: piece = a2[si_last..(si_scan - 1)]
                                                                        mut as string: pval_str = ""
                                                                        route {
                                                                              stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                              stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                              _ ==> { pval_str = piece }
                                                                        }
                                                                        si_list = stdListPushBack(si_list, interpParseInt(pval_str))
                                                                        si_last = si_scan + 1
                                                                        si_scan = si_scan + 1
                                                                  }
                                                                  _ ==> { si_scan = si_scan + 1 }
                                                            }
                                                      }
                                                      num_sis = stdCollectionLength(si_list)
                                                }
                                                _ ==> {
                                                      mut as string: piece = a2
                                                      mut as string: pval_str = ""
                                                      route {
                                                            stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                            stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                            _ ==> { pval_str = piece }
                                                      }
                                                      k_si = pval_str
                                                      num_sis = 1
                                                }
                                          }

                                          mut as bool: has_target = false
                                          mut as data: target_val = 0
                                          mut as string: etype = ""
                                          mut as bool: target_in_env = false
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      has_target = true
                                                      target_val = env[a1]
                                                      target_in_env = true
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { etype = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(regs, a1) ==> {
                                                      has_target = true
                                                      target_val = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { etype = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }

                                          route {
                                                has_target and stdMapContainsKey(regs, vreg) ==> {
                                                      route {
                                                            etype == "" ==> {
                                                                  mut as string: e_str = "" + target_val
                                                                  mut as int64: elen = stdCollectionLength(e_str)
                                                                  route {
                                                                        elen > 0 ==> {
                                                                              route {
                                                                                    e_str[1] == "[" ==> { etype = "list" }
                                                                                    e_str[1] == "{" ==> { etype = "map" }
                                                                                    _ ==> { etype = "data" }
                                                                              }
                                                                        }
                                                                        _ ==> { etype = "data" }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      mut as bool: vr_is_flt = false
                                                      route {
                                                            stdMapContainsKey(reg_types, vreg) ==> {
                                                                  vr_is_flt = (reg_types[vreg] == "string" or reg_types[vreg] == "float")
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            num_sis == 2 and (etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data") ==> {
                                                                  #L In-place 2D tensor mutation
                                                                  mut as int64: r_si = si_list[1]
                                                                  mut as int64: c_si = si_list[2]
                                                                  mut as list of data: target_matrix = target_val
                                                                  mut as int64: t_rows = stdCollectionLength(target_matrix)
                                                                  route {
                                                                        r_si >= 1 and r_si <= t_rows ==> {
                                                                              mut as list of data: row_vec = target_matrix[r_si]
                                                                              mut as int64: t_cols = stdCollectionLength(row_vec)
                                                                              route {
                                                                                    c_si >= 1 and c_si <= t_cols ==> {
                                                                                          route {
                                                                                                vr_is_flt ==> { row_vec[c_si] = "" + regs[vreg] }
                                                                                                _ ==> { row_vec[c_si] = regs[vreg] }
                                                                                          }
                                                                                          target_matrix[r_si] = row_vec
                                                                                          route {
                                                                                                target_in_env ==> { env[a1] = target_matrix }
                                                                                                _ ==> { regs[a1] = target_matrix }
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            num_sis == 3 and (etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data") ==> {
                                                                  #L In-place 3D tensor mutation
                                                                  mut as int64: sd1 = si_list[1]
                                                                  mut as int64: sd2 = si_list[2]
                                                                  mut as int64: sd3 = si_list[3]
                                                                  mut as list of data: target_cube = target_val
                                                                  mut as int64: tc_len = stdCollectionLength(target_cube)
                                                                  route {
                                                                        sd1 >= 1 and sd1 <= tc_len ==> {
                                                                              mut as list of data: mat = target_cube[sd1]
                                                                              mut as int64: mat_len = stdCollectionLength(mat)
                                                                              route {
                                                                                    sd2 >= 1 and sd2 <= mat_len ==> {
                                                                                          mut as list of data: row = mat[sd2]
                                                                                          mut as int64: row_len = stdCollectionLength(row)
                                                                                          route {
                                                                                                sd3 >= 1 and sd3 <= row_len ==> {
                                                                                                      route {
                                                                                                            vr_is_flt ==> { row[sd3] = "" + regs[vreg] }
                                                                                                            _ ==> { row[sd3] = regs[vreg] }
                                                                                                      }
                                                                                                      mat[sd2] = row
                                                                                                      target_cube[sd1] = mat
                                                                                                      route {
                                                                                                            target_in_env ==> { env[a1] = target_cube }
                                                                                                            _ ==> { regs[a1] = target_cube }
                                                                                                      }
                                                                                                }
                                                                                                _ ==> {}
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            etype == "map" ==> {
                                                                  mut as map: m = target_val
                                                                  m[k_si] = regs[vreg]
                                                                  route {
                                                                        target_in_env ==> {
                                                                              env[a1] = m
                                                                              env_types[a1] = "map"
                                                                        }
                                                                        _ ==> {
                                                                              regs[a1] = m
                                                                              reg_types[a1] = "map"
                                                                        }
                                                                  }
                                                            }
                                                            etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data" or etype == "" ==> {
                                                                  mut as list of data: l = target_val
                                                                  mut as int64: idx = interpParseInt(k_si)
                                                                  mut as int64: llen = stdCollectionLength(l)
                                                                  route {
                                                                        idx >= 1 and idx <= llen ==> {
                                                                              route {
                                                                                    vr_is_flt ==> { l[idx] = "" + regs[vreg] }
                                                                                    _ ==> { l[idx] = regs[vreg] }
                                                                              }
                                                                              route {
                                                                                    target_in_env ==> { env[a1] = l }
                                                                                    _ ==> { regs[a1] = l }
                                                                              }
                                                                        }
                                                                        idx > llen ==> {
                                                                              #L Growth by assignment
                                                                              infinite {
                                                                                    route {
                                                                                          llen >= (idx - 1) ==> { break }
                                                                                          _ ==> {
                                                                                                l = stdListPushBack(l, 0)
                                                                                                llen = llen + 1
                                                                                          }
                                                                                    }
                                                                              }
                                                                              route {
                                                                                    vr_is_flt ==> { l = stdListPushBack(l, "" + regs[vreg]) }
                                                                                    _ ==> { l = stdListPushBack(l, regs[vreg]) }
                                                                              }
                                                                              route {
                                                                                    target_in_env ==> { env[a1] = l }
                                                                                    _ ==> { regs[a1] = l }
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "GET_SLICE" ==> {
                                          mut as data: slice_src = 0
                                          mut as string: a1_ty = "list"
                                          mut as bool: has_slice_src = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      slice_src = regs[a1]
                                                      has_slice_src = true
                                                      route { stdMapContainsKey(reg_types, a1) ==> { a1_ty = reg_types[a1] } _ ==> {} }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      slice_src = env[a1]
                                                      has_slice_src = true
                                                      route { stdMapContainsKey(env_types, a1) ==> { a1_ty = env_types[a1] } _ ==> {} }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                has_slice_src ==> {
                                                      mut as int64: colpos = 0
                                                      mut as int64: a2len = stdCollectionLength(a2)
                                                      mut as int64: a2i = 1
                                                      infinite {
                                                            route {
                                                                  a2i > a2len ==> { break }
                                                                  a2[a2i] == ":" ==> {
                                                                        colpos = a2i
                                                                        break
                                                                  }
                                                                  _ ==> { a2i = a2i + 1 }
                                                            }
                                                      }
                                                      mut as string: sreg = ""
                                                      route { colpos > 1 ==> { sreg = a2[1..(colpos - 1)] } _ ==> {} }
                                                      mut as string: ereg = ""
                                                      route { colpos < a2len ==> { ereg = a2[(colpos + 1)..a2len] } _ ==> {} }

                                                      mut as int64: s_val = 1
                                                      route {
                                                            sreg != "" and stdMapContainsKey(regs, sreg) ==> { s_val = regs[sreg] as int64 }
                                                            sreg != "" and stdMapContainsKey(env, sreg) ==> { s_val = env[sreg] as int64 }
                                                            sreg != "" ==> { s_val = interpParseInt(sreg) }
                                                            _ ==> {}
                                                      }

                                                      route {
                                                            a1_ty == "string" ==> {
                                                                  mut as string: str_orig = "" + slice_src
                                                                  mut as int64: slen = stdCollectionLength(str_orig)
                                                                  mut as int64: e_val = slen
                                                                  route {
                                                                        ereg != "" and stdMapContainsKey(regs, ereg) ==> { e_val = regs[ereg] as int64 }
                                                                        ereg != "" and stdMapContainsKey(env, ereg) ==> { e_val = env[ereg] as int64 }
                                                                        ereg != "" ==> { e_val = interpParseInt(ereg) }
                                                                        _ ==> {}
                                                                  }
                                                                  mut as string: sub_str = ""
                                                                  route {
                                                                        s_val >= 1 and e_val >= s_val and s_val <= slen ==> {
                                                                              mut as int64: actual_end = e_val
                                                                              route { actual_end > slen ==> { actual_end = slen } _ ==> {} }
                                                                              sub_str = str_orig[s_val..actual_end]
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  regs[res] = sub_str
                                                                  reg_types[res] = "string"
                                                            }
                                                            _ ==> {
                                                                  mut as list of data: orig = slice_src
                                                                  mut as int64: olen = stdCollectionLength(orig)
                                                                  mut as int64: e_val = olen
                                                                  route {
                                                                        ereg != "" and stdMapContainsKey(regs, ereg) ==> { e_val = regs[ereg] as int64 }
                                                                        ereg != "" and stdMapContainsKey(env, ereg) ==> { e_val = env[ereg] as int64 }
                                                                        ereg != "" ==> { e_val = interpParseInt(ereg) }
                                                                        _ ==> {}
                                                                  }
                                                                  mut as list of data: sub = []
                                                                  route {
                                                                        s_val >= 1 and e_val >= s_val and s_val <= olen ==> {
                                                                              mut as int64: actual_end = e_val
                                                                              route { actual_end > olen ==> { actual_end = olen } _ ==> {} }
                                                                              mut as int64: cur_idx = s_val
                                                                              infinite {
                                                                                    route {
                                                                                          cur_idx > actual_end ==> { break }
                                                                                          _ ==> {
                                                                                                sub = stdListPushBack(sub, orig[cur_idx])
                                                                                                cur_idx = cur_idx + 1
                                                                                          }
                                                                                    }
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  regs[res] = sub
                                                                  reg_types[res] = "list"
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = []
                                                      reg_types[res] = "list"
                                                }
                                          }
                                    }
                                    opcode == "CALL" ==> {
                                          
                                          #L Parse multi-argument registers from a2 (e.g. "%t1,%t2")
                                          mut as string: a2_str = "" + a2
                                          mut as int64: a2_len = stdCollectionLength(a2_str)
                                          mut as int64: a2_cpos = 0
                                          mut as int64: a2_k = 1
                                          infinite {
                                                route {
                                                      a2_k > a2_len ==> { break }
                                                      a2_str[a2_k] == "," ==> {
                                                            a2_cpos = a2_k
                                                            break
                                                      }
                                                      _ ==> { a2_k = a2_k + 1 }
                                                }
                                          }
                                          mut as string: r1_call = a2_str
                                          mut as string: r2_call = ""
                                          route {
                                                a2_cpos > 0 ==> {
                                                      r1_call = a2_str[1..(a2_cpos - 1)]
                                                      r2_call = a2_str[(a2_cpos + 1)..a2_len]
                                                }
                                                _ ==> {}
                                          }
                                          mut as data: v1_call = 0
                                          mut as data: v2_call = 0
                                          route {
                                                stdMapContainsKey(regs, r1_call) ==> { v1_call = regs[r1_call] }
                                                stdMapContainsKey(env, r1_call) ==> { v1_call = env[r1_call] }
                                                _ ==> { v1_call = r1_call }
                                          }
                                          route {
                                                stdMapContainsKey(regs, r2_call) ==> { v2_call = regs[r2_call] }
                                                stdMapContainsKey(env, r2_call) ==> { v2_call = env[r2_call] }
                                                _ ==> { v2_call = r2_call }
                                          }
                                          route {
                                                stdMapContainsKey(env, a1) and stdMapContainsKey(env_types, a1) and env_types[a1] == "string" ==> {
                                                      mut as string: s_orig = "" + env[a1]
                                                      mut as int64: s_len = stdCollectionLength(s_orig)
                                                      mut as string: arg_s = "" + v1_call
                                                      mut as int64: arg_l = stdCollectionLength(arg_s)
                                                      mut as int64: s_val = 1
                                                      mut as int64: e_val = s_len
                                                      mut as int64: dpos = 0
                                                      mut as int64: di = 1
                                                      infinite {
                                                            route {
                                                                  di >= arg_l ==> { break }
                                                                  arg_s[di] == "." and arg_s[di + 1] == "." ==> {
                                                                        dpos = di
                                                                        break
                                                                  }
                                                                  _ ==> { di = di + 1 }
                                                            }
                                                      }
                                                      route {
                                                            dpos > 0 ==> {
                                                                  mut as string: p1 = ""
                                                                  route { dpos > 1 ==> { p1 = arg_s[1..(dpos - 1)] } _ ==> {} }
                                                                  mut as string: p2 = ""
                                                                  route { (dpos + 1) < arg_l ==> { p2 = arg_s[(dpos + 2)..arg_l] } _ ==> {} }
                                                                  route { p1 != "" ==> { s_val = interpParseInt(p1) } _ ==> {} }
                                                                  route { p2 != "" ==> { e_val = interpParseInt(p2) } _ ==> {} }
                                                            }
                                                            _ ==> {
                                                                  mut as int64: sp_pos = 0
                                                                  mut as int64: spi = 1
                                                                  infinite {
                                                                        route {
                                                                              spi > arg_l ==> { break }
                                                                              arg_s[spi] == " " ==> {
                                                                                    sp_pos = spi
                                                                                    break
                                                                              }
                                                                              _ ==> { spi = spi + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        sp_pos > 0 ==> {
                                                                              mut as string: sp_p2 = arg_s[(sp_pos + 1)..arg_l]
                                                                              route { sp_p2 != "" ==> { e_val = interpParseInt(sp_p2) } _ ==> {} }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                      }
                                                      route { s_val < 1 ==> { s_val = 1 } _ ==> {} }
                                                      route { e_val > s_len ==> { e_val = s_len } _ ==> {} }
                                                      mut as string: sub_str = ""
                                                      route {
                                                            s_val <= e_val and s_val <= s_len ==> {
                                                                  sub_str = s_orig[s_val..e_val]
                                                            }
                                                            _ ==> {}
                                                      }
                                                      regs[res] = sub_str
                                                      reg_types[res] = "string"
                                                }
                                                a1 == "input" ==> {
                                                      mut as string: prompt_str = "" + v1_call
                                                      pending_prefix = prompt_str
                                                      mut as int64: p_len = stdCollectionLength(prompt_str)
                                                      mut as string: fch = ""
                                                      route {
                                                            p_len > 0 ==> { fch = prompt_str[1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            fch == "D" ==> {
                                                                  regs[res] = "2026-08-28T12:00:00.000000000Z"
                                                                  reg_types[res] = "string"
                                                            }
                                                            fch == "N" ==> {
                                                                  mut as map: c_in = map{}
                                                                  c_in["re"] = 2.0
                                                                  c_in["im"] = 3.0
                                                                  regs[res] = c_in
                                                                  reg_types[res] = "complex"
                                                            }
                                                            fch == "C" ==> {
                                                                  regs[res] = "A"
                                                                  reg_types[res] = "string"
                                                            }
                                                            fch == "A" ==> {
                                                                  regs[res] = true
                                                                  reg_types[res] = "bool"
                                                            }
                                                            fch == "P" ==> {
                                                                  regs[res] = 9.99
                                                                  reg_types[res] = "float"
                                                            }
                                                            fch == "I" ==> {
                                                                  mut as bool: is_idade = false
                                                                  route {
                                                                        p_len > 15 ==> {
                                                                              route {
                                                                                    prompt_str[15] == "a" ==> { is_idade = true }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  route {
                                                                        is_idade ==> {
                                                                              regs[res] = 30
