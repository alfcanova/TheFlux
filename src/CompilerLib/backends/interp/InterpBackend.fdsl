                                                                                    mut as int64: mat_n = stdCollectionLength(mat)
                                                                                    mut as string: mat_str = "["
                                                                                    mut as int64: mi = 1
                                                                                    infinite {
                                                                                          route {
                                                                                                mi > mat_n ==> { break }
                                                                                                _ ==> {
                                                                                                      mut as list of data: row = mat[mi]
                                                                                                      mut as int64: row_n = stdCollectionLength(row)
                                                                                                      mut as string: row_str = "["
                                                                                                      mut as int64: ri = 1
                                                                                                      infinite {
                                                                                                            route {
                                                                                                                  ri > row_n ==> { break }
                                                                                                                  _ ==> {
                                                                                                                        route {
                                                                                                                              ri == 1 ==> { row_str = row_str + "" + row[ri] }
                                                                                                                              _ ==> { row_str = row_str + ", " + row[ri] }
                                                                                                                        }
                                                                                                                        ri = ri + 1
                                                                                                                  }
                                                                                                            }
                                                                                                      }
                                                                                                      row_str = row_str + "]"
                                                                                                      route {
                                                                                                            mi == 1 ==> { mat_str = mat_str + row_str }
                                                                                                            _ ==> { mat_str = mat_str + ", " + row_str }
                                                                                                      }
                                                                                                      mi = mi + 1
                                                                                                }
                                                                                          }
                                                                                    }
                                                                                    mat_str = mat_str + "]"
                                                                                    route {
                                                                                          li == 1 ==> { pval = pval + mat_str }
                                                                                          _ ==> { pval = pval + ", " + mat_str }
                                                                                    }
                                                                                    li = li + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  pval = pval + "]"
                                                            }
                                                            ptype == "set" ==> {
                                                                  mut as list of data: st = regs[a1]
                                                                  mut as int64: stn = stdCollectionLength(st)
                                                                  pval = "{"
                                                                  mut as int64: si = 1
                                                                  infinite {
                                                                        route {
                                                                              si > stn ==> { break }
                                                                              _ ==> {
                                                                                    route {
                                                                                          si == 1 ==> { pval = pval + "" + st[si] }
                                                                                          _ ==> { pval = pval + ", " + st[si] }
                                                                                    }
                                                                                    si = si + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  pval = pval + "}"
                                                            }
                                                            ptype == "map" ==> {
                                                                  mut as map: m = regs[a1]
                                                                  mut as int64: mn = stdCollectionLength(m)
                                                                  route {
                                                                        mn == 0 ==> { pval = "{}" }
                                                                        _ ==> {
                                                                              pval = "{"
                                                                              mut as int64: mi = 1
                                                                              infinite (k in m) {
                                                                                    route {
                                                                                          mi == 1 ==> { pval = pval + k + ": " + m[k] }
                                                                                          _ ==> { pval = pval + ", " + k + ": " + m[k] }
                                                                                    }
                                                                                    mi = mi + 1
                                                                              }
                                                                              pval = pval + "}"
                                                                        }
                                                                  }
                                                            }
                                                            ptype == "struct" ==> {
                                                                  mut as map: sm = regs[a1]
                                                                  mut as string: sname = sm["_struct_name"]
                                                                  pval = sname + "("
                                                                  mut as list of data: forder = sm["_field_order"]
                                                                  mut as int64: f_count = stdCollectionLength(forder)
                                                                  mut as int64: fi = 1
                                                                  infinite {
                                                                        route {
                                                                              fi > f_count ==> { break }
                                                                              _ ==> {
                                                                                    mut as string: f = forder[fi]
                                                                                    route {
                                                                                          fi == 1 ==> { pval = pval + "." + f + ": " + sm[f] }
                                                                                          _ ==> { pval = pval + ", ." + f + ": " + sm[f] }
                                                                                    }
                                                                                    fi = fi + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  pval = pval + ")"
                                                            }
                                                            ptype == "complex" ==> {
                                                                  mut as map: cm = regs[a1]
                                                                  mut as float64: cr = cm["re"] as float64
                                                                  mut as float64: ci = cm["im"] as float64
                                                                  route {
                                                                        ci >= 0.0 ==> {
                                                                              pval = "" + cr + " + " + ci + "i"
                                                                        }
                                                                        _ ==> {
                                                                              mut as float64: pos_ci = 0.0 - ci
                                                                              pval = "" + cr + " - " + pos_ci + "i"
                                                                        }
                                                                  }
                                                            }
                                                            ptype == "outcome" ==> {
                                                                  mut as map: outm = regs[a1]
                                                                  pval = "" + outm["val"]
                                                            }
                                                            _ ==> {
                                                                  pval = "" + regs[a1]
                                                            }
                                                      }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as string: et = ""
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { et = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            et == "complex" ==> {
                                                                  mut as map: cm_env = env[a1]
                                                                  mut as float64: cr_env = cm_env["re"] as float64
                                                                  mut as float64: ci_env = cm_env["im"] as float64
                                                                  route {
                                                                        ci_env >= 0.0 ==> {
                                                                              pval = "" + cr_env + " + " + ci_env + "i"
                                                                        }
                                                                        _ ==> {
                                                                              mut as float64: pos_ci_env = 0.0 - ci_env
                                                                              pval = "" + cr_env + " - " + pos_ci_env + "i"
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {
                                                                  pval = "" + env[a1]
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      pval = a1
                                                }
                                          }
                                          route {
                                                pending_prefix != "" ==> {
                                                      pval = pending_prefix + pval
                                                      pending_prefix = ""
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                stdCollectionLength(pval) >= 19 ==> {
                                                      pval = interpNormalizeDatetime(pval)
                                                }
                                                _ ==> {}
                                          }
                                          pval = interpCleanStructRepr(pval)
                                          print(pval)
                                          stdout_acc = stdout_acc + pval + "\n"
                                    }
                                    opcode == "EMIT" ==> {
                                          mut as data: eval = 0
                                          mut as string: ret_val_type = "data"
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      eval = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { ret_val_type = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      eval = env[a1]
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { ret_val_type = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(global_env, a1) ==> {
                                                      eval = global_env[a1]
                                                      route {
                                                            stdMapContainsKey(global_env_types, a1) ==> { ret_val_type = global_env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {
                                                      mut as int64: a1_len = stdCollectionLength(a1)
                                                      route {
                                                            a1 == "true" ==> {
                                                                  eval = true
                                                                  ret_val_type = "bool"
                                                            }
                                                            a1 == "false" ==> {
                                                                  eval = false
                                                                  ret_val_type = "bool"
                                                            }
                                                            a1_len > 0 and (a1[1] == "\"" or a1[1] == "'") ==> {
                                                                  eval = a1[2..(a1_len - 1)]
                                                                  ret_val_type = "string"
                                                            }
                                                            a1_len > 0 and ((a1[1] >= "0" and a1[1] <= "9") or (a1[1] == "-" and a1_len > 1)) ==> {
                                                                  route {
                                                                        interpStrContains(a1, ".") ==> {
                                                                              eval = interpParseFloat(a1)
                                                                              ret_val_type = "float"
                                                                        }
                                                                        _ ==> {
                                                                              eval = interpParseInt(a1)
                                                                              ret_val_type = "int"
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {
                                                                  eval = a1
                                                                  ret_val_type = "string"
                                                            }
                                                      }
                                                }
                                          }
                                          route {
                                                ret_val_type == "outcome" ==> {
                                                      mut as map: om_eval = eval
                                                      eval = om_eval["val"]
                                                      route {
                                                            stdMapContainsKey(om_eval, "_val_type") ==> {
                                                                  ret_val_type = "" + om_eval["_val_type"]
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                ret_val_type == "int64" or ret_val_type == "int32" or ret_val_type == "int16" or ret_val_type == "int8" or ret_val_type == "uint64" or ret_val_type == "uint32" or ret_val_type == "uint16" or ret_val_type == "uint8" ==> {
                                                      ret_val_type = "int"
                                                }
                                                ret_val_type == "float64" or ret_val_type == "float32" or ret_val_type == "float16" ==> {
                                                      ret_val_type = "float"
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                (ret_val_type == "data" or ret_val_type == "") and cur_fn_ret_type != "data" and cur_fn_ret_type != "" ==> {
                                                      ret_val_type = cur_fn_ret_type
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                ret_val_type == "data" or ret_val_type == "" ==> {
                                                      ret_val_type = interpInferDataType(eval)
                                                }
                                                _ ==> {}
                                          }
                                          mut as string: emit_sta = a2
                                          route { emit_sta == "" ==> { emit_sta = "nice" } _ ==> {} }
                                          mut as string: emit_msg = "ok"
                                          route {
                                                res != "" and stdMapContainsKey(regs, res) ==> { emit_msg = "" + regs[res] }
                                                res != "" and stdMapContainsKey(env, res) ==> { emit_msg = "" + env[res] }
                                                res != "" ==> { emit_msg = res }
                                                _ ==> {}
                                          }
                                          mut as string: eval_s = ""
                                          mut as float64: eval_f = 0.0
                                          mut as bool: eval_b = false
                                          mut as int64: eval_i = 0
                                          mut as list of data: eval_l = []
                                          mut as map: eval_m = map{}
                                          route {
                                                ret_val_type == "string" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_s = regs[a1] as string }
                                                            stdMapContainsKey(env, a1) ==> { eval_s = env[a1] as string }
                                                            _ ==> { eval_s = eval as string }
                                                      }
                                                }
                                                ret_val_type == "float" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_f = regs[a1] as float64 }
                                                            stdMapContainsKey(env, a1) ==> { eval_f = env[a1] as float64 }
                                                            _ ==> { eval_f = eval as float64 }
                                                      }
                                                }
                                                ret_val_type == "bool" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_b = regs[a1] as bool }
                                                            stdMapContainsKey(env, a1) ==> { eval_b = env[a1] as bool }
                                                            _ ==> { eval_b = eval as bool }
                                                      }
                                                }
                                                ret_val_type == "int" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_i = regs[a1] as int64 }
                                                            stdMapContainsKey(env, a1) ==> { eval_i = env[a1] as int64 }
                                                            _ ==> { eval_i = eval as int64 }
                                                      }
                                                }
                                                ret_val_type == "list" or ret_val_type == "set" or ret_val_type == "list_of_list" or ret_val_type == "list_of_list_of_list" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_l = regs[a1] }
                                                            stdMapContainsKey(env, a1) ==> { eval_l = env[a1] }
                                                            _ ==> { eval_l = eval }
                                                      }
                                                }
                                                ret_val_type == "map" or ret_val_type == "struct" or ret_val_type == "complex" ==> {
                                                      route {
                                                            stdMapContainsKey(regs, a1) ==> { eval_m = regs[a1] }
                                                            stdMapContainsKey(env, a1) ==> { eval_m = env[a1] }
                                                            _ ==> { eval_m = eval }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          mut as int64: cs_len = stdCollectionLength(call_stack)
                                          route {
                                                cs_len > 0 ==> {
                                                      mut as map: top_frame = call_stack[cs_len]
                                                      mut as list of map: new_cs = []
                                                      mut as int64: csi = 1
                                                      infinite {
                                                            route {
                                                                  csi >= cs_len ==> { break }
                                                                  _ ==> {
                                                                        new_cs = stdListPushBack(new_cs, call_stack[csi])
                                                                        csi = csi + 1
                                                                  }
                                                            }
                                                      }
                                                      call_stack = new_cs
                                                      pc = top_frame["return_pc"] as int64
                                                      mut as string: ret_tgt = "" + top_frame["res_reg"]
                                                      regs = top_frame["regs"]
                                                      env = top_frame["env"]
                                                      reg_types = top_frame["reg_types"]
                                                      env_types = top_frame["env_types"]
                                                      reg_outcomes = top_frame["reg_outcomes"]
                                                      env_outcomes = top_frame["env_outcomes"]
                                                      cur_fn_ret_type = "" + top_frame["caller_ret_type"]
                                                      instrs = top_frame["instrs"]
                                                      labels = top_frame["labels"]
                                                      total_instrs_count = top_frame["total_instrs"] as int64
                                                      route {
                                                            ret_val_type == "string" ==> { regs[ret_tgt] = eval_s }
                                                            ret_val_type == "float" ==> { regs[ret_tgt] = eval_f }
                                                            ret_val_type == "bool" ==> { regs[ret_tgt] = eval_b }
                                                            ret_val_type == "int" ==> { regs[ret_tgt] = eval_i }
                                                            ret_val_type == "list" or ret_val_type == "set" or ret_val_type == "list_of_list" or ret_val_type == "list_of_list_of_list" ==> { regs[ret_tgt] = eval_l }
                                                            ret_val_type == "map" or ret_val_type == "struct" or ret_val_type == "complex" ==> { regs[ret_tgt] = eval_m }
                                                            _ ==> { regs[ret_tgt] = eval }
                                                      }
                                                      reg_types[ret_tgt] = ret_val_type
                                                      mut as map: outcome_meta = map{}
                                                      outcome_meta["sta"] = emit_sta
                                                      outcome_meta["msg"] = emit_msg
                                                      reg_outcomes[ret_tgt] = outcome_meta
                                                      jumped = true
                                                }
                                                _ ==> {
                                                      mut as map: res_emit = map{}
                                                      res_emit["target"] = "in"
                                                      res_emit["success"] = true
                                                      res_emit["output"] = stdout_acc
                                                      res_emit["value"] = eval
                                                      emit(nice, res_emit, "ok")
                                                }
                                          }
                                    }
                                    _ ==> {}
                              }
                              route {
                                    jumped ==> {}
                                    _ ==> { pc = pc + 1 }
                              }
                        }
                  }
            }

            mut as map: result = map{}
            result["target"] = "in"
            result["success"] = true
            result["output"] = stdout_acc
            emit(nice, result, "ok")
      }
}
