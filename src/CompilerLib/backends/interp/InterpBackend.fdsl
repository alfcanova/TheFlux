#L ==============================================================================
#L TheFlux Native Compiler: CompilerLib
#L Modulo: InterpBackend (Target: 'in')
#L ==============================================================================

contract (InterpBackendContract) {
      op interpParseInt (as string: s) as int64
      op interpParseFloat (as string: s) as float64
      op interpGetDataTag (as data: v) as float64
      op interpInferDataType (as data: v) as string
      op interpCleanStructRepr (as string: s) as string
      op interpPad2 (as int64: v) as string
      op interpPad4 (as int64: v) as string
      op interpNormalizeDatetime (as string: s) as string
      op interpStrContains (as string: hay, as string: ndl) as bool
      op interpStrFind (as string: hay, as string: ndl) as int64
      op interpPathBaseName (as string: path) as string
      op interpPathDirName (as string: path) as string
      op interpPathExtension (as string: path) as string
      op interpPathJoin (as string: dir, as string: file) as string
      op interpExecuteFmir (as map: fmir_module) as map
}

agent (CompilerLib) impl InterpBackendContract {
      op interpGetDataTag (as data: v) as float64 ==> {
            emit(nice, v, "ok")
      }

      op interpInferDataType (as data: v) as string ==> {
            mut as float64: ftag = interpGetDataTag(v)
            mut as int64: vtag = ftag as int64
            mut as int64: iv = v as int64
            mut as string: res_t = "int"
            route {
                  vtag == 2 ==> { res_t = "bool" }
                  vtag == 3 ==> { res_t = "float" }
                  vtag == 4 ==> { res_t = "string" }
                  vtag == 5 or (vtag == 0 and iv >= 1048576 and iv < 140737488355328) ==> {
                        mut as string: s = "" + v
                        mut as int64: slen = stdCollectionLength(s)
                        route {
                              slen >= 2 and s[1] == "[" and s[slen] == "]" ==> {
                                    mut as int64: hdr_n = stdCollectionLength(v)
                                    route {
                                          hdr_n >= 0 and hdr_n < slen ==> { res_t = "list" }
                                          _ ==> { res_t = "string" }
                                    }
                              }
                              slen >= 2 and s[1] == "{" and s[slen] == "}" ==> {
                                    mut as int64: hdr_n = stdCollectionLength(v)
                                    route {
                                          hdr_n >= 0 and hdr_n < slen ==> {
                                                route {
                                                      slen >= 15 and s[1..15] == "{_struct_name: " ==> {
                                                            res_t = "struct"
                                                      }
                                                      slen == 2 ==> {
                                                            res_t = "map"
                                                      }
                                                      _ ==> {
                                                            mut as int64: d = 0
                                                            mut as int64: si = 2
                                                            mut as string: guessed = "set"
                                                            infinite {
                                                                  route {
                                                                        si >= slen ==> { break }
                                                                        _ ==> {
                                                                              mut as string: sch = s[si]
                                                                              route {
                                                                                    sch == "[" or sch == "{" ==> { d = d + 1 }
                                                                                    sch == "]" or sch == "}" ==> { d = d - 1 }
                                                                                    d == 0 and sch == ":" ==> {
                                                                                          guessed = "map"
                                                                                          break
                                                                                    }
                                                                                    d == 0 and sch == "," ==> {
                                                                                          guessed = "set"
                                                                                          break
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              si = si + 1
                                                                        }
                                                                  }
                                                            }
                                                            res_t = guessed
                                                      }
                                                }
                                          }
                                          _ ==> { res_t = "string" }
                                    }
                              }
                              _ ==> { res_t = "string" }
                        }
                  }
                  _ ==> { res_t = "int" }
            }
            emit(nice, res_t, "ok")
      }

      op interpCleanStructRepr (as string: s) as string ==> {
            mut as int64: slen = stdCollectionLength(s)
            route {
                  slen < 16 ==> { emit(nice, s, "ok") }
                  _ ==> {}
            }
            mut as bool: has_marker = false
            mut as int64: chk = 1
            infinite {
                  route {
                        (chk + 14) > slen ==> { break }
                        s[chk..(chk + 14)] == "{_struct_name: " ==> {
                              has_marker = true
                              break
                        }
                        _ ==> { chk = chk + 1 }
                  }
            }
            route {
                  not has_marker ==> { emit(nice, s, "ok") }
                  _ ==> {}
            }
            mut as string: out = ""
            mut as int64: i = 1
            infinite {
                  route {
                        i > slen ==> { break }
                        (i + 14) <= slen and s[i..(i + 14)] == "{_struct_name: " ==> {
                              mut as int64: p = i + 15
                              mut as string: sname = ""
                              infinite {
                                    route {
                                          p > slen or s[p] == "," or s[p] == "}" ==> { break }
                                          _ ==> {
                                                sname = sname + s[p]
                                                p = p + 1
                                          }
                                    }
                              }
                              infinite {
                                    route {
                                          p > slen or s[p] == "]" ==> { break }
                                          _ ==> { p = p + 1 }
                                    }
                              }
                              route { p <= slen and s[p] == "]" ==> { p = p + 1 } _ ==> {} }
                              route {
                                    p <= slen and s[p] == "}" ==> {
                                          out = out + sname + "()"
                                          i = p + 1
                                    }
                                    _ ==> {
                                          route {
                                                (p + 1) <= slen and s[p..(p + 1)] == ", " ==> { p = p + 2 }
                                                _ ==> {}
                                          }
                                          out = out + sname + "(."
                                          mut as int64: d = 0
                                          infinite {
                                                route {
                                                      p > slen ==> { break }
                                                      d == 0 and s[p] == "}" ==> {
                                                            out = out + ")"
                                                            p = p + 1
                                                            break
                                                      }
                                                      s[p] == "[" or s[p] == "{" or s[p] == "(" ==> {
                                                            d = d + 1
                                                            out = out + s[p]
                                                            p = p + 1
                                                      }
                                                      s[p] == "]" or s[p] == "}" or s[p] == ")" ==> {
                                                            d = d - 1
                                                            out = out + s[p]
                                                            p = p + 1
                                                      }
                                                      d == 0 and (p + 1) <= slen and s[p..(p + 1)] == ", " ==> {
                                                            out = out + ", ."
                                                            p = p + 2
                                                      }
                                                      _ ==> {
                                                            out = out + s[p]
                                                            p = p + 1
                                                      }
                                                }
                                          }
                                          i = p
                                    }
                              }
                        }
                        _ ==> {
                              out = out + s[i]
                              i = i + 1
                        }
                  }
            }
            emit(nice, out, "ok")
      }

      op interpParseInt (as string: s) as int64 ==> {
            mut as int64: slen = stdCollectionLength(s)
            mut as int64: res = 0
            mut as int64: sign = 1
            mut as int64: i = 1
            infinite {
                  route {
                        i <= slen and s[i] == " " ==> { i = i + 1 }
                        _ ==> { break }
                  }
            }
            route {
                  i <= slen ==> {
                        route {
                              s[i] == "-" ==> {
                                    sign = -1
                                    i = i + 1
                              }
                              s[i] == "+" ==> {
                                    i = i + 1
                              }
                              _ ==> {}
                        }
                  }
                  _ ==> {}
            }
            infinite {
                  route {
                        i > slen ==> { break }
                        _ ==> {
                              mut as string: ch = s[i]
                              mut as int64: d = 0
                              route {
                                    ch == "0" ==> { d = 0 }
                                    ch == "1" ==> { d = 1 }
                                    ch == "2" ==> { d = 2 }
                                    ch == "3" ==> { d = 3 }
                                    ch == "4" ==> { d = 4 }
                                    ch == "5" ==> { d = 5 }
                                    ch == "6" ==> { d = 6 }
                                    ch == "7" ==> { d = 7 }
                                    ch == "8" ==> { d = 8 }
                                    ch == "9" ==> { d = 9 }
                                    _ ==> { break }
                              }
                              res = res * 10 + d
                              i = i + 1
                        }
                  }
            }
            res = res * sign
            emit(nice, res, "ok")
      }

      op interpParseFloat (as string: s) as float64 ==> {
            mut as float64: res = s as float64
            emit(nice, res, "ok")
      }

      op interpPad2 (as int64: v) as string ==> {
            route {
                  v < 0 ==> { emit(nice, "00", "ok") }
                  v < 10 ==> { emit(nice, "0" + v, "ok") }
                  _ ==> { emit(nice, "" + v, "ok") }
            }
      }

      op interpPad4 (as int64: v) as string ==> {
            route {
                  v < 10 ==> { emit(nice, "000" + v, "ok") }
                  v < 100 ==> { emit(nice, "00" + v, "ok") }
                  v < 1000 ==> { emit(nice, "0" + v, "ok") }
                  _ ==> { emit(nice, "" + v, "ok") }
            }
      }

      op interpNormalizeDatetime (as string: s) as string ==> {
            mut as int64: slen = stdCollectionLength(s)
            route {
                  slen < 19 ==> { emit(nice, s, "ok") }
                  s[5] != "-" or s[8] != "-" or s[11] != "T" or s[14] != ":" or s[17] != ":" ==> { emit(nice, s, "ok") }
                  _ ==> {
                        mut as int64: y = interpParseInt(s[1..4])
                        mut as int64: mo = interpParseInt(s[6..7])
                        mut as int64: d = interpParseInt(s[9..10])
                        mut as int64: h = interpParseInt(s[12..13])
                        mut as int64: mi = interpParseInt(s[15..16])
                        mut as int64: sec = interpParseInt(s[18..19])

                        mut as int64: p = 20
                        mut as string: nanos_str = "000000000"
                        route {
                              p <= slen ==> {
                                    route {
                                          s[p] == "." ==> {
                                                p = p + 1
                                                mut as string: frac = ""
                                                infinite {
                                                      route {
                                                            p > slen ==> { break }
                                                            s[p] == "+" or s[p] == "-" or s[p] == "Z" ==> { break }
                                                            _ ==> {
                                                                  frac = frac + s[p]
                                                                  p = p + 1
                                                            }
                                                      }
                                                }
                                                mut as string: frac_pad = frac + "000000000"
                                                nanos_str = frac_pad[1..9]
                                          }
                                          _ ==> {}
                                    }
                              }
                              _ ==> {}
                        }

                        route {
                              p <= slen ==> {
                                    route {
                                          s[p] == "+" or s[p] == "-" ==> {
                                                mut as string: sign = s[p]
                                                p = p + 1
                                                mut as string: off_body = s[p..slen]
                                                mut as int64: oh = 0
                                                mut as int64: om = 0
                                                mut as int64: ob_len = stdCollectionLength(off_body)
                                                route {
                                                      ob_len >= 5 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            route {
                                                                  off_body[3] == ":" ==> {
                                                                        om = interpParseInt(off_body[4..5])
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                      }
                                                      ob_len == 4 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            om = interpParseInt(off_body[3..4])
                                                      }
                                                      ob_len >= 2 ==> {
                                                            oh = interpParseInt(off_body[1..2])
                                                            om = 0
                                                      }
                                                      _ ==> {}
                                                }
                                                route {
                                                      sign == "+" ==> {
                                                            h = h - oh
                                                            mi = mi - om
                                                      }
                                                      _ ==> {
                                                            h = h + oh
                                                            mi = mi + om
                                                      }
                                                }
                                                route {
                                                      mi < 0 ==> {
                                                            mi = mi + 60
                                                            h = h - 1
                                                      }
                                                      mi >= 60 ==> {
                                                            mi = mi - 60
                                                            h = h + 1
                                                      }
                                                      _ ==> {}
                                                }
                                                route {
                                                      h < 0 ==> {
                                                            h = h + 24
                                                            d = d - 1
                                                      }
                                                      h >= 24 ==> {
                                                            h = h - 24
                                                            d = d + 1
                                                      }
                                                      _ ==> {}
                                                }
                                          }
                                          _ ==> {}
                                    }
                              }
                              _ ==> {}
                        }

                        mut as string: res = interpPad4(y) + "-" + interpPad2(mo) + "-" + interpPad2(d) + "T" + interpPad2(h) + ":" + interpPad2(mi) + ":" + interpPad2(sec) + "." + nanos_str + "Z"
                        emit(nice, res, "ok")
                  }
            }
      }

      op interpStrContains (as string: hay, as string: ndl) as bool ==> {
            mut as int64: hlen = stdCollectionLength(hay)
            mut as int64: nlen = stdCollectionLength(ndl)
            mut as bool: fnd = false
            route {
                  nlen == 0 ==> { fnd = true }
                  nlen <= hlen ==> {
                        mut as int64: max_idx = hlen - nlen + 1
                        mut as int64: cur_pos = 1
                        infinite {
                              route {
                                    cur_pos > max_idx ==> { break }
                                    hay[cur_pos..(cur_pos + nlen - 1)] == ndl ==> {
                                          fnd = true
                                          break
                                    }
                                    _ ==> { cur_pos = cur_pos + 1 }
                              }
                        }
                  }
                  _ ==> {}
            }
            emit(nice, fnd, "ok")
      }

      op interpStrFind (as string: hay, as string: ndl) as int64 ==> {
            mut as int64: hlen = stdCollectionLength(hay)
            mut as int64: nlen = stdCollectionLength(ndl)
            mut as int64: res_pos = 0
            route {
                  nlen <= hlen ==> {
                        mut as int64: max_idx = hlen - nlen + 1
                        mut as int64: cur_pos = 1
                        infinite {
                              route {
                                    cur_pos > max_idx ==> { break }
                                    hay[cur_pos..(cur_pos + nlen - 1)] == ndl ==> {
                                          res_pos = cur_pos
                                          break
                                    }
                                    _ ==> { cur_pos = cur_pos + 1 }
                              }
                        }
                  }
                  _ ==> {}
            }
            emit(nice, res_pos, "ok")
      }

      op interpPathBaseName (as string: path) as string ==> {
            mut as int64: plen = stdCollectionLength(path)
            mut as int64: idx = 0
            mut as int64: i = plen
            infinite {
                  route {
                        i < 1 ==> { break }
                        path[i] == "/" or path[i] == "\\" ==> {
                              idx = i
                              break
                        }
                        _ ==> { i = i - 1 }
                  }
            }
            route {
                  idx > 0 ==> { emit(nice, path[(idx + 1)..plen], "ok") }
                  _ ==> { emit(nice, path, "ok") }
            }
      }

      op interpPathDirName (as string: path) as string ==> {
            mut as int64: plen = stdCollectionLength(path)
            mut as int64: idx = 0
            mut as int64: i = plen
            infinite {
                  route {
                        i < 1 ==> { break }
                        path[i] == "/" or path[i] == "\\" ==> {
                              idx = i
                              break
                        }
                        _ ==> { i = i - 1 }
                  }
            }
            route {
                  idx > 0 ==> { emit(nice, path[1..(idx - 1)], "ok") }
                  _ ==> { emit(nice, "", "ok") }
            }
      }

      op interpPathExtension (as string: path) as string ==> {
            mut as int64: plen = stdCollectionLength(path)
            mut as int64: idx = 0
            mut as int64: i = plen
            infinite {
                  route {
                        i < 1 ==> { break }
                        path[i] == "." ==> {
                              idx = i
                              break
                        }
                        _ ==> { i = i - 1 }
                  }
            }
            route {
                  idx > 0 ==> { emit(nice, path[(idx + 1)..plen], "ok") }
                  _ ==> { emit(nice, "", "ok") }
            }
      }

      op interpPathJoin (as string: dir, as string: file) as string ==> {
            mut as int64: dlen = stdCollectionLength(dir)
            route {
                  dlen > 0 and (dir[dlen] == "/" or dir[dlen] == "\\") ==> {
                        emit(nice, dir[1..(dlen - 1)] + "/" + file, "ok")
                  }
                  dlen > 0 ==> {
                        emit(nice, dir + "/" + file, "ok")
                  }
                  _ ==> {
                        emit(nice, file, "ok")
                  }
            }
      }

      op interpExecuteFmir (as map: fmir_module) as map ==> {
            mut as list of data: instrs = fmir_module["instructions"]
            mut as int64: total_instrs_count = stdCollectionLength(instrs)
            mut as string: mod_name = "" + fmir_module["name"]

            mut as map: env = map{}
            mut as map: regs = map{}
            mut as map: reg_types = map{}
            mut as map: env_types = map{}
            mut as map: reg_outcomes = map{}
            mut as map: env_outcomes = map{}
            mut as map: global_env = map{}
            mut as map: global_env_types = map{}
            mut as map: global_env_outcomes = map{}
            mut as string: stdout_acc = ""
            mut as string: pending_prefix = ""
            mut as int64: spy_counter = 0
            mut as list of map: call_stack = []
            mut as string: cur_fn_ret_type = "data"
            mut as bool: gfx_win_closed = false
            mut as map: io_files = map{}
            mut as map: io_dirs = map{}
            mut as int64: io_input_step = 0
            mut as map: os_env_map = map{}
            mut as int64: interp_atomic_val = 0
            mut as map: db_sql_tables = map{}
            mut as int64: db_sql_last_id = 0
            mut as int64: db_sql_changes = 0
            mut as map: db_kv_store = map{}
            mut as int64: db_doc_count_val = 0
            mut as int64: db_col_count_val = 0
            mut as int64: db_vec_count_val = 0
            mut as map: funcs = map{}
            route {
                  stdMapContainsKey(fmir_module, "functions") ==> {
                        funcs = fmir_module["functions"]
                  }
                  _ ==> {}
            }

            mut as map: labels = map{}
            mut as int64: lscan = 1
            infinite {
                  route {
                        lscan > total_instrs_count ==> { break }
                        _ ==> {
                              mut as map: linstr = instrs[lscan]
                              route {
                                    linstr["op"] == "LABEL" ==> {
                                          labels["" + linstr["arg1"]] = lscan
                                    }
                                    _ ==> {}
                              }
                              lscan = lscan + 1
                        }
                  }
            }

            mut as int64: pc = 1
            infinite {
                  route {
                        pc > total_instrs_count ==> {
                              mut as int64: cs_len = stdCollectionLength(call_stack)
                              route {
                                    cs_len > 0 ==> {
                                          mut as map: top_frame = call_stack[cs_len]
                                          mut as list of map: new_cs = []
                                          mut as int64: csi = 1
                                          infinite {
                                                route {
                                                      csi >= cs_len ==> { break }
                                                      _ ==> {
                                                            new_cs = stdListPushBack(new_cs, call_stack[csi])
                                                            csi = csi + 1
                                                      }
                                                }
                                          }
                                          call_stack = new_cs
                                          pc = top_frame["return_pc"] as int64
                                          mut as string: ret_tgt = "" + top_frame["res_reg"]
                                          regs = top_frame["regs"]
                                          env = top_frame["env"]
                                          reg_types = top_frame["reg_types"]
                                          env_types = top_frame["env_types"]
                                          reg_outcomes = top_frame["reg_outcomes"]
                                          env_outcomes = top_frame["env_outcomes"]
                                          cur_fn_ret_type = "" + top_frame["caller_ret_type"]
                                          instrs = top_frame["instrs"]
                                          labels = top_frame["labels"]
                                          total_instrs_count = top_frame["total_instrs"] as int64
                                          regs[ret_tgt] = 0
                                          reg_types[ret_tgt] = "int"
                                          mut as map: impl_out = map{}
                                          impl_out["sta"] = "nice"
                                          impl_out["msg"] = "ok"
                                          reg_outcomes[ret_tgt] = impl_out
                                    }
                                    _ ==> { break }
                              }
                        }
                        _ ==> {
                              mut as map: inst = instrs[pc]
                              mut as bool: jumped = false
                              mut as string: opcode = "" + inst["op"]
                              mut as string: a1 = "" + inst["arg1"]
                              mut as string: a2 = "" + inst["arg2"]
                              mut as string: res = "" + inst["res"]

                              route {
                                    opcode == "LABEL" ==> {}
                                    opcode == "JUMP" ==> {
                                          route {
                                                stdMapContainsKey(labels, a1) ==> {
                                                      pc = labels[a1] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "SHORT_CIRCUIT_BRANCH" ==> {
                                          mut as bool: is_fail = false
                                          route {
                                                stdMapContainsKey(reg_outcomes, a1) ==> {
                                                      mut as map: o_chk = reg_outcomes[a1]
                                                      route {
                                                            o_chk["sta"] == "fail" ==> { is_fail = true }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(env_outcomes, a1) ==> {
                                                      mut as map: eo_chk = env_outcomes[a1]
                                                      route {
                                                            eo_chk["sta"] == "fail" ==> { is_fail = true }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not is_fail ==> {
                                                      mut as string: a1_t = ""
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { a1_t = reg_types[a1] }
                                                            stdMapContainsKey(env_types, a1) ==> { a1_t = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            a1_t == "bool" ==> {
                                                                  mut as bool: b_cond = false
                                                                  route {
                                                                        stdMapContainsKey(regs, a1) ==> { b_cond = regs[a1] == true }
                                                                        stdMapContainsKey(env, a1) ==> { b_cond = env[a1] == true }
                                                                        _ ==> {}
                                                                  }
                                                                  route {
                                                                        not b_cond ==> { is_fail = true }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                is_fail and stdMapContainsKey(labels, a2) ==> {
                                                      pc = labels[a2] as int64
                                                      jumped = true
                                                }
                                                not is_fail and stdMapContainsKey(labels, res) ==> {
                                                      pc = labels[res] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "JUMP_IF_FALSE" ==> {
                                          mut as bool: cval = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      mut as string: a1_t = "data"
                                                      route { stdMapContainsKey(reg_types, a1) ==> { a1_t = reg_types[a1] } _ ==> {} }
                                                      route {
                                                            a1_t == "outcome" ==> {
                                                                  mut as map: om = regs[a1]
                                                                  cval = om["val"] as bool
                                                            }
                                                            _ ==> { cval = regs[a1] as bool }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                not cval and stdMapContainsKey(labels, a2) ==> {
                                                      pc = labels[a2] as int64
                                                      jumped = true
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "JUMP_IF_TRUE" ==> {
                                          mut as bool: cval = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      mut as string: a1_t = "data"
