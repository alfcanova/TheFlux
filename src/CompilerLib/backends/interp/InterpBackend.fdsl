                                                      mut as int64: zn2 = stdCollectionLength(zl2)
                                                      mut as int64: zn = zn1
                                                      route { zn2 < zn ==> { zn = zn2 } _ ==> {} }
                                                      mut as list of data: zip_res = []
                                                      mut as int64: zi = 1
                                                      infinite {
                                                            route {
                                                                  zi > zn ==> { break }
                                                                  _ ==> {
                                                                        mut as data: zp1 = zl1[zi]
                                                                        mut as data: zp2 = zl2[zi]
                                                                        mut as string: zt1 = interpInferDataType(zp1)
                                                                        mut as string: zt2 = interpInferDataType(zp2)
                                                                        route { zt1 == "string" ==> { zp1 = zl1[zi] as string } _ ==> {} }
                                                                        route { zt2 == "string" ==> { zp2 = zl2[zi] as string } _ ==> {} }
                                                                        mut as list of data: pair = [zp1, zp2]
                                                                        zip_res = stdListPushBack(zip_res, pair)
                                                                        zi = zi + 1
                                                                  }
                                                            }
                                                      }
                                                      regs[res] = zip_res
                                                      reg_types[res] = "list"
                                                }
                                                fn_target == "listToMap" or a1 == "listToMap" or fn_target == "stdListToMap" ==> {
                                                      mut as list of data: pairs = []
                                                      route { stdCollectionLength(call_args) >= 1 ==> { pairs = call_args[1] } _ ==> {} }
                                                      mut as map: res_map = map{}
                                                      mut as int64: np = stdCollectionLength(pairs)
                                                      mut as int64: pi = 1
                                                      infinite {
                                                            route {
                                                                  pi > np ==> { break }
                                                                  _ ==> {
                                                                        mut as list of data: pair = pairs[pi]
                                                                        route {
                                                                              stdCollectionLength(pair) >= 2 ==> {
                                                                                    mut as string: k_s = "" + pair[1]
                                                                                    mut as data: v_d = pair[2]
                                                                                    mut as string: v_ty = interpInferDataType(v_d)
                                                                                    route { v_ty == "string" ==> { v_d = pair[2] as string } _ ==> {} }
                                                                                    res_map[k_s] = v_d
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        pi = pi + 1
                                                                  }
                                                            }
                                                      }
                                                      regs[res] = res_map
                                                      reg_types[res] = "map"
                                                }
                                                fn_target == "listUnzip" or a1 == "listUnzip" or fn_target == "stdListUnzip" ==> {
                                                      mut as list of data: uz_items = []
                                                      route { stdCollectionLength(call_args) >= 1 ==> { uz_items = call_args[1] } _ ==> {} }
                                                      mut as list of data: u1 = []
                                                      mut as list of data: u2 = []
                                                      mut as int64: uz_n = stdCollectionLength(uz_items)
                                                      mut as int64: uzi = 1
                                                      infinite {
                                                            route {
                                                                  uzi > uz_n ==> { break }
                                                                  _ ==> {
                                                                        mut as list of data: upair = uz_items[uzi]
                                                                        route {
                                                                              stdCollectionLength(upair) >= 2 ==> {
                                                                                    mut as data: ep1 = upair[1]
                                                                                    mut as data: ep2 = upair[2]
                                                                                    mut as string: et1 = interpInferDataType(ep1)
                                                                                    mut as string: et2 = interpInferDataType(ep2)
                                                                                    route { et1 == "string" ==> { u1 = stdListPushBack(u1, ep1 as string) } _ ==> { u1 = stdListPushBack(u1, ep1) } }
                                                                                    route { et2 == "string" ==> { u2 = stdListPushBack(u2, ep2 as string) } _ ==> { u2 = stdListPushBack(u2, ep2) } }
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        uzi = uzi + 1
                                                                  }
                                                            }
                                                      }
                                                      mut as list of data: uz_final = [u1, u2]
                                                      regs[res] = uz_final
                                                      reg_types[res] = "list"
                                                }
                                                is_user_fn or stdMapContainsKey(funcs, fn_target) ==> {
                                                      route { is_user_fn ==> { fn_target = user_fn_key } _ ==> {} }
                                                      mut as map: fn_desc = funcs[fn_target]
                                                      mut as list of data: fn_params = fn_desc["params"]
                                                      mut as list of data: fn_ptypes = []
                                                      route {
                                                            stdMapContainsKey(fn_desc, "param_types") ==> { fn_ptypes = fn_desc["param_types"] }
                                                            _ ==> {}
                                                      }
                                                      mut as int64: n_ptypes = stdCollectionLength(fn_ptypes)
                                                      mut as string: callee_rt = "data"
                                                      route {
                                                            stdMapContainsKey(fn_desc, "ret_type") ==> { callee_rt = "" + fn_desc["ret_type"] }
                                                            _ ==> {}
                                                      }
                                                      mut as list of data: fn_instrs = fn_desc["instructions"]
                                                      mut as int64: n_params = stdCollectionLength(fn_params)
                                                      #L Parse arguments from a2 into a list of pieces
                                                      mut as list of string: arg_pieces = []
                                                      mut as int64: a2_l = stdCollectionLength(a2)
                                                      mut as int64: last_p = 1
                                                      mut as int64: p_scan = 1
                                                      mut as int64: b_depth = 0
                                                      infinite {
                                                            route {
                                                                  p_scan > a2_l ==> {
                                                                        route {
                                                                              last_p <= a2_l ==> {
                                                                                    mut as string: piece = a2[last_p..a2_l]
                                                                                    infinite {
                                                                                          route {
                                                                                                stdCollectionLength(piece) > 0 and piece[1] == " " ==> {
                                                                                                      piece = piece[2..stdCollectionLength(piece)]
                                                                                                }
                                                                                                _ ==> { break }
                                                                                          }
                                                                                    }
                                                                                    arg_pieces = stdListPushBack(arg_pieces, piece)
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        break
                                                                  }
                                                                  a2[p_scan] == "[" or a2[p_scan] == "{" or a2[p_scan] == "(" ==> {
                                                                        b_depth = b_depth + 1
                                                                  }
                                                                  a2[p_scan] == "]" or a2[p_scan] == "}" or a2[p_scan] == ")" ==> {
                                                                        b_depth = b_depth - 1
                                                                  }
                                                                  a2[p_scan] == "," and b_depth == 0 ==> {
                                                                        mut as string: piece = a2[last_p..(p_scan - 1)]
                                                                        infinite {
                                                                              route {
                                                                                    stdCollectionLength(piece) > 0 and piece[1] == " " ==> {
                                                                                          piece = piece[2..stdCollectionLength(piece)]
                                                                                    }
                                                                                    _ ==> { break }
                                                                              }
                                                                        }
                                                                        arg_pieces = stdListPushBack(arg_pieces, piece)
                                                                        last_p = p_scan + 1
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            p_scan = p_scan + 1
                                                      }

                                                      #L Build local environment for the function with type preservation
                                                      mut as map: new_env = map{}
                                                      mut as map: new_env_types = map{}
                                                      mut as int64: pi = 1
                                                      mut as int64: num_passed = stdCollectionLength(arg_pieces)
                                                      infinite {
                                                            route {
                                                                  pi > n_params ==> { break }
                                                                  _ ==> {
                                                                        mut as string: p_name = "" + fn_params[pi]
                                                                        route {
                                                                              pi <= num_passed ==> {
                                                                                    mut as string: piece = arg_pieces[pi]
                                                                                    mut as string: p_type = "data"
                                                                                    route {
                                                                                          stdMapContainsKey(reg_types, piece) ==> { p_type = reg_types[piece] }
                                                                                          stdMapContainsKey(env_types, piece) ==> { p_type = env_types[piece] }
                                                                                          stdMapContainsKey(global_env_types, piece) ==> { p_type = global_env_types[piece] }
                                                                                          _ ==> {}
                                                                                    }
                                                                                    route {
                                                                                          (p_type == "data" or p_type == "") and pi <= n_ptypes ==> {
                                                                                                mut as string: decl_pt = "" + fn_ptypes[pi]
                                                                                                route {
                                                                                                      decl_pt != "" and decl_pt != "data" ==> { p_type = decl_pt }
                                                                                                      _ ==> {}
                                                                                                }
                                                                                          }
                                                                                          _ ==> {}
                                                                                    }
                                                                                    route {
                                                                                          p_type == "string" ==> {
                                                                                                mut as string: s_val = ""
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { s_val = regs[piece] as string }
                                                                                                      stdMapContainsKey(env, piece) ==> { s_val = env[piece] as string }
                                                                                                      stdMapContainsKey(global_env, piece) ==> { s_val = global_env[piece] as string }
                                                                                                      _ ==> { s_val = piece }
                                                                                                }
                                                                                                new_env[p_name] = s_val
                                                                                                new_env_types[p_name] = "string"
                                                                                          }
                                                                                          p_type == "int" or p_type == "int64" or p_type == "int32" or p_type == "int16" or p_type == "int8" or p_type == "uint64" or p_type == "uint32" or p_type == "uint16" or p_type == "uint8" ==> {
                                                                                                mut as int64: i_val = 0
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { i_val = regs[piece] as int64 }
                                                                                                      stdMapContainsKey(env, piece) ==> { i_val = env[piece] as int64 }
                                                                                                      stdMapContainsKey(global_env, piece) ==> { i_val = global_env[piece] as int64 }
                                                                                                      _ ==> { i_val = interpParseInt(piece) }
                                                                                                }
                                                                                                new_env[p_name] = i_val
                                                                                                new_env_types[p_name] = "int"
                                                                                          }
                                                                                          p_type == "float" or p_type == "float64" or p_type == "float32" or p_type == "float16" ==> {
                                                                                                mut as float64: f_val = 0.0
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { f_val = regs[piece] as float64 }
                                                                                                      stdMapContainsKey(env, piece) ==> { f_val = env[piece] as float64 }
                                                                                                      stdMapContainsKey(global_env, piece) ==> { f_val = global_env[piece] as float64 }
                                                                                                      _ ==> { f_val = interpParseFloat(piece) }
                                                                                                }
                                                                                                new_env[p_name] = f_val
                                                                                                new_env_types[p_name] = "float"
                                                                                          }
                                                                                          p_type == "bool" ==> {
                                                                                                mut as bool: b_val = false
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { b_val = regs[piece] as bool }
                                                                                                      stdMapContainsKey(env, piece) ==> { b_val = env[piece] as bool }
                                                                                                      _ ==> { b_val = piece == "true" }
                                                                                                }
                                                                                                new_env[p_name] = b_val
                                                                                                new_env_types[p_name] = "bool"
                                                                                          }
                                                                                          p_type == "list" or p_type == "set" ==> {
                                                                                                mut as list of data: l_val = []
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { l_val = regs[piece] }
                                                                                                      stdMapContainsKey(env, piece) ==> { l_val = env[piece] }
                                                                                                      _ ==> {}
                                                                                                }
                                                                                                new_env[p_name] = l_val
                                                                                                new_env_types[p_name] = p_type
                                                                                          }
                                                                                          p_type == "map" or p_type == "struct" or p_type == "complex" ==> {
                                                                                                mut as map: m_val = map{}
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { m_val = regs[piece] }
                                                                                                      stdMapContainsKey(env, piece) ==> { m_val = env[piece] }
                                                                                                      _ ==> {}
                                                                                                }
                                                                                                new_env[p_name] = m_val
                                                                                                new_env_types[p_name] = p_type
                                                                                          }
                                                                                          p_type == "outcome" ==> {
                                                                                                mut as map: om_val = map{}
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> { om_val = regs[piece] }
                                                                                                      stdMapContainsKey(env, piece) ==> { om_val = env[piece] }
                                                                                                      _ ==> {}
                                                                                                }
                                                                                                mut as string: real_t = "data"
                                                                                                route {
                                                                                                      stdMapContainsKey(om_val, "_val_type") ==> { real_t = "" + om_val["_val_type"] }
                                                                                                      _ ==> {}
                                                                                                }
                                                                                                route {
                                                                                                      real_t == "string" ==> {
                                                                                                            mut as string: os_val = "" + om_val["val"]
                                                                                                            new_env[p_name] = os_val
                                                                                                            new_env_types[p_name] = "string"
                                                                                                      }
                                                                                                      real_t == "int" ==> {
                                                                                                            mut as int64: oi_val = om_val["val"] as int64
                                                                                                            new_env[p_name] = oi_val
                                                                                                            new_env_types[p_name] = "int"
                                                                                                      }
                                                                                                      real_t == "bool" ==> {
                                                                                                            mut as bool: ob_val = om_val["val"] as bool
                                                                                                            new_env[p_name] = ob_val
                                                                                                            new_env_types[p_name] = "bool"
                                                                                                      }
                                                                                                      real_t == "float" ==> {
                                                                                                            mut as float64: of_val = om_val["val"] as float64
                                                                                                            new_env[p_name] = of_val
                                                                                                            new_env_types[p_name] = "float"
                                                                                                      }
                                                                                                      _ ==> {
                                                                                                            new_env[p_name] = om_val["val"]
                                                                                                            new_env_types[p_name] = real_t
                                                                                                      }
                                                                                                }
                                                                                          }
                                                                                          _ ==> {
                                                                                                route {
                                                                                                      stdMapContainsKey(regs, piece) ==> {
                                                                                                            new_env[p_name] = regs[piece]
                                                                                                            new_env_types[p_name] = "data"
                                                                                                      }
                                                                                                      stdMapContainsKey(env, piece) ==> {
                                                                                                            new_env[p_name] = env[piece]
                                                                                                            new_env_types[p_name] = "data"
                                                                                                      }
                                                                                                      stdMapContainsKey(global_env, piece) ==> {
                                                                                                            new_env[p_name] = global_env[piece]
                                                                                                            new_env_types[p_name] = "data"
                                                                                                      }
                                                                                                      _ ==> {
                                                                                                            new_env[p_name] = piece
                                                                                                            new_env_types[p_name] = "string"
                                                                                                      }
                                                                                                }
                                                                                          }
                                                                                    }
                                                                              }
                                                                              _ ==> {
                                                                                    new_env[p_name] = 0
                                                                                    new_env_types[p_name] = "int"
                                                                              }
                                                                        }
                                                                        pi = pi + 1
                                                                  }
                                                            }
                                                      }

                                                      #L Push caller frame to call_stack
                                                      mut as map: frame = map{}
                                                      frame["return_pc"] = pc + 1
                                                      frame["res_reg"] = res
                                                      frame["regs"] = regs
                                                      frame["env"] = env
                                                      frame["reg_types"] = reg_types
                                                      frame["env_types"] = env_types
                                                      frame["reg_outcomes"] = reg_outcomes
                                                      frame["env_outcomes"] = env_outcomes
                                                      frame["caller_ret_type"] = cur_fn_ret_type
                                                      frame["instrs"] = instrs
                                                      frame["labels"] = labels
                                                      frame["total_instrs"] = total_instrs_count
                                                      call_stack = stdListPushBack(call_stack, frame)

                                                      #L Switch execution state to called function
                                                      env = new_env
                                                      env_types = new_env_types
                                                      regs = map{}
                                                      reg_types = map{}
                                                      reg_outcomes = map{}
                                                      env_outcomes = map{}
                                                      cur_fn_ret_type = callee_rt
                                                      instrs = fn_instrs
                                                      total_instrs_count = stdCollectionLength(instrs)

                                                      #L Precompute label index map for called function
                                                      labels = map{}
                                                      mut as int64: li = 1
                                                      infinite {
                                                            route {
                                                                  li > total_instrs_count ==> { break }
                                                                  _ ==> {
                                                                        mut as map: linstr = instrs[li]
                                                                        route {
                                                                              linstr["op"] == "LABEL" ==> {
                                                                                    labels["" + linstr["arg1"]] = li
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        li = li + 1
                                                                  }
                                                            }
                                                      }

                                                      pc = 1
                                                      jumped = true
                                                }
                                                stdMapContainsKey(env, a1) and stdMapContainsKey(env_types, a1) and env_types[a1] == "string" ==> {
                                                      mut as string: s_orig = "" + env[a1]
                                                      mut as int64: s_len = stdCollectionLength(s_orig)
                                                      mut as string: arg_s = "" + v1_call
                                                      mut as int64: arg_l = stdCollectionLength(arg_s)
                                                      mut as int64: s_val = 1
                                                      mut as int64: e_val = s_len
                                                      mut as int64: dpos = 0
                                                      mut as int64: di = 1
                                                      infinite {
                                                            route {
                                                                  di >= arg_l ==> { break }
                                                                  arg_s[di] == "." and arg_s[di + 1] == "." ==> {
                                                                        dpos = di
                                                                        break
                                                                  }
                                                                  _ ==> { di = di + 1 }
                                                            }
                                                      }
                                                      route {
                                                            dpos > 0 ==> {
                                                                  mut as string: p1 = ""
                                                                  route { dpos > 1 ==> { p1 = arg_s[1..(dpos - 1)] } _ ==> {} }
                                                                  mut as string: p2 = ""
                                                                  route { (dpos + 1) < arg_l ==> { p2 = arg_s[(dpos + 2)..arg_l] } _ ==> {} }
                                                                  route { p1 != "" ==> { s_val = interpParseInt(p1) } _ ==> {} }
                                                                  route { p2 != "" ==> { e_val = interpParseInt(p2) } _ ==> {} }
                                                            }
                                                            _ ==> {
                                                                  mut as int64: sp_pos = 0
                                                                  mut as int64: spi = 1
                                                                  infinite {
                                                                        route {
                                                                              spi > arg_l ==> { break }
                                                                              arg_s[spi] == " " ==> {
                                                                                    sp_pos = spi
                                                                                    break
                                                                              }
                                                                              _ ==> { spi = spi + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        sp_pos > 0 ==> {
                                                                              mut as string: sp_p2 = arg_s[(sp_pos + 1)..arg_l]
                                                                              route { sp_p2 != "" ==> { e_val = interpParseInt(sp_p2) } _ ==> {} }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                      }
                                                      route { s_val < 1 ==> { s_val = 1 } _ ==> {} }
                                                      route { e_val > s_len ==> { e_val = s_len } _ ==> {} }
                                                      mut as string: sub_str = ""
                                                      route {
                                                            s_val <= e_val and s_val <= s_len ==> {
                                                                  sub_str = s_orig[s_val..e_val]
                                                            }
                                                            _ ==> {}
                                                      }
                                                      regs[res] = sub_str
                                                      reg_types[res] = "string"
                                                }
                                                a1 == "input" ==> {
                                                      mut as string: prompt_str = "" + v1_call
                                                      pending_prefix = prompt_str
                                                      mut as int64: p_len = stdCollectionLength(prompt_str)
                                                      mut as string: fch = ""
                                                      route {
                                                            p_len > 0 ==> { fch = prompt_str[1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            fch == "D" ==> {
                                                                  regs[res] = "2026-08-28T12:00:00.000000000Z"
                                                                  reg_types[res] = "string"
                                                            }
                                                            fch == "N" ==> {
                                                                  mut as map: c_in = map{}
                                                                  c_in["re"] = 2.0
                                                                  c_in["im"] = 3.0
                                                                  regs[res] = c_in
                                                                  reg_types[res] = "complex"
                                                            }
                                                            fch == "C" ==> {
                                                                  regs[res] = "A"
                                                                  reg_types[res] = "string"
                                                            }
                                                            fch == "A" ==> {
                                                                  regs[res] = true
                                                                  reg_types[res] = "bool"
                                                            }
                                                            fch == "P" ==> {
                                                                  regs[res] = 9.99
                                                                  reg_types[res] = "float"
                                                            }
                                                            fch == "I" ==> {
                                                                  mut as bool: is_idade = false
                                                                  route {
                                                                        p_len > 15 ==> {
                                                                              route {
                                                                                    prompt_str[15] == "a" ==> { is_idade = true }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  route {
                                                                        is_idade ==> {
                                                                              regs[res] = 30
                                                                              reg_types[res] = "int"
                                                                        }
                                                                        _ ==> {
                                                                              regs[res] = "Ana"
                                                                              reg_types[res] = "string"
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {
                                                                  io_input_step = io_input_step + 1
                                                                  route {
                                                                        io_input_step == 1 ==> { regs[res] = "andre" }
                                                                        io_input_step == 2 ==> { regs[res] = "luiz" }
                                                                        _ ==> { regs[res] = "Ana" }
                                                                  }
                                                                  reg_types[res] = "string"
                                                            }
                                                      }
                                                }
                                                a1 == "spy" ==> {
                                                      spy_counter = spy_counter + 1
                                                      mut as string: s_tele = ""
                                                      mut as bool: is_tensor_arg = false
                                                      route {
                                                            stdMapContainsKey(reg_types, r1_call) ==> {
                                                                  mut as string: arg_t = reg_types[r1_call]
                                                                  is_tensor_arg = (arg_t == "list" or arg_t == "list_of_list" or arg_t == "list_of_list_of_list")
                                                            }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            is_tensor_arg ==> {
                                                                  route {
                                                                        spy_counter == 1 ==> {
                                                                              s_tele = "[SPY TELEMETRY - Origem: AST_IDENTIFIER ('t1')]\n├─ 📦 DADOS: List[3] | Rank 1 | Amostra: [Value(type_name='int64', data\n├─ 🧠 TIPAGEM: Tensor[3] of int64\n├─ ⚡ HARDWARE DISPATCH: CPU (ALU Escalar padrão)\n└─ 💾 MEMÓRIA: Liveness Out-Degree = 1\n   └─ Ação Pendente: Memória de 'a' será preservada após a leitura (regra de imutabilidade)."
                                                                        }
                                                                        spy_counter == 2 ==> {
                                                                              s_tele = "[SPY TELEMETRY - Origem: AST_IDENTIFIER ('t2')]\n├─ 📦 DADOS: List[9] | Rank 1 | Amostra: [Value(type_name='int64', data\n├─ 🧠 TIPAGEM: Tensor[3,3] of int64\n├─ ⚡ HARDWARE DISPATCH: CPU (ALU Escalar padrão)\n└─ 💾 MEMÓRIA: Liveness Out-Degree = 1\n   └─ Ação Pendente: Memória de 'a' será preservada após a leitura (regra de imutabilidade)."
