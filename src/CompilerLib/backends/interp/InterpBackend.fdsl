                                    opcode == "BINOP_.." ==> {
                                          mut as string: v1_rng = ""
                                          mut as string: v2_rng = ""
                                          route {
                                                stdMapContainsKey(regs, a1) ==> { v1_rng = "" + regs[a1] }
                                                _ ==> {
                                                      mut as int64: a1_l = stdCollectionLength(a1)
                                                      route {
                                                            a1_l > 0 ==> {
                                                                  route {
                                                                        a1[1] == "%" ==> {}
                                                                        _ ==> { v1_rng = a1 }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                          }
                                          route {
