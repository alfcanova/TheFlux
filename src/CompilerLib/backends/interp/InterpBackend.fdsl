                                                                  gf_type = "string"
                                                            }
                                                            a2 == "_struct_name" ==> {
                                                                  regs[res] = "" + regs[a1]
                                                                  gf_type = "string"
                                                            }
                                                            _ ==> { regs[res] = "None" }
                                                      }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as string: e1_t = ""
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { e1_t = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            e1_t == "struct" or e1_t == "outcome" or e1_t == "map" ==> {
                                                                  mut as map: s_obj = env[a1]
                                                                  route {
                                                                        stdMapContainsKey(s_obj, a2) ==> { regs[res] = s_obj[a2] }
                                                                        e1_t == "outcome" and stdMapContainsKey(s_obj, "val") ==> {
                                                                              mut as data: p_obj = s_obj["val"]
                                                                              route {
                                                                                    stdMapContainsKey(p_obj, a2) ==> { regs[res] = p_obj[a2] }
                                                                                    _ ==> { regs[res] = "None" }
                                                                              }
                                                                        }
                                                                        a2 == "val" and stdMapContainsKey(env_outcomes, a1) ==> {
                                                                              regs[res] = env[a1]
                                                                              gf_type = e1_t
                                                                        }
                                                                        (a2 == "sta" or a2 == "msg") and stdMapContainsKey(env_outcomes, a1) ==> {
                                                                              mut as map: om_gf = env_outcomes[a1]
                                                                              mut as string: om_s = "" + om_gf[a2]
                                                                              regs[res] = om_s
                                                                              gf_type = "string"
                                                                        }
                                                                        _ ==> { regs[res] = "None" }
                                                                  }
                                                            }
                                                            a2 == "val" ==> {
                                                                  regs[res] = env[a1]
                                                                  route { e1_t != "" ==> { gf_type = e1_t } _ ==> {} }
                                                            }
                                                            a2 == "sta" ==> {
                                                                  route {
                                                                        stdMapContainsKey(env_outcomes, a1) ==> {
                                                                              mut as map: om_gf = env_outcomes[a1]
                                                                              mut as string: om_s = "" + om_gf["sta"]
                                                                              regs[res] = om_s
                                                                        }
                                                                        _ ==> { regs[res] = "nice" }
                                                                  }
                                                                  gf_type = "string"
                                                            }
                                                            a2 == "msg" ==> {
                                                                  route {
                                                                        stdMapContainsKey(env_outcomes, a1) ==> {
                                                                              mut as map: om_gf = env_outcomes[a1]
                                                                              mut as string: om_s = "" + om_gf["msg"]
                                                                              regs[res] = om_s
                                                                        }
                                                                        _ ==> { regs[res] = "ok" }
                                                                  }
                                                                  gf_type = "string"
                                                            }
                                                            a2 == "_struct_name" ==> {
                                                                  regs[res] = "" + env[a1]
                                                                  gf_type = "string"
                                                            }
                                                            _ ==> { regs[res] = "None" }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = "None"
                                                }
                                          }
                                          reg_types[res] = gf_type
                                          route {
                                                gf_type == "data" or gf_type == "" or gf_type == "map" ==> {
                                                      reg_types[res] = interpInferDataType(regs[res])
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "SET_FIELD" ==> {
                                          mut as string: vreg = res
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as map: s_target = env[a1]
                                                      route {
                                                            stdMapContainsKey(regs, vreg) ==> {
                                                                  mut as string: sf2_vt = ""
                                                                  route { stdMapContainsKey(reg_types, vreg) ==> { sf2_vt = reg_types[vreg] } _ ==> {} }
                                                                  route {
                                                                        sf2_vt == "string" ==> {
                                                                              mut as string: sf2_s = "" + regs[vreg]
                                                                              s_target[a2] = sf2_s
                                                                        }
                                                                        sf2_vt == "float" ==> {
                                                                              mut as float64: sf2_f = regs[vreg] as float64
                                                                              s_target[a2] = sf2_f
                                                                        }
                                                                        sf2_vt == "bool" ==> {
                                                                              mut as bool: sf2_b = regs[vreg] == true
                                                                              s_target[a2] = sf2_b
                                                                        }
                                                                        sf2_vt == "list" or sf2_vt == "set" or sf2_vt == "list_of_list" or sf2_vt == "list_of_list_of_list" ==> {
                                                                              mut as list of data: sf2_l = regs[vreg]
                                                                              s_target[a2] = sf2_l
                                                                        }
                                                                        sf2_vt == "map" or sf2_vt == "struct" or sf2_vt == "complex" ==> {
                                                                              mut as map: sf2_m = regs[vreg]
                                                                              s_target[a2] = sf2_m
                                                                        }
                                                                        _ ==> {
                                                                              s_target[a2] = regs[vreg]
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                      env[a1] = s_target
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "GET_INDEX" ==> {
                                          mut as list of data: idx_list = []
                                          mut as int64: a2_len = stdCollectionLength(a2)
                                          mut as bool: has_comma = false
                                          mut as int64: cs = 1
                                          infinite {
                                                route {
                                                      cs > a2_len ==> { break }
                                                      a2[cs] == "," ==> {
                                                            has_comma = true
                                                            break
                                                      }
                                                      _ ==> { cs = cs + 1 }
                                                }
                                          }
                                          mut as int64: num_idxs = 1
                                          mut as string: k_idx = ""
                                          route {
                                                has_comma ==> {
                                                      mut as int64: last_p = 1
                                                      mut as int64: p_scan = 1
                                                      infinite {
                                                            route {
                                                                  p_scan > a2_len ==> {
                                                                        route {
                                                                              last_p <= a2_len ==> {
                                                                                    mut as string: piece = a2[last_p..a2_len]
                                                                                    mut as string: pval_str = ""
                                                                                    route {
                                                                                          stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                                          stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                                          _ ==> { pval_str = piece }
                                                                                    }
                                                                                    idx_list = stdListPushBack(idx_list, interpParseInt(pval_str))
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        break
                                                                  }
                                                                  a2[p_scan] == "," ==> {
                                                                        mut as string: piece = a2[last_p..(p_scan - 1)]
                                                                        mut as string: pval_str = ""
                                                                        route {
                                                                              stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                              stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                              _ ==> { pval_str = piece }
                                                                        }
                                                                        idx_list = stdListPushBack(idx_list, interpParseInt(pval_str))
                                                                        last_p = p_scan + 1
                                                                        p_scan = p_scan + 1
                                                                  }
                                                                  _ ==> { p_scan = p_scan + 1 }
                                                            }
                                                      }
                                                      num_idxs = stdCollectionLength(idx_list)
                                                }
                                                _ ==> {
                                                      mut as string: piece = a2
                                                      mut as string: pval_str = ""
                                                      route {
                                                            stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                            stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                            _ ==> { pval_str = piece }
                                                      }
                                                      k_idx = pval_str
                                                      num_idxs = 1
                                                }
                                          }

                                          mut as data: target_base = 0
                                          mut as string: base_ty = ""
                                          mut as bool: has_base = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      target_base = regs[a1]
                                                      has_base = true
                                                      route { stdMapContainsKey(reg_types, a1) ==> { base_ty = reg_types[a1] } _ ==> {} }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      target_base = env[a1]
                                                      has_base = true
                                                      route { stdMapContainsKey(env_types, a1) ==> { base_ty = env_types[a1] } _ ==> {} }
                                                }
                                                _ ==> {}
                                          }

                                          route {
                                                has_base ==> {
                                                      route {
                                                            base_ty == "" or base_ty == "data" ==> {
                                                                  base_ty = interpInferDataType(target_base)
                                                            }
                                                            _ ==> {}
                                                      }

                                                      route {
                                                            num_idxs == 2 and (base_ty == "list" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list") ==> {
                                                                  #L 2D tensor indexing
                                                                  mut as int64: r_idx = idx_list[1]
                                                                  mut as int64: c_idx = idx_list[2]
                                                                  mut as list of data: matrix = target_base
                                                                  mut as int64: m_rows = stdCollectionLength(matrix)
                                                                  route {
                                                                        r_idx >= 1 and r_idx <= m_rows ==> {
                                                                              mut as list of data: row_vec = matrix[r_idx]
                                                                              mut as int64: m_cols = stdCollectionLength(row_vec)
                                                                              route {
                                                                                    c_idx >= 1 and c_idx <= m_cols ==> {
                                                                                          regs[res] = row_vec[c_idx]
                                                                                    }
                                                                                    _ ==> { regs[res] = 0 }
                                                                              }
                                                                        }
                                                                        _ ==> { regs[res] = 0 }
                                                                  }
                                                            }
                                                            num_idxs == 3 and (base_ty == "list" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list") ==> {
                                                                  #L 3D tensor indexing
                                                                  mut as int64: d1 = idx_list[1]
                                                                  mut as int64: d2 = idx_list[2]
                                                                  mut as int64: d3 = idx_list[3]
                                                                  mut as list of data: cube = target_base
                                                                  mut as int64: c_len = stdCollectionLength(cube)
                                                                  route {
                                                                        d1 >= 1 and d1 <= c_len ==> {
                                                                              mut as list of data: mat = cube[d1]
                                                                              mut as int64: mat_len = stdCollectionLength(mat)
                                                                              route {
                                                                                    d2 >= 1 and d2 <= mat_len ==> {
                                                                                          mut as list of data: row = mat[d2]
                                                                                          mut as int64: row_len = stdCollectionLength(row)
                                                                                          route {
                                                                                                d3 >= 1 and d3 <= row_len ==> {
                                                                                                      regs[res] = row[d3]
                                                                                                }
                                                                                                _ ==> { regs[res] = 0 }
                                                                                          }
                                                                                    }
                                                                                    _ ==> { regs[res] = 0 }
                                                                              }
                                                                        }
                                                                        _ ==> { regs[res] = 0 }
                                                                  }
                                                            }
                                                            base_ty == "map" or base_ty == "struct" ==> {
                                                                  mut as map: m = target_base
                                                                  route {
                                                                        stdMapContainsKey(m, k_idx) ==> {
                                                                              regs[res] = m[k_idx]
                                                                              reg_types[res] = interpInferDataType(regs[res])
                                                                        }
                                                                        _ ==> {
                                                                              regs[res] = "None"
                                                                              reg_types[res] = "data"
                                                                        }
                                                                  }
                                                            }
                                                            base_ty == "list" or base_ty == "set" or base_ty == "list_of_list" or base_ty == "list_of_list_of_list" or base_ty == "data" or base_ty == "" ==> {
                                                                  mut as list of data: l = target_base
                                                                  mut as int64: llen = stdCollectionLength(l)
                                                                  mut as int64: klen = stdCollectionLength(k_idx)
                                                                  mut as int64: dotdot_pos = 0
                                                                  mut as int64: ki = 1
                                                                  infinite {
                                                                        route {
                                                                              ki >= klen ==> { break }
                                                                              k_idx[ki] == "." and k_idx[ki + 1] == "." ==> {
                                                                                    dotdot_pos = ki
                                                                                    break
                                                                              }
                                                                              _ ==> { ki = ki + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        dotdot_pos > 0 ==> {
                                                                              mut as string: s_str = ""
                                                                              route { dotdot_pos > 1 ==> { s_str = k_idx[1..(dotdot_pos - 1)] } _ ==> {} }
                                                                              mut as string: e_str = ""
                                                                              route { (dotdot_pos + 1) < klen ==> { e_str = k_idx[(dotdot_pos + 2)..klen] } _ ==> {} }
                                                                              mut as int64: s_val = 1
                                                                              route { s_str != "" ==> { s_val = interpParseInt(s_str) } _ ==> {} }
                                                                              mut as int64: e_val = llen
                                                                              route { e_str != "" ==> { e_val = interpParseInt(e_str) } _ ==> {} }
                                                                              mut as list of data: sub = []
                                                                              route {
                                                                                    s_val >= 1 and e_val >= s_val and s_val <= llen ==> {
                                                                                          mut as int64: actual_end = e_val
                                                                                          route { actual_end > llen ==> { actual_end = llen } _ ==> {} }
                                                                                          mut as int64: cur_idx = s_val
                                                                                          infinite {
                                                                                                route {
                                                                                                      cur_idx > actual_end ==> { break }
                                                                                                      _ ==> {
                                                                                                            mut as data: el_gi = l[cur_idx]
                                                                                                            mut as string: el_gi_ty = interpInferDataType(el_gi)
                                                                                                            route {
                                                                                                                  el_gi_ty == "string" ==> {
                                                                                                                        mut as string: s_el_gi = "" + el_gi
                                                                                                                        sub = stdListPushBack(sub, s_el_gi)
                                                                                                                  }
                                                                                                                  el_gi_ty == "float" ==> {
                                                                                                                        mut as float64: f_el_gi = el_gi as float64
                                                                                                                        sub = stdListPushBack(sub, f_el_gi)
                                                                                                                  }
                                                                                                                  el_gi_ty == "bool" ==> {
                                                                                                                        mut as bool: b_el_gi = el_gi == true
                                                                                                                        sub = stdListPushBack(sub, b_el_gi)
                                                                                                                  }
                                                                                                                  el_gi_ty == "list" or el_gi_ty == "set" ==> {
                                                                                                                        mut as list of data: l_el_gi = el_gi
                                                                                                                        sub = stdListPushBack(sub, l_el_gi)
                                                                                                                  }
                                                                                                                  el_gi_ty == "map" or el_gi_ty == "struct" ==> {
                                                                                                                        mut as map: m_el_gi = el_gi
                                                                                                                        sub = stdListPushBack(sub, m_el_gi)
                                                                                                                  }
                                                                                                                  _ ==> {
                                                                                                                        sub = stdListPushBack(sub, el_gi)
                                                                                                                  }
                                                                                                            }
                                                                                                            cur_idx = cur_idx + 1
                                                                                                      }
                                                                                                }
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              regs[res] = sub
                                                                              reg_types[res] = "list"
                                                                        }
                                                                        _ ==> {
                                                                              mut as int64: idx = 0
                                                                              mut as bool: idx_res = false
                                                                              route {
                                                                                    stdMapContainsKey(regs, a2) ==> {
                                                                                          mut as string: a2_rt = ""
                                                                                          route { stdMapContainsKey(reg_types, a2) ==> { a2_rt = reg_types[a2] } _ ==> {} }
                                                                                          route {
                                                                                                a2_rt == "int" or a2_rt == "int64" or a2_rt == "int32" or a2_rt == "int16" or a2_rt == "int8" ==> {
                                                                                                      idx = regs[a2] as int64
                                                                                                      idx_res = true
                                                                                                }
                                                                                                _ ==> {}
                                                                                          }
                                                                                    }
                                                                                    stdMapContainsKey(env, a2) ==> {
                                                                                          mut as string: a2_et = ""
                                                                                          route { stdMapContainsKey(env_types, a2) ==> { a2_et = env_types[a2] } _ ==> {} }
                                                                                          route {
                                                                                                a2_et == "int" or a2_et == "int64" or a2_et == "int32" or a2_et == "int16" or a2_et == "int8" ==> {
                                                                                                      idx = env[a2] as int64
                                                                                                      idx_res = true
                                                                                                }
                                                                                                _ ==> {}
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              route {
                                                                                    not idx_res ==> { idx = interpParseInt(k_idx) }
                                                                                    _ ==> {}
                                                                              }
                                                                              route {
                                                                                    idx >= 1 and idx <= llen ==> {
                                                                                          regs[res] = l[idx]
                                                                                          reg_types[res] = interpInferDataType(regs[res])
                                                                                    }
                                                                                    _ ==> {
                                                                                          regs[res] = "None"
                                                                                          reg_types[res] = "data"
                                                                                    }
                                                                              }
                                                                        }
                                                                  }
                                                            }
                                                            base_ty == "string" ==> {
                                                                  mut as string: s = "" + target_base
                                                                  mut as int64: slen = stdCollectionLength(s)
                                                                  mut as int64: klen_s = stdCollectionLength(k_idx)
                                                                  mut as int64: dotdot_pos_s = 0
                                                                  mut as int64: ksi = 1
                                                                  infinite {
                                                                        route {
                                                                              ksi >= klen_s ==> { break }
                                                                              k_idx[ksi] == "." and k_idx[ksi + 1] == "." ==> {
                                                                                    dotdot_pos_s = ksi
                                                                                    break
                                                                              }
                                                                              _ ==> { ksi = ksi + 1 }
                                                                        }
                                                                  }
                                                                  route {
                                                                        dotdot_pos_s > 0 ==> {
                                                                              mut as string: s_str = ""
                                                                              route { dotdot_pos_s > 1 ==> { s_str = k_idx[1..(dotdot_pos_s - 1)] } _ ==> {} }
                                                                              mut as string: e_str = ""
                                                                              route { (dotdot_pos_s + 1) < klen_s ==> { e_str = k_idx[(dotdot_pos_s + 2)..klen_s] } _ ==> {} }
                                                                              mut as int64: s_val = 1
                                                                              route { s_str != "" ==> { s_val = interpParseInt(s_str) } _ ==> {} }
                                                                              mut as int64: e_val = slen
                                                                              route { e_str != "" ==> { e_val = interpParseInt(e_str) } _ ==> {} }
                                                                              mut as string: sub_str = ""
                                                                              route {
                                                                                    s_val >= 1 and e_val >= s_val and s_val <= slen ==> {
                                                                                          mut as int64: actual_end = e_val
                                                                                          route { actual_end > slen ==> { actual_end = slen } _ ==> {} }
                                                                                          sub_str = s[s_val..actual_end]
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                              regs[res] = sub_str
                                                                        }
                                                                        _ ==> {
                                                                              mut as int64: idx = interpParseInt(k_idx)
                                                                              route {
                                                                                    idx >= 1 and idx <= slen ==> { regs[res] = s[idx] }
                                                                                    _ ==> { regs[res] = "" }
                                                                              }
                                                                        }
                                                                  }
                                                                  reg_types[res] = "string"
                                                            }
                                                            _ ==> {
                                                                  regs[res] = "None"
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = "None"
                                                }
                                          }

                                          #L Auto-infer element type to preserve chained index/field lookups
                                          route {
                                                (not stdMapContainsKey(reg_types, res)) or reg_types[res] == "data" or reg_types[res] == "" ==> {
                                                      reg_types[res] = interpInferDataType(regs[res])
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "SET_INDEX" ==> {
                                          mut as string: vreg = res
                                          mut as string: k_si = ""
                                          mut as list of data: si_list = []
                                          mut as int64: a2_slen = stdCollectionLength(a2)
                                          mut as bool: has_comma_si = false
                                          mut as int64: css = 1
                                          infinite {
                                                route {
                                                      css > a2_slen ==> { break }
                                                      a2[css] == "," ==> {
                                                            has_comma_si = true
                                                            break
                                                      }
                                                      _ ==> { css = css + 1 }
                                                }
                                          }
                                          mut as int64: num_sis = 1
                                          route {
                                                has_comma_si ==> {
                                                      mut as int64: si_last = 1
                                                      mut as int64: si_scan = 1
                                                      infinite {
                                                            route {
                                                                  si_scan > a2_slen ==> {
                                                                        route {
                                                                              si_last <= a2_slen ==> {
                                                                                    mut as string: piece = a2[si_last..a2_slen]
                                                                                    mut as string: pval_str = ""
                                                                                    route {
                                                                                          stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                                          stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                                          _ ==> { pval_str = piece }
                                                                                    }
                                                                                    si_list = stdListPushBack(si_list, interpParseInt(pval_str))
                                                                              }
                                                                              _ ==> {}
                                                                        }
                                                                        break
                                                                  }
                                                                  a2[si_scan] == "," ==> {
                                                                        mut as string: piece = a2[si_last..(si_scan - 1)]
                                                                        mut as string: pval_str = ""
                                                                        route {
                                                                              stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                                              stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                                              _ ==> { pval_str = piece }
                                                                        }
                                                                        si_list = stdListPushBack(si_list, interpParseInt(pval_str))
                                                                        si_last = si_scan + 1
                                                                        si_scan = si_scan + 1
                                                                  }
                                                                  _ ==> { si_scan = si_scan + 1 }
                                                            }
                                                      }
                                                      num_sis = stdCollectionLength(si_list)
                                                }
                                                _ ==> {
                                                      mut as string: piece = a2
                                                      mut as string: pval_str = ""
                                                      route {
                                                            stdMapContainsKey(regs, piece) ==> { pval_str = "" + regs[piece] }
                                                            stdMapContainsKey(env, piece) ==> { pval_str = "" + env[piece] }
                                                            _ ==> { pval_str = piece }
                                                      }
                                                      k_si = pval_str
                                                      num_sis = 1
                                                }
                                          }

                                          mut as bool: has_target = false
                                          mut as data: target_val = 0
                                          mut as string: etype = ""
                                          mut as bool: target_in_env = false
                                          route {
                                                stdMapContainsKey(env, a1) ==> {
                                                      has_target = true
                                                      target_val = env[a1]
                                                      target_in_env = true
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { etype = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                stdMapContainsKey(regs, a1) ==> {
                                                      has_target = true
                                                      target_val = regs[a1]
                                                      route {
                                                            stdMapContainsKey(reg_types, a1) ==> { etype = reg_types[a1] }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }

                                          mut as bool: has_vval = false
                                          mut as data: vval = 0
                                          mut as string: vr_ty = ""
                                          route {
                                                stdMapContainsKey(regs, vreg) ==> {
                                                      has_vval = true
                                                      vval = regs[vreg]
                                                      route { stdMapContainsKey(reg_types, vreg) ==> { vr_ty = reg_types[vreg] } _ ==> {} }
                                                }
                                                stdMapContainsKey(env, vreg) ==> {
                                                      has_vval = true
                                                      vval = env[vreg]
                                                      route { stdMapContainsKey(env_types, vreg) ==> { vr_ty = env_types[vreg] } _ ==> {} }
                                                }
                                                _ ==> {
                                                      has_vval = true
                                                      vval = vreg
                                                      vr_ty = "string"
                                                }
                                          }
                                          route {
                                                (vr_ty == "data" or vr_ty == "") ==> {
                                                      vr_ty = interpInferDataType(vval)
                                                }
                                                _ ==> {}
                                          }
                                          regs[vreg] = vval
                                          reg_types[vreg] = vr_ty

                                          route {
                                                has_target and has_vval ==> {
                                                      route {
                                                            etype == "" or etype == "data" ==> {
                                                                  etype = interpInferDataType(target_val)
                                                            }
                                                            _ ==> {}
                                                      }
                                                      mut as bool: vr_is_flt = (vr_ty == "string" or vr_ty == "float")
                                                      route {
                                                            num_sis == 2 and (etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data") ==> {
                                                                  #L In-place 2D tensor mutation
                                                                  mut as int64: r_si = si_list[1]
                                                                  mut as int64: c_si = si_list[2]
                                                                  mut as list of data: target_matrix = target_val
                                                                  mut as int64: t_rows = stdCollectionLength(target_matrix)
                                                                  route {
                                                                        r_si >= 1 and r_si <= t_rows ==> {
                                                                              mut as list of data: row_vec = target_matrix[r_si]
                                                                              mut as int64: t_cols = stdCollectionLength(row_vec)
                                                                              route {
                                                                                    c_si >= 1 and c_si <= t_cols ==> {
                                                                                          route {
                                                                                                vr_is_flt ==> { row_vec[c_si] = "" + regs[vreg] }
                                                                                                _ ==> { row_vec[c_si] = regs[vreg] }
                                                                                          }
                                                                                          target_matrix[r_si] = row_vec
                                                                                          route {
                                                                                                target_in_env ==> { env[a1] = target_matrix }
                                                                                                _ ==> { regs[a1] = target_matrix }
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            num_sis == 3 and (etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data") ==> {
                                                                  #L In-place 3D tensor mutation
                                                                  mut as int64: sd1 = si_list[1]
                                                                  mut as int64: sd2 = si_list[2]
                                                                  mut as int64: sd3 = si_list[3]
                                                                  mut as list of data: target_cube = target_val
                                                                  mut as int64: tc_len = stdCollectionLength(target_cube)
                                                                  route {
                                                                        sd1 >= 1 and sd1 <= tc_len ==> {
                                                                              mut as list of data: mat = target_cube[sd1]
                                                                              mut as int64: mat_len = stdCollectionLength(mat)
                                                                              route {
                                                                                    sd2 >= 1 and sd2 <= mat_len ==> {
                                                                                          mut as list of data: row = mat[sd2]
                                                                                          mut as int64: row_len = stdCollectionLength(row)
                                                                                          route {
                                                                                                sd3 >= 1 and sd3 <= row_len ==> {
                                                                                                      route {
                                                                                                            vr_is_flt ==> { row[sd3] = "" + regs[vreg] }
                                                                                                            _ ==> { row[sd3] = regs[vreg] }
                                                                                                      }
                                                                                                      mat[sd2] = row
                                                                                                      target_cube[sd1] = mat
                                                                                                      route {
                                                                                                            target_in_env ==> { env[a1] = target_cube }
                                                                                                            _ ==> { regs[a1] = target_cube }
                                                                                                      }
                                                                                                }
                                                                                                _ ==> {}
                                                                                          }
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            etype == "map" ==> {
                                                                  mut as map: m = target_val
                                                                  route {
                                                                        vr_ty == "string" ==> {
                                                                              mut as string: msi_s = "" + regs[vreg]
                                                                              m[k_si] = msi_s
                                                                        }
                                                                        vr_ty == "float" ==> {
                                                                              mut as float64: msi_f = regs[vreg] as float64
                                                                              m[k_si] = msi_f
                                                                        }
                                                                        vr_ty == "bool" ==> {
                                                                              mut as bool: msi_b = regs[vreg] == true
                                                                              m[k_si] = msi_b
                                                                        }
                                                                        vr_ty == "list" or vr_ty == "set" or vr_ty == "list_of_list" or vr_ty == "list_of_list_of_list" ==> {
                                                                              mut as list of data: msi_l = regs[vreg]
                                                                              m[k_si] = msi_l
                                                                        }
                                                                        vr_ty == "map" or vr_ty == "struct" or vr_ty == "complex" ==> {
                                                                              mut as map: msi_m = regs[vreg]
                                                                              m[k_si] = msi_m
                                                                        }
                                                                        _ ==> {
                                                                              m[k_si] = regs[vreg]
                                                                        }
                                                                  }
                                                                  route {
                                                                        target_in_env ==> {
                                                                              env[a1] = m
                                                                              env_types[a1] = "map"
                                                                        }
                                                                        _ ==> {
                                                                              regs[a1] = m
                                                                              reg_types[a1] = "map"
                                                                        }
                                                                  }
                                                            }
                                                            etype == "list" or etype == "list_of_list" or etype == "list_of_list_of_list" or etype == "data" or etype == "" ==> {
                                                                  mut as list of data: l = target_val
                                                                  mut as int64: idx = 0
                                                                  mut as bool: s_idx_res = false
                                                                  route {
                                                                        stdMapContainsKey(regs, a2) ==> {
                                                                              mut as string: a2_rt = ""
                                                                              route { stdMapContainsKey(reg_types, a2) ==> { a2_rt = reg_types[a2] } _ ==> {} }
                                                                              route {
                                                                                    a2_rt == "int" or a2_rt == "int64" or a2_rt == "int32" or a2_rt == "int16" or a2_rt == "int8" ==> {
                                                                                          idx = regs[a2] as int64
                                                                                          s_idx_res = true
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        stdMapContainsKey(env, a2) ==> {
                                                                              mut as string: a2_et = ""
                                                                              route { stdMapContainsKey(env_types, a2) ==> { a2_et = env_types[a2] } _ ==> {} }
                                                                              route {
                                                                                    a2_et == "int" or a2_et == "int64" or a2_et == "int32" or a2_et == "int16" or a2_et == "int8" ==> {
                                                                                          idx = env[a2] as int64
                                                                                          s_idx_res = true
                                                                                    }
                                                                                    _ ==> {}
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  route {
                                                                        not s_idx_res ==> { idx = interpParseInt(k_si) }
                                                                        _ ==> {}
                                                                  }
                                                                  mut as int64: llen = stdCollectionLength(l)
                                                                  route {
                                                                        idx >= 1 and idx <= llen ==> {
                                                                              route {
                                                                                    vr_ty == "string" ==> {
                                                                                          mut as string: lsi_s = "" + regs[vreg]
                                                                                          l[idx] = lsi_s
                                                                                    }
                                                                                    vr_ty == "float" ==> {
                                                                                          mut as float64: lsi_f = regs[vreg] as float64
                                                                                          l[idx] = lsi_f
                                                                                    }
                                                                                    vr_ty == "bool" ==> {
                                                                                          mut as bool: lsi_b = regs[vreg] == true
                                                                                          l[idx] = lsi_b
                                                                                    }
                                                                                    vr_ty == "list" or vr_ty == "set" or vr_ty == "list_of_list" or vr_ty == "list_of_list_of_list" ==> {
                                                                                          mut as list of data: lsi_l = regs[vreg]
                                                                                          l[idx] = lsi_l
                                                                                    }
                                                                                    vr_ty == "map" or vr_ty == "struct" or vr_ty == "complex" ==> {
                                                                                          mut as map: lsi_m = regs[vreg]
                                                                                          l[idx] = lsi_m
                                                                                    }
                                                                                    _ ==> { l[idx] = regs[vreg] }
                                                                              }
                                                                              route {
                                                                                    target_in_env ==> { env[a1] = l }
                                                                                    _ ==> { regs[a1] = l }
                                                                              }
                                                                        }
                                                                        idx > llen ==> {
                                                                              #L Growth by assignment
                                                                              infinite {
                                                                                    route {
                                                                                          llen >= (idx - 1) ==> { break }
                                                                                          _ ==> {
                                                                                                l = stdListPushBack(l, 0)
                                                                                                llen = llen + 1
                                                                                          }
                                                                                    }
                                                                              }
                                                                              route {
                                                                                    vr_ty == "string" ==> {
                                                                                          mut as string: lsi_s2 = "" + regs[vreg]
                                                                                          l = stdListPushBack(l, lsi_s2)
                                                                                    }
                                                                                    vr_ty == "float" ==> {
                                                                                          mut as float64: lsi_f2 = regs[vreg] as float64
                                                                                          l = stdListPushBack(l, lsi_f2)
                                                                                    }
                                                                                    vr_ty == "bool" ==> {
                                                                                          mut as bool: lsi_b2 = regs[vreg] == true
                                                                                          l = stdListPushBack(l, lsi_b2)
                                                                                    }
                                                                                    vr_ty == "list" or vr_ty == "set" or vr_ty == "list_of_list" or vr_ty == "list_of_list_of_list" ==> {
                                                                                          mut as list of data: lsi_l2 = regs[vreg]
                                                                                          l = stdListPushBack(l, lsi_l2)
                                                                                    }
                                                                                    vr_ty == "map" or vr_ty == "struct" or vr_ty == "complex" ==> {
                                                                                          mut as map: lsi_m2 = regs[vreg]
                                                                                          l = stdListPushBack(l, lsi_m2)
                                                                                    }
                                                                                    _ ==> { l = stdListPushBack(l, regs[vreg]) }
                                                                              }
                                                                              route {
                                                                                    target_in_env ==> { env[a1] = l }
                                                                                    _ ==> { regs[a1] = l }
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                    }
                                    opcode == "GET_SLICE" ==> {
                                          mut as data: slice_src = 0
                                          mut as string: a1_ty = "list"
                                          mut as bool: has_slice_src = false
                                          route {
                                                stdMapContainsKey(regs, a1) ==> {
                                                      slice_src = regs[a1]
                                                      has_slice_src = true
                                                      route { stdMapContainsKey(reg_types, a1) ==> { a1_ty = reg_types[a1] } _ ==> {} }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      slice_src = env[a1]
                                                      has_slice_src = true
                                                      route { stdMapContainsKey(env_types, a1) ==> { a1_ty = env_types[a1] } _ ==> {} }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                has_slice_src ==> {
                                                      mut as int64: colpos = 0
                                                      mut as int64: a2len = stdCollectionLength(a2)
                                                      mut as int64: a2i = 1
                                                      infinite {
                                                            route {
                                                                  a2i > a2len ==> { break }
                                                                  a2[a2i] == ":" ==> {
                                                                        colpos = a2i
                                                                        break
                                                                  }
                                                                  _ ==> { a2i = a2i + 1 }
                                                            }
                                                      }
                                                      mut as string: sreg = ""
                                                      route { colpos > 1 ==> { sreg = a2[1..(colpos - 1)] } _ ==> {} }
                                                      mut as string: ereg = ""
                                                      route { colpos < a2len ==> { ereg = a2[(colpos + 1)..a2len] } _ ==> {} }

                                                      mut as int64: s_val = 1
                                                      route {
                                                            sreg != "" and stdMapContainsKey(regs, sreg) ==> { s_val = regs[sreg] as int64 }
                                                            sreg != "" and stdMapContainsKey(env, sreg) ==> { s_val = env[sreg] as int64 }
                                                            sreg != "" ==> { s_val = interpParseInt(sreg) }
                                                            _ ==> {}
                                                      }

                                                      route {
                                                            a1_ty == "data" or a1_ty == "" ==> {
                                                                  a1_ty = interpInferDataType(slice_src)
                                                            }
                                                            _ ==> {}
                                                      }

                                                      route {
                                                            a1_ty == "string" ==> {
                                                                  mut as string: str_orig = "" + slice_src
                                                                  mut as int64: slen = stdCollectionLength(str_orig)
                                                                  mut as int64: e_val = slen
                                                                  route {
                                                                        ereg != "" and stdMapContainsKey(regs, ereg) ==> { e_val = regs[ereg] as int64 }
                                                                        ereg != "" and stdMapContainsKey(env, ereg) ==> { e_val = env[ereg] as int64 }
                                                                        ereg != "" ==> { e_val = interpParseInt(ereg) }
                                                                        _ ==> {}
                                                                  }
                                                                  mut as string: sub_str = ""
                                                                  route {
                                                                        s_val >= 1 and e_val >= s_val and s_val <= slen ==> {
                                                                              mut as int64: actual_end = e_val
                                                                              route { actual_end > slen ==> { actual_end = slen } _ ==> {} }
                                                                              sub_str = str_orig[s_val..actual_end]
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  regs[res] = sub_str
                                                                  reg_types[res] = "string"
                                                            }
                                                            _ ==> {
                                                                  mut as list of data: orig = slice_src
                                                                  mut as int64: olen = stdCollectionLength(orig)
                                                                  mut as int64: e_val = olen
                                                                  route {
                                                                        ereg != "" and stdMapContainsKey(regs, ereg) ==> { e_val = regs[ereg] as int64 }
                                                                        ereg != "" and stdMapContainsKey(env, ereg) ==> { e_val = env[ereg] as int64 }
                                                                        ereg != "" ==> { e_val = interpParseInt(ereg) }
                                                                        _ ==> {}
                                                                  }
                                                                  mut as list of data: sub = []
                                                                  route {
                                                                        s_val >= 1 and e_val >= s_val and s_val <= olen ==> {
                                                                              mut as int64: actual_end = e_val
                                                                              route { actual_end > olen ==> { actual_end = olen } _ ==> {} }
                                                                              mut as int64: cur_idx = s_val
                                                                              infinite {
                                                                                    route {
                                                                                          cur_idx > actual_end ==> { break }
                                                                                          _ ==> {
                                                                                                mut as data: el_sl = orig[cur_idx]
                                                                                                mut as string: el_sl_ty = interpInferDataType(el_sl)
                                                                                                route {
                                                                                                      el_sl_ty == "string" ==> {
                                                                                                            mut as string: s_el_sl = "" + el_sl
                                                                                                            sub = stdListPushBack(sub, s_el_sl)
                                                                                                      }
                                                                                                      el_sl_ty == "float" ==> {
                                                                                                            mut as float64: f_el_sl = el_sl as float64
                                                                                                            sub = stdListPushBack(sub, f_el_sl)
                                                                                                      }
                                                                                                      el_sl_ty == "bool" ==> {
                                                                                                            mut as bool: b_el_sl = el_sl == true
                                                                                                            sub = stdListPushBack(sub, b_el_sl)
                                                                                                      }
                                                                                                      el_sl_ty == "list" or el_sl_ty == "set" ==> {
                                                                                                            mut as list of data: l_el_sl = el_sl
                                                                                                            sub = stdListPushBack(sub, l_el_sl)
                                                                                                      }
                                                                                                      el_sl_ty == "map" or el_sl_ty == "struct" ==> {
                                                                                                            mut as map: m_el_sl = el_sl
                                                                                                            sub = stdListPushBack(sub, m_el_sl)
                                                                                                      }
                                                                                                      _ ==> {
                                                                                                            sub = stdListPushBack(sub, el_sl)
                                                                                                      }
                                                                                                }
                                                                                                cur_idx = cur_idx + 1
                                                                                          }
                                                                                    }
                                                                              }
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                                  regs[res] = sub
                                                                  reg_types[res] = "list"
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      regs[res] = []
                                                      reg_types[res] = "list"
                                                }
                                          }
                                    }
                                    opcode == "CALL" ==> {
                                          
                                          #L Parse multi-argument registers from a2 (e.g. "%t1,%t2")
                                          mut as string: a2_str = "" + a2
                                          mut as int64: a2_len = stdCollectionLength(a2_str)
                                          mut as int64: a2_cpos = 0
                                          mut as int64: a2_k = 1
                                          infinite {
                                                route {
                                                      a2_k > a2_len ==> { break }
                                                      a2_str[a2_k] == "," ==> {
                                                            a2_cpos = a2_k
                                                            break
                                                      }
                                                      _ ==> { a2_k = a2_k + 1 }
                                                }
                                          }
                                          mut as string: r1_call = a2_str
                                          mut as string: r2_call = ""
                                          route {
                                                a2_cpos > 0 ==> {
                                                      r1_call = a2_str[1..(a2_cpos - 1)]
                                                      r2_call = a2_str[(a2_cpos + 1)..a2_len]
                                                }
                                                _ ==> {}
                                          }
                                          mut as data: v1_call = 0
                                          mut as data: v2_call = 0
                                          route {
                                                stdMapContainsKey(regs, r1_call) ==> { v1_call = regs[r1_call] }
                                                stdMapContainsKey(env, r1_call) ==> { v1_call = env[r1_call] }
                                                _ ==> { v1_call = r1_call }
                                          }
                                          route {
                                                stdMapContainsKey(regs, r2_call) ==> { v2_call = regs[r2_call] }
                                                stdMapContainsKey(env, r2_call) ==> { v2_call = env[r2_call] }
                                                _ ==> { v2_call = r2_call }
                                          }
                                          mut as string: fn_target = a1
                                          route {
                                                (not stdMapContainsKey(funcs, fn_target)) ==> {
                                                      mut as int64: a1_len = stdCollectionLength(a1)
                                                      mut as int64: colon_pos = 0
                                                      mut as int64: ci = 1
                                                      infinite {
                                                            route {
                                                                  ci >= a1_len ==> { break }
                                                                  a1[ci] == ":" and a1[ci + 1] == ":" ==> {
                                                                        colon_pos = ci
                                                                        break
                                                                  }
                                                                  _ ==> { ci = ci + 1 }
                                                            }
                                                      }
                                                      route {
                                                            colon_pos > 0 ==> {
                                                                  mut as string: bare_op = a1[(colon_pos + 2)..a1_len]
                                                                  route {
                                                                        stdMapContainsKey(funcs, bare_op) ==> {
                                                                              fn_target = bare_op
                                                                        }
                                                                        _ ==> {}
                                                                  }
                                                            }
                                                            _ ==> {}
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          mut as list of string: arg_pieces = []
                                          mut as int64: a2_l = stdCollectionLength(a2)
                                          mut as int64: last_p = 1
                                          mut as int64: p_scan = 1
                                          mut as int64: b_depth = 0
                                          infinite {
                                                route {
                                                      p_scan > a2_l ==> {
                                                            route {
                                                                  last_p <= a2_l ==> {
                                                                        mut as string: piece = a2[last_p..a2_l]
                                                                        infinite {
                                                                              route {
                                                                                    stdCollectionLength(piece) > 0 and piece[1] == " " ==> {
                                                                                          piece = piece[2..stdCollectionLength(piece)]
                                                                                    }
                                                                                    _ ==> { break }
                                                                              }
                                                                        }
                                                                        arg_pieces = stdListPushBack(arg_pieces, piece)
                                                                  }
                                                                  _ ==> {}
                                                            }
                                                            break
                                                      }
                                                      a2[p_scan] == "[" or a2[p_scan] == "{" or a2[p_scan] == "(" ==> {
                                                            b_depth = b_depth + 1
                                                      }
                                                      a2[p_scan] == "]" or a2[p_scan] == "}" or a2[p_scan] == ")" ==> {
                                                            b_depth = b_depth - 1
                                                      }
                                                      a2[p_scan] == "," and b_depth == 0 ==> {
                                                            mut as string: piece = a2[last_p..(p_scan - 1)]
                                                            infinite {
                                                                  route {
                                                                        stdCollectionLength(piece) > 0 and piece[1] == " " ==> {
                                                                              piece = piece[2..stdCollectionLength(piece)]
                                                                        }
                                                                        _ ==> { break }
                                                                  }
                                                            }
                                                            arg_pieces = stdListPushBack(arg_pieces, piece)
                                                            last_p = p_scan + 1
                                                      }
                                                      _ ==> {}
                                                }
                                                p_scan = p_scan + 1
                                          }
                                          mut as list of data: call_args = []
                                          mut as int64: n_pieces = stdCollectionLength(arg_pieces)
                                          mut as int64: c_pi = 1
                                          infinite {
                                                route {
                                                      c_pi > n_pieces ==> { break }
                                                      _ ==> {
                                                            mut as string: piece = arg_pieces[c_pi]
                                                            infinite {
                                                                  route {
                                                                        stdCollectionLength(piece) > 0 and piece[1] == " " ==> {
                                                                              piece = piece[2..stdCollectionLength(piece)]
                                                                        }
                                                                        _ ==> { break }
                                                                  }
                                                            }
                                                            mut as data: p_val = 0
                                                            route {
                                                                  stdMapContainsKey(regs, piece) ==> { p_val = regs[piece] }
                                                                  stdMapContainsKey(env, piece) ==> { p_val = env[piece] }
                                                                  stdMapContainsKey(global_env, piece) ==> { p_val = global_env[piece] }
                                                                  _ ==> { p_val = piece }
                                                            }
                                                            call_args = stdListPushBack(call_args, p_val)
                                                            c_pi = c_pi + 1
                                                      }
                                                }
                                          }
                                          mut as bool: is_user_fn = false
                                          mut as string: user_fn_key = fn_target
                                          route {
                                                stdMapContainsKey(funcs, fn_target) ==> {
                                                      mut as map: uchk = funcs[fn_target]
                                                      route {
                                                            stdMapContainsKey(uchk, "is_stdlib") and uchk["is_stdlib"] == true ==> {
                                                                  is_user_fn = false
                                                                  fn_target = "" + uchk["name"]
                                                                  a1 = fn_target
                                                            }
                                                            _ ==> {
                                                                  is_user_fn = true
                                                                  fn_target = "__USER_CALL__"
                                                                  a1 = "__USER_CALL__"
                                                            }
                                                      }
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                fn_target == "stdGfxWindowCreate" ==> {
                                                      gfx_win_closed = false
                                                      regs[res] = 1
                                                      reg_types[res] = "int"
                                                }
                                                fn_target == "stdGfxWindowClose" ==> {
                                                      gfx_win_closed = true
                                                      regs[res] = true
