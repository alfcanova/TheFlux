                                    opcode == "BINOP_<=" ==> {
                                          route {
                                                (stdMapContainsKey(reg_types, a1) and reg_types[a1] == "string") or (stdMapContainsKey(reg_types, a2) and reg_types[a2] == "string") ==> {
