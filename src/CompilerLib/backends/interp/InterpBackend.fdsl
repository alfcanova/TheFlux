                                                                  infinite {
                                                                        route {
                                                                              li > ln ==> { break }
                                                                              _ ==> {
                                                                                    route {
                                                                                          li == 1 ==> { pval = pval + "" + l[li] }
                                                                                          _ ==> { pval = pval + ", " + l[li] }
                                                                                    }
                                                                                    li = li + 1
                                                                              }
                                                                        }
                                                                  }
                                                                  pval = pval + "]"
                                                            }
