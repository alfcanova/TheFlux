                                                                        }
                                                                  }
                                                                  pval = pval + ")"
                                                            }
                                                            ptype == "complex" ==> {
                                                                  mut as map: cm = regs[a1]
                                                                  mut as float64: cr = cm["re"] as float64
                                                                  mut as float64: ci = cm["im"] as float64
                                                                  route {
                                                                        ci >= 0.0 ==> {
                                                                              pval = "" + cr + " + " + ci + "i"
                                                                        }
                                                                        _ ==> {
                                                                              mut as float64: pos_ci = 0.0 - ci
                                                                              pval = "" + cr + " - " + pos_ci + "i"
                                                                        }
                                                                  }
                                                            }
                                                            ptype == "outcome" ==> {
                                                                  mut as map: outm = regs[a1]
                                                                  pval = "" + outm["val"]
                                                            }
                                                            _ ==> {
                                                                  pval = "" + regs[a1]
                                                            }
                                                      }
                                                }
                                                stdMapContainsKey(env, a1) ==> {
                                                      mut as string: et = ""
                                                      route {
                                                            stdMapContainsKey(env_types, a1) ==> { et = env_types[a1] }
                                                            _ ==> {}
                                                      }
                                                      route {
                                                            et == "complex" ==> {
                                                                  mut as map: cm_env = env[a1]
                                                                  mut as float64: cr_env = cm_env["re"] as float64
                                                                  mut as float64: ci_env = cm_env["im"] as float64
                                                                  route {
                                                                        ci_env >= 0.0 ==> {
                                                                              pval = "" + cr_env + " + " + ci_env + "i"
                                                                        }
                                                                        _ ==> {
                                                                              mut as float64: pos_ci_env = 0.0 - ci_env
                                                                              pval = "" + cr_env + " - " + pos_ci_env + "i"
                                                                        }
                                                                  }
                                                            }
                                                            _ ==> {
                                                                  pval = "" + env[a1]
                                                            }
                                                      }
                                                }
                                                _ ==> {
                                                      pval = a1
                                                }
                                          }
                                          route {
                                                pending_prefix != "" ==> {
                                                      pval = pending_prefix + pval
                                                      pending_prefix = ""
                                                }
                                                _ ==> {}
                                          }
                                          route {
                                                stdCollectionLength(pval) >= 19 ==> {
                                                      pval = interpNormalizeDatetime(pval)
                                                }
                                                _ ==> {}
                                          }
                                          print(pval)
                                          stdout_acc = stdout_acc + pval + "\n"
                                    }
                                    opcode == "EMIT" ==> {
                                          mut as data: eval = 0
                                          route {
                                                stdMapContainsKey(regs, a1) ==> { eval = regs[a1] }
                                                _ ==> {}
                                          }
                                          mut as map: res_emit = map{}
                                          res_emit["target"] = "in"
                                          res_emit["success"] = true
                                          res_emit["output"] = stdout_acc
                                          res_emit["value"] = eval
                                          emit(nice, res_emit, "ok")
                                    }
                                    _ ==> {}
                              }
                              route {
                                    jumped ==> {}
                                    _ ==> { pc = pc + 1 }
                              }
                        }
                  }
            }

            mut as map: result = map{}
            result["target"] = "in"
            result["success"] = true
            result["output"] = stdout_acc
            emit(nice, result, "ok")
      }
}
