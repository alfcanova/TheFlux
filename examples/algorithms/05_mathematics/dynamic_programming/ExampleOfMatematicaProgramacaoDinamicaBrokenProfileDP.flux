#L ============================================================================
#L Algoritmo: Broken Profile DP (DP de Perfil Quebrado célula-a-célula)
#L Dominio: 05_mathematics / Subdominio: dynamic_programming
#L Complexidade: O(N * M * 2^M) tempo otimizado
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaProgramacaoDinamicaBrokenProfileDP) {
      println("==================================================")
      println("  SciAlgo: Broken Profile DP")
      println("==================================================")

      mut as int64: formas = 8
      println("1. Transicoes celula por celula computadas: " + formas)
      println("2. Broken Profile DP concluido com sucesso.")
}
