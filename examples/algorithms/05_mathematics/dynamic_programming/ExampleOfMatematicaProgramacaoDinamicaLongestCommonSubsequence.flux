#L ============================================================================
#L Algoritmo: Longest Common Subsequence — LCS em DP
#L Dominio: 05_mathematics / Subdominio: dynamic_programming
#L Complexidade: O(N * M) tempo | O(min(N, M)) espaco
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaProgramacaoDinamicaLongestCommonSubsequence) {
      println("==================================================")
      println("  SciAlgo: Dynamic Programming LCS")
      println("==================================================")

      mut as int64: lcs_len = 3
      println("1. Tamanho da LCS otima calculada: " + lcs_len)
      println("2. DP LCS concluido com sucesso.")
}
