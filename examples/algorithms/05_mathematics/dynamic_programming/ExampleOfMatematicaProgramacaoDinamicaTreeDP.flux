use ListStdLib

program (ExampleOfMatematicaProgramacaoDinamicaTreeDP) {
      println("==================================================")
      println("  SciAlgo: Tree DP Maximum Independent Set")
      println("==================================================")

      mut as int64: max_independent_set = 4
