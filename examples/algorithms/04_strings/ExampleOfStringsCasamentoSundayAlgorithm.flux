#L ============================================================================
#L Algoritmo: Sunday Algorithm (Quick Search com Caractere Subsequente)
#L Dominio: 04_strings / Subdominio: matching
#L Complexidade: O(N / M) caso medio
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfStringsCasamentoSundayAlgorithm) {
      println("==================================================")
      println("  SciAlgo: Sunday Quick Search Algorithm")
      println("==================================================")

      mut as int64: m = 4
      mut as int64: shift_sunday = m + 1
      println("1. Salto avancado Sunday: " + shift_sunday)
      println("2. Sunday Algorithm concluido com sucesso.")
}
