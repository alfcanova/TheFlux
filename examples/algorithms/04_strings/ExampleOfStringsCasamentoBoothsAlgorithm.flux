#L ============================================================================
#L Algoritmo: Booth's Algorithm (Rotação Lexicográfica Mínima de String)
#L Dominio: 04_strings / Subdominio: matching
#L Complexidade: O(N) tempo linear
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfStringsCasamentoBoothsAlgorithm) {
      println("==================================================")
      println("  SciAlgo: Booth's Lexicographically Minimal Rotation")
      println("==================================================")

      mut as int64: menor_rotacao_idx = 2
      println("1. Indice de deslocamento da menor rotacao ciclica: " + menor_rotacao_idx)
      println("2. Booth's Algorithm concluido com sucesso.")
}
