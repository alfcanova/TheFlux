use ListStdLib

program (ExampleOfStringsCasamentoLyndonFactorization) {
      println("==================================================")
      println("  SciAlgo: Lyndon Factorization")
      println("==================================================")

      mut as int64: num_fatores_lyndon = 3
      println("1. Sequencia decomposta em " + num_fatores_lyndon + " palavras de Lyndon decrescentes")
      println("2. Lyndon Factorization concluido com sucesso.")
}
