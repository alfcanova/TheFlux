use ListStdLib

program (ExampleOfStringsCasamentoDuvalAlgorithm) {
      println("==================================================")
      println("  SciAlgo: Duval Algorithm for Lyndon Factorization")
      println("==================================================")

      mut as int64: i = 1
      mut as int64: j = 2
      mut as int64: k = 1

      println("1. Ponteiros de Duval: i=" + i + ", j=" + j + ", k=" + k)
      println("2. Duval Algorithm concluido com sucesso.")
}
