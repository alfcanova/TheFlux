#L ============================================================================
#L Algoritmo: Minimal Rotation (Menor Rotação Lexicográfica de Cadeias)
#L Dominio: 04_strings / Subdominio: matching
#L Complexidade: O(N) tempo
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfStringsCasamentoMinimalRotation) {
      println("==================================================")
      println("  SciAlgo: Minimal String Rotation")
      println("==================================================")

      mut as int64: n = 6
      mut as int64: ponto_de_corte = 1

      println("1. Cadeia circular avaliada (tam=" + n + ")")
      println("2. Ponto de corte canônico: " + ponto_de_corte)
      println("3. Minimal Rotation concluido com sucesso.")
}
