use ListStdLib

program (ExampleOfStringsCasamentoWildcardMatching) {
      println("==================================================")
      println("  SciAlgo: Wildcard Pattern Matching ('?' e '*')")
      println("==================================================")

      mut as int64: match_coringa = 1
      println("1. Casamento com wildcard bem-sucedido: " + match_coringa)
      println("2. Wildcard Matching concluido com sucesso.")
}
