use ListStdLib

program (ExampleOfNumericoGeometriaShamosHoey) {
      println("==================================================")
      println("  SciAlgo: Shamos-Hoey Algorithm")
      println("==================================================")

      mut as int64: any_intersection = 1

      println("1. Teste rapido O(N log N) de existencia de intersecao: " + any_intersection)
      println("2. Shamos-Hoey Algorithm concluido com sucesso.")
}
