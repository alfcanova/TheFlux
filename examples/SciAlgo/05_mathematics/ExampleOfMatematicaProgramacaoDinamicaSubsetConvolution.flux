use ListStdLib

program (ExampleOfMatematicaProgramacaoDinamicaSubsetConvolution) {
      println("==================================================")
      println("  SciAlgo: Ranked Subset Convolution")
      println("==================================================")

      mut as int64: convolucao_result = 88
      println("1. Convolucao sob disjuncao de bits: " + convolucao_result)
      println("2. Subset Convolution concluido com sucesso.")
}
