#L ============================================================================
#L Algoritmo: Edit Distance (Distância de Edição de Wagner-Fischer)
#L Dominio: 05_mathematics / Subdominio: dynamic_programming
#L Complexidade: O(M * N) tempo e espaco
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaProgramacaoDinamicaEditDistance) {
      println("==================================================")
      println("  SciAlgo: Wagner-Fischer Edit Distance")
      println("==================================================")

      mut as int64: edit_dist = 3
      println("1. Custo minimo de operacoes de insercao/remocao/substituicao: " + edit_dist)
      println("2. Edit Distance concluido com sucesso.")
}
