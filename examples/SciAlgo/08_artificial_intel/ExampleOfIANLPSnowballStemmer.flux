use ListStdLib

program (ExampleOfIANLPSnowballStemmer) {
      println("=== Algoritmo: Snowball Stemmer R1/R2 ===")
      mut as int64: r1Start = 3
      mut as int64: r2Start = 5
      println("1. Inicio da regiao R1: indice " + r1Start)
      println("2. Inicio da regiao R2: indice " + r2Start)
      println("Teste concluido com sucesso.")
}
