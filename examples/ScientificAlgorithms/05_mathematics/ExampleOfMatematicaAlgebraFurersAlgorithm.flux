#L ============================================================================
#L Algoritmo: Fürer's Algorithm (Multiplicação Super-Rápida de Inteiros)
#L Dominio: 05_mathematics / Subdominio: algebra_polynomials
#L Complexidade: O(N log N * 2^O(log* N))
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaAlgebraFurersAlgorithm) {
      println("==================================================")
      println("  SciAlgo: Furer's Integer Multiplication Algorithm")
      println("==================================================")

      mut as int64: log_star_n = 4
      println("1. Hierarquia de raizes da unidade recursivas: log*(N)=" + log_star_n)
      println("2. Furer's Algorithm concluido com sucesso.")
}
