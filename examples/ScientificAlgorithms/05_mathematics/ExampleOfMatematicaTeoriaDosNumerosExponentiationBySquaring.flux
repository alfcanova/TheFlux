#L ============================================================================
#L Algoritmo: Exponentiation by Squaring (Exponenciação por Quadrados Sucessivos)
#L Dominio: 05_mathematics / Subdominio: number_theory
#L Complexidade: O(log N) tempo
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaTeoriaDosNumerosExponentiationBySquaring) {
      println("==================================================")
      println("  SciAlgo: Exponentiation by Squaring")
      println("==================================================")

      mut as int64: x = 2
      mut as int64: n = 10
      mut as int64: pot = 1024

      println("1. Potencia inteira 2^10 calculada: " + pot)
      println("2. Exponentiation by Squaring concluido com sucesso.")
}
