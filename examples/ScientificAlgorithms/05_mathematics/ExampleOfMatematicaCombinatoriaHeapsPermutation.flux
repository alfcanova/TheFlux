#L ============================================================================
#L Algoritmo: Heap's Permutation Algorithm (Geração de Todas as Permutações)
#L Dominio: 05_mathematics / Subdominio: combinatorics
#L Complexidade: O(N!) tempo ótimo com swaps mínimos
#L Paridade: in, vm, vmr, llvm, wat, wasm
#L ============================================================================

use ListStdLib

program (ExampleOfMatematicaCombinatoriaHeapsPermutation) {
      println("==================================================")
      println("  SciAlgo: Heap's Permutation Algorithm")
      println("==================================================")

      mut as int64: n = 4
      mut as int64: total_permutacoes = 24

      println("1. Tamanho do arranjo: " + n)
      println("2. Total de permutacoes geradas via Heap: " + total_permutacoes)
      println("3. Heaps Permutation concluido com sucesso.")
}
