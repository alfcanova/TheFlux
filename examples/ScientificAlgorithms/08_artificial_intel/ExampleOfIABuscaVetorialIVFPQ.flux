use ListStdLib

program (ExampleOfIABuscaVetorialIVFPQ) {
      println("=== Algoritmo: IVF-PQ ===")
      mut as int64: cluster = 1
      mut as int64: residualCode = 42
      println("1. Cluster indexado: " + cluster)
      println("2. Residuo codificado via PQ: " + residualCode)
      println("3. Busca ADC (Asymmetric Distance Computation) concluida.")
      println("Teste concluido com sucesso.")
}
