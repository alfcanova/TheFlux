#L Exemplo de Uso: TrigonometryContract (Trigonometria Completa)
use MathStdLib as M

program (ExampleOfUseMathStdLib_TrigonometryContract) {
      print("==================================================")
      print("  Exemplo: TrigonometryContract (64, 32, 16)      ")
      print("==================================================")
      print("--- Seno, Cosseno & Tangente ---")
      print("sin64(PI / 6): " + ((sin64(PI64 /f 6.0)).val as string))
      print("sin32(PI / 6): " + ((sin32(PI32 /f (6.0 as float32))).val as string))
      print("sin16(PI / 6): " + ((sin16(PI16 /f (6.0 as float16))).val as string))
      print("cos64(PI / 3): " + ((cos64(PI64 /f 3.0)).val as string))
      print("cos32(PI / 3): " + ((cos32(PI32 /f (3.0 as float32))).val as string))
      print("cos16(PI / 3): " + ((cos16(PI16 /f (3.0 as float16))).val as string))
      print("tan64(PI / 4): " + ((tan64(PI64 /f 4.0)).val as string))
      print("tan32(PI / 4): " + ((tan32(PI32 /f (4.0 as float32))).val as string))
      print("tan16(PI / 4): " + ((tan16(PI16 /f (4.0 as float16))).val as string))

      print("--- Hipotenusa ---")
      print("hypotenuse64(3.0, 4.0): " + ((hypotenuse64(3.0, 4.0)).val as string))
      print("hypotenuse32(3.0, 4.0): " + ((hypotenuse32(3.0 as float32, 4.0 as float32)).val as string))
      print("hypotenuse16(3.0, 4.0): " + ((hypotenuse16(3.0 as float16, 4.0 as float16)).val as string))

      print("--- Trigonometricas Inversas (Arco) ---")
      print("arcTan64(1.0): " + ((arcTan64(1.0)).val as string))
      print("arcTan32(1.0): " + ((arcTan32(1.0 as float32)).val as string))
      print("arcTan16(1.0): " + ((arcTan16(1.0 as float16)).val as string))
      print("arcTan2_64(1.0, 1.0): " + ((arcTan2_64(1.0, 1.0)).val as string))
      print("arcTan2_32(1.0, 1.0): " + ((arcTan2_32(1.0 as float32, 1.0 as float32)).val as string))
      print("arcTan2_16(1.0, 1.0): " + ((arcTan2_16(1.0 as float16, 1.0 as float16)).val as string))
      print("arcSin64(0.5): " + ((arcSin64(0.5)).val as string))
      print("arcSin32(0.5): " + ((arcSin32(0.5 as float32)).val as string))
      print("arcSin16(0.5): " + ((arcSin16(0.5 as float16)).val as string))
      print("arcCos64(0.5): " + ((arcCos64(0.5)).val as string))
      print("arcCos32(0.5): " + ((arcCos32(0.5 as float32)).val as string))
      print("arcCos16(0.5): " + ((arcCos16(0.5 as float16)).val as string))

      print("--- Reciprocas (Sec, Csc, Cot) ---")
      print("sec64(0.0): " + ((sec64(0.0)).val as string))
      print("sec32(0.0): " + ((sec32(0.0 as float32)).val as string))
      print("sec16(0.0): " + ((sec16(0.0 as float16)).val as string))
      print("csc64(PI / 2): " + ((csc64(PI_2_64)).val as string))
      print("csc32(PI / 2): " + ((csc32(PI_2_32)).val as string))
      print("csc16(PI / 2): " + ((csc16(PI_2_16)).val as string))
      print("cot64(PI / 4): " + ((cot64(PI_4_64)).val as string))
      print("cot32(PI / 4): " + ((cot32(PI_4_32)).val as string))
      print("cot16(PI / 4): " + ((cot16(PI_4_16)).val as string))

      print("--- Reciprocas Inversas ---")
      print("arcSec64(2.0): " + ((arcSec64(2.0)).val as string))
      print("arcSec32(2.0): " + ((arcSec32(2.0 as float32)).val as string))
      print("arcSec16(2.0): " + ((arcSec16(2.0 as float16)).val as string))
      print("arcCsc64(2.0): " + ((arcCsc64(2.0)).val as string))
      print("arcCsc32(2.0): " + ((arcCsc32(2.0 as float32)).val as string))
      print("arcCsc16(2.0): " + ((arcCsc16(2.0 as float16)).val as string))
      print("arcCot64(1.0): " + ((arcCot64(1.0)).val as string))
      print("arcCot32(1.0): " + ((arcCot32(1.0 as float32)).val as string))
      print("arcCot16(1.0): " + ((arcCot16(1.0 as float16)).val as string))

      print("--- Sinc & Multiplos de Pi ---")
      print("sinc64(0.5): " + ((sinc64(0.5)).val as string))
      print("sinc32(0.5): " + ((sinc32(0.5 as float32)).val as string))
      print("sinc16(0.5): " + ((sinc16(0.5 as float16)).val as string))
      print("sinpi64(0.5): " + ((sinpi64(0.5)).val as string))
      print("sinpi32(0.5): " + ((sinpi32(0.5 as float32)).val as string))
      print("sinpi16(0.5): " + ((sinpi16(0.5 as float16)).val as string))
      print("cospi64(1.0): " + ((cospi64(1.0)).val as string))
      print("cospi32(1.0): " + ((cospi32(1.0 as float32)).val as string))
      print("cospi16(1.0): " + ((cospi16(1.0 as float16)).val as string))
      print("tanpi64(0.25): " + ((tanpi64(0.25)).val as string))
      print("tanpi32(0.25): " + ((tanpi32(0.25 as float32)).val as string))
      print("tanpi16(0.25): " + ((tanpi16(0.25 as float16)).val as string))
      print("==================================================")
}
