# ==============================================================================
# TheFlux - Regras de Exclusão do Git (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python (Bytecode, Caches, Ambientes Virtuais)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.pytest_cache/
.venv/
venv/
ENV/
env/

# ------------------------------------------------------------------------------
# 2. Arquivos Temporários, Backups e Logs de Editores
# ------------------------------------------------------------------------------
*.bak
*.swp
*.swo
*~
*.tmp
*.log
*.pdf
.~lock.*#
.~lock.*
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# 3. Node / NPM / Dependências de Ferramentas
# ------------------------------------------------------------------------------
node_modules/
**/.opencode/node_modules/
package-lock.json
bun.lock

# ------------------------------------------------------------------------------
# 4. Caches de Ferramentas e MCPs Locais
# ------------------------------------------------------------------------------
.code-review-graph/
.cache/
graft/.cache/
artifacts/

# ------------------------------------------------------------------------------
# 5. Saídas de Compilação, Binários e Intermediários do Compilador
# ------------------------------------------------------------------------------
temp/

# Bancos de dados em dbs/ (preservando .gitkeep)
dbs/*
!dbs/.gitkeep
build/*.db*
build/*.kv
build/*.unqlite
build/*.duckdb
build/*.kuzu*
build/*.obx*
build/intermediates/*
!build/intermediates/.gitkeep
build/intermediates/tmp/*
!build/intermediates/tmp/.gitkeep

# Pastas de testes t_* preservadas via .gitkeep
t_fvmbc/*
!t_fvmbc/.gitkeep
t_llvm/*
!t_llvm/.gitkeep
t_wasm-*/*
!t_wasm-*/.gitkeep
t_wat-*/*
!t_wat-*/.gitkeep

t_wasm/*

!t_wasm/.gitkeep

t_wat/*

!t_wat/.gitkeep


*.exe
*.wasm
*.wat
*.fvmbc
*.ll
*.o
*.obj
*.dll
*.so
*.dylib
*.pdb

# Bibliotecas gerenciadas em lib/
!lib/*.lib
!lib/*.a
!lib/*.dll
!lib/*.so
!lib/*.dylib

# ------------------------------------------------------------------------------
# Legado 0.9.9
# ------------------------------------------------------------------------------
legacy-0.9.9/scratch/*
!legacy-0.9.9/scratch/.gitkeep
legacy-0.9.9/t_fvmbc/*
!legacy-0.9.9/t_fvmbc/.gitkeep
legacy-0.9.9/t_llvm/*
!legacy-0.9.9/t_llvm/.gitkeep
legacy-0.9.9/t_wasm/*
!legacy-0.9.9/t_wasm/.gitkeep
legacy-0.9.9/t_wat/*
!legacy-0.9.9/t_wat/.gitkeep

# ------------------------------------------------------------------------------
# 6. Saídas Geradas por Testes e Execuções
# ------------------------------------------------------------------------------
io_stdlib_output.txt
io_stdlib_lines.txt
io_stdlib_copy.txt
io_stdlib_moved.txt
io_stdlib_test_dir/
# Preservar fixture estática indispensável para a suite de testes:
!io_stdlib_fixture.txt

# ------------------------------------------------------------------------------
# 7. Agentes de IA, Ferramentas e Configurações Locais
# ------------------------------------------------------------------------------
.agent/
.gemini/
.github/
.mcp/
.mcp
.mcp.json
.opencode/
.specify/
graft/
openspec/
opencode.jsonc
specs/



scratch/
iniciar.bat
