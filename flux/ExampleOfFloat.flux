program (ExampleOfFloat) {
      print("=== Float: literais tradicionais ===")
      mut as float16: meia = -1.5
      mut as float32: simples = 32.25
      mut as float64: dupla = -64.125
      print(meia)
      print(simples)
      print(dupla)

      print("=== Float: notacao cientifica ===")
      mut as float64: grande = 2.5e3
      mut as float64: pequeno = 1.5e-4
      print(grande)
      print(pequeno)

      print("=== Float: formas alternativas ===")
      mut as float64: metade = .5
      print(metade)
}