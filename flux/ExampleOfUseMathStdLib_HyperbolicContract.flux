#L Exemplo de Uso: HyperbolicContract (Hiperbolicas Completas)
use MathStdLib as M

program (ExampleOfUseMathStdLib_HyperbolicContract) {
      print("==================================================")
      print("  Exemplo: HyperbolicContract (64, 32, 16)        ")
      print("==================================================")
      print("--- Hiperbolicas Diretas ---")
      print("sinh64(1.0): " + ((sinh64(1.0)).val as string))
      print("sinh32(1.0): " + ((sinh32(1.0 as float32)).val as string))
      print("sinh16(1.0): " + ((sinh16(1.0 as float16)).val as string))
      print("cosh64(1.0): " + ((cosh64(1.0)).val as string))
      print("cosh32(1.0): " + ((cosh32(1.0 as float32)).val as string))
      print("cosh16(1.0): " + ((cosh16(1.0 as float16)).val as string))
      print("tanh64(1.0): " + ((tanh64(1.0)).val as string))
      print("tanh32(1.0): " + ((tanh32(1.0 as float32)).val as string))
      print("tanh16(1.0): " + ((tanh16(1.0 as float16)).val as string))

      print("--- Hiperbolicas Inversas (Area) ---")
      print("arcSinh64(1.0): " + ((arcSinh64(1.0)).val as string))
      print("arcSinh32(1.0): " + ((arcSinh32(1.0 as float32)).val as string))
      print("arcSinh16(1.0): " + ((arcSinh16(1.0 as float16)).val as string))
      print("arcCosh64(2.0): " + ((arcCosh64(2.0)).val as string))
      print("arcCosh32(2.0): " + ((arcCosh32(2.0 as float32)).val as string))
      print("arcCosh16(2.0): " + ((arcCosh16(2.0 as float16)).val as string))
      print("arcTanh64(0.5): " + ((arcTanh64(0.5)).val as string))
      print("arcTanh32(0.5): " + ((arcTanh32(0.5 as float32)).val as string))
      print("arcTanh16(0.5): " + ((arcTanh16(0.5 as float16)).val as string))
      print("arcTanh2_64(1.0, 2.0): " + ((arcTanh2_64(1.0, 2.0)).val as string))
      print("arcTanh2_32(1.0, 2.0): " + ((arcTanh2_32(1.0 as float32, 2.0 as float32)).val as string))
      print("arcTanh2_16(1.0, 2.0): " + ((arcTanh2_16(1.0 as float16, 2.0 as float16)).val as string))

      print("--- Hiperbolicas Reciprocas ---")
      print("sech64(0.0): " + ((sech64(0.0)).val as string))
      print("sech32(0.0): " + ((sech32(0.0 as float32)).val as string))
      print("sech16(0.0): " + ((sech16(0.0 as float16)).val as string))
      print("csch64(1.0): " + ((csch64(1.0)).val as string))
      print("csch32(1.0): " + ((csch32(1.0 as float32)).val as string))
      print("csch16(1.0): " + ((csch16(1.0 as float16)).val as string))
      print("coth64(1.0): " + ((coth64(1.0)).val as string))
      print("coth32(1.0): " + ((coth32(1.0 as float32)).val as string))
      print("coth16(1.0): " + ((coth16(1.0 as float16)).val as string))

      print("--- Hiperbolicas Reciprocas Inversas ---")
      print("arcSech64(0.5): " + ((arcSech64(0.5)).val as string))
      print("arcSech32(0.5): " + ((arcSech32(0.5 as float32)).val as string))
      print("arcSech16(0.5): " + ((arcSech16(0.5 as float16)).val as string))
      print("arcCsch64(1.0): " + ((arcCsch64(1.0)).val as string))
      print("arcCsch32(1.0): " + ((arcCsch32(1.0 as float32)).val as string))
      print("arcCsch16(1.0): " + ((arcCsch16(1.0 as float16)).val as string))
      print("arcCoth64(2.0): " + ((arcCoth64(2.0)).val as string))
      print("arcCoth32(2.0): " + ((arcCoth32(2.0 as float32)).val as string))
      print("arcCoth16(2.0): " + ((arcCoth16(2.0 as float16)).val as string))
      print("==================================================")
}
