use ConvertStdLib

program (ExampleOfUseConvertStdLib_ConvertNumericContract) {
      println("==================================================")
      println("  Exemplo: ConvertNumericContract (Conversoes Escalares e ML)")
      println("==================================================")

      #L 1. Int <-> Float (Precisao 64, 32 e 16 bits)
      mut as float64: f64 = convertIntToFloat(42)
      mut as int64: i64 = convertFloatToInt(42.89)
      mut as float64: f64_from_f = convertFloatToFloat64(3.14)
      mut as float32: f32 = convertFloatToFloat32(3.14159265)
      mut as float16: f16 = convertFloatToFloat16(3.14159265)
      println("1. convertIntToFloat(42): " + f64)
      println("   convertFloatToInt(42.89): " + i64)
      println("   convertFloatToFloat64(3.14): " + f64_from_f)
      println("   convertFloatToFloat32: " + f32)
      println("   convertFloatToFloat16: " + f16)

      #L 2. Bool <-> Int
      mut as int64: b_as_i = convertBoolToInt(true)
      mut as bool: i_as_b1 = convertIntToBool(42)
      mut as bool: i_as_b2 = convertIntToBool(0)
      println("2. convertBoolToInt(true): " + b_as_i)
      println("   convertIntToBool(42): " + i_as_b1)
      println("   convertIntToBool(0): " + i_as_b2)

      #L 3. Inteiros com e sem sinal com checagem de overflow (int8, uint8, int16, uint16)
      mut as int8: i8_ok = convertIntToInt8(120)
      mut as int8: i8_ov = convertIntToInt8OrDefault(200, -1)
      mut as uint8: u8_ok = convertIntToUint8(250)
      mut as uint8: u8_ov = convertIntToUint8OrDefault(300, 7)
      mut as int16: i16_ok = convertIntToInt16(32000)
      mut as int16: i16_ov = convertIntToInt16OrDefault(40000, -99)
      mut as uint16: u16_ok = convertIntToUint16(65000)
      mut as uint16: u16_ov = convertIntToUint16OrDefault(70000, 0)
      println("3. convertIntToInt8(120): " + i8_ok)
      println("   convertIntToInt8OrDefault(200, -1) [overflow]: " + i8_ov)
      println("   convertIntToUint8(250): " + u8_ok)
      println("   convertIntToUint8OrDefault(300, 7) [overflow]: " + u8_ov)
      println("   convertIntToInt16(32000): " + i16_ok)
      println("   convertIntToInt16OrDefault(40000, -99) [overflow]: " + i16_ov)
      println("   convertIntToUint16(65000): " + u16_ok)
      println("   convertIntToUint16OrDefault(70000, 0) [overflow]: " + u16_ov)

      #L 4. Int32, Uint32, Int64, Uint64
      mut as int32: i32_ok = convertIntToInt32(2000000000)
      mut as int32: i32_ov = convertIntToInt32OrDefault(3000000000, -1)
      mut as uint32: u32_ok = convertIntToUint32(4000000000)
      mut as uint32: u32_ov = convertIntToUint32OrDefault(5000000000, 0)
      mut as int64: i64_conv = convertIntToInt64(123456789)
      mut as uint64: u64_conv = convertIntToUint64(987654321)
      println("4. convertIntToInt32(2000000000): " + i32_ok)
      println("   convertIntToInt32OrDefault(3000000000, -1) [overflow]: " + i32_ov)
      println("   convertIntToUint32(4000000000): " + u32_ok)
      println("   convertIntToUint32OrDefault(5000000000, 0) [overflow]: " + u32_ov)
      println("   convertIntToInt64(123456789): " + i64_conv)
      println("   convertIntToUint64(987654321): " + u64_conv)

      #L 5. Operacoes de Cast Explicito (Inteiros e Flutuantes)
      println("5. Casts escalares:")
      println("   convertCastToInt8(127): " + convertCastToInt8(127))
      println("   convertCastToUint8(255): " + convertCastToUint8(255))
      println("   convertCastToInt16(32767): " + convertCastToInt16(32767))
      println("   convertCastToUint16(65535): " + convertCastToUint16(65535))
      println("   convertCastToInt32(100000): " + convertCastToInt32(100000))
      println("   convertCastToUint32(200000): " + convertCastToUint32(200000))
      println("   convertCastToInt64(1000000): " + convertCastToInt64(1000000))
      println("   convertCastToUint64(2000000): " + convertCastToUint64(2000000))
      println("   convertCastToFloat16(1.5): " + convertCastToFloat16(1.5))
      println("   convertCastToFloat32(2.5): " + convertCastToFloat32(2.5))
      println("   convertCastToFloat64(3.5): " + convertCastToFloat64(3.5))

      #L 6. Formatos reduzidos para Machine Learning e IA
      println("6. Formatos ML / IA:")
      println("   convertCastToBf16E8M7(0.98): " + convertCastToBf16E8M7(0.98))
      println("   convertCastToTf32E8M10(0.98): " + convertCastToTf32E8M10(0.98))
      println("   convertCastToFp8E4M3(0.98): " + convertCastToFp8E4M3(0.98))
      println("   convertCastToFp8E4M3OrDefault(500.0, 1.0) [overflow]: " + convertCastToFp8E4M3OrDefault(500.0, 1.0))
      println("   convertCastToFp8E5M2(0.98): " + convertCastToFp8E5M2(0.98))
}
