      op root64 (as float64: degree, as float64: radicand) as float64 ==> {
            mut as float64: zero_val = 0.0
            route {
                  degree == 0.0 ==> {
                        emit(fail, zero_val, "grau da raiz nao pode ser zero")
                  }
                  radicand < 0.0 ==> {
                        emit(fail, zero_val, "radicando negativo")
                  }
                  radicand == 0.0 ==> {
                        emit(nice, zero_val, "ok")
                  }
                  degree == 2.0 ==> {
                        mut as float64: x = radicand
                        mut as float64: y = (x + 1.0) /f 2.0
                        infinite {
                              mut as float64: diff = y - x /f y
                              route {
                                    diff < 0.0 ==> {
                                          diff = 0.0 - diff
                                    }
                              }
                              route {
                                    diff < 1.0e-15 ==> {
                                          break
                                    }
                              }
                              y = (y + x /f y) /f 2.0
                        }
                        emit(nice, y, "ok")
                  }
                  (degree != 2.0) and (radicand > 0.0) ==> {
                        mut as float64: res = radicand ^r degree
                        emit(nice, res, "ok")
                  }
            }
            emit(nice, zero_val, "ok")
