      imut as float32: SQRT3_32 = SQRT3_64 as float32
      imut as float16: SQRT3_16 = SQRT3_64 as float16
      imut as float64: INV_SQRT2_64 = 0.707106781186547572737310921369
      imut as float32: INV_SQRT2_32 = INV_SQRT2_64 as float32
      imut as float16: INV_SQRT2_16 = INV_SQRT2_64 as float16
      imut as float64: INV_SQRT3_64 = 0.577350269189625764509148780502
      imut as float32: INV_SQRT3_32 = INV_SQRT3_64 as float32
