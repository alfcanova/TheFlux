                  }
                  (k == 0) or (k == n) ==> {
                        emit(nice, one_val, "ok")
                  }
                  (k > 0) and (k < n) ==> {
                        mut as int64: k_eff = k
                        route {
                              k_eff > (n - k_eff) ==> {
                                    k_eff = n - k_eff
                              }
                        }
                        mut as int64: res = 1
                        mut as int64: i = 1
                        infinite {
                              route {
                                    i > k_eff ==> {
                                          break
                                    }
                              }
                              res = (res * (n - i + 1)) /i i
                              i = i + 1
                        }
                        emit(nice, res, "ok")
                  }
            }
            emit(nice, one_val, "ok")
      }

