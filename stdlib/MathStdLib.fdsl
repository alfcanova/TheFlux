      op greatestCommonDivisor64 (as int64: left, as int64: right) as int64 ==> {
            mut as int64: a = (absolute64(left)).val
            mut as int64: b = (absolute64(right)).val
            infinite {
                  route {
                        b == 0 ==> {
                              break
                        }
                  }
                  mut as int64: temp = b
                  b = a /r b
                  a = temp
            }
            emit(nice, a, "ok")
      }

      op greatestCommonDivisor32 (as int32: left, as int32: right) as int32 ==> {
            mut as int32: res = (greatestCommonDivisor64(left as int64, right as int64)).val as int32
            emit(nice, res, "ok")
