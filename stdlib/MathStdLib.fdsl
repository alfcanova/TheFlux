      }

      op errorFunction64 (as float64: value) as float64 ==> {
            mut as float64: x = value
            mut as float64: sign = 1.0
            route {
                  x < 0.0 ==> {
                        sign = -1.0
                        x = 0.0 - x
                  }
            }
            mut as float64: p = 0.3275911
            mut as float64: t = 1.0 /f (1.0 + p * x)
            mut as float64: a1 = 0.254829592
            mut as float64: a2 = -0.284496736
            mut as float64: a3 = 1.421413741
            mut as float64: a4 = -1.453152027
            mut as float64: a5 = 1.061405429
            mut as float64: poly = t * (a1 + t * (a2 + t * (a3 + t * (a4 + t * a5))))
            mut as float64: res = sign * (1.0 - poly * (exp64(0.0 - x * x)).val)
            emit(nice, res, "ok")
      }

      op errorFunction32 (as float32: value) as float32 ==> {
            mut as float32: res = (errorFunction64(value as float64)).val as float32
            emit(nice, res, "ok")
      }
      op errorFunction16 (as float16: value) as float16 ==> {
            mut as float16: res = (errorFunction64(value as float64)).val as float16
            emit(nice, res, "ok")
      }

      op gammaFunction64 (as float64: value) as float64 ==> {
            mut as float64: z = value
            route {
                  z < 0.5 ==> {
                        mut as float64: pi_val = 3.14159265358979323846264338327
                        mut as float64: sin_pi_z = (sin64(pi_val * z)).val
                        mut as float64: gamma_1_minus_z = (gammaFunction64(1.0 - z)).val
                        mut as float64: res = pi_val /f (sin_pi_z * gamma_1_minus_z)
                        emit(nice, res, "ok")
                  }
            }
            z = z - 1.0
            mut as float64: x = 0.99999999999980993 + (676.5203681218851 /f (z + 1.0)) - (1259.1392167224028 /f (z + 2.0)) + (771.32342877765313 /f (z + 3.0)) - (176.61502916214059 /f (z + 4.0)) + (12.507343278686905 /f (z + 5.0)) - (0.138571095836526 /f (z + 6.0)) + (9.9843695780195716e-6 /f (z + 7.0)) + (1.5056327351493116e-7 /f (z + 8.0))
            mut as float64: t = z + 7.5
            mut as float64: sqrt2pi = 2.5066282746310005
            mut as float64: res = sqrt2pi * (t ^e (z + 0.5)) * (exp64(0.0 - t)).val * x
            emit(nice, res, "ok")
      }

