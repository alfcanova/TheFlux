agent (MathStdLib) impl MathConstantsContract, BasicArithmeticContract, FloatElementaryContract, RootsAndRoundingContract, ExponentialLogContract, TrigonometryContract, HyperbolicContract, AngleConversionContract, CombinatoricsContract, SpecialFunctionsContract {
