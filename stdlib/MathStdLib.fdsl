      op arrangements64 (as int64: n, as int64: k) as int64 ==> {
            mut as int64: zero_val = 0
            mut as int64: one_val = 1
            route {
                  (n < 0) or (k < 0) or (k > n) ==> {
                        emit(fail, zero_val, "arranjo requer 0 <= k <= n")
                  }
                  k == 0 ==> {
                        emit(nice, one_val, "ok")
                  }
                  (k > 0) and (k <= n) ==> {
                        mut as int64: res = 1
                        mut as int64: i = n - k + 1
                        infinite {
                              route {
                                    i > n ==> {
                                          break
                                    }
                              }
                              res = res * i
                              i = i + 1
                        }
                        emit(nice, res, "ok")
