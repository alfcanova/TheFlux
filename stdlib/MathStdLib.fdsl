            emit(nice, res, "ok")
      }

      op smootherstep64 (as float64: edge0, as float64: edge1, as float64: x) as float64 ==> {
            mut as float64: zero_val = 0.0
            route {
                  edge0 == edge1 ==> {
                        emit(fail, zero_val, "smootherstep requer edge0 != edge1")
                  }
                  edge0 != edge1 ==> {
                        mut as float64: t = (constrain64((x - edge0) /f (edge1 - edge0), 0.0, 1.0)).val
                        mut as float64: res = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
                        emit(nice, res, "ok")
                  }
            }
            emit(nice, zero_val, "ok")
      }

      op smootherstep32 (as float32: edge0, as float32: edge1, as float32: x) as float32 ==> {
            mut as float32: res = (smootherstep64(edge0 as float64, edge1 as float64, x as float64)).val as float32
            emit(nice, res, "ok")
      }
      op smootherstep16 (as float16: edge0, as float16: edge1, as float16: x) as float16 ==> {
            mut as float16: res = (smootherstep64(edge0 as float64, edge1 as float64, x as float64)).val as float16
            emit(nice, res, "ok")
      }

      op inverseLinearInterpolation64 (as float64: a, as float64: b, as float64: val) as float64 ==> {
            mut as float64: zero_val = 0.0
            route {
                  a == b ==> {
                        emit(fail, zero_val, "interpolacao linear inversa requer a != b")
                  }
                  a != b ==> {
                        mut as float64: res = (val - a) /f (b - a)
                        emit(nice, res, "ok")
                  }
            }
            emit(nice, zero_val, "ok")
      }

      op inverseLinearInterpolation32 (as float32: a, as float32: b, as float32: val) as float32 ==> {
            mut as float32: res = (inverseLinearInterpolation64(a as float64, b as float64, val as float64)).val as float32
            emit(nice, res, "ok")
      }
      op inverseLinearInterpolation16 (as float16: a, as float16: b, as float16: val) as float16 ==> {
            mut as float16: res = (inverseLinearInterpolation64(a as float64, b as float64, val as float64)).val as float16
            emit(nice, res, "ok")
      }

      op mapRange64 (as float64: val, as float64: in_min, as float64: in_max, as float64: out_min, as float64: out_max) as float64 ==> {
            mut as float64: zero_val = 0.0
            route {
                  in_min == in_max ==> {
                        emit(fail, zero_val, "mapRange requer in_min != in_max")
                  }
                  in_min != in_max ==> {
                        mut as float64: norm = (val - in_min) /f (in_max - in_min)
                        mut as float64: res = out_min + norm * (out_max - out_min)
                        emit(nice, res, "ok")
                  }
            }
            emit(nice, zero_val, "ok")
      }

      op mapRange32 (as float32: val, as float32: in_min, as float32: in_max, as float32: out_min, as float32: out_max) as float32 ==> {
            mut as float32: res = (mapRange64(val as float64, in_min as float64, in_max as float64, out_min as float64, out_max as float64)).val as float32
            emit(nice, res, "ok")
      }
      op mapRange16 (as float16: val, as float16: in_min, as float16: in_max, as float16: out_min, as float16: out_max) as float16 ==> {
            mut as float16: res = (mapRange64(val as float64, in_min as float64, in_max as float64, out_min as float64, out_max as float64)).val as float16
            emit(nice, res, "ok")
      }
}
