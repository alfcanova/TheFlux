#L ==============================================================================
#L TheFlux Standard Library: GraphPlotStdLib
#L Motor Grafico Cientifico, Matematico, Estatistico, Curvilineo e de Engenharia
#L Suporte a 20+ Sistemas de Coordenadas, Cameras 3D e as 7 Grandes Familias
#L Implementacao 100% nativa em TheFlux (sem dependencias externas)
#L Regra: 1-index para humanos e 0-index para maquinas
#L ==============================================================================

use MathStdLib
use StatStdLib
use LinAlgStdLib
use GfxStdLib
use NativeGfxStdLib

contract (PlotContextContract) {
      op plotCreate (as int64: width, as int64: height, as string: title) as map
      op plotClose (as map: ctx) as map
      op plotSetViewport (as map: ctx, as int64: x, as int64: y, as int64: w, as int64: h) as map
      op plotSetMargins (as map: ctx, as int64: top, as int64: right, as int64: bottom, as int64: left) as map
      op plotSetCoordSystem (as map: ctx, as int64: coord_sys) as map
      op plotSetCamera (as map: ctx, as int64: cam_type, as float64: fov) as map
      op plotSetScaleType (as map: ctx, as int64: scale_type) as map
      op plotSetColorMap (as map: ctx, as int64: cmap) as map
      op plotShowAxes (as map: ctx, as bool: show) as map
      op plotShowGrid (as map: ctx, as bool: show) as map
      op plotShowLegend (as map: ctx, as bool: show) as map
      op plotBindWindow (as map: ctx, as int64: win_id) as map
      op plotGetWindow (as map: ctx) as int64
}

contract (PlotTransformContract) {
      op plotTransformToCartesian (as int64: coord_sys, as float64: u, as float64: v, as float64: w) as list of float64
      op plotTransformFromCartesian (as int64: coord_sys, as float64: x, as float64: y, as float64: z) as list of float64
      op plotProjectToScreen (as map: ctx, as float64: x, as float64: y, as float64: z) as list of int64
}

contract (PlotDistributionContract) {
      op plotHistogram (as map: ctx, as list of float64: data_vals, as int64: n_bins) as map
      op plotKde (as map: ctx, as list of float64: data_vals, as float64: bandwidth) as map
      op plotBoxplot (as map: ctx, as list of float64: data_vals, as float64: center_x, as float64: width) as map
      op plotViolin (as map: ctx, as list of float64: data_vals, as float64: center_x, as float64: width) as map
      op plotStrip (as map: ctx, as list of float64: data_vals, as float64: center_x) as map
      op plotOgive (as map: ctx, as list of float64: data_vals) as map
      op plotQqPlot (as map: ctx, as list of float64: data_vals) as map
}

contract (PlotRelationContract) {
      op plotScatter (as map: ctx, as list of float64: xs, as list of float64: ys, as list of int64: color) as map
      op plotLine (as map: ctx, as list of float64: xs, as list of float64: ys, as list of int64: color) as map
      op plotBubble (as map: ctx, as list of float64: xs, as list of float64: ys, as list of float64: sizes, as list of int64: color) as map
      op plotParallelCoords (as map: ctx, as list of data: dimensions, as list of data: records) as map
      op plotCorrelationMatrix (as map: ctx, as list of data: matrix_rows, as list of string: labels) as map
      op plotHexbin (as map: ctx, as list of float64: xs, as list of float64: ys, as int64: grid_size) as map
}

contract (PlotSurfaceFieldContract) {
      op plotSurface3D (as map: ctx, as list of data: grid_x, as list of data: grid_y, as list of data: grid_z) as map
      op plotMesh3D (as map: ctx, as list of data: grid_x, as list of data: grid_y, as list of data: grid_z) as map
      op plotContour (as map: ctx, as list of data: grid_z, as int64: n_levels) as map
      op plotQuiver2D (as map: ctx, as list of float64: xs, as list of float64: ys, as list of float64: us, as list of float64: vs) as map
      op plotStreamlines (as map: ctx, as list of data: grid_u, as list of data: grid_v) as map
      op plotScatter3D (as map: ctx, as list of float64: xs, as list of float64: ys, as list of float64: zs) as map
      op plotTrajectory3D (as map: ctx, as list of float64: xs, as list of float64: ys, as list of float64: zs) as map
}

contract (PlotCompositionContract) {
      op plotPie (as map: ctx, as list of float64: values, as list of string: labels) as map
      op plotDonut (as map: ctx, as list of float64: values, as list of string: labels, as float64: hole_ratio) as map
      op plotGauge (as map: ctx, as float64: value, as float64: min_val, as float64: max_val, as string: label) as map
      op plotTernary (as map: ctx, as list of float64: as_comp, as list of float64: bs_comp, as list of float64: cs_comp) as map
      op plotStackedBar (as map: ctx, as list of data: series_matrix, as list of string: group_labels) as map
      op plotStackedArea (as map: ctx, as list of float64: xs, as list of data: series_matrix) as map
      op plotTreemap (as map: ctx, as list of float64: values, as list of string: labels) as map
      op plotWaffle (as map: ctx, as list of float64: proportions, as list of string: labels) as map
}

contract (PlotGeometryCoordContract) {
      op plotCurvilinearGrid (as map: ctx, as int64: coord_sys, as int64: divisions) as map
      op plotCurvilinearCurve (as map: ctx, as int64: coord_sys, as list of float64: us, as list of float64: vs, as list of float64: ws, as list of int64: color) as map
}

contract (PlotSpecialMathContract) {
      op plotParametric2D (as map: ctx, as list of float64: xs, as list of float64: ys) as map
      op plotParametric3D (as map: ctx, as list of float64: xs, as list of float64: ys, as list of float64: zs) as map
      op plotBifurcation (as map: ctx, as float64: r_min, as float64: r_max, as int64: n_points) as map
      op plotPhaseSpace (as map: ctx, as list of float64: qs, as list of float64: ps) as map
      op plotNetworkGraph (as map: ctx, as list of data: nodes, as list of data: edges) as map
      op plotVenn (as map: ctx, as int64: set_count, as list of float64: subset_sizes) as map
}

contract (PlotEngineeringControlContract) {
      op plotBode (as map: ctx, as list of float64: omegas, as list of float64: mag_db, as list of float64: phase_deg) as map
      op plotNyquist (as map: ctx, as list of float64: real_parts, as list of float64: imag_parts) as map
      op plotNichols (as map: ctx, as list of float64: phase_deg, as list of float64: mag_db) as map
      op plotSmithChart (as map: ctx, as list of float64: gamma_re, as list of float64: gamma_im) as map
      op plotKaplanMeier (as map: ctx, as list of float64: times, as list of int64: events) as map
      op plotRocCurve (as map: ctx, as list of float64: fpr, as list of float64: tpr) as map
      op plotPareto (as map: ctx, as list of float64: frequencies, as list of string: categories) as map
      op plotRadar (as map: ctx, as list of float64: values, as list of string: axes_labels) as map
      op plotCoxcomb (as map: ctx, as list of float64: values, as list of string: sector_labels) as map
      op plotUxHeatmap (as map: ctx, as list of float64: click_xs, as list of float64: click_ys, as list of float64: weights) as map
}

contract (PlotThemeContract) {
      op plotThemeDark () as map
      op plotThemeLight () as map
      op plotThemeScientific () as map
      op plotGetColorMapRgb (as int64: cmap, as float64: t) as list of int64
}

contract (PlotRenderContract) {
      op plotRender (as map: ctx) as map
      op plotPresent (as map: ctx) as bool
      op plotShow (as map: ctx, as int64: ms) as bool
      op plotWait (as map: ctx) as bool
}

contract (PlotExportContract) {
      op plotExportHtml (as map: ctx, as string: path) as bool
      op plotExportSvg (as map: ctx, as string: path) as bool
}

agent (GraphPlotStdLib) impl PlotContextContract, PlotTransformContract, PlotDistributionContract, PlotRelationContract, PlotSurfaceFieldContract, PlotCompositionContract, PlotGeometryCoordContract, PlotSpecialMathContract, PlotEngineeringControlContract, PlotThemeContract, PlotRenderContract, PlotExportContract {

      #L =====================================================================
      #L Funcoes Auxiliares Internas
      #L =====================================================================

      op _listLen (as list of data: l) as int64 ==> {
            mut as int64: count = 0
            infinite (x in l) {
                  count = count + 1
            }
            emit(nice, count, "ok")
      }

      op _addLayer (as map: ctx, as map: layer) as map ==> {
            mut as list of data: layers = ctx["layers"] as list of data
            mut as int64: count = (ctx["items_count"] as int64) + 1
            layers[count] = layer
            ctx["layers"] = layers
            ctx["items_count"] = count
            emit(nice, ctx, "ok")
      }

      #L =====================================================================
      #L 1. PlotContextContract
      #L =====================================================================

      op plotCreate (as int64: width, as int64: height, as string: title) as map ==> {
            mut as int64: win_id = gfxWindowCreate(width, height, title)
            mut as map: p = map{}
            p["width"] = width
            p["height"] = height
            p["title"] = title
            p["vp_x"] = 0
            p["vp_y"] = 0
            p["vp_w"] = width
            p["vp_h"] = height
            p["margin_top"] = 40
            p["margin_right"] = 40
            p["margin_bottom"] = 50
            p["margin_left"] = 60
            p["coord_sys"] = 1 #L CARTESIAN_2D
            p["cam_type"] = 1  #L PERSPECTIVE
            p["cam_fov"] = 45.0
            p["cam_pitch"] = 30.0
            p["cam_yaw"] = -45.0
            p["cam_dist"] = 3.5
            p["scale_type"] = 1 #L LINEAR
            p["colormap"] = 1   #L VIRIDIS
            p["show_axes"] = true
            p["show_grid"] = true
            p["show_legend"] = true
            p["native_win"] = win_id
            p["layers"] = []
            p["items_count"] = 0
            
            mut as map: gctx = gfxInitContext(width, height, title)
            gctx = gfxBindNativeWindow(gctx, win_id)
            p["gfx_ctx"] = gctx
            emit(nice, p, "ok")
      }

      op plotClose (as map: ctx) as map ==> {
            route {
                  ctx["native_win"] as int64 > 0 ==> {
                        mut as int64: wid = ctx["native_win"] as int64
                        mut as bool: closed = gfxWindowClose(wid)
                  }
            }
            emit(nice, ctx, "ok")
      }

      op plotSetViewport (as map: ctx, as int64: x, as int64: y, as int64: w, as int64: h) as map ==> {
            ctx["vp_x"] = x
            ctx["vp_y"] = y
            ctx["vp_w"] = w
            ctx["vp_h"] = h
            emit(nice, ctx, "ok")
      }

      op plotSetMargins (as map: ctx, as int64: top, as int64: right, as int64: bottom, as int64: left) as map ==> {
            ctx["margin_top"] = top
            ctx["margin_right"] = right
            ctx["margin_bottom"] = bottom
            ctx["margin_left"] = left
            emit(nice, ctx, "ok")
      }

      op plotSetCoordSystem (as map: ctx, as int64: coord_sys) as map ==> {
            ctx["coord_sys"] = coord_sys
            emit(nice, ctx, "ok")
      }

      op plotSetCamera (as map: ctx, as int64: cam_type, as float64: fov) as map ==> {
            ctx["cam_type"] = cam_type
            ctx["cam_fov"] = fov
            emit(nice, ctx, "ok")
      }

      op plotSetScaleType (as map: ctx, as int64: scale_type) as map ==> {
            ctx["scale_type"] = scale_type
            emit(nice, ctx, "ok")
      }

      op plotSetColorMap (as map: ctx, as int64: cmap) as map ==> {
            ctx["colormap"] = cmap
            emit(nice, ctx, "ok")
      }

      op plotShowAxes (as map: ctx, as bool: show) as map ==> {
            ctx["show_axes"] = show
            emit(nice, ctx, "ok")
      }

      op plotShowGrid (as map: ctx, as bool: show) as map ==> {
            ctx["show_grid"] = show
            emit(nice, ctx, "ok")
      }

      op plotShowLegend (as map: ctx, as bool: show) as map ==> {
            ctx["show_legend"] = show
            emit(nice, ctx, "ok")
      }

      op plotBindWindow (as map: ctx, as int64: win_id) as map ==> {
            mut as int64: old_win = ctx["native_win"] as int64
            route {
                  old_win > 0 and old_win != win_id ==> {
                        mut as bool: closed_old = gfxWindowClose(old_win)
                  }
            }
            ctx["native_win"] = win_id
            mut as map: gctx = ctx["gfx_ctx"] as map
            gctx = gfxBindNativeWindow(gctx, win_id)
            ctx["gfx_ctx"] = gctx
            emit(nice, ctx, "ok")
      }

      op plotGetWindow (as map: ctx) as int64 ==> {
            mut as int64: win_id = ctx["native_win"] as int64
            emit(nice, win_id, "ok")
      }

      #L =====================================================================
      #L 2. PlotTransformContract (20+ Sistemas de Coordenadas)
      #L =====================================================================

      op plotTransformToCartesian (as int64: coord_sys, as float64: u, as float64: v, as float64: w) as list of float64 ==> {
            mut as float64: x = u
            mut as float64: y = v
            mut as float64: z = w

            route {
                  coord_sys == 3 ==> { #L POLAR (r, theta)
                        x = u * cos64(v)
                        y = u * sin64(v)
                        z = 0.0
                  }
                  coord_sys == 4 ==> { #L CYLINDRICAL (r, theta, z)
                        x = u * cos64(v)
                        y = u * sin64(v)
                        z = w
                  }
                  coord_sys == 5 ==> { #L SPHERICAL (r, theta, phi)
                        x = u * sin64(v) * cos64(w)
                        y = u * sin64(v) * sin64(w)
                        z = u * cos64(v)
                  }
                  coord_sys == 6 ==> { #L LOG_X (log_b(u), v)
                        x = u
                        route { u > 0.0 ==> { x = log10_64(u) } }
                        y = v
                        z = w
                  }
                  coord_sys == 7 ==> { #L LOG_Y (u, log_b(v))
                        x = u
                        y = v
                        route { v > 0.0 ==> { y = log10_64(v) } }
                        z = w
                  }
                  coord_sys == 8 ==> { #L LOG_LOG (log_b(u), log_b(v))
                        x = u
                        y = v
                        route { u > 0.0 ==> { x = log10_64(u) } }
                        route { v > 0.0 ==> { y = log10_64(v) } }
                        z = w
                  }
                  coord_sys == 9 ==> { #L TERNARY (a, b, c) -> 2D Triangulo
                        mut as float64: sum_abc = u + v + w
                        route { sum_abc <= 0.0 ==> { sum_abc = 1.0 } }
                        x = 0.5 * (2.0 * v + w) /f sum_abc
                        y = (1.7320508075688772 /f 2.0) * w /f sum_abc
                        z = 0.0
                  }
                  coord_sys == 10 ==> { #L BARYCENTRIC (u, v, w)
                        x = u
                        y = v
                        z = w
                  }
                  coord_sys == 12 ==> { #L ELLIPTIC_2D (mu, nu, focal_a=1.0)
                        mut as float64: a = 1.0
                        x = a * cosh64(u) * cos64(v)
                        y = a * sinh64(u) * sin64(v)
                        z = 0.0
                  }
                  coord_sys == 13 ==> { #L ELLIPTIC_CYLINDRICAL
                        mut as float64: a = 1.0
                        x = a * cosh64(u) * cos64(v)
                        y = a * sinh64(u) * sin64(v)
                        z = w
                  }
                  coord_sys == 14 ==> { #L PARABOLIC_2D (sigma, tau)
                        x = 0.5 * (u * u - v * v)
                        y = u * v
                        z = 0.0
                  }
                  coord_sys == 15 ==> { #L PARABOLIC_CYLINDRICAL
                        x = 0.5 * (u * u - v * v)
                        y = u * v
                        z = w
                  }
                  coord_sys == 16 ==> { #L PARABOLIC_3D
                        x = u * v * cos64(w)
                        y = u * v * sin64(w)
                        z = 0.5 * (u * u - v * v)
                  }
                  coord_sys == 17 ==> { #L BIPOLAR (tau, sigma, a=1.0)
                        mut as float64: a = 1.0
                        mut as float64: denom = cosh64(u) - cos64(v)
                        route { denom == 0.0 ==> { denom = 0.00001 } }
                        x = a * sinh64(u) /f denom
                        y = a * sin64(v) /f denom
                        z = 0.0
                  }
                  coord_sys == 18 ==> { #L BISPHERICAL
                        mut as float64: a = 1.0
                        mut as float64: denom = cosh64(u) - cos64(v)
                        route { denom == 0.0 ==> { denom = 0.00001 } }
                        x = a * sin64(v) * cos64(w) /f denom
                        y = a * sin64(v) * sin64(w) /f denom
                        z = a * sinh64(u) /f denom
                  }
                  coord_sys == 19 ==> { #L TOROIDAL
                        mut as float64: a = 1.0
                        mut as float64: denom = cosh64(u) - cos64(v)
                        route { denom == 0.0 ==> { denom = 0.00001 } }
                        x = a * sinh64(u) * cos64(w) /f denom
                        y = a * sinh64(u) * sin64(w) /f denom
                        z = a * sin64(v) /f denom
                  }
                  coord_sys == 20 ==> { #L PROLATE_SPHEROIDAL
                        mut as float64: a = 1.0
                        x = a * sinh64(u) * sin64(v) * cos64(w)
                        y = a * sinh64(u) * sin64(v) * sin64(w)
                        z = a * cosh64(u) * cos64(v)
                  }
                  coord_sys == 21 ==> { #L OBLATE_SPHEROIDAL
                        mut as float64: a = 1.0
                        x = a * cosh64(u) * cos64(v) * cos64(w)
                        y = a * cosh64(u) * cos64(v) * sin64(w)
                        z = a * sinh64(u) * sin64(v)
                  }
                  coord_sys == 22 ==> { #L STEREOGRAPHIC
                        mut as float64: denom = 1.0 - w
                        route { denom == 0.0 ==> { denom = 0.00001 } }
                        x = u /f denom
                        y = v /f denom
                        z = 0.0
                  }
                  coord_sys == 24 ==> { #L PHASE_SPACE (q, p, dot_p)
                        x = u
                        y = v
                        z = w
                  }
            }

            mut as list of float64: res = [x, y, z]
            emit(nice, res, "ok")
      }

      op plotTransformFromCartesian (as int64: coord_sys, as float64: x, as float64: y, as float64: z) as list of float64 ==> {
            mut as float64: u = x
            mut as float64: v = y
            mut as float64: w = z

            route {
                  coord_sys == 3 ==> { #L POLAR
                        u = (x * x + y * y) ^e 0.5
                        v = arcTan2_64(y, x)
                        w = 0.0
                  }
                  coord_sys == 4 ==> { #L CYLINDRICAL
                        u = (x * x + y * y) ^e 0.5
                        v = arcTan2_64(y, x)
                        w = z
                  }
                  coord_sys == 5 ==> { #L SPHERICAL
                        u = (x * x + y * y + z * z) ^e 0.5
                        route {
                              u > 0.0 ==> {
                                    v = arcCos64(z /f u)
                                    w = arcTan2_64(y, x)
                              }
                        }
                  }
            }

            mut as list of float64: res = [u, v, w]
            emit(nice, res, "ok")
      }

      op plotProjectToScreen (as map: ctx, as float64: x, as float64: y, as float64: z) as list of int64 ==> {
            mut as int64: vp_x = ctx["vp_x"] as int64
            mut as int64: vp_y = ctx["vp_y"] as int64
            mut as int64: vp_w = ctx["vp_w"] as int64
            mut as int64: vp_h = ctx["vp_h"] as int64
            mut as int64: m_t = ctx["margin_top"] as int64
            mut as int64: m_r = ctx["margin_right"] as int64
            mut as int64: m_b = ctx["margin_bottom"] as int64
            mut as int64: m_l = ctx["margin_left"] as int64

            mut as float64: plot_w = (vp_w - m_l - m_r) as float64
            mut as float64: plot_h = (vp_h - m_t - m_b) as float64
            mut as float64: center_x = (vp_x + m_l) as float64 + plot_w * 0.5
            mut as float64: center_y = (vp_y + m_t) as float64 + plot_h * 0.5

            mut as int64: cam = ctx["cam_type"] as int64
            mut as float64: scr_x = center_x + x * (plot_w * 0.45)
            mut as float64: scr_y = center_y - y * (plot_h * 0.45)

            route {
                  cam == 3 ==> { #L ISOMETRIC 3D
                        mut as float64: iso_x = (x - y) * 0.8660254037844386
                        mut as float64: iso_y = (x + y) * 0.5 - z
                        scr_x = center_x + iso_x * (plot_w * 0.3)
                        scr_y = center_y - iso_y * (plot_h * 0.3)
                  }
                  cam == 5 ==> { #L CABINET OBLIQUE
                        mut as float64: cab_x = x + 0.35355339 * z
                        mut as float64: cab_y = y + 0.35355339 * z
                        scr_x = center_x + cab_x * (plot_w * 0.35)
                        scr_y = center_y - cab_y * (plot_h * 0.35)
                  }
            }

            mut as list of int64: pt = [scr_x as int64, scr_y as int64]
            emit(nice, pt, "ok")
      }

      #L =====================================================================
      #L 3. PlotDistributionContract (Família 1)
      #L =====================================================================

      op plotHistogram (as map: ctx, as list of float64: data_vals, as int64: n_bins) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "histogram"
            layer["data"] = data_vals
            layer["bins"] = n_bins
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotKde (as map: ctx, as list of float64: data_vals, as float64: bandwidth) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "kde"
            layer["data"] = data_vals
            layer["bandwidth"] = bandwidth
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotBoxplot (as map: ctx, as list of float64: data_vals, as float64: center_x, as float64: width) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "boxplot"
            layer["data"] = data_vals
            layer["cx"] = center_x
            layer["w"] = width
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotViolin (as map: ctx, as list of float64: data_vals, as float64: center_x, as float64: width) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "violin"
            layer["data"] = data_vals
            layer["cx"] = center_x
            layer["w"] = width
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotStrip (as map: ctx, as list of float64: data_vals, as float64: center_x) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "strip"
            layer["data"] = data_vals
            layer["cx"] = center_x
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotOgive (as map: ctx, as list of float64: data_vals) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "ogive"
            layer["data"] = data_vals
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      op plotQqPlot (as map: ctx, as list of float64: data_vals) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "qqplot"
            layer["data"] = data_vals
            mut as map: res = _addLayer(ctx, layer)
            emit(nice, res, "ok")
      }

      #L =====================================================================
      #L 4. PlotRelationContract (Família 2)
      #L =====================================================================

      op plotScatter (as map: ctx, as list of float64: xs, as list of float64: ys, as list of int64: color) as map ==> {
            mut as map: layer = map{}
            layer["type"] = "scatter"
            layer["xs"] = xs
            layer["ys"] = ys
            layer["color"] = color
            mut as map: res = _addLayer(ctx, layer)
