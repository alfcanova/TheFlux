#L ==============================================================================
#L TheFlux Standard Library: GfxStdLib
#L Dominio: GfxState
#L ==============================================================================

contract (GfxStateContract) {
      op gfxInitContext (as int64: width, as int64: height, as string: title) as map
      op gfxCloseContext (as map: ctx) as map
      op gfxContextShouldClose (as map: ctx) as bool
      op gfxContextWidth (as map: ctx) as int64
      op gfxContextHeight (as map: ctx) as int64
      op gfxContextTitle (as map: ctx) as string
      op gfxContextSetFps (as map: ctx, as int64: fps) as map
      op gfxContextGetFps (as map: ctx) as int64
      op gfxContextDrawCalls (as map: ctx) as int64
      op gfxContextResetDrawCalls (as map: ctx) as map
      op gfxCheckInBounds (as float64: x, as float64: y, as float64: w, as float64: h, as int64: screen_w, as int64: screen_h) as bool
      op gfxBindNativeWindow (as map: ctx, as int64: win_id) as map
      op gfxGetNativeWindow (as map: ctx) as int64
      op gfxPresentFrame (as map: ctx) as bool
      op gfxPollNativeEvents (as map: ctx) as int64
      op gfxContextWait (as map: ctx, as int64: ms) as bool
}

agent (GfxStdLib) impl GfxStateContract {
      #L 2. GfxStateContract
      #L =====================================================================

      op gfxInitContext (as int64: width, as int64: height, as string: title) as map ==> {
            mut as map: ctx = map{}
            ctx["width"] = width
            ctx["height"] = height
            ctx["title"] = title
            ctx["fps"] = 60
            ctx["closed"] = false
            ctx["draw_calls"] = 0
            emit(nice, ctx, "ok")
      }

      op gfxCloseContext (as map: ctx) as map ==> {
            ctx["closed"] = true
            emit(nice, ctx, "ok")
      }

      op gfxContextShouldClose (as map: ctx) as bool ==> {
            mut as bool: is_closed = false
            route {
                  _mapHasKey(ctx, "closed") ==> {
                        is_closed = ctx["closed"] == true
                  }
            }
            emit(nice, is_closed, "ok")
      }

      op gfxContextWidth (as map: ctx) as int64 ==> {
            mut as int64: w = 0
            route {
                  _mapHasKey(ctx, "width") ==> {
                        w = ctx["width"] as int64
                  }
            }
            emit(nice, w, "ok")
      }

      op gfxContextHeight (as map: ctx) as int64 ==> {
            mut as int64: h = 0
            route {
                  _mapHasKey(ctx, "height") ==> {
                        h = ctx["height"] as int64
                  }
            }
            emit(nice, h, "ok")
      }

      op gfxContextTitle (as map: ctx) as string ==> {
            mut as string: t = ""
            route {
                  _mapHasKey(ctx, "title") ==> {
                        t = ctx["title"] as string
                  }
            }
            emit(nice, t, "ok")
      }

      op gfxContextSetFps (as map: ctx, as int64: fps) as map ==> {
            ctx["fps"] = fps
            emit(nice, ctx, "ok")
      }

      op gfxContextGetFps (as map: ctx) as int64 ==> {
            mut as int64: f = 60
            route {
                  _mapHasKey(ctx, "fps") ==> {
                        f = ctx["fps"] as int64
                  }
            }
            emit(nice, f, "ok")
      }

      op gfxContextDrawCalls (as map: ctx) as int64 ==> {
            mut as int64: dc = 0
            route {
                  _mapHasKey(ctx, "draw_calls") ==> {
                        dc = ctx["draw_calls"] as int64
                  }
            }
            emit(nice, dc, "ok")
      }

      op gfxContextResetDrawCalls (as map: ctx) as map ==> {
            ctx["draw_calls"] = 0
            emit(nice, ctx, "ok")
      }

      op gfxCheckInBounds (as float64: x, as float64: y, as float64: w, as float64: h, as int64: screen_w, as int64: screen_h) as bool ==> {
            mut as float64: sw = screen_w as float64
            mut as float64: sh = screen_h as float64
            route {
                  x < 0.0 or y < 0.0 or (x + w) > sw or (y + h) > sh ==> {
                        emit(nice, false, "ok")
                  }
                  _ ==> {
                        emit(nice, true, "ok")
                  }
            }
      }

      op gfxBindNativeWindow (as map: ctx, as int64: win_id) as map ==> {
            ctx["native_win"] = win_id
            emit(nice, ctx, "ok")
      }

      op gfxGetNativeWindow (as map: ctx) as int64 ==> {
            mut as int64: win_id = 0
            route {
                  _mapHasKey(ctx, "native_win") ==> {
                        win_id = ctx["native_win"] as int64
                  }
            }
            emit(nice, win_id, "ok")
      }

      op gfxPresentFrame (as map: ctx) as bool ==> {
            mut as bool: ok = true
            route {
                  _mapHasKey(ctx, "native_win") ==> {
                        mut as int64: win_id = ctx["native_win"] as int64
                        route {
                              win_id > 0 ==> {
                                    ok = stdGfxWindowFlush(win_id)
                              }
                        }
                  }
            }
            emit(nice, ok, "ok")
      }

      op gfxPollNativeEvents (as map: ctx) as int64 ==> {
            mut as int64: ev = 0
            route {
                  _mapHasKey(ctx, "native_win") ==> {
                        mut as int64: win_id = ctx["native_win"] as int64
                        route {
                              win_id > 0 ==> {
                                    ev = stdGfxEventPoll(win_id)
                              }
                        }
                  }
            }
            emit(nice, ev, "ok")
      }

      op gfxContextWait (as map: ctx, as int64: ms) as bool ==> {
            mut as bool: ok = true
            route {
                  _mapHasKey(ctx, "native_win") ==> {
                        mut as int64: win_id = ctx["native_win"] as int64
                        route {
                              win_id > 0 ==> {
                                    ok = stdGfxWindowWait(win_id, ms)
                              }
                        }
                  }
            }
            emit(nice, ok, "ok")
      }

      #L =====================================================================
}
