#L ==============================================================================
#L TheFlux Standard Library: ConvertStdLib
#L Dominio: ConvertEncoding
#L ==============================================================================

contract (ConvertEncodingContract) {
      op convertCharToAscii (as string: ch) as int64
      op convertOrd (as string: ch) as int64
      op convertAsciiToChar (as int64: code) as string
      op convertChr (as int64: code) as string
      op convertStringToBase64 (as string: text) as string
      op convertBase64ToString (as string: b64_text) as string
      op convertStringToHex (as string: text) as string
      op convertHexToString (as string: hex_text) as string
}

agent (ConvertStdLib) impl ConvertEncodingContract {
      #L 3. ConvertEncodingContract
      #L ==============================================================================
      op convertOrd (as string: ch) as int64 ==> {
            mut as string: ascii_table = " !\"$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            route {
                  ch == "#" ==> { emit(nice, 35, "ok") }
                  ch == "\n" ==> { emit(nice, 10, "ok") }
                  ch == "\t" ==> { emit(nice, 9, "ok") }
                  ch == "\r" ==> { emit(nice, 13, "ok") }
            }
            mut as int64: found_code = 0
            mut as int64: idx = 1
            infinite (c in ascii_table) {
                  route {
                        c == ch and found_code == 0 ==> {
                              mut as int64: code_val = 31 + idx
                              route {
                                    code_val >= 35 ==> { code_val = code_val + 1 }
                              }
                              found_code = code_val
                        }
                  }
                  idx = idx + 1
            }
            emit(nice, found_code, "ok")
      }

      op convertCharToAscii (as string: ch) as int64 ==> {
            emit(nice, convertOrd(ch), "ok")
      }

      op convertChr (as int64: code) as string ==> {
            mut as string: ascii_table = " !\"$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            route {
                  code == 35 ==> { emit(nice, "#", "ok") }
                  code == 10 ==> { emit(nice, "\n", "ok") }
                  code == 9 ==> { emit(nice, "\t", "ok") }
                  code == 13 ==> { emit(nice, "\r", "ok") }
                  code >= 32 and code <= 126 ==> {
                        mut as int64: pos = code - 31
                        route {
                              code > 35 ==> { pos = pos - 1 }
                        }
                        emit(nice, ascii_table[pos], "ok")
                  }
            }
            emit(nice, "", "ok")
      }

      op convertAsciiToChar (as int64: code) as string ==> {
            emit(nice, convertChr(code), "ok")
      }

      op convertStringToBase64 (as string: text) as string ==> {
            mut as string: b64_table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            mut as int64: len = 0
            infinite (c in text) { len = len + 1 }
            route {
                  len == 0 ==> { emit(nice, "", "ok") }
            }
            mut as string: res = ""
            mut as int64: i = 1
            infinite (i <= len) {
                  mut as int64: b1 = convertOrd(text[i])
                  mut as int64: b2 = 0
                  mut as int64: b3 = 0
                  mut as int64: chunk_size = 1
                  route {
                        i + 1 <= len ==> {
                              b2 = convertOrd(text[i + 1])
                              chunk_size = 2
                        }
                  }
                  route {
                        i + 2 <= len ==> {
                              b3 = convertOrd(text[i + 2])
                              chunk_size = 3
                        }
                  }
                  mut as int64: n = (b1 * 65536) + (b2 * 256) + b3
                  mut as int64: idx1 = ((n /i 262144) /r 64) + 1
                  mut as int64: idx2 = ((n /i 4096) /r 64) + 1
                  mut as int64: idx3 = ((n /i 64) /r 64) + 1
                  mut as int64: idx4 = (n /r 64) + 1
                  
                  res = res + b64_table[idx1] + b64_table[idx2]
                  route {
                        chunk_size == 1 ==> {
                              res = res + "=="
                        }
                        chunk_size == 2 ==> {
                              res = res + b64_table[idx3] + "="
                        }
                        chunk_size == 3 ==> {
                              res = res + b64_table[idx3] + b64_table[idx4]
                        }
                  }
                  i = i + 3
            }
            emit(nice, res, "ok")
      }

      op _b64CharToVal (as string: ch) as int64 ==> {
            mut as string: b64_table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            mut as int64: idx = 1
            mut as int64: found_val = 0
            infinite (c in b64_table) {
                  route {
                        c == ch ==> {
                              found_val = idx - 1
                        }
                  }
                  idx = idx + 1
            }
            emit(nice, found_val, "ok")
      }

      op convertBase64ToString (as string: b64_text) as string ==> {
            mut as int64: len = 0
            infinite (c in b64_text) { len = len + 1 }
            route {
                  len == 0 or (len /r 4 != 0) ==> { emit(nice, "", "ok") }
            }
            mut as string: res = ""
            mut as int64: i = 1
            infinite (i <= len) {
                  mut as string: c1 = b64_text[i]
                  mut as string: c2 = b64_text[i + 1]
                  mut as string: c3 = b64_text[i + 2]
                  mut as string: c4 = b64_text[i + 3]
                  mut as int64: v1 = _b64CharToVal(c1)
                  mut as int64: v2 = _b64CharToVal(c2)
                  mut as int64: v3 = 0
                  mut as int64: v4 = 0
                  mut as bool: pad2 = (c3 == "=")
                  mut as bool: pad3 = (c4 == "=")
                  route {
                        not pad2 ==> { v3 = _b64CharToVal(c3) }
                  }
                  route {
                        not pad3 ==> { v4 = _b64CharToVal(c4) }
                  }
                  mut as int64: n = (v1 * 262144) + (v2 * 4096) + (v3 * 64) + v4
                  mut as int64: b1 = (n /i 65536) /r 256
                  mut as int64: b2 = (n /i 256) /r 256
                  mut as int64: b3 = n /r 256
                  res = res + convertChr(b1)
                  route {
                        not pad2 ==> { res = res + convertChr(b2) }
                  }
                  route {
                        not pad3 ==> { res = res + convertChr(b3) }
                  }
                  i = i + 4
            }
            emit(nice, res, "ok")
      }

      op convertStringToHex (as string: text) as string ==> {
            mut as string: hex_digits = "0123456789ABCDEF"
            mut as string: res = ""
            infinite (c in text) {
                  mut as int64: code = convertOrd(c)
                  mut as int64: h1 = code /i 16
                  mut as int64: h2 = code /r 16
                  res = res + hex_digits[h1 + 1] + hex_digits[h2 + 1]
            }
            emit(nice, res, "ok")
      }

      op convertHexToString (as string: hex_text) as string ==> {
            mut as int64: len = 0
            infinite (c in hex_text) { len = len + 1 }
            route {
                  len == 0 or (len /r 2 != 0) ==> { emit(nice, "", "ok") }
            }
            mut as string: res = ""
            mut as int64: i = 1
            infinite (i <= len) {
                  mut as string: ch1 = hex_text[i]
                  mut as string: ch2 = hex_text[i + 1]
                  mut as int64: d1 = 0
                  mut as int64: d2 = 0
                  route {
                        ch1 == "A" or ch1 == "a" ==> { d1 = 10 }
                        ch1 == "B" or ch1 == "b" ==> { d1 = 11 }
                        ch1 == "C" or ch1 == "c" ==> { d1 = 12 }
                        ch1 == "D" or ch1 == "d" ==> { d1 = 13 }
                        ch1 == "E" or ch1 == "e" ==> { d1 = 14 }
                        ch1 == "F" or ch1 == "f" ==> { d1 = 15 }
                        ch1 >= "0" and ch1 <= "9" ==> { d1 = (ch1 as int64) }
                  }
                  route {
                        ch2 == "A" or ch2 == "a" ==> { d2 = 10 }
                        ch2 == "B" or ch2 == "b" ==> { d2 = 11 }
                        ch2 == "C" or ch2 == "c" ==> { d2 = 12 }
                        ch2 == "D" or ch2 == "d" ==> { d2 = 13 }
                        ch2 == "E" or ch2 == "e" ==> { d2 = 14 }
                        ch2 == "F" or ch2 == "f" ==> { d2 = 15 }
                        ch2 >= "0" and ch2 <= "9" ==> { d2 = (ch2 as int64) }
                  }
                  mut as int64: code = d1 * 16 + d2
                  res = res + convertChr(code)
                  i = i + 2
            }
            emit(nice, res, "ok")
      }

      #L ==============================================================================
}
