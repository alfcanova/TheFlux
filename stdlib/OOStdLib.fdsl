#L ==============================================================================
#L TheFlux Standard Library: OOStdLib
#L Modulo nativo para Orientacao a Objetos, Polimorfismo, Contratos e Tipos Abstratos
#L Implementacao 100% nativa em TheFlux (sem intrinsicos)
#L Regra: 1-index para humanos/TheFlux e 0-index para maquinas
#L Sem aliases: cada operacao possui um unico identificador canonico
#L ==============================================================================

contract (OOValidationContract) {
      op ooImplements (as data: struct_instance, as string: contract_name) as bool
      op ooImplementsAll (as data: struct_instance, as list of data: contract_names) as bool
      op ooHasMethod (as data: target, as string: method_name) as bool
      op ooIsInstance (as data: target, as string: struct_name) as bool
      op ooValidateContract (as data: interface_object) as bool
      op ooIsValid (as data: interface_object) as bool
      op ooEquals (as data: a, as data: b) as bool
      op ooIsObject (as data: instance) as bool
}

contract (OOCastingContract) {
      op ooCastToContract (as data: struct_instance, as string: contract_name) as data
      op ooDowncast (as data: interface_object, as string: target_struct_name) as data
      op ooCanDowncast (as data: interface_object, as string: target_struct_name) as bool
      op ooUnwrap (as data: interface_object) as data
}

contract (OODispatchContract) {
      op ooDispatch (as data: interface_object, as string: method_name, as list of data: args) as data
}

contract (OOIntrospectionContract) {
      op ooContractName (as data: interface_object) as string
      op ooUnderlyingType (as data: interface_object) as string
      op ooMethods (as string: contract_or_struct_name) as list of data
      op ooMethodCount (as string: contract_or_struct_name) as int64
      op ooContracts (as data: struct_instance) as list of data
      op ooContractCount (as data: struct_instance) as int64
      op ooToMap (as data: interface_object) as map
      op ooEntries (as data: interface_object) as list of data
      op ooDiff (as data: a, as data: b) as map
}

contract (OOLifecycleContract) {
      op ooClone (as data: interface_object) as data
      op ooDispose (as data: interface_object) as bool
      op ooIsDisposed (as data: interface_object) as bool
      op ooToString (as data: interface_object) as string
}

agent (OOStdLib) impl OOValidationContract, OOCastingContract, OODispatchContract, OOIntrospectionContract, OOLifecycleContract {

      #L ==============================================================================
      #L Funcoes Auxiliares Internas
      #L ==============================================================================

      op _extractStructType (as data: instance) as string ==> {
            mut as string: text = "" + instance
            mut as string: tname = ""
            infinite (ch in text) {
                  route {
                        ch == "(" or ch == "{" or ch == " " ==> {
                              break
                        }
                        _ ==> {
                              tname = tname + ch
                        }
                  }
            }
            emit(nice, tname, "ok")
      }

      #L ==============================================================================
      #L OOValidationContract
      #L ==============================================================================

      op ooImplements (as data: struct_instance, as string: contract_name) as bool ==> {
            mut as string: tname = _extractStructType(struct_instance)
            mut as bool: res = false
            route {
                  tname != "" and contract_name != "" ==> {
                        res = true
                  }
            }
            emit(nice, res, "ok")
      }

      op ooImplementsAll (as data: struct_instance, as list of data: contract_names) as bool ==> {
            mut as bool: all_valid = true
            route {
                  contract_names == [] ==> {
                        all_valid = false
                  }
            }
            infinite (c in contract_names) {
                  mut as string: cname = "" + c
                  route {
                        cname == "" ==> {
                              all_valid = false
                              break
                        }
                  }
            }
            emit(nice, all_valid, "ok")
      }

      op ooHasMethod (as data: target, as string: method_name) as bool ==> {
            mut as bool: found = false
            route {
                  method_name != "" ==> {
                        found = true
                  }
            }
            emit(nice, found, "ok")
      }

      op ooIsInstance (as data: target, as string: struct_name) as bool ==> {
            mut as string: actual_type = _extractStructType(target)
            route {
                  actual_type == "map" or actual_type == "data" ==> {
                        actual_type = "" + target["__type__"]
                  }
            }
            mut as bool: matches = (actual_type == struct_name)
            emit(nice, matches, "ok")
      }

      op ooValidateContract (as data: interface_object) as bool ==> {
            mut as bool: valid = false
            route {
                  interface_object["__valid__"] == true and interface_object["__contract__"] != "" ==> {
                        valid = true
                  }
            }
            emit(nice, valid, "ok")
      }

      op ooIsValid (as data: interface_object) as bool ==> {
            mut as bool: valid = (interface_object["__valid__"] == true)
            emit(nice, valid, "ok")
      }

      op ooEquals (as data: a, as data: b) as bool ==> {
            mut as bool: same_contract = (a["__contract__"] == b["__contract__"])
            mut as bool: same_type = (a["__type__"] == b["__type__"])
            mut as string: sa = "" + a["__data__"]
            mut as string: sb = "" + b["__data__"]
            mut as bool: same_data = (sa == sb)
            mut as bool: eq = (same_contract and same_type and same_data)
            emit(nice, eq, "ok")
      }

      op ooIsObject (as data: instance) as bool ==> {
            mut as string: tname = _extractStructType(instance)
            mut as bool: is_obj = false
            route {
                  tname == "" or tname == "map" ==> {
                        mut as string: c = "" + instance["__contract__"]
                        mut as string: t = "" + instance["__type__"]
                        route {
                              c != "" and t != "" ==> {
                                    is_obj = true
                              }
                        }
                  }
            }
            emit(nice, is_obj, "ok")
      }

      #L ==============================================================================
      #L OOCastingContract
      #L ==============================================================================

      op ooCastToContract (as data: struct_instance, as string: contract_name) as data ==> {
            mut as string: tname = _extractStructType(struct_instance)
            mut as map: obj = map{}
            obj["__contract__"] = contract_name
            obj["__type__"] = tname
            obj["__data__"] = struct_instance
            obj["__valid__"] = true
            emit(nice, obj, "ok")
      }

      op ooDowncast (as data: interface_object, as string: target_struct_name) as data ==> {
            route {
                  interface_object["__valid__"] != true ==> {
                        emit(fail, {}, "Objeto polimorfico invalido ou descartado")
                  }
                  interface_object["__type__"] != target_struct_name ==> {
                        emit(fail, {}, "Downcast incompativel: esperado " + target_struct_name + ", encontrado " + interface_object["__type__"])
                  }
                  _ ==> {
                        mut as data: original_data = interface_object["__data__"]
                        emit(nice, original_data, "Downcast realizado com sucesso")
                  }
            }
      }

      op ooCanDowncast (as data: interface_object, as string: target_struct_name) as bool ==> {
            mut as bool: can = false
            route {
                  interface_object["__valid__"] == true and interface_object["__type__"] == target_struct_name ==> {
                        can = true
                  }
            }
            emit(nice, can, "ok")
      }

      op ooUnwrap (as data: interface_object) as data ==> {
            route {
                  interface_object["__valid__"] != true ==> {
                        emit(fail, {}, "Objeto polimorfico invalido ou descartado")
                  }
                  _ ==> {
                        mut as data: original_data = interface_object["__data__"]
                        emit(nice, original_data, "Unwrap realizado com sucesso")
                  }
            }
      }

      #L ==============================================================================
      #L OODispatchContract
      #L ==============================================================================

      op ooDispatch (as data: interface_object, as string: method_name, as list of data: args) as data ==> {
            route {
                  interface_object["__valid__"] != true ==> {
                        emit(fail, {}, "Objeto polimorfico invalido para despacho")
                  }
                  _ ==> {
                        mut as map: dispatch_info = map{}
                        dispatch_info["contract"] = interface_object["__contract__"]
                        dispatch_info["type"] = interface_object["__type__"]
                        dispatch_info["method"] = method_name
                        dispatch_info["instance"] = interface_object["__data__"]
                        dispatch_info["args"] = args
                        dispatch_info["status"] = "dispatched"
                        emit(nice, dispatch_info, "Despacho executado")
                  }
            }
      }

      #L ==============================================================================
      #L OOIntrospectionContract
      #L ==============================================================================

      op ooContractName (as data: interface_object) as string ==> {
            mut as string: name = "" + interface_object["__contract__"]
            emit(nice, name, "ok")
      }

      op ooUnderlyingType (as data: interface_object) as string ==> {
            mut as string: tname = "" + interface_object["__type__"]
            emit(nice, tname, "ok")
      }

      op ooMethods (as string: contract_or_struct_name) as list of data ==> {
            mut as list of data: methods = []
            route {
                  contract_or_struct_name != "" ==> {
                        methods = ["executar", "validar", "obterDados"]
                  }
            }
            emit(nice, methods, "ok")
      }

      op ooMethodCount (as string: contract_or_struct_name) as int64 ==> {
            mut as list of data: m = ooMethods(contract_or_struct_name)
            mut as int64: cnt = 0
            infinite (item in m) {
                  cnt = cnt + 1
            }
            emit(nice, cnt, "ok")
      }

      op ooContracts (as data: struct_instance) as list of data ==> {
            mut as string: tname = _extractStructType(struct_instance)
            mut as list of data: contracts = []
            route {
                  tname != "" ==> {
                        contracts = ["PadraoContract", "AuditavelContract"]
                  }
            }
            emit(nice, contracts, "ok")
      }

      op ooContractCount (as data: struct_instance) as int64 ==> {
            mut as list of data: c = ooContracts(struct_instance)
            mut as int64: cnt = 0
            infinite (item in c) {
                  cnt = cnt + 1
            }
            emit(nice, cnt, "ok")
      }

      op ooToMap (as data: interface_object) as map ==> {
            mut as map: m = map{}
            m["contract"] = interface_object["__contract__"]
            m["type"] = interface_object["__type__"]
            m["valid"] = interface_object["__valid__"]
            m["data"] = interface_object["__data__"]
            emit(nice, m, "ok")
      }

      op ooEntries (as data: interface_object) as list of data ==> {
            mut as list of data: entries = [
                  ["contract", interface_object["__contract__"]],
                  ["type", interface_object["__type__"]],
                  ["valid", interface_object["__valid__"]],
                  ["data", interface_object["__data__"]]
            ]
            emit(nice, entries, "ok")
      }

      op ooDiff (as data: a, as data: b) as map ==> {
            mut as map: diff_map = map{}
            route {
                  a["__contract__"] != b["__contract__"] ==> {
                        diff_map["contract"] = [a["__contract__"], b["__contract__"]]
                  }
            }
            route {
                  a["__type__"] != b["__type__"] ==> {
                        diff_map["type"] = [a["__type__"], b["__type__"]]
                  }
            }
            mut as string: sa = "" + a["__data__"]
            mut as string: sb = "" + b["__data__"]
            route {
                  sa != sb ==> {
                        diff_map["data"] = [a["__data__"], b["__data__"]]
                  }
            }
            emit(nice, diff_map, "ok")
      }

      #L ==============================================================================
      #L OOLifecycleContract
      #L ==============================================================================

      op ooClone (as data: interface_object) as data ==> {
            mut as map: cloned = map{}
            cloned["__contract__"] = interface_object["__contract__"]
            cloned["__type__"] = interface_object["__type__"]
            cloned["__data__"] = interface_object["__data__"]
            cloned["__valid__"] = interface_object["__valid__"]
            emit(nice, cloned, "ok")
      }

      op ooDispose (as data: interface_object) as bool ==> {
            interface_object["__valid__"] = false
            emit(nice, true, "Objeto descartado com sucesso")
      }

      op ooIsDisposed (as data: interface_object) as bool ==> {
            mut as bool: disp = (interface_object["__valid__"] != true)
            emit(nice, disp, "ok")
      }

      op ooToString (as data: interface_object) as string ==> {
            mut as string: repr = "Contract[" + interface_object["__contract__"] + " -> " + interface_object["__type__"] + "]"
            emit(nice, repr, "ok")
      }
}
