#L ==============================================================================
#L TheFlux Standard Library: DebugStdLib
#L Modulo nativo para depuracao, telemetria, assercoes, logs, inspecao e metricas
#L Implementacao 100% nativa em TheFlux (sem intrinsicos)
#L Regra: 1-index para humanos e 0-index para maquinas
#L ==============================================================================

contract (DebugAssertContract) {
      op debugAssert (as bool: condition, as string: message) as bool
      op debugAssertEqualInt (as int64: actual, as int64: expected, as string: tag) as bool
      op debugAssertEqualString (as string: actual, as string: expected, as string: tag) as bool
      op debugAssertEqualBool (as bool: actual, as bool: expected, as string: tag) as bool
      op debugAssertInRange (as int64: val, as int64: min_val, as int64: max_val, as string: tag) as bool
}

contract (DebugLoggingContract) {
      op debugLogInfo (as string: tag, as string: message) as string
      op debugLogWarn (as string: tag, as string: message) as string
      op debugLogError (as string: tag, as string: message) as string
      op debugLogDebug (as string: tag, as string: message) as string
      op debugTrace (as string: context, as string: step) as string
      op debugBanner (as string: title, as int64: width) as string
}

contract (DebugInspectContract) {
      op debugReprString (as string: text) as string
      op debugReprInt (as int64: value) as string
      op debugReprFloat (as float64: value) as string
      op debugReprBool (as bool: value) as string
      op debugDumpList (as list of data: items, as string: label) as string
      op debugHexDump (as string: text) as string
}

contract (DebugProfileContract) {
      op debugCounterNew () as int64
      op debugCounterIncrement (as int64: counter, as int64: step) as int64
      op debugMetricRecord (as string: name, as int64: value, as string: unit) as string
      op debugProgress (as int64: current, as int64: total, as int64: width) as string
}

contract (DebugDiffContract) {
      op debugDiffString (as string: actual, as string: expected) as string
      op debugDiffList (as list of data: actual, as list of data: expected) as string
      op debugDiffCount (as list of data: a, as list of data: b) as int64
}

contract (DebugPipelineContract) {
      op debugTap (as data: value, as string: step_name) as data
      op debugTapIf (as data: value, as bool: condition, as string: tag) as data
      op debugCounterTap (as data: value, as int64: counter) as int64
}

contract (DebugStateContract) {
      op debugStateTransition (as string: entity_name, as string: from_state, as string: to_state, as string: event_name) as string
      op debugStateAudit (as string: current_state, as list of data: allowed_states) as bool
      op debugBreadcrumb (as string: trail, as string: new_event) as string
}

contract (DebugFilterContract) {
      op debugLevelShouldLog (as int64: current_level, as int64: message_level) as bool
      op debugLevelName (as int64: level) as string
      op debugTagMatches (as string: active_tags, as string: target_tag) as bool
}

agent (DebugStdLib) impl DebugAssertContract, DebugLoggingContract, DebugInspectContract, DebugProfileContract, DebugDiffContract, DebugPipelineContract, DebugStateContract, DebugFilterContract {
      #L ==============================================================================
      #L Utilitarios Internos
      #L ==============================================================================
      op _ord (as string: ch) as int64 ==> {
            mut as string: ascii_table = " !\"$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            route {
                  ch == "#" ==> { emit(nice, 35, "ok") }
                  ch == "\n" ==> { emit(nice, 10, "ok") }
                  ch == "\t" ==> { emit(nice, 9, "ok") }
                  ch == "\r" ==> { emit(nice, 13, "ok") }
            }
            mut as int64: found_code = 0
            mut as int64: idx = 1
            infinite (c in ascii_table) {
                  route {
                        c == ch and found_code == 0 ==> {
                              mut as int64: code_val = 31 + idx
                              route {
                                    code_val >= 35 ==> { code_val = code_val + 1 }
                              }
                              found_code = code_val
                        }
                  }
                  idx = idx + 1
            }
            emit(nice, found_code, "ok")
      }

      op _toHexByte (as int64: code) as string ==> {
            mut as string: hex_digits = "0123456789ABCDEF"
            mut as int64: hi = code /i 16
            mut as int64: lo = code - hi * 16
            mut as string: res = hex_digits[hi + 1] + hex_digits[lo + 1]
            emit(nice, res, "ok")
      }

      #L ==============================================================================
      #L 2. DebugAssertContract
      #L ==============================================================================
      op debugAssert (as bool: condition, as string: message) as bool ==> {
            route {
                  condition ==> { emit(nice, true, "ok") }
                  _ ==> { emit(fail, false, message) }
            }
      }

      op debugAssertEqualInt (as int64: actual, as int64: expected, as string: tag) as bool ==> {
            route {
                  actual == expected ==> { emit(nice, true, "ok") }
                  _ ==> { emit(fail, false, tag + ": esperado " + expected + " mas obteve " + actual) }
            }
      }

      op debugAssertEqualString (as string: actual, as string: expected, as string: tag) as bool ==> {
            route {
                  actual == expected ==> { emit(nice, true, "ok") }
                  _ ==> { emit(fail, false, tag + ": esperado '" + expected + "' mas obteve '" + actual + "'") }
            }
      }

      op debugAssertEqualBool (as bool: actual, as bool: expected, as string: tag) as bool ==> {
            route {
                  actual == expected ==> { emit(nice, true, "ok") }
                  _ ==> { emit(fail, false, tag + ": valor booleano divergente") }
            }
      }

      op debugAssertInRange (as int64: val, as int64: min_val, as int64: max_val, as string: tag) as bool ==> {
            route {
                  val >= min_val and val <= max_val ==> { emit(nice, true, "ok") }
                  _ ==> { emit(fail, false, tag + ": valor " + val + " fora do intervalo [" + min_val + ", " + max_val + "]") }
            }
      }

      #L ==============================================================================
      #L 3. DebugLoggingContract
      #L ==============================================================================
      op debugLogInfo (as string: tag, as string: message) as string ==> {
            emit(nice, "[INFO]  [" + tag + "] " + message, "ok")
      }

      op debugLogWarn (as string: tag, as string: message) as string ==> {
            emit(nice, "[WARN]  [" + tag + "] " + message, "ok")
      }

      op debugLogError (as string: tag, as string: message) as string ==> {
            emit(nice, "[ERROR] [" + tag + "] " + message, "ok")
      }

      op debugLogDebug (as string: tag, as string: message) as string ==> {
            emit(nice, "[DEBUG] [" + tag + "] " + message, "ok")
      }

      op debugTrace (as string: context, as string: step) as string ==> {
            emit(nice, "[TRACE] " + context + " -> " + step, "ok")
      }

      op debugBanner (as string: title, as int64: width) as string ==> {
            mut as int64: w = width
            route {
                  w <= 0 ==> { w = 40 }
            }
            mut as string: line = ""
            mut as int64: i = 1
            infinite (i <= w) {
                  line = line + "="
                  i = i + 1
            }
            emit(nice, line + "\n  " + title + "\n" + line, "ok")
      }

      #L ==============================================================================
      #L 4. DebugInspectContract
      #L ==============================================================================
      op debugReprString (as string: text) as string ==> {
            emit(nice, "\"" + text + "\"", "ok")
      }

      op debugReprInt (as int64: value) as string ==> {
            emit(nice, "Int64(" + value + ")", "ok")
      }

      op debugReprFloat (as float64: value) as string ==> {
            emit(nice, "Float64(" + value + ")", "ok")
      }

      op debugReprBool (as bool: value) as string ==> {
            route {
                  value ==> { emit(nice, "Bool(true)", "ok") }
                  _ ==> { emit(nice, "Bool(false)", "ok") }
            }
      }

      op debugDumpList (as list of data: items, as string: label) as string ==> {
            mut as string: out_str = label + " ["
            mut as bool: first = true
            mut as int64: count = 0
            infinite (it in items) {
                  route {
                        first ==> {
                              out_str = out_str + it
                              first = false
                        }
                        _ ==> {
                              out_str = out_str + ", " + it
                        }
                  }
                  count = count + 1
            }
            out_str = out_str + "] (total: " + count + ")"
            emit(nice, out_str, "ok")
      }

      op debugHexDump (as string: text) as string ==> {
            mut as string: res = ""
            mut as bool: first = true
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  mut as string: h = _toHexByte(code)
                  route {
                        first ==> {
                              res = res + h
                              first = false
                        }
                        _ ==> {
                              res = res + " " + h
                        }
                  }
            }
            emit(nice, res, "ok")
      }

      #L ==============================================================================
      #L 5. DebugProfileContract
      #L ==============================================================================
      op debugCounterNew () as int64 ==> {
            emit(nice, 0, "ok")
      }

      op debugCounterIncrement (as int64: counter, as int64: step) as int64 ==> {
            emit(nice, counter + step, "ok")
      }

      op debugMetricRecord (as string: name, as int64: value, as string: unit) as string ==> {
            emit(nice, "[METRIC] " + name + ": " + value + " (" + unit + ")", "ok")
      }

      op debugProgress (as int64: current, as int64: total, as int64: width) as string ==> {
            mut as int64: tot = total
            route {
                  tot <= 0 ==> { tot = 100 }
            }
            mut as int64: cur = current
            route {
                  cur < 0 ==> { cur = 0 }
                  cur > tot ==> { cur = tot }
            }
            mut as int64: w = width
            route {
                  w <= 0 ==> { w = 20 }
            }
            mut as int64: filled = (cur * w) /i tot
            mut as int64: percent = (cur * 100) /i tot
            mut as string: bar = "["
            mut as int64: i = 1
            infinite (i <= filled) {
                  bar = bar + "="
                  i = i + 1
            }
            route {
                  filled < w ==> {
                        bar = bar + ">"
                        mut as int64: j = filled + 2
                        infinite (j <= w) {
                              bar = bar + " "
                              j = j + 1
                        }
                  }
            }
            bar = bar + "] " + percent + "%"
            emit(nice, bar, "ok")
      }

      #L ==============================================================================
      #L 6. DebugDiffContract
      #L ==============================================================================
      op debugDiffString (as string: actual, as string: expected) as string ==> {
            route {
                  actual == expected ==> {
                        emit(nice, "[DIFF:MATCH] Strings identicas", "ok")
                  }
                  _ ==> {
                        mut as int64: la = 0
                        infinite (c in actual) { la = la + 1 }
                        mut as int64: le = 0
                        infinite (c in expected) { le = le + 1 }
                        mut as int64: min_len = la
                        route { le < min_len ==> { min_len = le } }
                        mut as int64: diff_idx = 0
                        mut as int64: i = 1
                        infinite (i <= min_len and diff_idx == 0) {
                              route {
                                    actual[i] != expected[i] ==> {
                                          diff_idx = i
                                    }
                              }
                              i = i + 1
                        }
                        route {
                              diff_idx > 0 ==> {
                                    emit(nice, "[DIFF:MISMATCH] Divergencia no indice " + diff_idx + ": esperado '" + expected[diff_idx] + "' mas obteve '" + actual[diff_idx] + "'", "ok")
                              }
                              _ ==> {
                                    emit(nice, "[DIFF:LENGTH] Tamanhos divergentes: esperado " + le + " caracteres, obtido " + la, "ok")
                              }
                        }
                  }
            }
      }

      op debugDiffList (as list of data: actual, as list of data: expected) as string ==> {
            mut as int64: la = 0
            infinite (x in actual) { la = la + 1 }
            mut as int64: le = 0
            infinite (x in expected) { le = le + 1 }
            route {
                  la != le ==> {
                        emit(nice, "[DIFF:LIST_LENGTH] Tamanhos divergentes: esperado " + le + " itens, obtido " + la, "ok")
                  }
                  _ ==> {
                        mut as int64: diff_idx = 0
                        mut as int64: i = 1
                        infinite (i <= la and diff_idx == 0) {
                              route {
                                    actual[i] != expected[i] ==> {
                                          diff_idx = i
                                    }
                              }
                              i = i + 1
                        }
                        route {
                              diff_idx > 0 ==> {
                                    emit(nice, "[DIFF:LIST_MISMATCH] Divergencia no item " + diff_idx + ": esperado '" + expected[diff_idx] + "' mas obteve '" + actual[diff_idx] + "'", "ok")
                              }
                              _ ==> {
                                    emit(nice, "[DIFF:MATCH] Listas identicas (" + la + " itens)", "ok")
                              }
                        }
                  }
            }
      }

      op debugDiffCount (as list of data: a, as list of data: b) as int64 ==> {
            mut as int64: la = 0
            infinite (x in a) { la = la + 1 }
            mut as int64: lb = 0
            infinite (x in b) { lb = lb + 1 }
            mut as int64: min_len = la
            route { lb < min_len ==> { min_len = lb } }
            mut as int64: diffs = 0
            mut as int64: i = 1
            infinite (i <= min_len) {
                  route {
                        a[i] != b[i] ==> { diffs = diffs + 1 }
                  }
                  i = i + 1
            }
            route {
                  la > lb ==> { diffs = diffs + (la - lb) }
                  lb > la ==> { diffs = diffs + (lb - la) }
            }
            emit(nice, diffs, "ok")
      }

      #L ==============================================================================
      #L 7. DebugPipelineContract
      #L ==============================================================================
      op debugTap (as data: value, as string: step_name) as data ==> {
            println("[TAP] [" + step_name + "]: " + value)
            emit(nice, value, "ok")
      }

      op debugTapIf (as data: value, as bool: condition, as string: tag) as data ==> {
            route {
                  condition ==> {
                        println("[TAP:COND] [" + tag + "]: " + value)
                  }
            }
            emit(nice, value, "ok")
      }

      op debugCounterTap (as data: value, as int64: counter) as int64 ==> {
            emit(nice, counter + 1, "ok")
      }

      #L ==============================================================================
      #L 8. DebugStateContract
      #L ==============================================================================
      op debugStateTransition (as string: entity_name, as string: from_state, as string: to_state, as string: event_name) as string ==> {
            emit(nice, "[FSM:" + entity_name + "] '" + from_state + "' --(" + event_name + ")--> '" + to_state + "'", "ok")
      }

      op debugStateAudit (as string: current_state, as list of data: allowed_states) as bool ==> {
            mut as bool: valid = false
            infinite (st in allowed_states) {
                  route {
                        st == current_state ==> {
                              valid = true
                              break
                        }
                  }
            }
            emit(nice, valid, "ok")
      }

      op debugBreadcrumb (as string: trail, as string: new_event) as string ==> {
            route {
                  trail == "" ==> { emit(nice, new_event, "ok") }
                  _ ==> { emit(nice, trail + " > " + new_event, "ok") }
            }
      }

      #L ==============================================================================
      #L 9. DebugFilterContract
      #L ==============================================================================
      op debugLevelShouldLog (as int64: current_level, as int64: message_level) as bool ==> {
            emit(nice, current_level >= message_level, "ok")
      }

      op debugLevelName (as int64: level) as string ==> {
            route {
                  level == 1 ==> { emit(nice, "ERROR", "ok") }
                  level == 2 ==> { emit(nice, "WARN", "ok") }
                  level == 3 ==> { emit(nice, "INFO", "ok") }
                  level == 4 ==> { emit(nice, "DEBUG", "ok") }
                  _ ==> { emit(nice, "UNKNOWN", "ok") }
            }
      }

      op debugTagMatches (as string: active_tags, as string: target_tag) as bool ==> {
            route {
                  active_tags == "*" or active_tags == target_tag ==> {
                        emit(nice, true, "ok")
                  }
                  _ ==> {
                        emit(nice, false, "ok")
                  }
            }
      }
}
