#L ==============================================================================
#L TheFlux Standard Library: HashStdLib
#L Dominio: HashChecksum
#L ==============================================================================

contract (HashChecksumContract) {
      op hashCrc16 (as string: text) as int64
      op hashCrc32 (as string: text) as int64
      op hashCrc64 (as string: text) as int64
      op hashAdler32 (as string: text) as int64
      op hashFletcher16 (as string: text) as int64
      op hashBsdChecksum (as string: text) as int64
      op hashSysVChecksum (as string: text) as int64
      op hashLuhn (as string: digits) as bool
}

agent (HashStdLib) impl HashChecksumContract {
      #L ==============================================================================
      #L Utilitarios Internos
      #L ==============================================================================
      op _ord (as string: ch) as int64 ==> {
            route {
                  ch >= "a" and ch <= "z" ==> {
                        route {
                              ch == "a" ==> { emit(nice, 97, "ok") }
                              ch == "b" ==> { emit(nice, 98, "ok") }
                              ch == "c" ==> { emit(nice, 99, "ok") }
                              ch == "d" ==> { emit(nice, 100, "ok") }
                              ch == "e" ==> { emit(nice, 101, "ok") }
                              ch == "f" ==> { emit(nice, 102, "ok") }
                              ch == "g" ==> { emit(nice, 103, "ok") }
                              ch == "h" ==> { emit(nice, 104, "ok") }
                              ch == "i" ==> { emit(nice, 105, "ok") }
                              ch == "j" ==> { emit(nice, 106, "ok") }
                              ch == "k" ==> { emit(nice, 107, "ok") }
                              ch == "l" ==> { emit(nice, 108, "ok") }
                              ch == "m" ==> { emit(nice, 109, "ok") }
                              ch == "n" ==> { emit(nice, 110, "ok") }
                              ch == "o" ==> { emit(nice, 111, "ok") }
                              ch == "p" ==> { emit(nice, 112, "ok") }
                              ch == "q" ==> { emit(nice, 113, "ok") }
                              ch == "r" ==> { emit(nice, 114, "ok") }
                              ch == "s" ==> { emit(nice, 115, "ok") }
                              ch == "t" ==> { emit(nice, 116, "ok") }
                              ch == "u" ==> { emit(nice, 117, "ok") }
                              ch == "v" ==> { emit(nice, 118, "ok") }
                              ch == "w" ==> { emit(nice, 119, "ok") }
                              ch == "x" ==> { emit(nice, 120, "ok") }
                              ch == "y" ==> { emit(nice, 121, "ok") }
                              ch == "z" ==> { emit(nice, 122, "ok") }
                        }
                  }
                  ch >= "0" and ch <= "9" ==> {
                        route {
                              ch == "0" ==> { emit(nice, 48, "ok") }
                              ch == "1" ==> { emit(nice, 49, "ok") }
                              ch == "2" ==> { emit(nice, 50, "ok") }
                              ch == "3" ==> { emit(nice, 51, "ok") }
                              ch == "4" ==> { emit(nice, 52, "ok") }
                              ch == "5" ==> { emit(nice, 53, "ok") }
                              ch == "6" ==> { emit(nice, 54, "ok") }
                              ch == "7" ==> { emit(nice, 55, "ok") }
                              ch == "8" ==> { emit(nice, 56, "ok") }
                              ch == "9" ==> { emit(nice, 57, "ok") }
                        }
                  }
                  ch >= "A" and ch <= "Z" ==> {
                        route {
                              ch == "A" ==> { emit(nice, 65, "ok") }
                              ch == "B" ==> { emit(nice, 66, "ok") }
                              ch == "C" ==> { emit(nice, 67, "ok") }
                              ch == "D" ==> { emit(nice, 68, "ok") }
                              ch == "E" ==> { emit(nice, 69, "ok") }
                              ch == "F" ==> { emit(nice, 70, "ok") }
                              ch == "G" ==> { emit(nice, 71, "ok") }
                              ch == "H" ==> { emit(nice, 72, "ok") }
                              ch == "I" ==> { emit(nice, 73, "ok") }
                              ch == "J" ==> { emit(nice, 74, "ok") }
                              ch == "K" ==> { emit(nice, 75, "ok") }
                              ch == "L" ==> { emit(nice, 76, "ok") }
                              ch == "M" ==> { emit(nice, 77, "ok") }
                              ch == "N" ==> { emit(nice, 78, "ok") }
                              ch == "O" ==> { emit(nice, 79, "ok") }
                              ch == "P" ==> { emit(nice, 80, "ok") }
                              ch == "Q" ==> { emit(nice, 81, "ok") }
                              ch == "R" ==> { emit(nice, 82, "ok") }
                              ch == "S" ==> { emit(nice, 83, "ok") }
                              ch == "T" ==> { emit(nice, 84, "ok") }
                              ch == "U" ==> { emit(nice, 85, "ok") }
                              ch == "V" ==> { emit(nice, 86, "ok") }
                              ch == "W" ==> { emit(nice, 87, "ok") }
                              ch == "X" ==> { emit(nice, 88, "ok") }
                              ch == "Y" ==> { emit(nice, 89, "ok") }
                              ch == "Z" ==> { emit(nice, 90, "ok") }
                        }
                  }
                  ch == " " ==> { emit(nice, 32, "ok") }
                  ch == "!" ==> { emit(nice, 33, "ok") }
                  ch == "\"" ==> { emit(nice, 34, "ok") }
                  ch == "#" ==> { emit(nice, 35, "ok") }
                  ch == "$" ==> { emit(nice, 36, "ok") }
                  ch == "%" ==> { emit(nice, 37, "ok") }
                  ch == "&" ==> { emit(nice, 38, "ok") }
                  ch == "'" ==> { emit(nice, 39, "ok") }
                  ch == "(" ==> { emit(nice, 40, "ok") }
                  ch == ")" ==> { emit(nice, 41, "ok") }
                  ch == "*" ==> { emit(nice, 42, "ok") }
                  ch == "+" ==> { emit(nice, 43, "ok") }
                  ch == "," ==> { emit(nice, 44, "ok") }
                  ch == "-" ==> { emit(nice, 45, "ok") }
                  ch == "." ==> { emit(nice, 46, "ok") }
                  ch == "/" ==> { emit(nice, 47, "ok") }
                  ch == ":" ==> { emit(nice, 58, "ok") }
                  ch == ";" ==> { emit(nice, 59, "ok") }
                  ch == "<" ==> { emit(nice, 60, "ok") }
                  ch == "=" ==> { emit(nice, 61, "ok") }
                  ch == ">" ==> { emit(nice, 62, "ok") }
                  ch == "?" ==> { emit(nice, 63, "ok") }
                  ch == "@" ==> { emit(nice, 64, "ok") }
                  ch == "[" ==> { emit(nice, 91, "ok") }
                  ch == "\\" ==> { emit(nice, 92, "ok") }
                  ch == "]" ==> { emit(nice, 93, "ok") }
                  ch == "^" ==> { emit(nice, 94, "ok") }
                  ch == "_" ==> { emit(nice, 95, "ok") }
                  ch == "`" ==> { emit(nice, 96, "ok") }
                  ch == "{" ==> { emit(nice, 123, "ok") }
                  ch == "|" ==> { emit(nice, 124, "ok") }
                  ch == "}" ==> { emit(nice, 125, "ok") }
                  ch == "~" ==> { emit(nice, 126, "ok") }
                  ch == "\n" ==> { emit(nice, 10, "ok") }
                  ch == "\t" ==> { emit(nice, 9, "ok") }
                  ch == "\r" ==> { emit(nice, 13, "ok") }
            }
            emit(nice, 0, "ok")
      }

      op _toHex32 (as int64: val) as string ==> {
            mut as string: hx = "0123456789abcdef"
            mut as int64: v = val /r 4294967296
            mut as int64: d8 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d7 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d6 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d5 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d4 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d3 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d2 = (v /r 16) + 1
            v = v /i 16
            mut as int64: d1 = (v /r 16) + 1
            emit(nice, hx[d1] + hx[d2] + hx[d3] + hx[d4] + hx[d5] + hx[d6] + hx[d7] + hx[d8], "ok")
      }

      #L ==============================================================================
      #L 1. HashChecksumContract
      #L ==============================================================================
      op hashCrc16 (as string: text) as int64 ==> {
            mut as int64: crc = 65535
            mut as int64: poly = 4129
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  crc = crc ^ (code * 256)
                  mut as int64: bit = 1
                  infinite (bit <= 8) {
                        mut as bool: msb = ((crc /i 32768) /r 2 == 1)
                        crc = (crc * 2) /r 65536
                        route {
                              msb ==> { crc = crc ^ poly }
                        }
                        bit = bit + 1
                  }
            }
            emit(nice, crc, "ok")
      }

      op hashCrc32 (as string: text) as int64 ==> {
            mut as int64: crc = 4294967295
            mut as int64: poly = 3988292384
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  crc = crc ^ code
                  mut as int64: bit = 1
                  infinite (bit <= 8) {
                        mut as bool: lsb = (crc /r 2 == 1)
                        crc = crc /i 2
                        route {
                              lsb ==> { crc = crc ^ poly }
                        }
                        bit = bit + 1
                  }
            }
            crc = crc ^ 4294967295
            emit(nice, crc, "ok")
      }

      op hashCrc64 (as string: text) as int64 ==> {
            mut as int64: crc = 9223372036854775807
            mut as int64: poly = 482362153549216093
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  crc = (crc ^ code)
                  mut as int64: bit = 1
                  infinite (bit <= 8) {
                        mut as bool: lsb = (crc /r 2 == 1)
                        crc = crc /i 2
                        route {
                              lsb ==> { crc = (crc ^ poly) /r 9223372036854775807 }
                        }
                        bit = bit + 1
                  }
            }
            emit(nice, crc, "ok")
      }

      op hashAdler32 (as string: text) as int64 ==> {
            mut as int64: a = 1
            mut as int64: b = 0
            mut as int64: mod_adler = 65521
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  a = (a + code) /r mod_adler
                  b = (b + a) /r mod_adler
            }
            mut as int64: res = (b * 65536) + a
            emit(nice, res, "ok")
      }

      op hashFletcher16 (as string: text) as int64 ==> {
            mut as int64: sum1 = 0
            mut as int64: sum2 = 0
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  sum1 = (sum1 + code) /r 255
                  sum2 = (sum2 + sum1) /r 255
            }
            mut as int64: res = (sum2 * 256) + sum1
            emit(nice, res, "ok")
      }

      op hashBsdChecksum (as string: text) as int64 ==> {
            #L BSD 16-bit rotated checksum
            mut as int64: checksum = 0
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  #L checksum = (checksum >> 1) + ((checksum & 1) << 15)
                  checksum = (checksum /i 2) + ((checksum /r 2) * 32768)
                  checksum = (checksum + code) /r 65536
            }
            emit(nice, checksum, "ok")
      }

      op hashSysVChecksum (as string: text) as int64 ==> {
            #L System V 16-bit checksum
            mut as int64: s = 0
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  s = s + code
            }
            mut as int64: r = (s /r 65536) + (s /i 65536)
            r = (r /r 65536) + (r /i 65536)
            emit(nice, r, "ok")
      }

      op hashLuhn (as string: digits) as bool ==> {
            #L Algoritmo de Luhn (Mod 10 Check para validacao de cartoes de credito)
            mut as int64: sum = 0
            mut as int64: len = 0
            infinite (c in digits) {
                  len = len + 1
            }
            mut as int64: idx = 1
            mut as bool: alternate = false
            infinite (idx <= len) {
                  mut as int64: pos = len - idx + 1
                  mut as string: ch = digits[pos]
                  mut as int64: d = _ord(ch) - 48
                  route {
                        d >= 0 and d <= 9 ==> {
                              route {
                                    alternate ==> {
                                          d = d * 2
                                          route {
                                                d > 9 ==> { d = d - 9 }
                                          }
                                    }
                              }
                              sum = sum + d
                              alternate = not alternate
                        }
                  }
                  idx = idx + 1
            }
            emit(nice, (sum /r 10) == 0, "ok")
      }

      #L ==============================================================================
}
