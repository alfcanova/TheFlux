#L ==============================================================================
#L TheFlux Standard Library: HashStdLib
#L Dominio: HashDistributed
#L ==============================================================================

contract (HashDistributedContract) {
      op hashJumpConsistent (as int64: key, as int64: num_buckets) as int64
      op hashBloomIndices (as string: key, as int64: num_hashes, as int64: filter_size) as list of data
      op hashSimHash (as string: text) as string
      op hashMinHash (as string: text, as int64: num_hashes) as list of data
}

agent (HashStdLib) impl HashDistributedContract {
      #L 4. HashDistributedContract
      #L ==============================================================================
      op hashJumpConsistent (as int64: key, as int64: num_buckets) as int64 ==> {
            #L Jump Consistent Hash (Google Lamping & Veach)
            #L Retorna 1-index para humanos: [1..num_buckets]
            route {
                  num_buckets <= 1 ==> { emit(nice, 1, "ok") }
            }
            mut as int64: b = 0 - 1
            mut as int64: j = 0
            mut as int64: k = key
            infinite (j < num_buckets) {
                  b = j
                  k = ((k * 2862933555777941757) + 1) /r 9223372036854775807
                  mut as int64: denom = (k /i 2147483648) + 1
                  route {
                        denom <= 0 ==> { denom = 1 }
                  }
                  mut as int64: next_j = ((b + 1) * 2147483648) /i denom
                  route {
                        next_j <= j ==> { j = j + 1 }
                        next_j > j ==> { j = next_j }
                  }
            }
            emit(nice, b + 1, "ok")
      }

      op hashBloomIndices (as string: key, as int64: num_hashes, as int64: filter_size) as list of data ==> {
            #L Otimizacao Kirsch-Mitzenmacher para Bloom Filter: g_i(x) = (h1 + i * h2) % filter_size + 1
            mut as int64: h1 = 2166136261
            mut as int64: h2 = 5381
            infinite (c in key) {
                  mut as int64: code = _ord(c)
                  h1 = ((h1 ^ code) * 16777619) /r 4294967296
                  h2 = ((h2 * 33) ^ code) /r 4294967296
            }
            mut as list of data: indices = []
            mut as int64: i = 1
            infinite (i <= num_hashes) {
                  mut as int64: combined = (h1 + (i * h2)) /r filter_size
                  indices = indices + [combined + 1]
                  i = i + 1
            }
            emit(nice, indices, "ok")
      }

      op hashSimHash (as string: text) as string ==> {
            #L SimHash 64-bit fingerprint para deteccao de similaridade de texto
            mut as int64: h = 0
            infinite (c in text) {
                  mut as int64: code = _ord(c)
                  h = ((h ^ code) * 1099511628211) /r 9223372036854775807
            }
            mut as string: hex_digits = "0123456789abcdef"
            mut as string: res = ""
            mut as int64: v = h
            mut as int64: step = 1
            infinite (step <= 16) {
                  mut as int64: rem = v /r 16
                  res = hex_digits[rem + 1] + res
                  v = v /i 16
                  step = step + 1
            }
            emit(nice, res, "ok")
      }

      op hashMinHash (as string: text, as int64: num_hashes) as list of data ==> {
            mut as int64: base = hashFnv1a32(text)
            mut as list of data: sigs = []
            mut as int64: i = 1
            infinite (i <= num_hashes) {
                  sigs = sigs + [hashInt32(base + i)]
                  i = i + 1
            }
            emit(nice, sigs, "ok")
      }

      #L ==============================================================================
}
