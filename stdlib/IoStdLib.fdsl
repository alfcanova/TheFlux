#L ==============================================================================
#L TheFlux Standard Library: IoStdLib
#L Modulo nativo para operacoes de Entrada e Saida (I/O)
#L Regra: 1-index para humanos/TheFlux e 0-index para maquinas
#L ==============================================================================

contract (IoPrintContract) {
      op echo (as string: text) as string
      op printLn (as data: value) as data
      op printLine (as data: value) as data
      op printErr (as data: value) as data
}

contract (IoInputContract) {
      op readLn (as string: prompt) as string
      op readLine (as string: prompt) as string
}

contract (IoFileContract) {
      op readFile (as string: path) as string
      op writeFile (as string: path, as string: content) as string
      op appendFile (as string: path, as string: content) as string
      op deleteFile (as string: path) as bool
      op copyFile (as string: src, as string: dst) as bool
      op moveFile (as string: src, as string: dst) as bool
}

contract (IoFileInspectionContract) {
      op fileExists (as string: path) as bool
      op fileSize (as string: path) as int64
      op fileIsEmpty (as string: path) as bool
}

contract (IoFileLineContract) {
      op readLines (as string: path) as list of data
      op writeLines (as string: path, as list of data: lines) as string
      op appendLines (as string: path, as list of data: lines) as string
}

contract (IoDirectoryContract) {
      op dirExists (as string: path) as bool
      op createDir (as string: path) as bool
      op removeDir (as string: path) as bool
      op listDir (as string: path) as list of data
}

contract (IoPathContract) {
      op pathBaseName (as string: path) as string
      op pathDirName (as string: path) as string
      op pathExtension (as string: path) as string
      op pathJoin (as string: dir, as string: file) as string
}

contract (IoBinaryFileContract) {
      op readBinaryFile (as string: path) as string
      op writeBinaryFile (as string: path, as string: content) as string
      op readHexFile (as string: path) as string
      op writeHexFile (as string: path, as string: hex_content) as string
      op readBase64File (as string: path) as string
      op writeBase64File (as string: path, as string: b64_content) as string
}

contract (IoArchiveContract) {
      op archiveZip (as string: src_path, as string: dst_zip) as bool
      op archiveUnzip (as string: src_zip, as string: dst_dir) as bool
      op archiveTar (as string: src_path, as string: dst_tar) as bool
      op archiveExtractTar (as string: src_tar, as string: dst_dir) as bool
      op archiveTarGz (as string: src_path, as string: dst_targz) as bool
      op archiveExtractTarGz (as string: src_targz, as string: dst_dir) as bool
      op archiveTarBz2 (as string: src_path, as string: dst_tarbz2) as bool
      op archiveExtractTarBz2 (as string: src_tarbz2, as string: dst_dir) as bool
      op archiveTarXz (as string: src_path, as string: dst_tarxz) as bool
      op archiveExtractTarXz (as string: src_tarxz, as string: dst_dir) as bool
      op archiveTarZst (as string: src_path, as string: dst_tarzst) as bool
      op archiveExtractTarZst (as string: src_tarzst, as string: dst_dir) as bool
      op archiveCreate7z (as string: src_path, as string: dst_7z) as bool
      op archiveExtract7z (as string: src_7z, as string: dst_dir) as bool
      op archiveExtractRar (as string: src_rar, as string: dst_dir) as bool
      op archiveListFiles (as string: archive_path) as list of data
      op archiveExtractFile (as string: archive_path, as string: entry_name, as string: dst_dir) as bool
      op archiveIsArchive (as string: file_path) as bool
      op archiveDetectFormat (as string: file_path) as string
}

agent (IoStdLib) impl IoPrintContract, IoInputContract, IoFileContract, IoFileInspectionContract, IoFileLineContract, IoDirectoryContract, IoPathContract, IoBinaryFileContract, IoArchiveContract {

      #L -- IoPrintContract -------------------------------------------
      op echo (as string: text) as string ==> {
            print(text)
            emit(nice, text, "ok")
      }

      op printLn (as data: value) as data ==> {
            print(value)
            emit(nice, value, "ok")
      }

      op printLine (as data: value) as data ==> {
            print(value)
            emit(nice, value, "ok")
      }

      op printErr (as data: value) as data ==> {
            stdIoPrintErr(value)
            emit(nice, value, "ok")
      }

      #L -- IoInputContract -------------------------------------------
      op readLn (as string: prompt) as string ==> {
            mut as string: line = input(prompt)
            emit(nice, line, "ok")
      }

      op readLine (as string: prompt) as string ==> {
            mut as string: line = input(prompt)
            emit(nice, line, "ok")
      }

      #L -- IoFileContract --------------------------------------------
      op readFile (as string: path) as string ==> {
            emit(nice, stdIoReadFile(path), "ok")
      }

      op writeFile (as string: path, as string: content) as string ==> {
            emit(nice, stdIoWriteFile(path, content), "ok")
      }

      op appendFile (as string: path, as string: content) as string ==> {
            emit(nice, stdIoAppendFile(path, content), "ok")
      }

      op deleteFile (as string: path) as bool ==> {
            emit(nice, stdIoDeleteFile(path), "ok")
      }

      op copyFile (as string: src, as string: dst) as bool ==> {
            emit(nice, stdIoCopyFile(src, dst), "ok")
      }

      op moveFile (as string: src, as string: dst) as bool ==> {
            emit(nice, stdIoMoveFile(src, dst), "ok")
      }

      #L -- IoFileInspectionContract ----------------------------------
      op fileExists (as string: path) as bool ==> {
            emit(nice, stdIoFileExists(path), "ok")
      }

      op fileSize (as string: path) as int64 ==> {
            emit(nice, stdIoFileSize(path), "ok")
      }

      op fileIsEmpty (as string: path) as bool ==> {
            mut as int64: sz = stdIoFileSize(path)
            emit(nice, sz == 0, "ok")
      }

      #L -- IoFileLineContract ----------------------------------------
      op readLines (as string: path) as list of data ==> {
            emit(nice, stdIoReadLines(path), "ok")
      }

      op writeLines (as string: path, as list of data: lines) as string ==> {
            emit(nice, stdIoWriteLines(path, lines), "ok")
      }

      op appendLines (as string: path, as list of data: lines) as string ==> {
            emit(nice, stdIoAppendLines(path, lines), "ok")
      }

      #L -- IoDirectoryContract ---------------------------------------
      op dirExists (as string: path) as bool ==> {
            emit(nice, stdIoDirExists(path), "ok")
      }

      op createDir (as string: path) as bool ==> {
            emit(nice, stdIoCreateDir(path), "ok")
      }

      op removeDir (as string: path) as bool ==> {
            emit(nice, stdIoRemoveDir(path), "ok")
      }

      op listDir (as string: path) as list of data ==> {
            emit(nice, stdIoListDir(path), "ok")
      }

      #L -- IoPathContract --------------------------------------------
      op pathBaseName (as string: path) as string ==> {
            emit(nice, stdIoPathBaseName(path), "ok")
      }

      op pathDirName (as string: path) as string ==> {
            emit(nice, stdIoPathDirName(path), "ok")
      }

      op pathExtension (as string: path) as string ==> {
            emit(nice, stdIoPathExtension(path), "ok")
      }

      op pathJoin (as string: dir, as string: file) as string ==> {
            emit(nice, stdIoPathJoin(dir, file), "ok")
      }

      #L -- IoBinaryFileContract --------------------------------------
      op readBinaryFile (as string: path) as string ==> {
            emit(nice, stdIoReadBinaryFile(path), "ok")
      }

      op writeBinaryFile (as string: path, as string: content) as string ==> {
            emit(nice, stdIoWriteBinaryFile(path, content), "ok")
      }

      op readHexFile (as string: path) as string ==> {
            emit(nice, stdIoReadHexFile(path), "ok")
      }

      op writeHexFile (as string: path, as string: hex_content) as string ==> {
            emit(nice, stdIoWriteHexFile(path, hex_content), "ok")
      }

      op readBase64File (as string: path) as string ==> {
            emit(nice, stdIoReadBase64File(path), "ok")
      }

      op writeBase64File (as string: path, as string: b64_content) as string ==> {
            emit(nice, stdIoWriteBase64File(path, b64_content), "ok")
      }

      #L -- IoArchiveContract -----------------------------------------
      op archiveZip (as string: src_path, as string: dst_zip) as bool ==> {
            emit(nice, stdArchiveZip(src_path, dst_zip), "ok")
      }

      op archiveUnzip (as string: src_zip, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveUnzip(src_zip, dst_dir), "ok")
      }

      op archiveTar (as string: src_path, as string: dst_tar) as bool ==> {
            emit(nice, stdArchiveTar(src_path, dst_tar), "ok")
      }

      op archiveExtractTar (as string: src_tar, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractTar(src_tar, dst_dir), "ok")
      }

      op archiveTarGz (as string: src_path, as string: dst_targz) as bool ==> {
            emit(nice, stdArchiveTarGz(src_path, dst_targz), "ok")
      }

      op archiveExtractTarGz (as string: src_targz, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractTarGz(src_targz, dst_dir), "ok")
      }

      op archiveTarBz2 (as string: src_path, as string: dst_tarbz2) as bool ==> {
            emit(nice, stdArchiveTarBz2(src_path, dst_tarbz2), "ok")
      }

      op archiveExtractTarBz2 (as string: src_tarbz2, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractTarBz2(src_tarbz2, dst_dir), "ok")
      }

      op archiveTarXz (as string: src_path, as string: dst_tarxz) as bool ==> {
            emit(nice, stdArchiveTarXz(src_path, dst_tarxz), "ok")
      }

      op archiveExtractTarXz (as string: src_tarxz, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractTarXz(src_tarxz, dst_dir), "ok")
      }

      op archiveTarZst (as string: src_path, as string: dst_tarzst) as bool ==> {
            emit(nice, stdArchiveTarZst(src_path, dst_tarzst), "ok")
      }

      op archiveExtractTarZst (as string: src_tarzst, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractTarZst(src_tarzst, dst_dir), "ok")
      }

      op archiveCreate7z (as string: src_path, as string: dst_7z) as bool ==> {
            emit(nice, stdArchiveCreate7z(src_path, dst_7z), "ok")
      }

      op archiveExtract7z (as string: src_7z, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtract7z(src_7z, dst_dir), "ok")
      }

      op archiveExtractRar (as string: src_rar, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractRar(src_rar, dst_dir), "ok")
      }

      op archiveListFiles (as string: archive_path) as list of data ==> {
            emit(nice, stdArchiveListFiles(archive_path), "ok")
      }

      op archiveExtractFile (as string: archive_path, as string: entry_name, as string: dst_dir) as bool ==> {
            emit(nice, stdArchiveExtractFile(archive_path, entry_name, dst_dir), "ok")
      }

      op archiveIsArchive (as string: file_path) as bool ==> {
            emit(nice, stdArchiveIsArchive(file_path), "ok")
      }

      op archiveDetectFormat (as string: file_path) as string ==> {
            emit(nice, stdArchiveDetectFormat(file_path), "ok")
      }
}
