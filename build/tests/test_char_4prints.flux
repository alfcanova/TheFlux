mut as char: letra = 'A'
mut as char: digito = '7'
mut as char: espaco = ' '
mut as char: nova_linha = '\n'
mut as char: tabulacao = '\t'
mut as char: omega = '\u{03A9}'
mut as char: acento = 'ê'
mut as char: emoji = '\u{1F600}'

program (ExampleOfChar) {
      print("=== Char: caractere simples ===")
      print("letra: ", letra)
      print("digito: ", digito)
      print("espaco: [", espaco, "]")
}
