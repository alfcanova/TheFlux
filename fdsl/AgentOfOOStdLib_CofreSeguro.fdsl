struct (CofreDados) {
      imut: .SERIAL: string
      mut: .saldo_guardado: float64
      mut: .pin_hash: int64
      mut: .bloqueado: bool
}

contract (OperacoesCofre) {
      op depositarSeguro (as float64: valor_atual, as float64: deposito) as float64
      op retirarSeguro (as float64: valor_atual, as float64: saque, as int64: pin_digitado, as int64: pin_correto) as float64
}

agent (AgentOfOOStdLib_CofreSeguro) impl OperacoesCofre {
      op depositarSeguro (as float64: valor_atual, as float64: deposito) as float64 ==> {
            route {
                  deposito <= 0.0 ==> {
                        emit(fail, valor_atual, "Valor de deposito deve ser positivo")
                  }
                  _ ==> {
                        mut as float64: novo_saldo = valor_atual + deposito
                        emit(nice, novo_saldo, "Deposito aprovado com sucesso")
                  }
            }
      }

      op retirarSeguro (as float64: valor_atual, as float64: saque, as int64: pin_digitado, as int64: pin_correto) as float64 ==> {
            route {
                  pin_digitado != pin_correto ==> {
                        emit(fail, valor_atual, "Acesso negado: PIN incorreto")
                  }
                  saque > valor_atual ==> {
                        emit(fail, valor_atual, "Saldo insuficiente no cofre")
                  }
                  saque <= 0.0 ==> {
                        emit(fail, valor_atual, "Valor de saque invalido")
                  }
                  _ ==> {
                        mut as float64: novo_saldo = valor_atual - saque
                        emit(nice, novo_saldo, "Saque autorizado com sucesso")
                  }
            }
      }
}
